TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Iniciando carga das variáveis das Métricas do ePol;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;

//-----------------------------------------------------------------------------------------------
// Variáveis de métricas do ePol - versão parametrizada
//-----------------------------------------------------------------------------------------------
//
// Observações:
//      SomaAnteriores já é o Pareto
//      DtMesAno      = cálculo com [Tipo da Data] = {'Evento do Caso'} (datas únicas)
//      ProcDtDtMesAno = cálculo sem [Tipo da Data], usando [Proc_Data Data Ano] (datas do fato)
//      DtMesAnoInst  = cálculo usando [Ano da Instauração] (para métricas InstData)
//
// OBS:
//    - variáveis SEM sufixo 'Tot' → usadas em gráficos com dimensões de Unidade/localização etc.
//    - variáveis COM sufixo 'Tot' → usadas em gráficos com dimensões de Data Mês Ano etc.
//-----------------------------------------------------------------------------------------------

//==============================================================================================
// SUBROUTINES AUXILIARES
//==============================================================================================

/*----------------------------------------------------------------------------------------------
    SUB GerarConjunto12ProcData(vNomeFiltro)
    Gera vListaConjunto com 12 variantes usando padrão de datas de Evento do Caso / Proc_Data.
    Parâmetro: vNomeFiltro = nome da variável que contém o filtro base (ex: 'vFCasosData').
    O filtro base deve conter [Tipo do Fato] mas NÃO [Tipo da Data].
    Uso:  SET vFMeuFiltro = [Tipo do Fato] = {'Casos_Data'};
          CALL GerarConjunto12ProcData('vFMeuFiltro');
----------------------------------------------------------------------------------------------*/
SUB GerarConjunto12ProcData(vNomeFiltro)
    SET vListaConjunto =
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento do Caso'}|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento do Caso'}
                ,$(vConjProcDataDtMesAnoPfEmNumeros)|
                $($(vNomeFiltro))|
                $($(vNomeFiltro))
                ,$(vConjProcDataDtMesAnoProcDataPfEmNumeros)|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento do Caso'}
                ,[Ano] = {@(=Year(Today()))}|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento do Caso'}
                ,[Ano] = {@(=Year(Today()))}
                ,$(vConjProcDataDtMesAnoPfEmNumeros)|
                $($(vNomeFiltro))
                ,[Proc_Data Data Ano] = {@(=Year(Today()))}|
                $($(vNomeFiltro))
                ,[Proc_Data Data Ano] = {@(=Year(Today()))}
                ,$(vConjProcDataDtMesAnoProcDataPfEmNumeros)|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento do Caso'}
                ,[Ano] = {@(=MAX([Ano]-1))}|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento do Caso'}
                ,[Ano] = {@(=MAX([Ano]-1))}
                ,$(vConjProcDataDtMesAnoPfEmNumeros)|
                $($(vNomeFiltro))
                ,[Proc_Data Data Ano] = {@(MAX([Proc_Data Data Ano]-1))}|
                $($(vNomeFiltro))
                ,[Proc_Data Data Ano] = {@(MAX([Proc_Data Data Ano]-1))}
                ,$(vConjProcDataDtMesAnoProcDataPfEmNumeros)
                ;
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarConjunto12ProcDataSemPfEmNum(vNomeFiltro)
    Igual ao GerarConjunto12ProcData, mas as variantes PfEmNum são idênticas às não-PfEmNum.
    Usado para métricas onde o filtro de PfEmNum não se aplica (ex: vReRecAtivInst, vDurMedIplRelat).
----------------------------------------------------------------------------------------------*/
SUB GerarConjunto12ProcDataSemPfEmNum(vNomeFiltro)
    SET vListaConjunto =
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento do Caso'}|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento do Caso'}|
                $($(vNomeFiltro))|
                $($(vNomeFiltro))|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento do Caso'}
                ,[Ano] = {@(=Year(Today()))}|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento do Caso'}
                ,[Ano] = {@(=Year(Today()))}|
                $($(vNomeFiltro))
                ,[Proc_Data Data Ano] = {@(=Year(Today()))}|
                $($(vNomeFiltro))
                ,[Proc_Data Data Ano] = {@(=Year(Today()))}|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento do Caso'}
                ,[Ano] = {@(=MAX([Ano]-1))}|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento do Caso'}
                ,[Ano] = {@(=MAX([Ano]-1))}|
                $($(vNomeFiltro))
                ,[Proc_Data Data Ano] = {@(MAX([Proc_Data Data Ano]-1))}|
                $($(vNomeFiltro))
                ,[Proc_Data Data Ano] = {@(MAX([Proc_Data Data Ano]-1))}
                ;
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarConjunto12InstData(vNomeFiltro)
    Gera vListaConjunto com 12 variantes usando padrão de datas de Instauração.
    Parâmetro: vNomeFiltro = nome da variável que contém o filtro base.
    O filtro base deve conter [Tipo do Fato] mas NÃO [Tipo da Data] nem [Ano da Instauração].
----------------------------------------------------------------------------------------------*/
SUB GerarConjunto12InstData(vNomeFiltro)
    SET vListaConjunto =
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento do Caso'}|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento do Caso'}
                ,$(vConjInstDtMesAnoPfEmNumeros)|
                $($(vNomeFiltro))|
                $($(vNomeFiltro))
                ,$(vConjInstDtMesAnoInstPfEmNumeros)|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento do Caso'}
                ,[Ano] = {@(=Year(Today()))}|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento do Caso'}
                ,[Ano] = {@(=Year(Today()))}
                ,$(vConjInstDtMesAnoPfEmNumeros)|
                $($(vNomeFiltro))
                ,[Ano da Instauração] = {@(=Year(Today()))}|
                $($(vNomeFiltro))
                ,[Ano da Instauração] = {@(=Year(Today()))}
                ,$(vConjInstDtMesAnoInstPfEmNumeros)|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento do Caso'}
                ,[Ano] = {@(=MAX([Ano]-1))}|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento do Caso'}
                ,[Ano] = {@(=MAX([Ano]-1))}
                ,$(vConjInstDtMesAnoPfEmNumeros)|
                $($(vNomeFiltro))
                ,[Ano da Instauração] = {@(MAX([Ano da Instauração]-1))}|
                $($(vNomeFiltro))
                ,[Ano da Instauração] = {@(MAX([Ano da Instauração]-1))}
                ,$(vConjInstDtMesAnoInstPfEmNumeros)
                ;
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarListaNomes12ProcData(vRadical)
    Gera vListaNomeVariavel com os 12 sufixos do padrão ProcData.
----------------------------------------------------------------------------------------------*/
SUB GerarListaNomes12ProcData(vRadical)
    SET vListaNomeVariavel =
$(vRadical)DtMesAno|
$(vRadical)PfEmNumDtMesAno|
$(vRadical)ProcDtDtMesAno|
$(vRadical)PfEmNumProcDtDtMesAno|
$(vRadical)AnoAtual|
$(vRadical)PfEmNumAnoAtual|
$(vRadical)ProcDtDtAnoAtual|
$(vRadical)PfEmNumProcDtDtAnoAtual|
$(vRadical)AnoAnterior|
$(vRadical)PfEmNumAnoAnterior|
$(vRadical)ProcDtDtAnoAnterior|
$(vRadical)PfEmNumProcDtDtAnoAnterior
;
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarListaNomes12InstData(vRadical)
    Gera vListaNomeVariavel com os 12 sufixos do padrão InstData.
----------------------------------------------------------------------------------------------*/
SUB GerarListaNomes12InstData(vRadical)
    SET vListaNomeVariavel =
$(vRadical)DtMesAno|
$(vRadical)PfEmNumDtMesAno|
$(vRadical)DtMesAnoInst|
$(vRadical)PfEmNumDtMesAnoInst|
$(vRadical)AnoAtual|
$(vRadical)PfEmNumAnoAtual|
$(vRadical)AnoAtualInst|
$(vRadical)PfEmNumAnoAtualInst|
$(vRadical)AnoAnterior|
$(vRadical)PfEmNumAnoAnterior|
$(vRadical)AnoAnteriorInst|
$(vRadical)PfEmNumAnoAnteriorInst
;
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarListaNomesSomAnter12ProcData(vRadical)
    Gera vListaNomeVariavel com 12 sufixos para variáveis de Soma Anteriores (padrão ProcData).
----------------------------------------------------------------------------------------------*/
SUB GerarListaNomesSomAnter12ProcData(vRadical)
    SET vListaNomeVariavel =
$(vRadical)SomAnterDtMesAno|
$(vRadical)SomAnterPfEmNumDtMesAno|
$(vRadical)SomAnterProcDtDtMesAno|
$(vRadical)SomAnterPfEmNumProcDtDtMesAno|
$(vRadical)SomAnterAnoAtual|
$(vRadical)SomAnterPfEmNumAnoAtual|
$(vRadical)SomAnterProcDtDtAnoAtual|
$(vRadical)SomAnterPfEmNumProcDtDtAnoAtual|
$(vRadical)SomAnterAnoAnterior|
$(vRadical)SomAnterPfEmNumAnoAnterior|
$(vRadical)SomAnterProcDtDtAnoAnterior|
$(vRadical)SomAnterPfEmNumProcDtDtAnoAnterior
;
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarListaNomesSomAnter12InstData(vRadical)
    Gera vListaNomeVariavel com 12 sufixos para variáveis de Soma Anteriores (padrão InstData).
----------------------------------------------------------------------------------------------*/
SUB GerarListaNomesSomAnter12InstData(vRadical)
    SET vListaNomeVariavel =
$(vRadical)SomAnterDtMesAno|
$(vRadical)SomAnterPfEmNumDtMesAno|
$(vRadical)SomAnterDtMesAnoInst|
$(vRadical)SomAnterPfEmNumDtMesAnoInst|
$(vRadical)SomAnterAnoAtual|
$(vRadical)SomAnterPfEmNumAnoAtual|
$(vRadical)SomAnterAnoAtualInst|
$(vRadical)SomAnterPfEmNumAnoAtualInst|
$(vRadical)SomAnterAnoAnterior|
$(vRadical)SomAnterPfEmNumAnoAnterior|
$(vRadical)SomAnterAnoAnteriorInst|
$(vRadical)SomAnterPfEmNumAnoAnteriorInst
;
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarListaCampo12(vCampo)
    Gera vListaCampo repetindo o campo 12 vezes (separado por |).
----------------------------------------------------------------------------------------------*/
SUB GerarListaCampo12(vCampo)
    SET vListaCampo =
$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)
;
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarListaCampoDen12(vCampo)
    Gera vListaCampoDenominador repetindo o campo 12 vezes (separado por |).
----------------------------------------------------------------------------------------------*/
SUB GerarListaCampoDen12(vCampo)
    SET vListaCampoDenominador =
$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)
;
END SUB

/*----------------------------------------------------------------------------------------------
    SUB ExecutarLoopSoma12
    Executa FOR loop de 12 itens chamando CriarVariavelSoma.
    Requer: vListaNomeVariavel, vListaConjunto, vListaCampo já definidos.
----------------------------------------------------------------------------------------------*/
SUB ExecutarLoopSoma12
    FOR i = 1 TO 12
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vConjunto = SubField('$(vListaConjunto)', '|', i);
        LET vCampo = SubField('$(vListaCampo)', '|', i);
        CALL CriarVariavelSoma('$(vNomeVariavel)', '$(vConjunto)', '$(vCampo)');
    NEXT i
END SUB

/*----------------------------------------------------------------------------------------------
    SUB ExecutarLoopContagem12
    Executa FOR loop de 12 itens chamando CriarVariavelContagem.
----------------------------------------------------------------------------------------------*/
SUB ExecutarLoopContagem12
    FOR i = 1 TO 12
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vConjunto = SubField('$(vListaConjunto)', '|', i);
        LET vCampo = SubField('$(vListaCampo)', '|', i);
        CALL CriarVariavelContagem('$(vNomeVariavel)', '$(vConjunto)', '$(vCampo)');
    NEXT i
END SUB

