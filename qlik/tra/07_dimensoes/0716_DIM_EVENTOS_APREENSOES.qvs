TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Carregando DIM_EVENTOS_APREENSOES;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;

DIM_EVENTOS_APREENSOES:
Load Distinct
    AutoNumberHash128(id_evento_apreensao) AS [%EVENTOSAPREENSOESKEY],
    id_evento_apreensao,
    cd_item_epol_fk,
    cd_categoria_epol_fk,
    cd_classe_epol_fk,
    nr_apreensao,
    Date(dt_apreensao) as "Data do Evento Apreensão", // Data como texto
    year(dt_apreensao) as "Ano do Evento Apreensão", // Data como texto
    month(dt_apreensao) as "Mês do Evento Apreensão", // Data como texto
    Num(MONTH(dt_apreensao)) as  "Mês (Num) do Evento Apreensão", // Data como texto
    ds_apreensao,
    nr_caso,
    ds_item,
//     qt_item,
//     st_selecionado,
    ds_local_apreensao,
    un_item,
    un_item_original
RESIDENT TEMP_EVENTOS_APREENSOES_UNIFICADOS;

CALL StoreAndDrop('DIM_EVENTOS_APREENSOES', '$(vCaminhoTransformadosV3)');

TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Concluída carga DIM_EVENTOS_APREENSOES;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
