// -------------------------------------------------------------------
// Explode PRE_GPOL_EFETIVOS_LISTA em pares TIPO:QTD por operação
// Ex.: "APF:4; DPF:1; EPF:2" → linhas: (APF,4), (DPF,1), (EPF,2)
// -------------------------------------------------------------------
EFETIVOS_GPOL_RAW:
LOAD
    AutoNumberHash128(ID_OPERACAO) AS [%ID_OPERACAO_KEY],
    // Quebra por ';' (expande em múltiplas linhas)
    Trim(SubField(Replace(PRE_GPOL_EFETIVOS_LISTA, '; ', ';'), ';')) AS PairRaw
Resident TEMP_SIGACrimHomologadas
Where Len(Trim(PRE_GPOL_EFETIVOS_LISTA)) > 0;

// -------------------------------------------------------------------
// Refina cada par "TIPO:QTD", normaliza TIPO e converte QTD para número
// Mantém somente os tipos esperados (APF, DPF, EPF, PPF, PCF)
// -------------------------------------------------------------------
EFETIVOS_GPOL:
NoConcatenate
LOAD
    [%ID_OPERACAO_KEY],
    Upper(Trim(SubField(PairRaw, ':', 1))) AS CARGO,
    // Extrai apenas dígitos/sinais/ separados e normaliza decimal (se aparecer)
    Floor( Num#( Replace( KeepChar(SubField(PairRaw, ':', 2), '0123456789-+.,'),
                          ',', '.' ) ) ) AS QTD
Resident EFETIVOS_GPOL_RAW
Where
    Len(Trim(PairRaw)) > 0
    // Filtro de tipos válidos
    and Match(Upper(Trim(SubField(PairRaw, ':', 1))), 'APF','DPF','EPF','PPF','PCF');

Drop Table EFETIVOS_GPOL_RAW;

// -------------------------------------------------------------------
// Se por algum motivo a mesma operação trouxer o mesmo TIPO repetido,
// consolide as quantidades por segurança.
// -------------------------------------------------------------------
DIM_EFETIVOS_GPOL:
NoConcatenate
LOAD
    [%ID_OPERACAO_KEY],
    CARGO,
    Sum(QTD) AS QTD
Resident EFETIVOS_GPOL
Group By [%ID_OPERACAO_KEY], CARGO;

Drop Table EFETIVOS_GPOL;
// Mantém DIM_EFETIVOS_GPOL como tabela final normalizada.

CALL StoreAndDrop('DIM_EFETIVOS_GPOL', '$(vCaminhoTransformadosV3)');

