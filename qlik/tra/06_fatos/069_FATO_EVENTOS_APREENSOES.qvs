TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Carregando FATO_EVENTOS_APREENSOES;
TRACE >>> do TEMP_EVENTOS_APREENSOES_UNIFICADOS;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
///////////////////////////////////////////////////////////////
// Carga do BI DE ESTATÍSTICAS CRIMINAIS do NGE/COP/DICOR/PF //
// FATO_EVENTOS_APREENSOES DO Eventos_prisoes.qvd COM LINK TABLE //
///////////////////////////////////////////////////////////////

// === FATO_EVENTOS_APREENSOES DO Eventos_apreensoes.qvd === //
FATO_EVENTOS_APREENSOES:
LOAD
    AutoNumberHash128(id_evento_apreensao) AS [%EVENTOSAPREENSOESKEY],
//     nr_caso,
//     id_evento,
//     id_evento_apreensao,
//     "GestãoBens Item Material Subclasse Código",
//     cd_item_epol_fk,
//     cd_categoria_epol_fk,
//     cd_classe_epol_fk,
//     nr_apreensao,
//     dt_apreensao,
//     ds_apreensao,
//     ds_item,
    qt_item,
    qt_item_original,
    st_selecionado,
    IF(
        ApplyMap('MapCocainaMaterialIDs', cd_item_epol_fk, 'Não') = 'Sim',
        PICK(
            1 + MATCH(
                    upper(un_item), 'GR', 'G', 'KG'
            ),
            qt_item,
            qt_item / 1000,
            qt_item / 1000,
            qt_item
        ),
        0
    ) 
    AS "Evento Quantidade Apreendida Cocaína (kg)",
    IF(
        Year(dt_apreensao) < 2026,

        IF(
            ApplyMap('MapMaconhaMaterialIDs<2026', cd_item_epol_fk, 'Não') = 'Sim',
            PICK(
                1 + MATCH(
                    Upper(un_item),
                    'GR', 'G', 'KG'
                ),
                qt_item,
                qt_item / 1000,
                qt_item / 1000,
                qt_item
            ),
            0
        ),

        IF(
            ApplyMap('MapMaconhaMaterialIDs', cd_item_epol_fk, 'Não') = 'Sim',
            PICK(
                1 + MATCH(
                    Upper(un_item),
                    'GR', 'G', 'KG'
                ),
                qt_item,
                qt_item / 1000,
                qt_item / 1000,
                qt_item
            ),
            0
        )
    )
    AS [Evento Quantidade Apreendida Maconha (kg)]
//     ,
//     ds_local_apreensao,
//     un_item
//     ,
//     "Proc. Identificação"
RESIDENT TEMP_EVENTOS_APREENSOES_UNIFICADOS;


// === LINK TABLE DA FATO_EVENTOS_APREENSOES DO Eventos_apreensoes.qvd ===
// CONCATENATE(LINK_TABLE_APREENSOES_OPERACOES_CASOS)
TEMP_LINK_TABLE_APREENSOES_OPERACOES_CASOS_EVENTOS_APREENSOES_EXTERNAS_ESTRANGEIRO:
LOAD Distinct
    AutoNumberHash128("IPL") AS [%CASOSKEY],
    AutoNumberHash128(ID_OPERACAO) AS [%OPERACOESKEY],
//     NULL() AS [%APREENSOESKEY], 
    AutoNumberHash128("GestãoBens Item Material Subclasse Código") AS [%SUBCLASSESKEY],
//     NULL() AS [%CASOSDATAKEY],
    AutoNumberHash128(id_ordem_original_evento) AS [%EVENTOSKEY],
    AutoNumberHash128(id_evento_apreensao) AS [%EVENTOSAPREENSOESKEY],
//
// COMENTADO PARA COLOCAR AS DATAS NAS DIMENSÕES
//     Date(PRE_DT_PREVISTA_DEFLAGRACAO) as "Data Prevista para Deflagração",
//     YEAR(date(PRE_DT_PREVISTA_DEFLAGRACAO)) as "Ano Previsto para Deflagração",
//     MONTH(date(PRE_DT_PREVISTA_DEFLAGRACAO)) as "Mês Previsto para Deflagração",
// //
//     Date(DT_DEFLAGRACAO) as "Data da Deflagração",
//     YEAR(date(DT_DEFLAGRACAO)) as "Ano da Deflagração",
//     MONTH(date(DT_DEFLAGRACAO)) as "Mês da Deflagração",
//     Num(MONTH(date(DT_DEFLAGRACAO))) as "Mês (Num) da Deflagração",
// //
//     date(DT_INICIO) as "Data de Início",
//     Date(DT_HOMOLOGACAO) as "Data da Homologação",
//     YEAR(date(DT_HOMOLOGACAO)) as "Ano da Homologação",
//     MONTH(date(DT_HOMOLOGACAO)) as "Mês da Homologação",
//
    Date(dt_apreensao) as Data,
    YEAR(date(dt_apreensao)) as "Ano",
    MONTH(date(dt_apreensao)) as "Mês",
    Num(MONTH(date(dt_apreensao))) as "Mês (Num)",
    'Evento Apreensão' as "Tipo da Data",
//
    'Eventos Apreensões SIGACrim' as "Fonte",
    'Eventos Apreensões' AS "Tipo do Fato"
    
    // CARREGA %UNIDADEKEY
    ,$(vCarregaUnidAreaDirCoorGeralDoEventoOperacional)

RESIDENT TEMP_EVENTOS_APREENSOES_UNIFICADOS;

// LEFT JOIN (TEMP_LINK_TABLE_APREENSOES_OPERACOES_CASOS_EVENTOS_APREENSOES_EXTERNAS_ESTRANGEIRO)
// LOAD DISTINCT
//     AutoNumberHash128("IPL") AS [%CASOSKEY],
// 	$(vCarregaUnidAreaDirCoorGeralDoCaso)
// RESIDENT TEMP_DIM_CASOS;

// LEFT JOIN (TEMP_LINK_TABLE_APREENSOES_OPERACOES_CASOS_EVENTOS_APREENSOES_EXTERNAS_ESTRANGEIRO)
