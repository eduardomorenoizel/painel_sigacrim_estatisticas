SUB GerarMetricaReaisCompleta(vRadical, vNomeFiltro, vCampo)
    CALL GerarListaNomes12Apre('$(vRadical)');
    CALL GerarConjunto12Apre('$(vNomeFiltro)');
    CALL GerarListaCampo12('$(vCampo)');

    FOR i = 1 TO 12
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vConjunto = SubField('$(vListaConjunto)', '|', i);
        LET vCampoLocal = SubField('$(vListaCampo)', '|', i);
        CALL CriarVariavelSomaReais('$(vNomeVariavel)', '$(vConjunto)', '$(vCampoLocal)');
    NEXT i

    CALL GerarPorEfet6Reais('$(vRadical)');

    CALL GerarListaNomesSomAnter12Apre('$(vRadical)');
    CALL GerarConjunto12Apre('$(vNomeFiltro)');
    CALL GerarListaCampo12('$(vCampo)');

    FOR i = 1 TO 12
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vConjunto = SubField('$(vListaConjunto)', '|', i);
        LET vCampoLocal = SubField('$(vListaCampo)', '|', i);
        CALL CriarVariavelSomaReaisAnteriores('$(vNomeVariavel)', '$(vConjunto)', '$(vCampoLocal)');
    NEXT i
END SUB

SUB GerarMetricaMiCompleta(vRadical, vNomeFiltro, vCampo)
    CALL GerarListaNomes12Apre('$(vRadical)');
    CALL GerarConjunto12Apre('$(vNomeFiltro)');
    CALL GerarListaCampo12('$(vCampo)');

    FOR i = 1 TO 12
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vConjunto = SubField('$(vListaConjunto)', '|', i);
        LET vCampoLocal = SubField('$(vListaCampo)', '|', i);
        CALL CriarVariavelSomaMi('$(vNomeVariavel)', '$(vConjunto)', '$(vCampoLocal)');
    NEXT i

    CALL GerarPorEfet6Mi('$(vRadical)');
END SUB

SUB GerarMetricaBiCompleta(vRadical, vNomeFiltro, vCampo)
    CALL GerarListaNomes12Apre('$(vRadical)');
    CALL GerarConjunto12Apre('$(vNomeFiltro)');
    CALL GerarListaCampo12('$(vCampo)');

    FOR i = 1 TO 12
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vConjunto = SubField('$(vListaConjunto)', '|', i);
        LET vCampoLocal = SubField('$(vListaCampo)', '|', i);
        CALL CriarVariavelSomaBi('$(vNomeVariavel)', '$(vConjunto)', '$(vCampoLocal)');
    NEXT i

    CALL GerarPorEfet6Bi('$(vRadical)');
END SUB

SUB GerarProporcaoAprePercentual(vRadical, vNum, vDen)
    CALL GerarListaNomes12Apre('$(vRadical)');
    SET vListaNumerador =
$($(vNum)DtMesAno)|
$($(vNum)PfEmNumDtMesAno)|
$($(vNum)DtMesAnoApre)|
$($(vNum)PfEmNumDtMesAnoApre)|
$($(vNum)AnoAtual)|
$($(vNum)PfEmNumAnoAtual)|
$($(vNum)AnoApreAtual)|
$($(vNum)PfEmNumAnoApreAtual)|
$($(vNum)AnoAnterior)|
$($(vNum)PfEmNumAnoAnterior)|
$($(vNum)AnoApreAnterior)|
$($(vNum)PfEmNumAnoApreAnterior)
;
    SET vListaDenominador =
$($(vDen)DtMesAno)|
$($(vDen)PfEmNumDtMesAno)|
$($(vDen)DtMesAnoApre)|
$($(vDen)PfEmNumDtMesAnoApre)|
$($(vDen)AnoAtual)|
$($(vDen)PfEmNumAnoAtual)|
$($(vDen)AnoApreAtual)|
$($(vDen)PfEmNumAnoApreAtual)|
$($(vDen)AnoAnterior)|
$($(vDen)PfEmNumAnoAnterior)|
$($(vDen)AnoApreAnterior)|
$($(vDen)PfEmNumAnoApreAnterior)
;

    FOR i = 1 TO 12
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativaPercentual('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i
END SUB

SUB GerarProporcaoMiPorOper(vRadical)
    CALL GerarListaNomes12Apre('$(vRadical)');
    SET vListaNumerador =
$(vValDescapMiDtMesAno)|
$(vValDescapMiPfEmNumDtMesAno)|
$(vValDescapMiDtMesAnoApre)|
$(vValDescapMiPfEmNumDtMesAnoApre)|
$(vValDescapMiAnoAtual)|
$(vValDescapMiPfEmNumAnoAtual)|
$(vValDescapMiAnoApreAtual)|
$(vValDescapMiPfEmNumAnoApreAtual)|
$(vValDescapMiAnoAnterior)|
$(vValDescapMiPfEmNumAnoAnterior)|
$(vValDescapMiAnoApreAnterior)|
$(vValDescapMiPfEmNumAnoApreAnterior)
;
    SET vListaDenominador =
$(vOperHomDtMesAno)|
$(vOperHomPfEmNumDtMesAno)|
$(vOperHomDtMesAnoDefl)|
$(vOperHomPfEmNumDtMesAnoDefl)|
$(vOperHomAnoAtual)|
$(vOperHomPfEmNumAnoAtual)|
$(vOperHomAnoDeflAtual)|
$(vOperHomPfEmNumAnoDeflAtual)|
$(vOperHomAnoAnterior)|
$(vOperHomPfEmNumAnoAnterior)|
$(vOperHomAnoDeflAnterior)|
$(vOperHomPfEmNumAnoDeflAnterior)
;

    FOR i = 1 TO 12
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativaMi('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i
END SUB

//==============================================================================================
// FILTROS BASE
//==============================================================================================

SET vFApreBase   = [Tipo do Fato] = {'Apreensões'};
SET vFApreDesvio = [Área de Atribuição do Caso] = {'Desvio de Recursos Públicos'}, [Tipo do Fato] = {'Apreensões'};
SET vFApreFront  = AREA_FRONTEIRA = {"SIM"}, [Tipo do Fato] = {'Apreensões'};

//==============================================================================================
// MÉTRICAS BASE (REAIS)
//==============================================================================================

CALL GerarMetricaReaisCompleta('vValDescap',               'vFApreBase', '[Valor Total Descapitalização]');
CALL GerarMetricaReaisCompleta('vValImoveis',              'vFApreBase', '[1 Valor Bens Imóveis Apreendidos/Sequestrados LVL1]');
CALL GerarMetricaReaisCompleta('vValMovSemov',             'vFApreBase', '[2 Valor Bens Móveis e Semoventes Apreendidos/Sequestrados LVL1]');
CALL GerarMetricaReaisCompleta('vValImovMov',              'vFApreBase', '[1+2 Bens Imóveis Apreendidos/Sequestrados + Bens Móveis e Semoventes Apreendidos/Sequestrados LVL1]');
CALL GerarMetricaReaisCompleta('vValCripto',               'vFApreBase', '[3 Valor Criptoativos apreendidos/sequestrados LVL1]');
CALL GerarMetricaReaisCompleta('vValTilValMob',            'vFApreBase', '[4 Valor Títulos  Valores Mobiliários e Direitos Apreendidos/Sequestrados LVL1]');
CALL GerarMetricaReaisCompleta('vValMonet',                'vFApreBase', '[5 Valores Monetários Apreendidos/Sequestrados LVL1]');
CALL GerarMetricaReaisCompleta('vValMonTit',               'vFApreBase', '[4+5 Valores Monetários, Títulos e Direitos Apreendidos/Sequestrados LVL1]');
CALL GerarMetricaReaisCompleta('vValPedMetJoiArte',        'vFApreBase', '[2.1 Valor Pedras, Metais Preciosos, Joias e Obras de Arte LVL2]');
CALL GerarMetricaReaisCompleta('vValSemov',                'vFApreBase', '[2.2 Valor Semoventes LVL2]');
CALL GerarMetricaReaisCompleta('vValVeicAer',              'vFApreBase', '[2.3 Valor Veículos aéreos LVL2]');
CALL GerarMetricaReaisCompleta('vValVeicAquat',            'vFApreBase', '[2.4 Valor Veículos aquáticos LVL2]');
CALL GerarMetricaReaisCompleta('vValVeicTerr',             'vFApreBase', '[2.5 Valor Veículos terrestres LVL2]');
CALL GerarMetricaReaisCompleta('vValOutMoveis',            'vFApreBase', '[2.6 Valor Outros bens Móvies LVL2]');
CALL GerarMetricaReaisCompleta('vValMonetEsp',             'vFApreBase', '[5.1 Valores Monetários em espécie LVL2]');
CALL GerarMetricaReaisCompleta('vValBacenjud',             'vFApreBase', '[5.2 Valores Monetários bloqueados via Bacenjud ou similares LVL2]');
CALL GerarMetricaReaisCompleta('vValSeqMovImovCriptBloq',  'vFApreBase', '[1+2+3+5.2 Sequestros e bloqueios (Sequestros Móveis e Imóveis + Criptoativos + Bloqueio Financeiro)]');
CALL GerarMetricaReaisCompleta('vItensDestr',              'vFApreBase', '[6 Valor Itens de Descapitalização Destruídos no Local LVL1]');

//==============================================================================================
// MÉTRICAS BASE (MILHÕES)
//==============================================================================================

CALL GerarMetricaMiCompleta('vValDescapMi',               'vFApreBase', '[Valor Total Descapitalização]');
CALL GerarMetricaMiCompleta('vValImoveisMi',              'vFApreBase', '[1 Valor Bens Imóveis Apreendidos/Sequestrados LVL1]');
CALL GerarMetricaMiCompleta('vValMovSemovMi',             'vFApreBase', '[2 Valor Bens Móveis e Semoventes Apreendidos/Sequestrados LVL1]');
CALL GerarMetricaMiCompleta('vValImovMovMi',              'vFApreBase', '[1+2 Bens Imóveis Apreendidos/Sequestrados + Bens Móveis e Semoventes Apreendidos/Sequestrados LVL1]');
CALL GerarMetricaMiCompleta('vValCriptoMi',               'vFApreBase', '[3 Valor Criptoativos apreendidos/sequestrados LVL1]');
CALL GerarMetricaMiCompleta('vValTilValMobMi',            'vFApreBase', '[4 Valor Títulos  Valores Mobiliários e Direitos Apreendidos/Sequestrados LVL1]');
CALL GerarMetricaMiCompleta('vValMonetMi',                'vFApreBase', '[5 Valores Monetários Apreendidos/Sequestrados LVL1]');
CALL GerarMetricaMiCompleta('vValMonTitMi',               'vFApreBase', '[4+5 Valores Monetários, Títulos e Direitos Apreendidos/Sequestrados LVL1]');
CALL GerarMetricaMiCompleta('vValPedMetJoiArteMi',        'vFApreBase', '[2.1 Valor Pedras, Metais Preciosos, Joias e Obras de Arte LVL2]');
CALL GerarMetricaMiCompleta('vValSemovMi',                'vFApreBase', '[2.2 Valor Semoventes LVL2]');
CALL GerarMetricaMiCompleta('vValVeicAerMi',              'vFApreBase', '[2.3 Valor Veículos aéreos LVL2]');
CALL GerarMetricaMiCompleta('vValVeicAquatMi',            'vFApreBase', '[2.4 Valor Veículos aquáticos LVL2]');
CALL GerarMetricaMiCompleta('vValVeicTerrMi',             'vFApreBase', '[2.5 Valor Veículos terrestres LVL2]');
