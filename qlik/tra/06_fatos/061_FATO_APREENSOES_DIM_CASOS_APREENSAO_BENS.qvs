    AS "1 Valor Bens Imóveis Apreendidos/Sequestrados LVL1",

    // Descapitalização LVL 1 - 2 Bens Móveis e Semoventes Apreendidos/Sequestrados
    Num(
    If(
        Year("GestãoBens Item Data Apreensão") < 2024,
