// Título da medida mestra para KPI das buscas cumpridas em operações SÓ PF EM NÚMEROS:
SET vTituloMedidaMestraKpiBuscasCumpridasEmOperacoesSoPfEmNumeros = 
IF(
    // Se [Ano] selecionado mostrar vAnoSelecionado
    GetSelectedCount([Ano]) > 0,
