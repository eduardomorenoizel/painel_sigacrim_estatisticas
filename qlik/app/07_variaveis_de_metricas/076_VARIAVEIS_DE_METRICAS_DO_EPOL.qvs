/*----------------------------------------------------------------------------------------------
    SUB ExecutarLoopPercTotal12
    Executa FOR loop de 12 itens chamando CriarVariavelContagemPercentualdoTotal.
    Requer: vListaNomeVariavel, vListaConjunto, vListaCampo, vListaCampoDenominador.
----------------------------------------------------------------------------------------------*/
SUB ExecutarLoopPercTotal12
    FOR i = 1 TO 12
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vConjunto = SubField('$(vListaConjunto)', '|', i);
        LET vCampo = SubField('$(vListaCampo)', '|', i);
        LET vCampoDenominador = SubField('$(vListaCampoDenominador)', '|', i);
        CALL CriarVariavelContagemPercentualdoTotal('$(vNomeVariavel)', '$(vConjunto)', '$(vCampo)', '$(vCampoDenominador)');
    NEXT i
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarPorEfet6ProcData(vRadical)
    Gera as 6+6 variáveis PorEfet e PorEfetTot para o radical informado (padrão ProcData).
    Sufixos: DtMesAno, ProcDtDtMesAno, AnoAtual, ProcDtDtAnoAtual, AnoAnterior, ProcDtDtAnoAnterior.
    Denominadores: vServPJ / vServPJTotal.
----------------------------------------------------------------------------------------------*/
SUB GerarPorEfet6ProcData(vRadical)
    SET vListaNomeVariavel =
$(vRadical)DtMesAnoPorEfet|
$(vRadical)ProcDtDtMesAnoPorEfet|
$(vRadical)AnoAtualPorEfet|
$(vRadical)ProcDtDtAnoAtualPorEfet|
$(vRadical)AnoAnteriorPorEfet|
$(vRadical)ProcDtDtAnoAnteriorPorEfet
;
    SET vListaNumerador =
$($(vRadical)DtMesAno)|
$($(vRadical)ProcDtDtMesAno)|
$($(vRadical)AnoAtual)|
$($(vRadical)ProcDtDtAnoAtual)|
$($(vRadical)AnoAnterior)|
$($(vRadical)ProcDtDtAnoAnterior)
;
    SET vListaDenominador =
$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)
;
    FOR i = 1 TO 6
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativa('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i

    SET vListaNomeVariavel =
$(vRadical)DtMesAnoPorEfetTot|
$(vRadical)ProcDtDtMesAnoPorEfetTot|
$(vRadical)AnoAtualPorEfetTot|
$(vRadical)ProcDtDtAnoAtualPorEfetTot|
$(vRadical)AnoAnteriorPorEfetTot|
$(vRadical)ProcDtDtAnoAnteriorPorEfetTot
;
    SET vListaDenominador =
$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)
;
    FOR i = 1 TO 6
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativa('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarPorEfet6InstData(vRadical)
    Gera as 6+6 variáveis PorEfet e PorEfetTot para o radical informado (padrão InstData).
    Sufixos: DtMesAno, DtMesAnoInst, AnoAtual, AnoAtualInst, AnoAnterior, AnoAnteriorInst.
    Denominadores: vServPJ / vServPJTotal.
----------------------------------------------------------------------------------------------*/
SUB GerarPorEfet6InstData(vRadical)
    SET vListaNomeVariavel =
$(vRadical)DtMesAnoPorEfet|
$(vRadical)DtMesAnoInstPorEfet|
$(vRadical)AnoAtualPorEfet|
$(vRadical)AnoAtualInstPorEfet|
$(vRadical)AnoAnteriorPorEfet|
$(vRadical)AnoAnteriorInstPorEfet
;
    SET vListaNumerador =
$($(vRadical)DtMesAno)|
$($(vRadical)DtMesAnoInst)|
$($(vRadical)AnoAtual)|
$($(vRadical)AnoAtualInst)|
$($(vRadical)AnoAnterior)|
$($(vRadical)AnoAnteriorInst)
;
    SET vListaDenominador =
$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)
;
    FOR i = 1 TO 6
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativa('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i

    SET vListaNomeVariavel =
$(vRadical)DtMesAnoPorEfetTot|
$(vRadical)DtMesAnoInstPorEfetTot|
$(vRadical)AnoAtualPorEfetTot|
$(vRadical)AnoAtualInstPorEfetTot|
$(vRadical)AnoAnteriorPorEfetTot|
$(vRadical)AnoAnteriorInstPorEfetTot
;
    SET vListaDenominador =
$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)
;
    FOR i = 1 TO 6
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativa('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarMetricaSomaCompletaProcData(vRadical, vNomeFiltro, vCampo)
    Gera o conjunto completo de variáveis de SOMA para um radical (padrão ProcData):
      - 12 variáveis principais  (CriarVariavelSoma)
      - 6+6 variáveis por efetivo (CriarVariavelRelativa)
      - 12 variáveis soma anteriores (CriarVariavelSomaAnteriores)
----------------------------------------------------------------------------------------------*/
SUB GerarMetricaSomaCompletaProcData(vRadical, vNomeFiltro, vCampo)
    CALL GerarListaNomes12ProcData('$(vRadical)');
    CALL GerarListaCampo12('$(vCampo)');
    CALL GerarConjunto12ProcData('$(vNomeFiltro)');
    CALL ExecutarLoopSoma12;

    CALL GerarPorEfet6ProcData('$(vRadical)');

    CALL GerarListaNomesSomAnter12ProcData('$(vRadical)');
    CALL GerarListaCampo12('$(vCampo)');
    CALL GerarConjunto12ProcData('$(vNomeFiltro)');
    CALL ExecutarLoopSomAnter12;
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarMetricaContagemCompletaProcData(vRadical, vNomeFiltro, vCampo)
    Gera o conjunto completo de variáveis de CONTAGEM para um radical (padrão ProcData):
      - 12 variáveis principais  (CriarVariavelContagem)
      - 6+6 variáveis por efetivo (CriarVariavelRelativa)
      - 12 variáveis soma anteriores (CriarVariavelContagemSomaAnteriores)
----------------------------------------------------------------------------------------------*/
SUB GerarMetricaContagemCompletaProcData(vRadical, vNomeFiltro, vCampo)
    CALL GerarListaNomes12ProcData('$(vRadical)');
    CALL GerarListaCampo12('$(vCampo)');
    CALL GerarConjunto12ProcData('$(vNomeFiltro)');
    CALL ExecutarLoopContagem12;

    CALL GerarPorEfet6ProcData('$(vRadical)');

    CALL GerarListaNomesSomAnter12ProcData('$(vRadical)');
    CALL GerarListaCampo12('$(vCampo)');
    CALL GerarConjunto12ProcData('$(vNomeFiltro)');
    CALL ExecutarLoopContagemSomAnter12;
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarMetricaMedia12ProcDataSemPfEmNum(vRadical, vNomeFiltro, vCampo)
    Gera apenas 12 variáveis de MÉDIA sem filtro PfEmNum (sem PorEfet, sem SomAnter).
    Usado para métricas de duração média como vDurMedIplRelat.
----------------------------------------------------------------------------------------------*/
SUB GerarMetricaMedia12ProcDataSemPfEmNum(vRadical, vNomeFiltro, vCampo)
    CALL GerarListaNomes12ProcData('$(vRadical)');
    CALL GerarListaCampo12('$(vCampo)');
    CALL GerarConjunto12ProcDataSemPfEmNum('$(vNomeFiltro)');
    CALL ExecutarLoopMedia12;
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarMetricaContagemPorEfetProcDataSemPfEmNum(vRadical, vNomeFiltro, vCampo)
    Gera 12 variáveis de CONTAGEM + 6+6 PorEfet sem filtro PfEmNum (sem SomAnter).
    Usado para vReRecAtivInst e vReRecAtivRelat.
----------------------------------------------------------------------------------------------*/
SUB GerarMetricaContagemPorEfetProcDataSemPfEmNum(vRadical, vNomeFiltro, vCampo)
    CALL GerarListaNomes12ProcData('$(vRadical)');
    CALL GerarListaCampo12('$(vCampo)');
    CALL GerarConjunto12ProcDataSemPfEmNum('$(vNomeFiltro)');
    CALL ExecutarLoopContagem12;

    CALL GerarPorEfet6ProcData('$(vRadical)');
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarMetricaContagemCompletaInstData(vRadical, vNomeFiltro, vCampo)
    Gera o conjunto completo de variáveis de CONTAGEM para um radical (padrão InstData):
      - 12 variáveis principais  (CriarVariavelContagem)
      - 6+6 variáveis por efetivo (CriarVariavelRelativa)
      - 12 variáveis soma anteriores (CriarVariavelContagemSomaAnteriores)
----------------------------------------------------------------------------------------------*/
SUB GerarMetricaContagemCompletaInstData(vRadical, vNomeFiltro, vCampo)
    CALL GerarListaNomes12InstData('$(vRadical)');
    CALL GerarListaCampo12('$(vCampo)');
    CALL GerarConjunto12InstData('$(vNomeFiltro)');
    CALL ExecutarLoopContagem12;

    CALL GerarPorEfet6InstData('$(vRadical)');

    CALL GerarListaNomesSomAnter12InstData('$(vRadical)');
    CALL GerarListaCampo12('$(vCampo)');
    CALL GerarConjunto12InstData('$(vNomeFiltro)');
    CALL ExecutarLoopContagemSomAnter12;
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarPercTotal12ProcData(vRadical, vNomeFiltro, vCampo, vCampoDen)
    Gera 12 variáveis percentuais do total (CriarVariavelContagemPercentualdoTotal).
    Padrão ProcData. Sem PorEfet, sem SomAnter.
----------------------------------------------------------------------------------------------*/
SUB GerarPercTotal12ProcData(vRadical, vNomeFiltro, vCampo, vCampoDen)
    CALL GerarListaNomes12ProcData('$(vRadical)');
    CALL GerarListaCampo12('$(vCampo)');
    CALL GerarListaCampoDen12('$(vCampoDen)');
    CALL GerarConjunto12ProcData('$(vNomeFiltro)');
    CALL ExecutarLoopPercTotal12;
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarMetricaEmAndComSomAnter(vRadical, vNomeFiltroSemRel, vNomeFiltroVazio, vCampo)
    Gera 4 variáveis de contagem EmAnd (SemRel×2 + Vazio×2), 2+2 PorEfet e 4 SomAnter.
    Uso: para IplEmAnd que possui Pareto (SomaAnteriores).
    Os filtros SemRel e Vazio devem ser definidos como variáveis SET antes da chamada.
----------------------------------------------------------------------------------------------*/
SUB GerarMetricaEmAndComSomAnter(vRadical, vNomeFiltroSemRel, vNomeFiltroVazio, vCampo)
    SET vListaNomeVariavel =
$(vRadical)SemRelDtAprOpeCaso|
$(vRadical)PfEmNumSemRelDtAprOpeCaso|
$(vRadical)|
$(vRadical)PfEmNum
;
    SET vListaConjunto =
                $($(vNomeFiltroSemRel))|
                $($(vNomeFiltroSemRel))|
                $($(vNomeFiltroVazio))|
                $($(vNomeFiltroVazio))
                ;
    SET vListaCampo =
$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)
;
    FOR i = 1 TO 4
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vConjunto = SubField('$(vListaConjunto)', '|', i);
        LET vCampoLocal = SubField('$(vListaCampo)', '|', i);
        CALL CriarVariavelContagem('$(vNomeVariavel)', '$(vConjunto)', '$(vCampoLocal)');
    NEXT i

    SET vListaNomeVariavel =
$(vRadical)SemRelDtAprOpeCasoPorEfet|
$(vRadical)PorEfet
;
    SET vListaNumerador = $($(vRadical)SemRelDtAprOpeCaso)|$($(vRadical));
    SET vListaDenominador = $(vServPJ)|$(vServPJ);
    FOR i = 1 TO 2
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativa('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i

    SET vListaNomeVariavel =
$(vRadical)SemRelDtAprOpeCasoPorEfetTot|
$(vRadical)PorEfetTot
;
    SET vListaDenominador = $(vServPJTotal)|$(vServPJTotal);
    FOR i = 1 TO 2
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativa('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i

    SET vListaNomeVariavel =
$(vRadical)SomAnterSemRelDtAprOpeCaso|
$(vRadical)SomAnterPfEmNumSemRelDtAprOpeCaso|
$(vRadical)SomAnter|
$(vRadical)SomAnterPfEmNum
;
    SET vListaConjunto =
                $($(vNomeFiltroSemRel))|
                $($(vNomeFiltroSemRel))|
                $($(vNomeFiltroVazio))|
                $($(vNomeFiltroVazio))
                ;
    SET vListaCampo =
$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)
;
    FOR i = 1 TO 4
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vConjunto = SubField('$(vListaConjunto)', '|', i);
        LET vCampoLocal = SubField('$(vListaCampo)', '|', i);
        CALL CriarVariavelContagemSomaAnteriores('$(vNomeVariavel)', '$(vConjunto)', '$(vCampoLocal)');
    NEXT i
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarMetricaEmAnd(vRadical, vNomeFiltroSemRel, vNomeFiltroVazio, vCampo)
    Gera 4 variáveis de contagem EmAnd (SemRel×2 + Vazio×2) e 2+2 PorEfet. Sem SomAnter.
    Uso: para ReRecAtivEmAnd que não possui Pareto.
----------------------------------------------------------------------------------------------*/
SUB GerarMetricaEmAnd(vRadical, vNomeFiltroSemRel, vNomeFiltroVazio, vCampo)
    SET vListaNomeVariavel =
$(vRadical)SemRelDtAprOpeCaso|
$(vRadical)PfEmNumSemRelDtAprOpeCaso|
$(vRadical)|
$(vRadical)PfEmNum
;
    SET vListaConjunto =
                $($(vNomeFiltroSemRel))|
                $($(vNomeFiltroSemRel))|
                $($(vNomeFiltroVazio))|
                $($(vNomeFiltroVazio))
                ;
    SET vListaCampo =
$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)
;
    FOR i = 1 TO 4
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vConjunto = SubField('$(vListaConjunto)', '|', i);
        LET vCampoLocal = SubField('$(vListaCampo)', '|', i);
        CALL CriarVariavelContagem('$(vNomeVariavel)', '$(vConjunto)', '$(vCampoLocal)');
    NEXT i

    SET vListaNomeVariavel =
$(vRadical)SemRelDtAprOpeCasoPorEfet|
$(vRadical)PorEfet
;
    SET vListaNumerador = $($(vRadical)SemRelDtAprOpeCaso)|$($(vRadical));
    SET vListaDenominador = $(vServPJ)|$(vServPJ);
    FOR i = 1 TO 2
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativa('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i

    SET vListaNomeVariavel =
$(vRadical)SemRelDtAprOpeCasoPorEfetTot|
$(vRadical)PorEfetTot
;
    SET vListaDenominador = $(vServPJTotal)|$(vServPJTotal);
    FOR i = 1 TO 2
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativa('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarMetricaDurMedEmAnd(vRadical, vNomeFiltroSemRel, vNomeFiltroVazio, vCampo)
    Gera 4 variáveis de média EmAnd (SemRel×2 + Vazio×2). Sem PorEfet, sem SomAnter.
    Uso: para DurMedIplEmAnd e DurMedReRecAtivEmAnd.
----------------------------------------------------------------------------------------------*/
SUB GerarMetricaDurMedEmAnd(vRadical, vNomeFiltroSemRel, vNomeFiltroVazio, vCampo)
    SET vListaNomeVariavel =
$(vRadical)SemRelDtAprOpeCaso|
$(vRadical)PfEmNumSemRelDtAprOpeCaso|
$(vRadical)|
$(vRadical)PfEmNum
;
    SET vListaConjunto =
                $($(vNomeFiltroSemRel))|
                $($(vNomeFiltroSemRel))|
                $($(vNomeFiltroVazio))|
                $($(vNomeFiltroVazio))
                ;
    SET vListaCampo =
$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)
;
    FOR i = 1 TO 4
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vConjunto = SubField('$(vListaConjunto)', '|', i);
        LET vCampoLocal = SubField('$(vListaCampo)', '|', i);
        CALL CriarVariavelMedia('$(vNomeVariavel)', '$(vConjunto)', '$(vCampoLocal)');
    NEXT i
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarMetricaMedia12RelatEspecial(vRadical, vNomeFiltroComTipo, vNomeFiltroSemTipo, vCampo)
    Gera 12 variáveis de média com padrão especial de datas para métricas Relat:
      - EventoCaso (items 1-2, 5-6, 9-10) e AnoAnterior ProcDt (items 11-12): usam ComTipo
        (inclui [Tipo do Fato] e [Tipo da Data] = {'Evento do Caso'})
      - ProcDtDtMesAno (items 3-4) e ProcDtDtAnoAtual (items 7-8): usam SemTipo
        (apenas o filtro base sem [Tipo do Fato] nem [Tipo da Data])
    Uso: para DurMedReRecAtivRelat.
----------------------------------------------------------------------------------------------*/
SUB GerarMetricaMedia12RelatEspecial(vRadical, vNomeFiltroComTipo, vNomeFiltroSemTipo, vCampo)
    CALL GerarListaNomes12ProcData('$(vRadical)');
    CALL GerarListaCampo12('$(vCampo)');
    SET vListaConjunto =
                $($(vNomeFiltroComTipo))|
                $($(vNomeFiltroComTipo))|
                $($(vNomeFiltroSemTipo))|
                $($(vNomeFiltroSemTipo))|
                $($(vNomeFiltroComTipo))
                ,[Ano] = {@(=Year(Today()))}|
                $($(vNomeFiltroComTipo))
                ,[Ano] = {@(=Year(Today()))}|
                $($(vNomeFiltroSemTipo))
                ,[Proc_Data Data Ano] = {@(=Year(Today()))}|
                $($(vNomeFiltroSemTipo))
                ,[Proc_Data Data Ano] = {@(=Year(Today()))}|
                $($(vNomeFiltroComTipo))
                ,[Ano] = {@(=MAX([Ano]-1))}|
                $($(vNomeFiltroComTipo))
                ,[Ano] = {@(=MAX([Ano]-1))}|
                $($(vNomeFiltroComTipo))
                ,[Proc_Data Data Ano] = {@(MAX([Proc_Data Data Ano]-1))}|
                $($(vNomeFiltroComTipo))
                ,[Proc_Data Data Ano] = {@(MAX([Proc_Data Data Ano]-1))}
                ;
    CALL ExecutarLoopMedia12;
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarProporcaoPercentual6ProcDtInstData(vRadical, vRadicalNum, vRadicalDen)
    Gera 6 variáveis de proporção percentual: numerador ProcDt, denominador InstData.
    Sufixos do resultado: DtMesAno, DtMesAnoInst, AnoAtual, AnoAtualInst, AnoAnterior, AnoAnteriorInst.
    Numerador usa DtMesAno/AnoAtual/AnoAnterior (EventoCaso) de vRadicalNum.
    Denominador usa DtMesAno/DtMesAnoInst/AnoAtual/AnoAtualInst/AnoAnterior/AnoAnteriorInst de vRadicalDen.
    Uso: vPrisEmFlagrPorFlaInst (num=vPrisEmFlagr ProcDt, den=vFlaInst InstData).
----------------------------------------------------------------------------------------------*/
SUB GerarProporcaoPercentual6ProcDtInstData(vRadical, vRadicalNum, vRadicalDen)
    SET vListaNomeVariavel =
$(vRadical)DtMesAno|
$(vRadical)DtMesAnoInst|
$(vRadical)AnoAtual|
$(vRadical)AnoAtualInst|
$(vRadical)AnoAnterior|
$(vRadical)AnoAnteriorInst
;
    SET vListaNumerador =
$($(vRadicalNum)DtMesAno)|
$($(vRadicalNum)DtMesAno)|
$($(vRadicalNum)AnoAtual)|
$($(vRadicalNum)AnoAtual)|
$($(vRadicalNum)AnoAnterior)|
$($(vRadicalNum)AnoAnterior)
;
    SET vListaDenominador =
$($(vRadicalDen)DtMesAno)|
$($(vRadicalDen)DtMesAnoInst)|
$($(vRadicalDen)AnoAtual)|
$($(vRadicalDen)AnoAtualInst)|
$($(vRadicalDen)AnoAnterior)|
$($(vRadicalDen)AnoAnteriorInst)
;
    FOR i = 1 TO 6
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativaPercentual('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarProporcaoPercentual6ProcData(vRadical, vRadicalNum, vRadicalDen)
    Gera 6 variáveis de proporção percentual: ambos numerador e denominador são ProcDt.
    Sufixos do resultado: DtMesAno, ProcDtDtMesAno, AnoAtual, ProcDtDtAnoAtual, AnoAnterior, ProcDtDtAnoAnterior.
    Numerador e denominador usam variantes PfEmNum de cada radical.
    Uso: vIplRelatPorInst, vIplInstInicPropPorInst.
----------------------------------------------------------------------------------------------*/
SUB GerarProporcaoPercentual6ProcData(vRadical, vRadicalNum, vRadicalDen)
    SET vListaNomeVariavel =
$(vRadical)DtMesAno|
$(vRadical)ProcDtDtMesAno|
$(vRadical)AnoAtual|
$(vRadical)ProcDtDtAnoAtual|
$(vRadical)AnoAnterior|
$(vRadical)ProcDtDtAnoAnterior
;
    SET vListaNumerador =
$($(vRadicalNum)DtMesAno)|
$($(vRadicalNum)ProcDtDtMesAno)|
$($(vRadicalNum)AnoAtual)|
$($(vRadicalNum)ProcDtDtAnoAtual)|
$($(vRadicalNum)AnoAnterior)|
$($(vRadicalNum)ProcDtDtAnoAnterior)
;
    SET vListaDenominador =
$($(vRadicalDen)DtMesAno)|
$($(vRadicalDen)ProcDtDtMesAno)|
$($(vRadicalDen)AnoAtual)|
$($(vRadicalDen)ProcDtDtAnoAtual)|
$($(vRadicalDen)AnoAnterior)|
$($(vRadicalDen)ProcDtDtAnoAnterior)
;
    FOR i = 1 TO 6
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativaPercentual('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i
END SUB

//==============================================================================================
// FILTROS BASE
//==============================================================================================

// Filtro base para métricas ProcData (Casos_Data sem [Tipo da Data])
SET vFCasosData = [Tipo do Fato] = {'Casos_Data'};

// Filtros ProcData com condições adicionais
SET vFPrisEmFlagr = [Proc_Data Tipo] = {'Prisão Flagrante'},[Tipo do Fato] = {'Casos_Data'};
SET vFPrisEmFlagrInt = [Proc_Data Tipo] = {'Prisão Flagrante'},[É Flagrante de Iniciativa Interna] = {'Sim'},[Tipo do Fato] = {'Casos_Data'};
SET vFPrisEmFlagrExt = [Proc_Data Tipo] = {'Prisão Flagrante'},[É Flagrante de Iniciativa Externa] = {'Sim'},[Tipo do Fato] = {'Casos_Data'};
SET vFIplInstInicProp = [Proc. Origem Documento] = {'PF - Polícia Federal'},[Tipo do Fato] = {'Casos_Data'};
SET vFReRecAtiv = [Proc. Matéria Registro Especial] = {'Recuperação de ativos'},[Tipo do Fato] = {'Casos_Data'};
SET vFDurMedIplRelat = [Proc_Data IPL Relatado ID] = {"*"},[Tipo do Fato] = {'Casos_Data'};

// Filtros InstData
SET vFFlaInstBase = [Foi Instaurado por Flagrante] = {'Sim'},[Tipo do Fato] = {'Casos_Data'};
SET vFFlaInstInt = [É Flagrante de Iniciativa Interna] = {'Sim'},[Tipo do Fato] = {'Casos_Data'};
SET vFFlaInstExt = [É Flagrante de Iniciativa Externa] = {'Sim'},[Tipo do Fato] = {'Casos_Data'};
SET vFTcoInst = [Foi Instaurado por TC] = {'Sim'},[Tipo do Fato] = {'Casos_Data'};
SET vFIndiciamFront = [AREA_FRONTEIRA] = {"SIM"},[Tipo do Fato] = {'Casos_Data'};

// Filtros EmAnd — IplEmAnd e DurMedIplEmAnd
SET vFIplEmAndSemRel = [Proc. Tipo] = {'IPL'},[Proc. Situação] = {'Em Andamento'},$(vSemRelDatasApreeOperCasos);
SET vFIplEmAndVazio = [Proc. Tipo] = {'IPL'},[Proc. Situação] = {'Em Andamento'},[Data] =,[Ano] =,[Mês] =,[Proc_Data Data Ano] =,[Proc_Data Data Mês] =,[Proc_Data Data] =;

// Filtros EmAnd — ReRecAtivEmAnd e DurMedReRecAtivEmAnd
SET vFReRecAtivEmAndSemRel = [Proc. Matéria Registro Especial] = {'Recuperação de ativos'},[Proc. Tipo] = {'RE'},[Proc. Situação] = {'Em Andamento'},$(vSemRelDatasApreeOperCasos);
SET vFReRecAtivEmAndVazio = [Proc. Matéria Registro Especial] = {'Recuperação de ativos'},[Proc. Tipo] = {'RE'},[Proc. Situação] = {'Em Andamento'},[Data] =,[Ano] =,[Mês] =;

// Filtros DurMedReRecAtivRelat — padrão especial (ComTipo inclui [Tipo do Fato] e [Tipo da Data])
SET vFDurMedReRecAtivRelatComTipo = [Proc_Data RE Relatado ID] = {"*"},[Tipo do Fato] = {'Casos_Data'},[Tipo da Data] = {'Evento do Caso'};
SET vFDurMedReRecAtivRelatSemTipo = [Proc_Data RE Relatado ID] = {"*"};

//==============================================================================================
// MÉTRICAS
//==============================================================================================

//----------------------------------------------------------------------------------------------
// Prisões em Flagrante
//----------------------------------------------------------------------------------------------

CALL GerarMetricaSomaCompletaProcData('vPrisEmFlagr', 'vFPrisEmFlagr', '[Proc_Data Prisão]');

//----------------------------------------------------------------------------------------------
// Inquéritos Instaurados
//----------------------------------------------------------------------------------------------

CALL GerarMetricaContagemCompletaProcData('vIplInst', 'vFCasosData', '[Proc_Data IPL Instaurado ID]');

//----------------------------------------------------------------------------------------------
// Inquéritos Instaurados por Iniciativa Própria
//----------------------------------------------------------------------------------------------

CALL GerarMetricaContagemCompletaProcData('vIplInstInicProp', 'vFIplInstInicProp', '[Proc_Data IPL Instaurado ID]');

//----------------------------------------------------------------------------------------------
// Inquéritos Relatados
//----------------------------------------------------------------------------------------------

CALL GerarMetricaContagemCompletaProcData('vIplRelat', 'vFCasosData', '[Proc_Data IPL Relatado ID]');

//----------------------------------------------------------------------------------------------
// Inquéritos em Andamento
//----------------------------------------------------------------------------------------------

CALL GerarMetricaEmAndComSomAnter('vIplEmAnd', 'vFIplEmAndSemRel', 'vFIplEmAndVazio', 'DISTINCT [Proc. Identificação]');

//----------------------------------------------------------------------------------------------
// Duração Média dos Inquéritos em Andamento
//----------------------------------------------------------------------------------------------

CALL GerarMetricaDurMedEmAnd('vDurMedIplEmAnd', 'vFIplEmAndSemRel', 'vFIplEmAndVazio', '[Proc. Duração Dias]');

//----------------------------------------------------------------------------------------------
// Duração Média dos Inquéritos Relatados
//----------------------------------------------------------------------------------------------

CALL GerarMetricaMedia12ProcDataSemPfEmNum('vDurMedIplRelat', 'vFDurMedIplRelat', '[Proc_Data IPL Duração Dias]');

//----------------------------------------------------------------------------------------------
// RE de Recuperação de Ativos Instaurados
//----------------------------------------------------------------------------------------------

CALL GerarMetricaContagemPorEfetProcDataSemPfEmNum('vReRecAtivInst', 'vFReRecAtiv', '[Proc_Data RE Instaurado ID]');

//----------------------------------------------------------------------------------------------
// RE de Recuperação de Ativos Relatados
//----------------------------------------------------------------------------------------------

CALL GerarMetricaContagemPorEfetProcDataSemPfEmNum('vReRecAtivRelat', 'vFReRecAtiv', '[Proc_Data RE Relatado ID]');

//----------------------------------------------------------------------------------------------
// RE de Recuperação de Ativos em Andamento
//----------------------------------------------------------------------------------------------

CALL GerarMetricaEmAnd('vReRecAtivEmAnd', 'vFReRecAtivEmAndSemRel', 'vFReRecAtivEmAndVazio', 'DISTINCT [Proc. Identificação]');

//----------------------------------------------------------------------------------------------
// Duração Média dos RE de Recuperação de Ativos em Andamento
//----------------------------------------------------------------------------------------------

CALL GerarMetricaDurMedEmAnd('vDurMedReRecAtivEmAnd', 'vFReRecAtivEmAndSemRel', 'vFReRecAtivEmAndVazio', '[Proc. Duração Dias]');

//----------------------------------------------------------------------------------------------
// Duração Média dos RE de Recuperação de Ativos Relatados
// Padrão especial: variantes ProcDtDtMesAno e ProcDtDtAnoAtual omitem [Tipo do Fato];
//                  variante ProcDtDtAnoAnterior mantém [Tipo do Fato] e [Tipo da Data].
//----------------------------------------------------------------------------------------------

CALL GerarMetricaMedia12RelatEspecial('vDurMedReRecAtivRelat', 'vFDurMedReRecAtivRelatComTipo', 'vFDurMedReRecAtivRelatSemTipo', '[Proc_Data RE Duração Dias]');

//----------------------------------------------------------------------------------------------
// Indiciamentos
//----------------------------------------------------------------------------------------------

CALL GerarMetricaSomaCompletaProcData('vIndiciam', 'vFCasosData', '[Proc_Data Indiciamento]');

//----------------------------------------------------------------------------------------------
// Indiciamentos em Área de Fronteira
//----------------------------------------------------------------------------------------------

CALL GerarMetricaSomaCompletaProcData('vIndiciamEmAreaFront', 'vFIndiciamFront', '[Proc_Data Indiciamento]');

//----------------------------------------------------------------------------------------------
// Flagrantes Instaurados
//----------------------------------------------------------------------------------------------

CALL GerarMetricaContagemCompletaInstData('vFlaInst', 'vFFlaInstBase', '[Proc_Data Flagrante Instaurado ID]');

//----------------------------------------------------------------------------------------------
// Flagrantes Instaurados Internos
//----------------------------------------------------------------------------------------------

CALL GerarMetricaContagemCompletaInstData('vFlaInstInt', 'vFFlaInstInt', '[Proc_Data Flagrante Instaurado ID]');

//----------------------------------------------------------------------------------------------
// Flagrantes Instaurados Externos
//----------------------------------------------------------------------------------------------

CALL GerarMetricaContagemCompletaInstData('vFlaInstExt', 'vFFlaInstExt', '[Proc_Data Flagrante Instaurado ID]');

//----------------------------------------------------------------------------------------------
// TCOs Instaurados
//----------------------------------------------------------------------------------------------

CALL GerarMetricaContagemCompletaInstData('vTcoInst', 'vFTcoInst', '[Proc_Data Flagrante Instaurado ID]');

//----------------------------------------------------------------------------------------------
// TCOs Encerrados
//----------------------------------------------------------------------------------------------

CALL GerarMetricaContagemCompletaInstData('vTcoEnce', 'vFCasosData', '[Proc_Data TC Encerrado ID]');

//----------------------------------------------------------------------------------------------
// Prisões em Flagrante Internas
//----------------------------------------------------------------------------------------------

CALL GerarMetricaSomaCompletaProcData('vPrisEmFlagrInt', 'vFPrisEmFlagrInt', '[Proc_Data Prisão]');

//----------------------------------------------------------------------------------------------
// Prisões em Flagrante Externas
//----------------------------------------------------------------------------------------------

CALL GerarMetricaSomaCompletaProcData('vPrisEmFlagrExt', 'vFPrisEmFlagrExt', '[Proc_Data Prisão]');

//----------------------------------------------------------------------------------------------
// Prisões em Flagrante por Flagrante Instaurado
//----------------------------------------------------------------------------------------------

CALL GerarProporcaoPercentual6ProcDtInstData('vPrisEmFlagrPorFlaInst', 'vPrisEmFlagr', 'vFlaInst');

//----------------------------------------------------------------------------------------------
// Inquéritos Relatados por Instaurados
//----------------------------------------------------------------------------------------------

CALL GerarProporcaoPercentual6ProcData('vIplRelatPorInst', 'vIplRelat', 'vIplInst');

//----------------------------------------------------------------------------------------------
// Inquéritos Solucionados
//----------------------------------------------------------------------------------------------

CALL GerarMetricaContagemCompletaProcData('vIplSoluc', 'vFCasosData', '[Proc_Data IPL Solucionado]');

//----------------------------------------------------------------------------------------------
// Percentual de Inquéritos Solucionados
//----------------------------------------------------------------------------------------------

CALL GerarPercTotal12ProcData('vPercIplSoluc', 'vFCasosData', '[Proc_Data IPL Solucionado]', '[Proc_Data IPL Relatado ID]');

//----------------------------------------------------------------------------------------------
// Inquéritos com Autoria Identificada
//----------------------------------------------------------------------------------------------

CALL GerarMetricaContagemCompletaProcData('vIplComAutIdent', 'vFCasosData', '[Proc_Data IPL Autoria Identificada]');

//----------------------------------------------------------------------------------------------
// Percentual de Inquéritos com Autoria Identificada
//----------------------------------------------------------------------------------------------

CALL GerarPercTotal12ProcData('vPercIplComAutIdent', 'vFCasosData', '[Proc_Data IPL Autoria Identificada]', '[Proc_Data IPL Relatado ID]');

//----------------------------------------------------------------------------------------------
// Inquéritos Não Crime
//----------------------------------------------------------------------------------------------

CALL GerarMetricaContagemCompletaProcData('vIplNaoCrime', 'vFCasosData', '[Proc_Data IPL Não Crime]');

//----------------------------------------------------------------------------------------------
// Percentual de Inquéritos Não Crime
//----------------------------------------------------------------------------------------------

CALL GerarPercTotal12ProcData('vPercIplNaoCrime', 'vFCasosData', '[Proc_Data IPL Não Crime]', '[Proc_Data IPL Relatado ID]');

