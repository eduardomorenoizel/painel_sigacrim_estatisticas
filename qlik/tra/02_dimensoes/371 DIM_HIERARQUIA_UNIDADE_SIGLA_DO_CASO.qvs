        ) > 0,
		'Sim',
        'Não')
	AS "É BEMIG",
    PICK(
    	1 + WildMatch(
        "Unidade Sigla do Caso",
        '*FICCO/*',
        '*GISE/*',
        '*BEMIG/*',
        '*DELECIBER/*',
        '*DELECOR/*',
        '*DELEFAZ/*',
        '*DELEINQUE/*',
        '*DELEPAT/*',
        '*DELEPREV/*',
        '*DELINST/*',
        '*DMA/*',
        '*DRE/*'
        )
        ,'Outras',
        'FICCO',
        'GISE',
        'BEMIG',
        'DELECIBER',
        'DELECOR',
        'DELEFAZ',
        'DELEINQUE',
        'DELEPAT',
        'DELEPREV',
        'DELINST',
        'DMA',
        'DRE'
    )
    AS "Especializadas e Bases"
RESIDENT LINK_TABLE_APREENSOES_OPERACOES_CASOS
WHERE LEN(TRIM("Unidade Sigla do Caso"))>0;

CALL StoreAndDrop('DIM_HIERARQUIA_UNIDADE_SIGLA_DO_CASO', '$(vCaminhoTransformadosV3)');