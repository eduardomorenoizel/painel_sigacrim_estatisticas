            ),
//////////////////////// Se não selecionado [Ano da Deflagração], [Mês da Deflagração] ou [Data da Deflagração], mostrar [Ano], [Mês] ou [Data]
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vBuscEfetivEmOperPorOperHomDtMesAno),
        // numeros absolutos 
            $(vBuscEfetivEmOperPorOperHomDtMesAno),
        // números PF EM NÚMEROS
            $(vBuscEfetivEmOperPorOperHomPfEmNumDtMesAno)
            )
    )
;

Call TratarExpansaoMacro(vMedidaMestraBuscasEfetivasPorOperacaoHomologada);

