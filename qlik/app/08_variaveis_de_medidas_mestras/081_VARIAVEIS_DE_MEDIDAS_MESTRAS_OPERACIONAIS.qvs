                        '$(pTituloBase) por Efetivo de ' & MIN([Ano do Cadastro]) & ' a ' & MAX([Ano do Cadastro]),
                        '$(pTituloBase) PF EM NÚMEROS de ' & MIN([Ano do Cadastro]) & ' a ' & MAX([Ano do Cadastro])
                    )
                )
            )
        )
    ;

    CALL TratarExpansaoMacro(vTituloMedidaMestra$(pAlias));

    // vTituloMedidaMestraKpi[Alias] - uses GetSelectedCount for Cadastro fields
    SET vTituloMedidaMestraKpi$(pAlias) =
        IF(
            $(vTemSelecaoAnoCalendario),
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                '$(pTituloBase) em ' & @(vAnoSelecionado),
                '$(pTituloBase) por Efetivo em ' & @(vAnoSelecionado),
                '$(pTituloBase) PF EM NÚMEROS em ' & @(vAnoSelecionado)
            ),
            IF(
                $(vTemSelecaoMesOuDataCalendario),
                PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    '$(pTituloBase) de ' & MIN([Ano]) & ' a ' & MAX([Ano]),
                    '$(pTituloBase) por Efetivo de ' & MIN([Ano]) & ' a ' & MAX([Ano]),
                    '$(pTituloBase) PF EM NÚMEROS de ' & MIN([Ano]) & ' a ' & MAX([Ano])
                ),
                IF(
                    GetSelectedCount([Ano do Cadastro]) > 0,
                    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                        '$(pTituloBase) em ' & @(vAnoCadastroSelecionado),
                        '$(pTituloBase) por Efetivo em ' & @(vAnoCadastroSelecionado),
                        '$(pTituloBase) PF EM NÚMEROS em ' & @(vAnoCadastroSelecionado)
                    ),
                    IF(
                        GetSelectedCount([Mês do Cadastro]) + GetSelectedCount([Data do Cadastro]) > 0,
                        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                            '$(pTituloBase) de ' & MIN([Ano do Cadastro]) & ' a ' & MAX([Ano do Cadastro]),
                            '$(pTituloBase) por Efetivo de ' & MIN([Ano do Cadastro]) & ' a ' & MAX([Ano do Cadastro]),
                            '$(pTituloBase) PF EM NÚMEROS de ' & MIN([Ano do Cadastro]) & ' a ' & MAX([Ano do Cadastro])
                        ),
                        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                            '$(pTituloBase) em ' & '@(=Year(Today()))',
                            '$(pTituloBase) por Efetivo em ' & '@(=Year(Today()))',
                            '$(pTituloBase) PF EM NÚMEROS em ' & '@(=Year(Today()))'
                        )
                    )
                )
            )
        )
    ;

    CALL TratarExpansaoMacro(vTituloMedidaMestraKpi$(pAlias));

    // vTituloCurtoMedidaMestraKpi[Alias] - uses GetSelectedCount for Cadastro fields
    SET vTituloCurtoMedidaMestraKpi$(pAlias) =
        IF(
            $(vTemSelecaoAnoCalendario),
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                'em ' & @(vAnoSelecionado),
                'por Efetivo em ' & @(vAnoSelecionado),
                'PF EM NÚMEROS em ' & @(vAnoSelecionado)
            ),
            IF(
                $(vTemSelecaoMesOuDataCalendario),
                PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    'de ' & MIN([Ano]) & ' a ' & MAX([Ano]),
                    'por Efetivo de ' & MIN([Ano]) & ' a ' & MAX([Ano]),
                    'PF EM NÚMEROS de ' & MIN([Ano]) & ' a ' & MAX([Ano])
                ),
                IF(
                    GetSelectedCount([Ano do Cadastro]) > 0,
                    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                        'em ' & @(vAnoCadastroSelecionado),
                        'por Efetivo em ' & @(vAnoCadastroSelecionado),
                        'PF EM NÚMEROS em ' & @(vAnoCadastroSelecionado)
                    ),
                    IF(
                        GetSelectedCount([Mês do Cadastro]) + GetSelectedCount([Data do Cadastro]) > 0,
                        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                            'de ' & MIN([Ano do Cadastro]) & ' a ' & MAX([Ano do Cadastro]),
                            'por Efetivo de ' & MIN([Ano do Cadastro]) & ' a ' & MAX([Ano do Cadastro]),
                            'PF EM NÚMEROS de ' & MIN([Ano do Cadastro]) & ' a ' & MAX([Ano do Cadastro])
                        ),
                        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                            'em ' & '@(=Year(Today()))',
                            'por Efetivo em ' & '@(=Year(Today()))',
                            'PF EM NÚMEROS em ' & '@(=Year(Today()))'
                        )
                    )
                )
            )
        )
    ;

    CALL TratarExpansaoMacro(vTituloCurtoMedidaMestraKpi$(pAlias));

    // vRodapeMedidaMestra[Alias]
    SET vRodapeMedidaMestra$(pAlias) =
        'Ano anterior: '
        &
        IF(
            $(vTemSelecaoDatasContextoFato),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)AnoCadAnterior),
                $($(pRadical)AnoCadAnteriorPorEfet),
                $($(pRadical)PfEmNumAnoCadAnterior)
            ),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)AnoAnterior),
                $($(pRadical)AnoAnteriorPorEfet),
                $($(pRadical)PfEmNumAnoAnterior)
            )
        )
    ;

    CALL TratarExpansaoMacro(vRodapeMedidaMestra$(pAlias));

    // vRodapeMedidaMestraTot[Alias]
    SET vRodapeMedidaMestra$(pAlias)Tot =
        'Ano anterior: '
        &
        IF(
            $(vTemSelecaoDatasContextoFato),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)AnoCadAnterior),
                $($(pRadical)AnoCadAnteriorPorEfetTot),
                $($(pRadical)PfEmNumAnoCadAnterior)
            ),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)AnoAnterior),
                $($(pRadical)AnoAnteriorPorEfetTot),
                $($(pRadical)PfEmNumAnoAnterior)
            )
        )
    ;

    CALL TratarExpansaoMacro(vRodapeMedidaMestra$(pAlias)Tot);
END SUB

