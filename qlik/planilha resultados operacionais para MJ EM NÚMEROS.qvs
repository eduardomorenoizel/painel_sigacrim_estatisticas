(qvd)

Where
	ETAPAOPERACAO = 'Homologada'
    AND DT_DEFLAGRACAO < MonthStart(Today())
    AND DT_HOMOLOGACAO < MakeDate(Year(Today()), Month(Today()), 6);
    
    

TABELA_AREA_ATRIBUICAO_TEMP:
LOAD
    distinct ID_AREA_ATRIBUICAO,
    AREAATRIBUICAO
FROM [lib://CORP_DICOR_COP/SIGACrim.qvd]
(qvd);

Left join(TABELA_SIGACRIM)
load
ID_AREA_ATRIBUICAO,
AREAATRIBUICAO
resident TABELA_AREA_ATRIBUICAO_TEMP;

Drop Table TABELA_AREA_ATRIBUICAO_TEMP;


