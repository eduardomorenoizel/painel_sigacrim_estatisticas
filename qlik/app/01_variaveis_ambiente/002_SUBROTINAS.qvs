//-----------------------------------------------------------------------------------------------
//   Função: 	 CriarVariavelRelativaVezesDezMil
//   Objetivo:	 Cria variáveis de soma de conjuntos específicados relativa 
//               a outros conjuntos específicados
//               e substitui o '@' por '$' no conteudo da variavel para 
//               permitir a chamada recursiva de variável sem calculo forçado
//-----------------------------------------------------------------------------------------------
SUB CriarVariavelRelativaVezesDezMil(vNomeVariavel, vNumerador, vDenominador)
    SET $(vNomeVariavel) = NUM(
        $(vNumerador) /
        $(vDenominador) * 10000,
        '0,00'
    );
    LET vNomeVariavel = Text(Replace(vNomeVariavel, '@', '$'));
END SUB
