//-----------------------------------------------------------------------------------------------
// Cálculo das medidas das Eventos Operacionais Homologados
//  - selecionáveis por:
//      - datas únicas, apresentando o resultado sem a influência dos outros fatos:
//          - [Ano], [Mês] e [Data]
//      - datas dos fatos [Ano da Deflagração], [Mês da Deflagração] e [Data da Deflagração]
//        correlacionados com os demais fatos e apresentando o resultado influenciado
//        pelas seleções dos outros fatos:
//  - do [Ano] atual
//  - do [Ano da Deflagração] atual
//  - do [Ano] anterior
//  - do [Ano da Deflagração] anterior
//-----------------------------------------------------------------------------------------------

SET vListaNomeVariavel = 
vEvenOperHomDtMesAno|
vEvenOperHomPfEmNumDtMesAno|
vEvenOperHomDtMesAnoEven|
vEvenOperHomPfEmNumDtMesAnoEven|
vEvenOperHomAnoAtual|
vEvenOperHomPfEmNumAnoAtual|
vEvenOperHomAnoEvenAtual|
vEvenOperHomPfEmNumAnoEvenAtual|
vEvenOperHomAnoAnterior|
vEvenOperHomPfEmNumAnoAnterior|
vEvenOperHomAnoEvenAnterior|
vEvenOperHomPfEmNumAnoEvenAnterior
;

SET vListaConjunto =
                ETAPAOPERACAO = {'Homologada'}
                ,[Tipo do Fato] = {'Operações'}
                ,[Tipo da Data] = {'Deflagração da Operação'}|
                ETAPAOPERACAO = {'Homologada'}
                ,[Tipo do Fato] = {'Operações'}
                ,[Tipo da Data] = {'Deflagração da Operação'}
                ,$(vConjOpDtMesAnoPfEmNumeros)|
                ETAPAOPERACAO = {'Homologada'}
                ,[Tipo do Fato] = {'Operações'}|
