$($(vRadical)DtMesAno)|
$($(vRadical)DtMesAnoInst)|
$($(vRadical)AnoAtual)|
$($(vRadical)AnoAtualInst)|
$($(vRadical)AnoAnterior)|
$($(vRadical)AnoAnteriorInst)
;
    SET vListaDenominador =
$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)
;
    FOR i = 1 TO 6
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativa('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i

    SET vListaNomeVariavel =
$(vRadical)DtMesAnoPorEfetTot|
$(vRadical)DtMesAnoInstPorEfetTot|
$(vRadical)AnoAtualPorEfetTot|
$(vRadical)AnoAtualInstPorEfetTot|
$(vRadical)AnoAnteriorPorEfetTot|
$(vRadical)AnoAnteriorInstPorEfetTot
;
    SET vListaDenominador =
$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)
;
    FOR i = 1 TO 6
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativa('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i
END SUB

SUB GerarMetricaContagemCompletaProc(vRadical, vFiltro, vCampo)
    CALL GerarListaNomes12Proc('$(vRadical)');
    CALL GerarListaCampo12('$(vCampo)');
    CALL GerarConjunto12Proc('$(vFiltro)');
    CALL ExecutarLoopContagem12;
    CALL GerarPorEfet6Proc('$(vRadical)');
    CALL GerarListaNomesSomAnter12Proc('$(vRadical)');
    CALL GerarListaCampo12('$(vCampo)');
    CALL GerarConjunto12Proc('$(vFiltro)');
    CALL ExecutarLoopContagemSomAnter12;
END SUB

SUB GerarMetricaSomaCompletaProc(vRadical, vFiltro, vCampo)
    CALL GerarListaNomes12Proc('$(vRadical)');
    CALL GerarListaCampo12('$(vCampo)');
    CALL GerarConjunto12Proc('$(vFiltro)');
    CALL ExecutarLoopSoma12;
    CALL GerarPorEfet6Proc('$(vRadical)');
    CALL GerarListaNomesSomAnter12Proc('$(vRadical)');
    CALL GerarListaCampo12('$(vCampo)');
    CALL GerarConjunto12Proc('$(vFiltro)');
    CALL ExecutarLoopSomaSomAnter12;
END SUB

SUB GerarMetricaContagemCompletaInst(vRadical, vFiltro, vCampo)
    CALL GerarListaNomes12Inst('$(vRadical)');
    CALL GerarListaCampo12('$(vCampo)');
    CALL GerarConjunto12Inst('$(vFiltro)');
    CALL ExecutarLoopContagem12;
    CALL GerarPorEfet6Inst('$(vRadical)');
    CALL GerarListaNomesSomAnter12Inst('$(vRadical)');
    CALL GerarListaCampo12('$(vCampo)');
    CALL GerarConjunto12Inst('$(vFiltro)');
    CALL ExecutarLoopContagemSomAnter12;
END SUB

SUB GerarMetricaMedia12Proc(vRadical, vFiltro, vCampo)
    CALL GerarListaNomes12Proc('$(vRadical)');
    CALL GerarListaCampo12('$(vCampo)');
    CALL GerarConjunto12Proc('$(vFiltro)');
    CALL ExecutarLoopMedia12;
END SUB

SUB GerarMetricaMedia12ProcSemPf(vRadical, vFiltro, vCampo)
    CALL GerarListaNomes12Proc('$(vRadical)');
    CALL GerarListaCampo12('$(vCampo)');
    CALL GerarConjunto12ProcSemPf('$(vFiltro)');
    CALL ExecutarLoopMedia12;
END SUB

SUB GerarProporcaoProc12(vRadicalOut, vRadicalNum, vRadicalDen, vListaSfxNum, vListaSfxDen)
    CALL GerarListaNomes12Proc('$(vRadicalOut)');
    FOR i = 1 TO 12
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vSfxNum = SubField('$(vListaSfxNum)', '|', i);
        LET vSfxDen = SubField('$(vListaSfxDen)', '|', i);
        LET vNumerador = '$(' & '$(vRadicalNum)' & '$(vSfxNum)' & ')';
        LET vDenominador = '$(' & '$(vRadicalDen)' & '$(vSfxDen)' & ')';
        CALL CriarVariavelRelativaPercentual('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i
END SUB

