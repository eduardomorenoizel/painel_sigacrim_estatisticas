CONCATENATE(LINK_TABLE_APREENSOES_OPERACOES_CASOS)
Load
	*
RESIDENT TEMP_LINK_TABLE_APREENSOES_OPERACOES_CASOS_EVENTOS_OPERACIONAIS;

DROP TABLE TEMP_LINK_TABLE_APREENSOES_OPERACOES_CASOS_EVENTOS_OPERACIONAIS;

CALL StoreAndDrop('FATO_EVENTOS_OPERACIONAIS', '$(vCaminhoTransformadosV3)');

