// Título da medida mestra das operações homologadas com registro especial de recuperação de ativos:
SET vTituloMedidaMestraOperacoesHomologadasComReRecuperacaoAtivos = 
IF(
    // Se [Ano] selecionado mostrar vAnoSelecionado
    GetSelectedCount([Ano]) > 0,
    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        'Operações Homologadas com RE de Recuperação de Ativos em ' & @(vAnoSelecionado),
        'Operações Homologadas com RE de Recuperação de Ativos por Efetivo em ' & @(vAnoSelecionado),
        'Operações Homologadas com RE de Recuperação de Ativos PF EM NÚMEROS em ' & @(vAnoSelecionado)
        ),
    IF(
        // Se [Mês] ou [Data] selecionado mostrar MIN([Ano]) a MAX([Ano])
        GetSelectedCount([Mês]) + GetSelectedCount([Data]) > 0,
        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
            'Operações Homologadas com RE de Recuperação de Ativos de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Operações Homologadas com RE de Recuperação de Ativos por Efetivo de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Operações Homologadas com RE de Recuperação de Ativos PF EM NÚMEROS de ' & MIN([Ano]) & ' a '& MAX([Ano])
            ),
        IF(
            // Se [Ano da Deflagração] selecionado mostrar vAnoDeflagracaoSelecionado
            GetSelectedCount([Ano da Deflagração]) > 0,
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                'Operações Homologadas com RE de Recuperação de Ativos em ' & @(vAnoDeflagracaoSelecionado),
                'Operações Homologadas com RE de Recuperação de Ativos por Efetivo em ' & @(vAnoDeflagracaoSelecionado),
                'Operações Homologadas com RE de Recuperação de Ativos PF EM NÚMEROS em ' & @(vAnoDeflagracaoSelecionado)
                ),
            // Se nada selecionado mostrar MIN([Ano da Deflagração]) a MAX([Ano da Deflagração])
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                'Operações Homologadas com RE de Recuperação de Ativos de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
                'Operações Homologadas com RE de Recuperação de Ativos por Efetivo de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
                'Operações Homologadas com RE de Recuperação de Ativos PF EM NÚMEROS de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração])
                )
        )
    )
)
;

Call TratarExpansaoMacro(vTituloMedidaMestraOperacoesHomologadasComReRecuperacaoAtivos);

