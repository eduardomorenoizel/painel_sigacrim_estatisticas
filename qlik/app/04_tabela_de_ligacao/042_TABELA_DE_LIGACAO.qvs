TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Iniciando carga da Tabela de Ligacao;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;

[LINK_TABLE_APREENSOES_OPERACOES_CASOS]:
LOAD DISTINCT
    [%CASOSKEY]
    ,[%OPERACOESKEY]
    ,[%APREENSOESKEY]
    ,[%SUBCLASSESKEY]
    ,[%EVENTOSKEY]
    ,[Data]
    ,[Ano]
    ,[Mês]
    ,[Mês (Num)]
    ,[Tipo da Data]
    ,[Fonte]
    ,[Tipo do Fato]
    ,[%UNIDADE_KEY]
    ,[Unidade Sigla do Caso]
    ,[Unidade UF do Caso]
    ,[Área de Atribuição do Caso]
    ,[Diretoria do Caso]
    ,[Coordenação-Geral do Caso]
    ,[%CASOSDATAKEY]
    ,[Unidade Sigla do Evento Operacional]
    ,[Unidade UF do Evento Operacional]
    ,[Área de Atribuição do Evento Operacional]
    ,[Diretoria do Evento Operacional]
    ,[Coordenação-Geral do Evento Operacional]
    ,[%EVENTOSAPREENSOESKEY]
    ,[%EVENTOSPRISOESKEY]
FROM [$(vCaminhoTransformadosV3)LINK_TABLE_APREENSOES_OPERACOES_CASOS.qvd]
(qvd);

TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Concluída carga da Tabela de Ligacao;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
