LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'Quebra Sigilo Fiscal'                 AS [Medidas Extraordinárias] RESIDENT TEMP_SIGACrimHomologadas WHERE Upper(QUEBRA_SIGILO_FISCAL) = 'SIM';
Concatenate(DIM_MEDIDAS_EXTRAORDINARIAS)
LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'Ação Controlada'                      AS [Medidas Extraordinárias] RESIDENT TEMP_SIGACrimHomologadas WHERE Upper(ACAO_CONTROLADA) = 'SIM';
Concatenate(DIM_MEDIDAS_EXTRAORDINARIAS)
LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'Captação Ambiental'                   AS [Medidas Extraordinárias] RESIDENT TEMP_SIGACrimHomologadas WHERE Upper(CAPTACAO_AMBIENTAL_SINAIS_MAGNETICOS) = 'SIM';
Concatenate(DIM_MEDIDAS_EXTRAORDINARIAS)
LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'Agente Infiltrado'                    AS [Medidas Extraordinárias] RESIDENT TEMP_SIGACrimHomologadas WHERE Upper(AGENTE_INFILTRADO) = 'SIM';


