    NPJADMBases,                        vConjServidoresNPJADMBases
    NPJADMDelegaciasEspecializadasPJ,   vConjServidoresNPJADMDelegaciasEspecializadasPJ
];

// Pré-computa o conjunto-base uma única vez para evitar reexpansão a cada iteração
LET vLoop_BaseConj = '$(vConjSemRelDatasAreaCasoOperacaoBem)';

FOR i = 1 TO NoOfRows('TabelaQtdServEfetivo')
    LET vLoop_S = Peek('Sufixo',       $(i)-1, 'TabelaQtdServEfetivo');
    LET vLoop_C = Peek('ConjVariavel', $(i)-1, 'TabelaQtdServEfetivo');

    LET vLoop_N1 = 'vQtdServ' & '$(vLoop_S)';
    LET vLoop_N2 = 'vQtdServ' & '$(vLoop_S)' & 'Total';
    LET vLoop_N3 = 'vQtdServ' & '$(vLoop_S)' & 'SomAnter';

    // Combina base + filtro específico: 1 expansão por iteração em vez de 4
    LET vLoop_E = '$(vLoop_BaseConj),$($(vLoop_C))';

    SET $(vLoop_N1) = NUM(Count({<$(vLoop_E)>}[Servidor ID]),'#.##0');
    SET $(vLoop_N2) = NUM(Count(TOTAL {<$(vLoop_E)>}[Servidor ID]),'#.##0');
    SET $(vLoop_N3) = NUM(RangeSum(Above(Count({<$(vLoop_E)>}[Servidor ID]),0,RowNo()))/Count(TOTAL {<$(vLoop_E)>}[Servidor ID]));

NEXT i
DROP TABLE TabelaQtdServEfetivo;


//-----------------------------------------------------------------------------------------------
// Quantidades da Unidade da Operação/Caso selecionada (sem filtro de data/caso/operação)
//-----------------------------------------------------------------------------------------------

SET vQtdServUnidOpApreCaso    = NUM(Count({<$(vConjServidoresPF)>}[Servidor ID]),'#.##0');
SET vQtdServPolUnidOpApreCaso = NUM(Count({<$(vConjServidoresPol)>}[Servidor ID]),'#.##0');
SET vQtdServADMUnidOpApreCaso = NUM(Count({<$(vConjServidoresADM)>}[Servidor ID]),'#.##0');


//-----------------------------------------------------------------------------------------------
// SEÇÃO 2: vServ — Denominadores para cálculos relativos ao efetivo
// Gera: vServ{Sufixo}, vServ{Sufixo}Total
//-----------------------------------------------------------------------------------------------

TabelaServDenominadores:
LOAD * INLINE [
    Sufixo,               ConjVariavel
    PFComSede,            vConjServidoresPFComSede
    PF,                   vConjServidoresPF
    NPFComSede,           vConjServidoresNPFComSede
    NPF,                  vConjServidoresNPF
    PJComSede,            vConjServidoresPJComSede
    PJ,                   vConjServidoresPJ
    NPJComSede,           vConjServidoresNPJComSede
    NPJ,                  vConjServidoresNPJ
    PolComSede,           vConjServidoresPolComSede
    Pol,                  vConjServidoresPol
    DPFComSede,           vConjServidoresDPFComSede
    DPF,                  vConjServidoresDPF
    APFComSede,           vConjServidoresAPFComSede
    APF,                  vConjServidoresAPF
    EPFComSede,           vConjServidoresEPFComSede
    EPF,                  vConjServidoresEPF
    PPFComSede,           vConjServidoresPPFComSede
    PPF,                  vConjServidoresPPF
    PCFComSede,           vConjServidoresPCFComSede
    PCF,                  vConjServidoresPCF
    ADMComSede,           vConjServidoresADMComSede
    ADM,                  vConjServidoresADM
    PFPCF,                vConjServidoresPCFPF
    PJPCF,                vConjServidoresPCFPJ
];

FOR i = 1 TO NoOfRows('TabelaServDenominadores')
    LET vLoop_S = Peek('Sufixo',       $(i)-1, 'TabelaServDenominadores');
    LET vLoop_C = Peek('ConjVariavel', $(i)-1, 'TabelaServDenominadores');

    LET vLoop_N1 = 'vServ' & '$(vLoop_S)';
    LET vLoop_N2 = 'vServ' & '$(vLoop_S)' & 'Total';

    LET vLoop_E = '$(vLoop_BaseConj),$($(vLoop_C))';

    SET $(vLoop_N1) = NUM(Count({<$(vLoop_E)>}[Servidor ID]),'#.##0');
    SET $(vLoop_N2) = NUM(Count(TOTAL {<$(vLoop_E)>}[Servidor ID]),'#.##0');

NEXT i
DROP TABLE TabelaServDenominadores;


//-----------------------------------------------------------------------------------------------
// SEÇÃO 3: vServ — Denominadores por Unidade (sem filtro de data/caso/operação)
// Gera: vServ{Sufixo}UnidOpApreCaso
//-----------------------------------------------------------------------------------------------

TabelaServUnidOpApreCaso:
LOAD * INLINE [
    Sufixo,               ConjVariavel
    PFComSede,            vConjServidoresPFComSede
    PF,                   vConjServidoresPF
    PJComSede,            vConjServidoresPJComSede
    PJ,                   vConjServidoresPJ
    PolComSede,           vConjServidoresPolComSede
    Pol,                  vConjServidoresPol
    DPFComSede,           vConjServidoresDPFComSede
    DPF,                  vConjServidoresDPF
    APFComSede,           vConjServidoresAPFComSede
    APF,                  vConjServidoresAPF
    EPFComSede,           vConjServidoresEPFComSede
    EPF,                  vConjServidoresEPF
    PPFComSede,           vConjServidoresPPFComSede
    PPF,                  vConjServidoresPPF
    PCFComSede,           vConjServidoresPCFComSede
    PCF,                  vConjServidoresPCF
    ADMComSede,           vConjServidoresADMComSede
    ADM,                  vConjServidoresADM
];

FOR i = 1 TO NoOfRows('TabelaServUnidOpApreCaso')
    LET vLoop_S = Peek('Sufixo',       $(i)-1, 'TabelaServUnidOpApreCaso');
    LET vLoop_C = Peek('ConjVariavel', $(i)-1, 'TabelaServUnidOpApreCaso');

    LET vLoop_N1 = 'vServ' & '$(vLoop_S)' & 'UnidOpApreCaso';

    SET $(vLoop_N1) = NUM(Count({<$($(vLoop_C))>}[Servidor ID]),'#.##0');

NEXT i
DROP TABLE TabelaServUnidOpApreCaso;


//-----------------------------------------------------------------------------------------------
// Limpeza das variáveis auxiliares do loop
//-----------------------------------------------------------------------------------------------

SET vLoop_S         = ;
SET vLoop_C         = ;
SET vLoop_N1        = ;
SET vLoop_N2        = ;
SET vLoop_N3        = ;
SET vLoop_E         = ;
SET vLoop_BaseConj  = ;

