                ,[Ano do Evento Prisão] = {@(=Year(Today()))}
                ,$(vConjEvenPrisDtMesAnoEvenPrisPfEmNumeros)|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento Prisão'}
                ,[Ano] = {@(=MAX([Ano]-1))}|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento Prisão'}
                ,[Ano] = {@(=MAX([Ano]-1))}
                ,$(vConjEvenPrisDtMesAnoPfEmNumeros)|
