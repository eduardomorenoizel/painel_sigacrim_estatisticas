        PRE_PREVISAO_AUXILIO_GRUPO_TATICO, // Boleano sim/nao
        IF(Len(Trim(PRE_GPOL_ST_AUX_GRUPO_TATICO)) > 0,
            'sim',
            'nao'))
    AS AUX_GRUPO_TATICO,
    PRE_OB_PRE_DEFLAGRACAO, // Texto com 1041 caracteres
    ID_DADOS_GPOL, // Número Real
