// Medida mestra das buscas cumpridas em operações com seleção de Ano, Mês ou Data TOTAL:
SET vMedidaMestraBuscasCumpridasEmOperacoesTot =
    IF(
    // Se selecionado [Ano da Deflagração], [Mês da Deflagração] ou [Data da Deflagração]
       GetSelectedCount([Ano da Deflagração])
        + GetSelectedCount([Mês da Deflagração])
        + GetSelectedCount([Data da Deflagração])
        + GetSelectedCount([Ano da Apreensão])
        + GetSelectedCount([Mês da Apreensão])
        + GetSelectedCount([Data da Apreensão])
        + GetSelectedCount([Proc_Data Data Ano])
        + GetSelectedCount([Proc_Data Data Mês])
        + GetSelectedCount([Proc_Data Data])
        + GetSelectedCount([Ano do Cadastro])
        + GetSelectedCount([Mês do Cadastro])
        + GetSelectedCount([Data do Cadastro])
        + GetSelectedCount([Ano da Instauração])
        + GetSelectedCount([Mês da Instauração])
        + GetSelectedCount([Data da Instauração])
        + GetSelectedCount([Ano do Relatório])
        + GetSelectedCount([Mês do Relatório])
        + GetSelectedCount([Data do Relatório]) > 0,
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vBuscCumprEmOperDtMesAnoDefl),
        // números por efetivo
            $(vBuscCumprEmOperDtMesAnoDeflPorEfetTot),
        // números PF EM NÚMEROS
            $(vBuscCumprEmOperPfEmNumDtMesAnoDefl)
            ),
//////////////////////// Se não selecionado [Ano da Deflagração], [Mês da Deflagração] ou [Data da Deflagração], mostrar [Ano], [Mês] ou [Data]
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vBuscCumprEmOperDtMesAno),
        // números por efetivo
            $(vBuscCumprEmOperDtMesAnoPorEfetTot),
        // números PF EM NÚMEROS
            $(vBuscCumprEmOperPfEmNumDtMesAno)
            )
        )
;

Call TratarExpansaoMacro(vMedidaMestraBuscasCumpridasEmOperacoesTot);

// Medida mestra das buscas cumpridas em operações com seleção de Ano, Mês ou Data soma acumulada (soma anteriores):
SET vMedidaMestraBuscasCumpridasEmOperacoesSomAnter =
    IF(
// Se selecionado [Ano da Deflagração], [Mês da Deflagração] ou [Data da Deflagração], mostrar [Ano da Deflagração]
       GetSelectedCount([Ano da Deflagração])
        + GetSelectedCount([Mês da Deflagração])
        + GetSelectedCount([Data da Deflagração])
        + GetSelectedCount([Ano da Apreensão])
        + GetSelectedCount([Mês da Apreensão])
        + GetSelectedCount([Data da Apreensão])
        + GetSelectedCount([Proc_Data Data Ano])
        + GetSelectedCount([Proc_Data Data Mês])
        + GetSelectedCount([Proc_Data Data])
        + GetSelectedCount([Ano do Cadastro])
        + GetSelectedCount([Mês do Cadastro])
        + GetSelectedCount([Data do Cadastro])
        + GetSelectedCount([Ano da Instauração])
        + GetSelectedCount([Mês da Instauração])
        + GetSelectedCount([Data da Instauração])
        + GetSelectedCount([Ano do Relatório])
        + GetSelectedCount([Mês do Relatório])
        + GetSelectedCount([Data do Relatório]) > 0,
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vBuscCumprEmOperSomAnterDtMesAnoDefl),
        // números por efetivo
            $(vBuscCumprEmOperSomAnterDtMesAnoDefl),
        // números PF EM NÚMEROS
            $(vBuscCumprEmOperSomAnterPfEmNumDtMesAnoDefl)
            ),
//////////////////////// Se não selecionado [Ano da Deflagração], [Mês da Deflagração] ou [Data da Deflagração], mostrar [Ano], [Mês] ou [Data]:
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vBuscCumprEmOperSomAnterDtMesAno),
        // números por efetivo
            $(vBuscCumprEmOperSomAnterDtMesAno),
        // números PF EM NÚMEROS
            $(vBuscCumprEmOperSomAnterPfEmNumDtMesAno)
            )
    )
;

Call TratarExpansaoMacro(vMedidaMestraBuscasCumpridasEmOperacoesSomAnter);

