END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarMetricaContagemCompletaEven(vRadical, vNomeFiltro)
    Gera o conjunto completo de variáveis de CONTAGEM para um radical:
      - 12 variáveis principais  (CriarVariavelContagem)
      - 6+6 variáveis por efetivo (CriarVariavelRelativa)
      - 12 variáveis soma anteriores (CriarVariavelContagemSomaAnteriores)
    Padrão de datas: Evento Operacional.
----------------------------------------------------------------------------------------------*/
SUB GerarMetricaContagemCompletaEven(vRadical, vNomeFiltro)
    CALL GerarListaNomes12Even('$(vRadical)');
    CALL GerarListaCampo12('distinct id_ordem_original_evento');
    CALL GerarConjunto12Even('$(vNomeFiltro)');
    CALL ExecutarLoopContagem12;

    CALL GerarPorEfet6Even('$(vRadical)');

    CALL GerarListaNomesSomAnter12Even('$(vRadical)');
    CALL GerarListaCampo12('distinct id_ordem_original_evento');
    CALL GerarConjunto12Even('$(vNomeFiltro)');
    CALL ExecutarLoopContagemSomAnter12;
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarMetricaSomaCompletaEven(vRadical, vNomeFiltro, vCampo)
    Gera o conjunto completo de variáveis de SOMA para um radical:
      - 12 variáveis principais  (CriarVariavelSoma)
      - 6+6 variáveis por efetivo (CriarVariavelRelativa)
      - 12 variáveis soma anteriores (CriarVariavelSomaAnteriores)
    Padrão de datas: Evento Operacional.
----------------------------------------------------------------------------------------------*/
SUB GerarMetricaSomaCompletaEven(vRadical, vNomeFiltro, vCampo)
    CALL GerarListaNomes12Even('$(vRadical)');
    CALL GerarListaCampo12('$(vCampo)');
    CALL GerarConjunto12Even('$(vNomeFiltro)');
    CALL ExecutarLoopSoma12;

    CALL GerarPorEfet6Even('$(vRadical)');

    CALL GerarListaNomesSomAnter12Even('$(vRadical)');
    CALL GerarListaCampo12('$(vCampo)');
    CALL GerarConjunto12Even('$(vNomeFiltro)');
    CALL ExecutarLoopSomAnter12;
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarMetricaSomaSomenteEven(vRadical, vNomeFiltro, vCampo)
    Gera apenas 12 variáveis de soma, sem por efetivo e sem soma anteriores.
    Usado para métricas escolhidas
----------------------------------------------------------------------------------------------*/
SUB GerarMetricaSomaSomenteEven(vRadical, vNomeFiltro, vCampo)
    CALL GerarListaNomes12Even('$(vRadical)');
    CALL GerarListaCampo12('$(vCampo)');
    CALL GerarConjunto12Even('$(vNomeFiltro)');
    CALL ExecutarLoopSoma12;
END SUB

