SUB GerarPorEfet6Proc(vRadical)
    SET vListaNomeVariavel =
$(vRadical)DtMesAnoPorEfet|
$(vRadical)ProcDtDtMesAnoPorEfet|
$(vRadical)AnoAtualPorEfet|
$(vRadical)ProcDtDtAnoAtualPorEfet|
$(vRadical)AnoAnteriorPorEfet|
$(vRadical)ProcDtDtAnoAnteriorPorEfet
;
    SET vListaNumerador =
$($(vRadical)DtMesAno)|
$($(vRadical)ProcDtDtMesAno)|
$($(vRadical)AnoAtual)|
$($(vRadical)ProcDtDtAnoAtual)|
$($(vRadical)AnoAnterior)|
$($(vRadical)ProcDtDtAnoAnterior)
;
    SET vListaDenominador =
$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)
;
    FOR i = 1 TO 6
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativa('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i

    SET vListaNomeVariavel =
$(vRadical)DtMesAnoPorEfetTot|
$(vRadical)ProcDtDtMesAnoPorEfetTot|
$(vRadical)AnoAtualPorEfetTot|
$(vRadical)ProcDtDtAnoAtualPorEfetTot|
$(vRadical)AnoAnteriorPorEfetTot|
$(vRadical)ProcDtDtAnoAnteriorPorEfetTot
;
    SET vListaDenominador =
$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)
;
    FOR i = 1 TO 6
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativa('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i
END SUB

SUB GerarPorEfet6Inst(vRadical)
    SET vListaNomeVariavel =
$(vRadical)DtMesAnoPorEfet|
$(vRadical)DtMesAnoInstPorEfet|
$(vRadical)AnoAtualPorEfet|
$(vRadical)AnoAtualInstPorEfet|
$(vRadical)AnoAnteriorPorEfet|
