// Título da medida mestra das operações homologadas em áreas de fronteira:
SET vTituloMedidaMestraOperacoesHomologadasEmAreasFronteira = 
IF(
    // Se [Ano] selecionado mostrar vAnoSelecionado
    GetSelectedCount([Ano]) > 0,
    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        'Operações Homologadas em Áreas de Fronteira em ' & @(vAnoSelecionado),
        'Operações Homologadas em Áreas de Fronteira por Efetivo em ' & @(vAnoSelecionado),
        'Operações Homologadas em Áreas de Fronteira PF EM NÚMEROS em ' & @(vAnoSelecionado)
        ),
    IF(
        // Se [Mês] ou [Data] selecionado mostrar MIN([Ano]) a MAX([Ano])
        GetSelectedCount([Mês]) + GetSelectedCount([Data]) > 0,
        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
            'Operações Homologadas em Áreas de Fronteira de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Operações Homologadas em Áreas de Fronteira por Efetivo de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Operações Homologadas em Áreas de Fronteira PF EM NÚMEROS de ' & MIN([Ano]) & ' a '& MAX([Ano])
            ),
        IF(
            // Se [Ano da Deflagração] selecionado mostrar vAnoDeflagracaoSelecionado
            GetSelectedCount([Ano da Deflagração]) > 0,
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                'Operações Homologadas em Áreas de Fronteira em ' & @(vAnoDeflagracaoSelecionado),
                'Operações Homologadas em Áreas de Fronteira por Efetivo em ' & @(vAnoDeflagracaoSelecionado),
                'Operações Homologadas em Áreas de Fronteira PF EM NÚMEROS em ' & @(vAnoDeflagracaoSelecionado)
                ),
            // Se nada selecionado mostrar MIN([Ano da Deflagração]) a MAX([Ano da Deflagração])
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                'Operações Homologadas em Áreas de Fronteira de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
                'Operações Homologadas em Áreas de Fronteira por Efetivo de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
                'Operações Homologadas em Áreas de Fronteira PF EM NÚMEROS de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração])
                )
        )
    )
)
;

Call TratarExpansaoMacro(vTituloMedidaMestraOperacoesHomologadasEmAreasFronteira);

