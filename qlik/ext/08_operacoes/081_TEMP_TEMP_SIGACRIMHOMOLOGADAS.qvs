    PRE_PREVISAO_CUMPRIMENTO_MEDIDAS_CAUTELARES, // Boleano sim/nao
    PRE_PREVISAO_AUXILIO_ORGAO_EXTERNO, // Boleano sim/nao
    PRE_NO_ORGAO_COOPERACAO, // Array separado por ";"
    PRE_PREVISAO_AUXILIO_GRUPO_TATICO, // Boleano sim/nao
    PRE_DS_GRUPO_TATICO, // Array separado por ";"
