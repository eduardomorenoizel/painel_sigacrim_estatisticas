    GRUPO_EXTERMINIO_MILICIA, // Boleano Sim/Não
    TERRA_INDIGENA, // Boleano Sim/Não
    DS_TERRA_INDIGENA, // Array separado por ";"
    ENVOLVE_UNIDADE_CONSERVACAO, // Boleano Sim/Não
    UNIDADE_CONSERVACAO, // Array separado por ";"
    ENVOLVE_AREA_PRIORITARIA, // Boleano Sim/Não
