    QTD_MEDIDAS_CAUTELARES_SUSPENSAO_EXERCICIO, // Inteiro
    MEDIDAS_CAUTELARES_INTERNACAO_PROVISORIA, // Boleano Sim/Não
    QTD_MEDIDAS_CAUTELARES_INTERNACAO_PROVISORIA, // Inteiro
    MEDIDAS_CAUTELARES_FIANCA, // Boleano Sim/Não
    QTD_MEDIDAS_CAUTELARES_FIANCA, // Inteiro
    MEDIDAS_CAUTELARES_MONITORACAO_ELETRONICA, // Boleano Sim/Não
    QTD_MEDIDAS_CAUTELARES_MONITORACAO_ELETRONICA, // Inteiro
    MEDIDAS_CAUTELARES_PROIBICAO_AUSENTAR_PAIS, // Boleano Sim/Não
