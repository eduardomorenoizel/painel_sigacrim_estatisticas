            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vPrisPrevCumprEmOperEmAreaFrontDtMesAno),
        // números por efetivo
            $(vPrisPrevCumprEmOperEmAreaFrontDtMesAnoPorEfet),
        // números PF EM NÚMEROS
            $(vPrisPrevCumprEmOperEmAreaFrontPfEmNumDtMesAno)
            )
