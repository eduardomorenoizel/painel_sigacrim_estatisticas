//-----------------------------------------------------------------------------------------------
// Cálculo das medidas mestras de:
//      - Operações x Prisões x Descapitalizações
//		- Resgate de Vítimas de Trabalho Escravo por Operações de Crimes contra Direitos Humanos
//		- Resgates de vítimas de Tráfico de Pessoas por Operações de Crimes contra Direitos Humanos
//		- Resgates de vítimas de Migração Ilegal por Operações de Crimes contra Direitos Humanos
//		- Resgates de vítimas de grupos de Extermínio por Operações de Crimes contra Direitos Humanos
//-----------------------------------------------------------------------------------------------

////////////////////////////////Em construção////////////////////////////////

//-----------------------------------------------------------------------------------------------
// Cálculo das medidas mestras de prisoes cumpridas por operação relativas:
//      - numeros absolutos
//      - números por efetivo
//      - números PF EM NÚMEROS
//-----------------------------------------------------------------------------------------------

// Medida mestra de prisoes cumpridas por operação com seleção de Ano, Mês ou Data:
SET vMedidaMestraPrisoesCumpridasPorOperacaoHomologada =
    IF(
    // Se selecionado [Ano da Deflagração], [Mês da Deflagração] ou [Data da Deflagração]
       GetSelectedCount([Ano da Deflagração])
        + GetSelectedCount([Mês da Deflagração])
        + GetSelectedCount([Data da Deflagração])
        + GetSelectedCount([Ano da Apreensão])
        + GetSelectedCount([Mês da Apreensão])
        + GetSelectedCount([Data da Apreensão])
        + GetSelectedCount([Proc_Data Data Ano])
        + GetSelectedCount([Proc_Data Data Mês])
        + GetSelectedCount([Proc_Data Data])
        + GetSelectedCount([Ano do Cadastro])
        + GetSelectedCount([Mês do Cadastro])
        + GetSelectedCount([Data do Cadastro])
        + GetSelectedCount([Ano da Instauração])
        + GetSelectedCount([Mês da Instauração])
        + GetSelectedCount([Data da Instauração])
        + GetSelectedCount([Ano do Relatório])
        + GetSelectedCount([Mês do Relatório])
        + GetSelectedCount([Data do Relatório]) > 0,
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vPrisCumprEmOperPorOperHomDtMesAnoDefl),
        // numeros absolutos 
            $(vPrisCumprEmOperPorOperHomDtMesAnoDefl),
        // números PF EM NÚMEROS
            $(vPrisCumprEmOperPorOperHomPfEmNumDtMesAnoDefl)
            ),
//////////////////////// Se não selecionado [Ano da Deflagração], [Mês da Deflagração] ou [Data da Deflagração], mostrar [Ano], [Mês] ou [Data]
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vPrisCumprEmOperPorOperHomDtMesAno),
        // numeros absolutos 
            $(vPrisCumprEmOperPorOperHomDtMesAno),
        // números PF EM NÚMEROS
            $(vPrisCumprEmOperPorOperHomPfEmNumDtMesAno)
            )
    )
;

Call TratarExpansaoMacro(vMedidaMestraPrisoesCumpridasPorOperacaoHomologada);

// Medida mestra para KPI de prisoes cumpridas por operação com seleção de Ano, Mês ou Data, para mostrar dados do ano atual quando nada estiver selecionado:
SET vMedidaMestraKpiPrisoesCumpridasPorOperacaoHomologada =
IF(
// Se selecionado [Ano], [Mês] ou [Data]
	  GetSelectedCount([Ano])
    + GetSelectedCount([Mês])
    + GetSelectedCount([Data]) > 0,
    PICK(
        @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
    // numeros absolutos 
        $(vPrisCumprEmOperPorOperHomDtMesAno),
    // numeros absolutos 
        $(vPrisCumprEmOperPorOperHomDtMesAno),
    // números PF EM NÚMEROS
        $(vPrisCumprEmOperPorOperHomPfEmNumDtMesAno)
        ),
//////////////////////// Se selecionado [Ano da Deflagração], [Mês da Deflagração] ou [Data da Deflagração]
    IF(
    // Se selecionado [Ano da Deflagração], [Mês da Deflagração] ou [Data da Deflagração]
       GetSelectedCount([Ano da Deflagração])
        + GetSelectedCount([Mês da Deflagração])
        + GetSelectedCount([Data da Deflagração])
        + GetSelectedCount([Ano da Apreensão])
        + GetSelectedCount([Mês da Apreensão])
        + GetSelectedCount([Data da Apreensão])
        + GetSelectedCount([Proc_Data Data Ano])
        + GetSelectedCount([Proc_Data Data Mês])
        + GetSelectedCount([Proc_Data Data])
        + GetSelectedCount([Ano do Cadastro])
        + GetSelectedCount([Mês do Cadastro])
        + GetSelectedCount([Data do Cadastro])
        + GetSelectedCount([Ano da Instauração])
        + GetSelectedCount([Mês da Instauração])
        + GetSelectedCount([Data da Instauração])
        + GetSelectedCount([Ano do Relatório])
        + GetSelectedCount([Mês do Relatório])
        + GetSelectedCount([Data do Relatório]) > 0,
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vPrisCumprEmOperPorOperHomDtMesAnoDefl),
        // numeros absolutos 
            $(vPrisCumprEmOperPorOperHomDtMesAnoDefl),
        // números PF EM NÚMEROS
            $(vPrisCumprEmOperPorOperHomPfEmNumDtMesAnoDefl)
            ),
//////////////////////// Se selecionado nada selecionado mostrar Ano Atual
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vPrisCumprEmOperPorOperHomAnoAtual),
        // numeros absolutos 
            $(vPrisCumprEmOperPorOperHomAnoAtual),
        // números PF EM NÚMEROS
            $(vPrisCumprEmOperPorOperHomPfEmNumAnoAtual)
            )
        )
    )
;

Call TratarExpansaoMacro(vMedidaMestraKpiPrisoesCumpridasPorOperacaoHomologada);

