    CALL GerarListaNomes12EvenPris('$(vRadical)');
    CALL GerarListaCampo12('distinct ID_OPERACAO');
    CALL GerarConjunto12EvenPris('$(vNomeFiltro)');
    CALL ExecutarLoopContagem12;

    CALL GerarPorEfet6EvenPris('$(vRadical)');

    CALL GerarListaNomesSomAnter12EvenPris('$(vRadical)');
    CALL GerarListaCampo12('distinct ID_OPERACAO');
    CALL GerarConjunto12EvenPris('$(vNomeFiltro)');
    CALL ExecutarLoopContagemSomAnter12;
END SUB

