                ETAPAOPERACAO = {'Homologada'} 
                ,[Tipo do Fato] = {'Operações'}
                ,[Tipo da Data] = {'Deflagração da Operação'}
                ,[Ano] = {@(=Year(Today()))}|
                ETAPAOPERACAO = {'Homologada'} 
                ,[Tipo do Fato] = {'Operações'}
                ,[Tipo da Data] = {'Deflagração da Operação'}
                ,[Ano] = {@(=Year(Today()))}
                ,$(vConjOpDtMesAnoPfEmNumeros)|
                ETAPAOPERACAO = {'Homologada'} 
                ,[Tipo do Fato] = {'Operações'}
                ,[Ano da Deflagração] = {@(=Year(Today()))}|
                ETAPAOPERACAO = {'Homologada'} 
                ,[Tipo do Fato] = {'Operações'}
                ,[Ano da Deflagração] = {@(=Year(Today()))}
