    QTD_NOTICIAS_PROMETHEUS, // Inteiro
    TENTACULOS, // Boleano Sim/Não
    TENTACULOS_IPJ_ENVIADA_CBAN, // Boleano Sim/Não
    Num(
		Num#(Replace(Trim(VL_TENTACULOS_FRAUDE), 'R$', ''), '#.##0,00'),
		'R$ #.##0,00'
	) AS VL_TENTACULOS_FRAUDE, // Número
    QTD_NOTICIAS_TENTACULOS, // Inteiro
    TENTACULOS_SEI_IPJ, // Texto
    PRE_DT_PREVISTA_DEFLAGRACAO, // Daca como texto DD/MM/AAAA
    PRE_NR_REGISTROS_ESPECIAIS, // Array separado por 
