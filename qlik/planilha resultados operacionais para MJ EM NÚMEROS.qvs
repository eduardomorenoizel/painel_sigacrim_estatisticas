FROM [lib://CORP_DADOS_AUXILIARES/qvd/DIM_CASOS.qvd]
(qvd)


Where	"Proc. Tipo" <> 'NC' and "Proc. Data Instauração Ano" > '2018'  


;

left join (TABELA_SIGACRIM)
Load
	IPL,
    "Município Crime",
 	"Município Crime UF"
//    "Proc. Quantidade Indiciados"
    resident TABELA_EPOL;


Left Join (TABELA_SIGACRIM)

LOAD
    ID_OPERACAO,
    if((Match(UF, 'MA','TO','PA','AM','RO','RR','AP','AC','MT')>0) AND 
	(AREAATRIBUICAO ='Crimes Ambientais, contra o Patrimônio Histórico e Cultural e Povos Originários'), 'SIM', 'NÃO') as AMAZONIA_LEGAL?,
    if(AREAATRIBUICAO = 'Crimes Cibernéticos relacionados ao abuso sexual infantojuvenil' , 'SIM', 'NÃO') as ABUSO_INFANTO_JUVENIL,
	if (WildMatch(UNIDADE, '*FICCO*')>0, 'SIM', 'NÃO') as FICCO?,
	if (left(UNIDADE, 4) = 'GISE', 'SIM', 'NÃO') as GISE?,
    if(WildMatch(trim(NOME_OPERACAO), '*202?.*', '-')>0, 'Operação ID ' & ID_OPERACAO, NOME_OPERACAO) as NOME_ANONIMIZADO
     
    resident TABELA_SIGACRIM;



Left Join (TABELA_EPOL)

LOAD
    IPL,
    if((Match("Unidade UF", 'MA','TO','PA','AM','RO','RR','AP','AC','MT')>0) AND 
	("Proc. Área de Atribuição" ='Crimes Ambientais, contra o Patrimônio Histórico e Cultural e Povos Originários'), 'SIM', 'NÃO') as AMAZONIA_LEGAL?,
    if("Proc. Área de Atribuição" = 'Crimes Cibernéticos relacionados ao abuso sexual infantojuvenil' , 'SIM', 'NÃO') as ABUSO_INFANTO_JUVENIL,
	if (WildMatch("Proc. Unidade Exercício", '*FICCO*')>0, 'SIM', 'NÃO') as FICCO?,
	if (left("Proc. Unidade Exercício", 4) = 'GISE', 'SIM', 'NÃO') as GISE?

     
    resident TABELA_EPOL;


TABELA_DESCAPITALIZACAO:
LOAD
    "Tipo do Fato",
    "Ano da Apreensão",
    "Mês (Num) da Apreensão",
    Unidade as UNIDADE_DESCAPITALIZACAO,
//     if((Match(UF, 'MA','TO','PA','AM','RO','RR','AP','AC','MT')>0) AND 
//	(AREAATRIBUICAO ='Crimes Ambientais, contra o Patrimônio Histórico e Cultural e Povos Originários'), 'SIM', 'NÃO') as AMAZONIA_LEGAL?,
	if (WildMatch(Unidade, '*FICCO*')>0, 'SIM', 'NÃO') as FICCO?,
	if (left(Unidade, 4) = 'GISE', 'SIM', 'NÃO') as GISE?,
    UF as UF_DESCAPITALIZACAO,
    if(ID_OPERACAO = '-', '0',ID_OPERACAO) as ID_OPERACAO,
    if(ID_OPERACAO = '-', 'Polícia Judiciária - Outros',
    	if(WildMatch(trim(NOME_OPERACAO), '*202?.*', '-')>0, 'Operação ID ' & ID_OPERACAO, NOME_OPERACAO)) as NOME_DESCAPITALIZACAO,
    Caso as Caso_principal_descap,
    "Data da Apreensão",
     if((Match(UF, 'MA','TO','PA','AM','RO','RR','AP','AC','MT')>0) AND 
	("Área de Atribuição do Caso" ='Crimes Ambientais, contra o Patrimônio Histórico e Cultural e Povos Originários'), 'SIM', 'NÃO') as AMAZONIA_LEGAL?,
    if("Área de Atribuição do Caso" = 'Crimes Cibernéticos relacionados ao abuso sexual infantojuvenil' , 'SIM', 'NÃO') as ABUSO_INFANTO_JUVENIL,
    money("Valor Total Descapitalização") as "Valor Total Descapitalização",
    money("1 Valor Bens Imóveis Apreendidos/Sequestrados LVL1") as "1 Valor Bens Imóveis Apreendidos/Sequestrados LVL1",
    money("2 Valor Bens Móveis e Semoventes Apreendidos/Sequestrados LVL1") as "2 Valor Bens Móveis e Semoventes Apreendidos/Sequestrados LVL1", 
    money("2.1 Valor Pedras, Metais Preciosos, Joias e Obras de Arte LVL2") as "2.1 Valor Pedras, Metais Preciosos, Joias e Obras de Arte LVL2",
    money("2.2 Valor Semoventes LVL2") as "2.2 Valor Semoventes LVL2",
    money("2.3 Valor Veículos aéreos LVL2") as "2.3 Valor Veículos aéreos LVL2",
    money("2.4 Valor Veículos aquáticos LVL2") as "2.4 Valor Veículos aquáticos LVL2",
    money("2.5 Valor Veículos terrestres LVL2") as "2.5 Valor Veículos terrestres LVL2",
    money("2.6 Valor Outros bens Móvies LVL2") as "2.6 Valor Outros bens Móvies LVL2",
    money("3 Valor Criptoativos apreendidos/sequestrados LVL1") as "3 Valor Criptoativos apreendidos/sequestrados LVL1",
    money("4 Valor Títulos  Valores Mobiliários e Direitos Apreendidos/Sequestrados LVL1") as "4 Valor Títulos  Valores Mobiliários e Direitos Apreendidos/Sequestrados LVL1",
    money("5 Valores Monetários Apreendidos/Sequestrados LVL1") as "5 Valores Monetários Apreendidos/Sequestrados LVL1",
    money("5.1 Valores Monetários em espécie LVL2") as "5.1 Valores Monetários em espécie LVL2",
    money("5.2 Valores Monetários bloqueados via Bacenjud ou similares LVL2") as "5.2 Valores Monetários bloqueados via Bacenjud ou similares LVL2",
    money("6 Valor Itens de Descapitalização Destruídos no Local LVL1") as "6 Valor Itens de Descapitalização Destruídos no Local LVL1"


FROM [lib://CORP_DICOR_NGE/BI_NGE_ESTATISTICAS/descapitalizacao_baggio_09-09-2026.xlsx]
(ooxml, embedded labels, table is Sheet1);



TABELA_DROGAS:
LOAD
    "Tipo do Fato",
    "Ano da Apreensão",
    "Mês da Apreensão",
    "Mês (Num) da Apreensão",
    UF,
    "Unidade Sigla do Caso" as Unidade_Drogas,
    "Data da Apreensão",
    "Área de Atribuição do Caso",
    if (WildMatch("Unidade Sigla do Caso", '*FICCO*')>0, 'SIM', 'NÃO') as FICCO?,
	if (left("Unidade Sigla do Caso", 4) = 'GISE', 'SIM', 'NÃO') as GISE?,
    if((Match(UF, 'MA','TO','PA','AM','RO','RR','AP','AC','MT')>0) AND 
	("Área de Atribuição do Caso" ='Crimes Ambientais, contra o Patrimônio Histórico e Cultural e Povos Originários'), 'SIM', 'NÃO') as AMAZONIA_LEGAL?,
    if(ID_OPERACAO = '-', '0',ID_OPERACAO) as ID_OPERACAO,
    if(ID_OPERACAO = '-', 'Polícia Judiciária - Outros',
    	if(WildMatch(trim(NOME_OPERACAO), '*202?.*', '-')>0, 'Operação ID ' & ID_OPERACAO, NOME_OPERACAO)) as NOME_OPERACAO_DROGAS,
    if("Área de Atribuição do Caso" = 'Crimes Cibernéticos relacionados ao abuso sexual infantojuvenil' , 'SIM', 'NÃO') as ABUSO_INFANTO_JUVENIL,
    Caso,
    "GestãoBens Item Material Categoria",
    "GestãoBens Item Material Classe",
    "GestãoBens Item Material",
    "Sum([GestãoBens Item Quantidade Apreendida Ajustada])",
    "GestãoBens Item Unidade Material Ajustada"
    
FROM [lib://CORP_DICOR_NGE/BI_NGE_ESTATISTICAS/drogas_baggio_09-09-2026.xlsx]
(ooxml, embedded labels, table is Sheet1);

TABELA_ARMAS:
LOAD
    "Tipo do Fato",
    "Ano da Apreensão",
    "Mês (Num) da Apreensão",
    UF,
    "Unidade Sigla do Caso" as Unidade_Armas,    
    "Data da Apreensão",
    "Área de Atribuição do Caso",
    if((Match(UF, 'MA','TO','PA','AM','RO','RR','AP','AC','MT')>0) AND 
		("Área de Atribuição do Caso" ='Crimes Ambientais, contra o Patrimônio Histórico e Cultural e Povos Originários'), 'SIM', 'NÃO') as AMAZONIA_LEGAL?,
    if (WildMatch("Unidade Sigla do Caso", '*FICCO*')>0, 'SIM', 'NÃO') as FICCO?,
	if (left("Unidade Sigla do Caso", 4) = 'GISE', 'SIM', 'NÃO') as GISE?,
    if(ID_OPERACAO = '-', '0',ID_OPERACAO) as ID_OPERACAO,
    if(ID_OPERACAO = '-', 'Polícia Judiciária - Outros',
    	if(WildMatch(trim(NOME_OPERACAO), '*202?.*', '-')>0, 'Operação ID ' & ID_OPERACAO, NOME_OPERACAO)) as NOME_OPERACAO_ARMAS,
    if("Área de Atribuição do Caso" = 'Crimes Cibernéticos relacionados ao abuso sexual infantojuvenil' , 'SIM', 'NÃO') as ABUSO_INFANTO_JUVENIL,
    Caso,
    "GestãoBens Item Material Categoria",
    "GestãoBens Item Material Classe",
    "GestãoBens Item Material",
    "Sum([GestãoBens Item Quantidade Apreendida Ajustada])",
    "GestãoBens Item Unidade Material Ajustada"

FROM [lib://CORP_DICOR_NGE/BI_NGE_ESTATISTICAS/armas_municoes_baggio_09-09-2026.xlsx]
(ooxml, embedded labels, table is Sheet1);

TABELA_MJ:
Load

 ID_OPERACAO,
  IPL,
  NOME_ANONIMIZADO as NOME_OPERACAO,
  UF,
  'Operações deflagradas' as indicador_produtividade,
  'Quantidade operações' as grupo_indicador,
  "Município Crime",
  DT_DEFLAGRACAO as Data,
  DT_MES_DEFLAGRACAO as mes,
  DT_ANO_DEFLAGRACAO as ano,
  Num(1, '#.##0') as QTD_COLUNA,
  FICCO?,
  GISE?,
  AMAZONIA_LEGAL?,
  ABUSO_INFANTO_JUVENIL,

  'un' as UN_MEDIDA
    
resident TABELA_SIGACRIM;

Concatenate(TABELA_MJ)
Load
 RowNo() as ID_linha,
 ID_OPERACAO,
  IPL,
  NOME_ANONIMIZADO as NOME_OPERACAO,
  UF,
  'Prisões Preventivas Cumpridas' as indicador_produtividade,
  'Prisões' as grupo_indicador,
  "Município Crime",
  DT_DEFLAGRACAO as Data,
  DT_MES_DEFLAGRACAO as mes,
  DT_ANO_DEFLAGRACAO as ano,
  Num(QTD_CUMPRIDA_PRISAO_PREVENTIVA, '#.##0') as QTD_COLUNA,
  FICCO?,
  GISE?,
  AMAZONIA_LEGAL?,
  ABUSO_INFANTO_JUVENIL,

  'Mandados' as UN_MEDIDA
    
resident TABELA_SIGACRIM;

    
  
Concatenate(TABELA_MJ)
Load
   RowNo() as ID_linha,
  ID_OPERACAO,
  IPL,
  NOME_ANONIMIZADO as NOME_OPERACAO,
  UF,
  'Prisões Temporárias Cumpridas' as indicador_produtividade,
  'Prisões' as grupo_indicador,
  Num(QTD_CUMPRIDA_PRISAO_TEMPORARIA, '#.##0') as QTD_COLUNA,
  "Município Crime",
  DT_DEFLAGRACAO as Data,
  DT_MES_DEFLAGRACAO as mes,
  DT_ANO_DEFLAGRACAO as ano,
  FICCO?,
  GISE?,
  AMAZONIA_LEGAL?,
  ABUSO_INFANTO_JUVENIL,
