/*----------------------------------------------------------------------------------------------
    SUB GerarPorEfet6Even(vRadical)
    Gera as 6+6 variáveis PorEfet e PorEfetTot para o radical informado.
    Padrão de sufixos: Evento Operacional (DtMesAno, DtMesAnoEven, AnoAtual, AnoEvenAtual, ...).
    Requer que as variáveis principais (vRadicalDtMesAno etc.) já existam.
    Nota: $($(vRadical)DtMesAno) expande em dois passos: vRadical → nome da var → valor.
----------------------------------------------------------------------------------------------*/
SUB GerarPorEfet6Even(vRadical)
    SET vListaNomeVariavel =
$(vRadical)DtMesAnoPorEfet|
$(vRadical)DtMesAnoEvenPorEfet|
$(vRadical)AnoAtualPorEfet|
$(vRadical)AnoEvenAtualPorEfet|
$(vRadical)AnoAnteriorPorEfet|
$(vRadical)AnoEvenAnteriorPorEfet
;
    SET vListaNumerador =
$($(vRadical)DtMesAno)|
$($(vRadical)DtMesAnoEven)|
$($(vRadical)AnoAtual)|
$($(vRadical)AnoEvenAtual)|
$($(vRadical)AnoAnterior)|
$($(vRadical)AnoEvenAnterior)
;
    SET vListaDenominador =
$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)
;
    FOR i = 1 TO 6
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativa('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i

    SET vListaNomeVariavel =
$(vRadical)DtMesAnoPorEfetTot|
$(vRadical)DtMesAnoEvenPorEfetTot|
$(vRadical)AnoAtualPorEfetTot|
$(vRadical)AnoEvenAtualPorEfetTot|
$(vRadical)AnoAnteriorPorEfetTot|
$(vRadical)AnoEvenAnteriorPorEfetTot
;
    SET vListaDenominador =
$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)
;
    FOR i = 1 TO 6
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativa('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarPorEfet6EvenApre(vRadical)
    Gera as 6+6 variáveis PorEfet e PorEfetTot para o padrão Evento Apreensão.
    Sufixos: DtMesAno, DtMesAnoEvenApre, AnoAtual, AnoEvenApreAtual, AnoAnterior, AnoEvenApreAnterior.
----------------------------------------------------------------------------------------------*/

SUB GerarPorEfet6EvenApre(vRadical)
    SET vListaNomeVariavel =
$(vRadical)DtMesAnoPorEfet|
$(vRadical)DtMesAnoEvenAprePorEfet|
$(vRadical)AnoAtualPorEfet|
$(vRadical)AnoEvenApreAtualPorEfet|
$(vRadical)AnoAnteriorPorEfet|
$(vRadical)AnoEvenApreAnteriorPorEfet
;
    SET vListaNumerador =
$($(vRadical)DtMesAno)|
$($(vRadical)DtMesAnoEvenApre)|
$($(vRadical)AnoAtual)|
$($(vRadical)AnoEvenApreAtual)|
$($(vRadical)AnoAnterior)|
$($(vRadical)AnoEvenApreAnterior)
;
    SET vListaDenominador =
$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)
;
    FOR i = 1 TO 6
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativa('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i

    SET vListaNomeVariavel =
$(vRadical)DtMesAnoPorEfetTot|
$(vRadical)DtMesAnoEvenAprePorEfetTot|
$(vRadical)AnoAtualPorEfetTot|
$(vRadical)AnoEvenApreAtualPorEfetTot|
$(vRadical)AnoAnteriorPorEfetTot|
$(vRadical)AnoEvenApreAnteriorPorEfetTot
;
    SET vListaDenominador =
$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)
;
    FOR i = 1 TO 6
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativa('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarPorEfet6EvenPris(vRadical)
    Gera as 6+6 variáveis PorEfet e PorEfetTot para o padrão Evento Prisão.
    Sufixos: DtMesAno, DtMesAnoEvenPris, AnoAtual, AnoEvenPrisAtual, AnoAnterior, AnoEvenPrisAnterior.
