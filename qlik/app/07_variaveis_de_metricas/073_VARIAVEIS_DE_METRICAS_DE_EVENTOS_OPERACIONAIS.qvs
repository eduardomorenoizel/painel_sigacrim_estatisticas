$($(vRadicalNum)AnoEvenApreAnterior)|
$($(vRadicalNum)PfEmNumAnoEvenApreAnterior)
;
    SET vListaDenominador =
$($(vRadicalDen)DtMesAno)|
$($(vRadicalDen)PfEmNumDtMesAno)|
$($(vRadicalDen)DtMesAnoEvenApre)|
$($(vRadicalDen)PfEmNumDtMesAnoEvenApre)|
$($(vRadicalDen)AnoAtual)|
