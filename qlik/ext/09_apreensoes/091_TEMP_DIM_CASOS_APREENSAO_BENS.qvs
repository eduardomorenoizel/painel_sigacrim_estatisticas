TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Deduplicando e carregando TEMP_TEMP_DIM_CASOS_APREENSAO_BENS;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
/*******************************************************************************
    Carrega a tabela TEMP_TEMP_DIM_CASOS_APREENSAO_BENS a partir da
    DIM_CASOS_APREENSAO_BENS.qvd, trazendo somente as apreensões
        a partir do ano de 2022 até o ano atual.
    Utiliza a função LastValue() para retirar os registros duplicados por
    erro, vindos do SISCART ou do SINPRO.
*******************************************************************************/

// Preceding LOAD: aplica as conversões monetárias somente após deduplicação,
// em vez de nas 8M linhas brutas. Os demais campos passam por '*' sem custo.
TEMP_TEMP_DIM_CASOS_APREENSAO_BENS:
LOAD
    *,
    Num(
        Num#(Replace(Trim([_ValorEstimado]), 'R$', ''), '#.##0,00'),
        'R$ #.##0,00'
    )
        AS "GestãoBens Item Valor Estimado",
    Num(
        Num#(Replace(Trim([_ValorEstimadoDeposito]), 'R$', ''), '#.##0,00'),
        'R$ #.##0,00'
    )
        AS "GestãoBens Item Valor Estimado Em Depósito";
// GROUP BY sobre as linhas filtradas — apenas LastValue simples sem conversão por linha.
LOAD
    "GestãoBens Item ID", // Chave primária com duplicidade com 22 caracteres
// Campos para a tabela FATO_APREENSOES
    LastValue("GestãoBens Apreensão Sistema")
        AS "GestãoBens Apreensão Sistema", // Texto (Siscart/ePol) (sem registros faltantes)
    LastValue("Proc. Identificação")
        AS "Proc. Identificação", // Texto com 32 caracteres (353 registros faltantes)
    LastValue($(vTransformaProcIdentificacaoEmCaso))
        AS IPL,
    LastValue("GestãoBens Alerta Unidades Diferentes")
        AS "GestãoBens Alerta Unidades Diferentes", // Texto (Sim/Não) (sem registros faltantes)
    LastValue("GestãoBens Alerta Apreensão sem Procedimento")
        AS "GestãoBens Alerta Apreensão sem Procedimento", // Texto (Sim/Não) (sem registros faltantes)
    LastValue("GestãoBens Item Em Custódia")
        AS "GestãoBens Item Em Custódia", // Texto (Sim/Não) (sem registros faltantes)
    LastValue("GestãoBens Item Quantidade Apreendida")
        AS "GestãoBens Item Quantidade Apreendida", // Número como Texto com 11 caracteres
    LastValue("GestãoBens Item Quantidade Normalizada Apreendida")
        AS "GestãoBens Item Quantidade Normalizada Apreendida", // Número como Texto com 11 caracteres
    LastValue("GestãoBens Item Valor Estimado")
        AS [_ValorEstimado], // Texto bruto — convertido no LOAD externo (mais rápido pós-dedup)
    LastValue("GestãoBens Item Unidade Material")
        AS "GestãoBens Item Unidade Material", // Texto 2 caracteres (sem registros faltantes)
    LastValue("GestãoBens Item Data Apreensão")
        AS "GestãoBens Item Data Apreensão", // Data (DD/MM/AAAA) como Texto com 10 caracteres (sem registros faltantes)
    LastValue("GestãoBens Item Data Entrada Depósito")
        AS "GestãoBens Item Data Entrada Depósito", // Data (DD/MM/AAAA) como Texto com 10 caracteres
    LastValue("GestãoBens Item Data Saída Depósito")
        AS "GestãoBens Item Data Saída Depósito", // Data (DD/MM/AAAA) como Texto com 10 caracteres
    LastValue("GestãoBens Item Quantidade em Depósito")
        AS "GestãoBens Item Quantidade em Depósito", // Número como Texto com 9 caracteres
    LastValue("GestãoBens Item Quantidade Normalizada em Depósito")
        AS "GestãoBens Item Quantidade Normalizada em Depósito", // Número como Texto com 9 caracteres
    LastValue("GestãoBens Item Valor Estimado Em Depósito")
        AS [_ValorEstimadoDeposito], // Texto bruto — convertido no LOAD externo (mais rápido pós-dedup)
    LastValue("GestãoBens Item Em Depósito")
        AS "GestãoBens Item Em Depósito", // Texto (Sim/Não) (sem registros faltantes)
    LastValue("GestãoBens Item Passou Depósito")
        AS "GestãoBens Item Passou Depósito", // Texto (Sim/Não) (sem registros faltantes)
    LastValue("GestãoBens Item Idade em Depósito")
        AS "GestãoBens Item Idade em Depósito", // Texto com 19 caracteres
    LastValue("GestãoBens Item Idade Apreensão")
        AS "GestãoBens Item Idade Apreensão", // Texto com 19 caracteres
    LastValue("GestãoBens Item Idade Inteira em Depósito")
        AS "GestãoBens Item Idade Inteira em Depósito", // Número Real
    LastValue("GestãoBens Item Idade Inteira Apreensão")
        AS "GestãoBens Item Idade Inteira Apreensão", // Número Real
    LastValue("GestãoBens Item Idade Saída Depósito")
        AS "GestãoBens Item Idade Saída Depósito", // Texto com 19 caracteres
    LastValue("GestãoBens Procedimento Sistema")
        AS "GestãoBens Procedimento Sistema", // Texto (Siscart/ePol) (sem registros faltantes)
// Campos para a tabela DIM_APREENSOES
    LastValue("GestãoBens Procedimento Situação ID")
        AS "GestãoBens Procedimento Situação ID", // Texto com 4 caracteres no máximo (só tem quando SISCART)
    LastValue("GestãoBens Procedimento ID")
        AS "GestãoBens Procedimento ID", // Texto com 25 caracteres (sem registros faltantes)
    LastValue("GestãoBens Apreensão ID")
        AS "GestãoBens Apreensão ID", // Texto com 14 caracteres (só tem quando SISCART)
    LastValue("GestãoBens Apreensão Unidade Sigla")
        AS "GestãoBens Apreensão Unidade Sigla", // Texto com 30 caracteres (sem registros faltantes)
    LastValue("GestãoBens Apreensão Unidade Cidade")
        AS "GestãoBens Apreensão Unidade Cidade", // Texto com 23 caracteres (só tem quando SISCART)
    LastValue("GestãoBens Apreensão Unidade UF")
        AS "GestãoBens Apreensão Unidade UF", // Texto com 2 caracteres (sem registros faltantes)
    LastValue("GestãoBens Procedimento Número")
        AS "GestãoBens Procedimento Número", // Texto com 17 caracteres (sem registros faltantes)
    LastValue("GestãoBens Procedimento Ano")
        AS "GestãoBens Procedimento Ano", // Texto com 4 caracteres (sem registros faltantes)
    LastValue("GestãoBens Procedimento Cartório")
        AS "GestãoBens Procedimento Cartório", // Texto com 3 caracteres (só tem quando SISCART)
    LastValue("GestãoBens Procedimento Original")
        AS "GestãoBens Procedimento Original", // Texto com 32 caracteres (sem registros faltantes)
    LastValue("GestãoBens Procedimento Tipo")
        AS "GestãoBens Procedimento Tipo", // Texto com 3 caracteres (sem registros faltantes)
    LastValue("GestãoBens Apreensão Número")
        AS "GestãoBens Apreensão Número", // Texto com 10 dígitos (só tem quando SISCART)
    LastValue("GestãoBens Apreensão Usuário Matrícula")
        AS "GestãoBens Apreensão Usuário Matrícula", // Número Real
    LastValue("GestãoBens Apreensão Usuário Nome")
        AS "GestãoBens Apreensão Usuário Nome", // Texto com 49 caracteres
    LastValue("GestãoBens Item Número")
        AS "GestãoBens Item Número", // Texto com 12 caracteres (sem registros faltantes)
    LastValue("GestãoBens Item Lacre")
        AS "GestãoBens Item Lacre", // Texto Longo
    LastValue("GestãoBens Item Vínculo")
        AS "GestãoBens Item Vínculo", // Texto com 51 caracteres (só tem quando ePol)
    LastValue("GestãoBens Item Custódia")
        AS "GestãoBens Item Custódia", // Texto com 72 caracteres
    LastValue("GestãoBens Item Unidade Custódia")
        AS "GestãoBens Item Unidade Custódia", // Texto com 30 caracteres
    LastValue("GestãoBens Item Unidade UF Custódia")
        AS "GestãoBens Item Unidade UF Custódia", // Texto com 2 caracteres
    LastValue("GestãoBens Item Custódia Tipo")
        AS "GestãoBens Item Custódia Tipo", // Texto com 27 caracteres
    LastValue("GestãoBens Item Material ID")
        AS "GestãoBens Item Material ID", // Número Real (sem registros faltantes)
    LastValue("GestãoBens Item Material")
        AS "GestãoBens Item Material", // Texto Longo
    LastValue("GestãoBens Item Material Observação")
        AS "GestãoBens Item Material Observação", // Texto Longo
    LastValue("GestãoBens Item Material Observação ePol")
        AS "GestãoBens Item Material Observação ePol", // Texto Longo
    LastValue("GestãoBens Item Placa Veículo")
        AS "GestãoBens Item Placa Veículo", // Texto com 15 caracteres
    LastValue("GestãoBens Item Depósito")
        AS "GestãoBens Item Depósito", // Texto com 72 caracteres
    LastValue("GestãoBens Item Unidade e Depósito")
        AS "GestãoBens Item Unidade e Depósito", // Texto com 92 caracteres
    LastValue("GestãoBens Item Material Tipo")
        AS "GestãoBens Item Material Tipo", // Texto com 80 caracteres (20 registros distintos)
    LastValue("GestãoBens Item Material Classe")
        AS "GestãoBens Item Material Classe", // Texto com 132 caracteres (143 registros distintos)
    LastValue("GestãoBens Item Material Categoria")
        AS "GestãoBens Item Material Categoria", // Texto com 80 caracteres (20 registros distintos)
    LastValue("GestãoBens Item Material Subclasse Código")
        AS "GestãoBens Item Material Subclasse Código", // Texto com 8 caracteres (782 registros distintos)
    LastValue("GestãoBens Item Arma Marca")
        AS "GestãoBens Item Arma Marca", // Texto com 64 caracteres
    LastValue("GestãoBens Item Arma Espécie")
        AS "GestãoBens Item Arma Espécie", // Texto com 23 caracteres
    LastValue("GestãoBens Item Arma Modelo")
        AS "GestãoBens Item Arma Modelo", // Texto com 50 caracteres
    LastValue("GestãoBens Item Arma Calibre")
        AS "GestãoBens Item Arma Calibre", // Texto com 30 caracteres
    LastValue("GestãoBens Item Arma Série")
        AS "GestãoBens Item Arma Série", // Texto com 30 caracteres
    LastValue("GestãoBens Item Arma País")
        AS "GestãoBens Item Arma País", // Texto com 25 caracteres
    LastValue("GestãoBens Item Arma Importador")
        AS "GestãoBens Item Arma Importador", // Texto com 49 caracteres
    LastValue("GestãoBens Apreensão Detentor Nome")
        AS "GestãoBens Apreensão Detentor Nome", // Texto com 50 caracteres
    LastValue("GestãoBens Apreensão Detentor CPF")
        AS "GestãoBens Apreensão Detentor CPF", // Número Real
    LastValue("GestãoBens Item Laudo")
        AS "GestãoBens Item Laudo", // Texto com 50 caracteres
    LastValue("GestãoBens Item Localização ID")
        AS "GestãoBens Item Localização ID", // Número Real
    LastValue("GestãoBens Item Destinação")
        AS "GestãoBens Item Destinação", // Texto Longo com 1000 caracteres
    LastValue("GestãoBens Item Observação Depósito")
        AS "GestãoBens Item Observação Depósito", // Texto Longo com 1046 caracteres
    LastValue("GestãoBens Item Localização Interna")
        AS "GestãoBens Item Localização Interna", // Texto com 204 caracteres
    LastValue("GestãoBens Item Desmembramento Pai")
        AS "GestãoBens Item Desmembramento Pai", // Número Real
    LastValue("GestãoBens Procedimento Processo Número")
        AS "GestãoBens Procedimento Processo Número", // Texto com 34 caracteres
    LastValue("GestãoBens Procedimento Processo Seção")
        AS "GestãoBens Procedimento Processo Seção", // Texto com 99 caracteres
    LastValue("GestãoBens Procedimento Processo Tribunal")
        AS "GestãoBens Procedimento Processo Tribunal", // Texto com 49 caracteres
    LastValue("GestãoBens Procedimento Processo Órgão")
        AS "GestãoBens Procedimento Processo Órgão", // Texto com 121 caracteres
    LastValue("GestãoBens Procedimento Processo MPF")
        AS "GestãoBens Procedimento Processo MPF", // Número Real
    LastValue("GestãoBens Procedimento Incidência Penal Princ.")
        AS "GestãoBens Procedimento Incidência Penal Princ.", // Texto com 254 caracteres
    LastValue("GestãoBens Procedimento Situação")
        AS "GestãoBens Procedimento Situação", // Texto com 28 caracteres
    LastValue("GestãoBens Item Último Movimento")
        AS "GestãoBens Item Último Movimento", // Texto com 30 caracteres
    LastValue("Gestãobens Item Decisão")
        AS "Gestãobens Item Decisão", // Texto com 63 caracteres (sem registros faltantes)
    LastValue("Gestãobens Número SEI (Alienação SENAD)")
        AS "Gestãobens Número SEI (Alienação SENAD)" // Texto com 17 caracteres
FROM [$(vCarregaDIM_CASOS_APREENSAO_BENS)]
(qvd)
WHERE year("GestãoBens Item Data Apreensão") > 2021
    AND year("GestãoBens Item Data Apreensão") <= year(Today())
GROUP BY "GestãoBens Item ID";

// Remove os campos monetários brutos — substituídos pelos convertidos no LOAD externo
DROP FIELDS [_ValorEstimado], [_ValorEstimadoDeposito] FROM TEMP_TEMP_DIM_CASOS_APREENSAO_BENS;

// CALL StoreCsv('TEMP_TEMP_DIM_CASOS_APREENSAO_BENS', '$(vCaminhoTabelasTeste)');

TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Gravando TEMP_TEMP_DIM_CASOS_APREENSAO_BENS.csv;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;

TRACE >>> Gravando CSV TEMP_TEMP_DIM_CASOS_APREENSAO_BENS;
CALL StoreCsv('TEMP_TEMP_DIM_CASOS_APREENSAO_BENS', '$(vCaminhoTabelasCorpDicorNge)');

// NoConcatenate
