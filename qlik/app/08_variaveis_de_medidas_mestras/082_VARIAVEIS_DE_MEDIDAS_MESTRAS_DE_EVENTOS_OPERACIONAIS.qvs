// Título da medida mestra das operações homologadas com majorantes:
SET vTituloMedidaMestraOperacoesHomologadasComMajorantes = 
IF(
    // Se [Ano] selecionado mostrar vAnoSelecionado
    GetSelectedCount([Ano]) > 0,
    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        'Operações Homologadas Com Majorantes em ' & @(vAnoSelecionado),
        'Operações Homologadas Com Majorantes por Efetivo em ' & @(vAnoSelecionado),
        'Operações Homologadas Com Majorantes PF EM NÚMEROS em ' & @(vAnoSelecionado)
        ),
    IF(
        // Se [Mês] ou [Data] selecionado mostrar MIN([Ano]) a MAX([Ano])
        GetSelectedCount([Mês]) + GetSelectedCount([Data]) > 0,
        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
            'Operações Homologadas Com Majorantes de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Operações Homologadas Com Majorantes por Efetivo de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Operações Homologadas Com Majorantes PF EM NÚMEROS de ' & MIN([Ano]) & ' a '& MAX([Ano])
            ),
        IF(
            // Se [Ano da Deflagração] selecionado mostrar vAnoDeflagracaoSelecionado
            GetSelectedCount([Ano da Deflagração]) > 0,
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                'Operações Homologadas Com Majorantes em ' & @(vAnoDeflagracaoSelecionado),
                'Operações Homologadas Com Majorantes por Efetivo em ' & @(vAnoDeflagracaoSelecionado),
                'Operações Homologadas Com Majorantes PF EM NÚMEROS em ' & @(vAnoDeflagracaoSelecionado)
                ),
            // Se nada selecionado mostrar MIN([Ano da Deflagração]) a MAX([Ano da Deflagração])
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                'Operações Homologadas Com Majorantes de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
                'Operações Homologadas Com Majorantes por Efetivo de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
                'Operações Homologadas Com Majorantes PF EM NÚMEROS de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração])
                )
        )
    )
)
;

Call TratarExpansaoMacro(vTituloMedidaMestraOperacoesHomologadasComMajorantes);

// Título da medida mestra para KPI das operações homologadas com majorantes:
SET vTituloMedidaMestraKpiOperacoesHomologadasComMajorantes = 
