            $(vTemSelecaoDatasCalendario),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)SomAnterDtMesAno),
                $($(pRadical)SomAnterDtMesAno),
                $($(pRadical)SomAnterPfEmNumDtMesAno)
            ),
            IF(
                $(vTemSelecaoDatasContextoFato),
                PICK(
                    @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    $($(pRadical)SomAnterDtMesAnoCad),
                    $($(pRadical)SomAnterDtMesAnoCad),
                    $($(pRadical)SomAnterPfEmNumDtMesAnoCad)
                ),
                PICK(
                    @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    $($(pRadical)SomAnterAnoAtual),
                    $($(pRadical)SomAnterAnoAtual),
                    $($(pRadical)SomAnterPfEmNumAnoAtual)
                )
            )
        )
    ;

    CALL TratarExpansaoMacro(vMedidaMestraKpi$(pAlias)SomAnter);

    // vTituloMedidaMestra[Alias] - uses GetSelectedCount for Cadastro fields
    SET vTituloMedidaMestra$(pAlias) =
        IF(
            $(vTemSelecaoAnoCalendario),
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                '$(pTituloBase) em ' & @(vAnoSelecionado),
                '$(pTituloBase) por Efetivo em ' & @(vAnoSelecionado),
                '$(pTituloBase) PF EM NÚMEROS em ' & @(vAnoSelecionado)
            ),
            IF(
                $(vTemSelecaoMesOuDataCalendario),
                PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    '$(pTituloBase) de ' & MIN([Ano]) & ' a ' & MAX([Ano]),
                    '$(pTituloBase) por Efetivo de ' & MIN([Ano]) & ' a ' & MAX([Ano]),
                    '$(pTituloBase) PF EM NÚMEROS de ' & MIN([Ano]) & ' a ' & MAX([Ano])
                ),
                IF(
                    GetSelectedCount([Ano do Cadastro]) > 0,
                    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                        '$(pTituloBase) em ' & @(vAnoCadastroSelecionado),
                        '$(pTituloBase) por Efetivo em ' & @(vAnoCadastroSelecionado),
                        '$(pTituloBase) PF EM NÚMEROS em ' & @(vAnoCadastroSelecionado)
                    ),
