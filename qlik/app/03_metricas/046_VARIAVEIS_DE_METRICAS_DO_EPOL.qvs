SUB GerarPorEfetEmAnd(vRadical)
    SET vListaNomeVariavel =
$(vRadical)SemRelDtAprOpeCasoPorEfet|
$(vRadical)PorEfet
;
    SET vListaNumerador =
$($(vRadical)SemRelDtAprOpeCaso)|
$($(vRadical))
;
    SET vListaDenominador =
$(vServPJ)|$(vServPJ)
;
    FOR i = 1 TO 2
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativa('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i

    SET vListaNomeVariavel =
$(vRadical)SemRelDtAprOpeCasoPorEfetTot|
$(vRadical)PorEfetTot
;
    SET vListaDenominador =
$(vServPJTotal)|$(vServPJTotal)
;
    FOR i = 1 TO 2
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativa('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i
END SUB

