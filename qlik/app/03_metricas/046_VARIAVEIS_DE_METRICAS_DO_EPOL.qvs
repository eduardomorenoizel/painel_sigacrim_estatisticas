$(vPrefixoFiltro)[Proc. Tipo] = {'IPL'},[Proc. Situação] = {'Em Andamento'},[Data] = ,[Ano] = ,[Mês] = ,[Proc_Data Data Ano] = ,[Proc_Data Data Mês] = ,[Proc_Data Data] = |
$(vPrefixoFiltro)[Proc. Tipo] = {'IPL'},[Proc. Situação] = {'Em Andamento'},[Data] = ,[Ano] = ,[Mês] = ,[Proc_Data Data Ano] = ,[Proc_Data Data Mês] = ,[Proc_Data Data] =
;
END SUB

