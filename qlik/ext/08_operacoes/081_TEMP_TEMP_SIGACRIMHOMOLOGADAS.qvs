    HOUVE_TRAFICO_DROGAS, // Boleano Sim/Não
    MODAIS_UTILIZADOS, // Array separado por ";"
    BANCO_DADOS_INVADIDOS, // Boleano Sim/Não
    OB_BANCO_DADOS_INVADIDOS, // Texto
