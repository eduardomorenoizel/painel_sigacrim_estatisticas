                    'em ' & '@(=Year(Today()))',
                    'por Efetivo em ' & '@(=Year(Today()))',
                    'PF EM NÚMEROS em ' & '@(=Year(Today()))'
                    )
            )
        )
    )
)
;

Call TratarExpansaoMacro(vTituloCurtoMedidaMestraKpiOperacoesHomologadasComMajorantes);

