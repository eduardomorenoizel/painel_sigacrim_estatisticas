//-----------------------------------------------------------------------------------------------
// Funções para definição das variáveis de métricas
//-----------------------------------------------------------------------------------------------

//-----------------------------------------------------------------------------------------------
//   Função: 	 TratarExpansaoMacro                                                            
//   Objetivo:	 Permite chamada recursiva de variável sem calculo forçado
//                  (substitui '@' por '$' no conteudo da variavel)
//-----------------------------------------------------------------------------------------------
SUB TratarExpansaoMacro(vNomeVariavel)
	LET vNomeVariavel = Text(Replace(vNomeVariavel, '@', '$'));
END SUB
//-----------------------------------------------------------------------------------------------

//-----------------------------------------------------------------------------------------------
//   Função: 	 CriarVariavelContagem
//   Objetivo:	 Cria variáveis de contagem de conjuntos específicados
//               e substitui o '@' por '$' no conteudo da variavel para 
//               permitir a chamada recursiva de variável sem calculo forçado
//-----------------------------------------------------------------------------------------------
SUB CriarVariavelContagem(vNomeVariavel, vConjunto, vCampo)
    SET $(vNomeVariavel) = NUM(
        Count({< $(vConjunto) >} $(vCampo)),
        '#.##0'
    );
    LET vNomeVariavel = Text(Replace(vNomeVariavel, '@', '$'));
END SUB
//-----------------------------------------------------------------------------------------------

//-----------------------------------------------------------------------------------------------
//   Função: 	 CriarVariavelContagemSomaAnteriores
//   Objetivo:	 Cria variáveis de contagem de conjuntos específicados
//               e substitui o '@' por '$' no conteudo da variavel para 
//               permitir a chamada recursiva de variável sem calculo forçado
//-----------------------------------------------------------------------------------------------
SUB CriarVariavelContagemSomaAnteriores(vNomeVariavel, vConjunto, vCampo)
    SET $(vNomeVariavel) = NUM(
        RangeSum(Above(Count({< $(vConjunto) >} $(vCampo)),0,RowNo())) /
        Count({< $(vConjunto) >} Total $(vCampo))
    );
    LET vNomeVariavel = Text(Replace(vNomeVariavel, '@', '$'));
END SUB
//-----------------------------------------------------------------------------------------------

//-----------------------------------------------------------------------------------------------
//   Função: 	 CriarVariavelMedia
//   Objetivo:	 Cria variáveis de média de conjuntos específicados
//               e substitui o '@' por '$' no conteudo da variavel para 
//               permitir a chamada recursiva de variável sem calculo forçado
//-----------------------------------------------------------------------------------------------
SUB CriarVariavelMedia(vNomeVariavel, vConjunto, vCampo)
    SET $(vNomeVariavel) = NUM(
        Avg({< $(vConjunto) >} $(vCampo)),
        '#.##0'
    );
    LET vNomeVariavel = Text(Replace(vNomeVariavel, '@', '$'));
END SUB
//-----------------------------------------------------------------------------------------------

//-----------------------------------------------------------------------------------------------
//   Função: 	 CriarVariavelSoma
//   Objetivo:	 Cria variáveis de soma de conjuntos específicados
//               e substitui o '@' por '$' no conteudo da variavel para 
//               permitir a chamada recursiva de variável sem calculo forçado
//-----------------------------------------------------------------------------------------------
SUB CriarVariavelSoma(vNomeVariavel, vConjunto, vCampo)
    SET $(vNomeVariavel) = NUM(
        Sum({< $(vConjunto) >} $(vCampo)),
        '#.##0'
    );
    LET vNomeVariavel = Text(Replace(vNomeVariavel, '@', '$'));
END SUB
//-----------------------------------------------------------------------------------------------

//-----------------------------------------------------------------------------------------------
//   Função: 	 CriarVariavelSomaReais
//   Objetivo:	 Cria variáveis de soma de conjuntos específicados
//               e substitui o '@' por '$' no conteudo da variavel para 
//               permitir a chamada recursiva de variável sem calculo forçado
//-----------------------------------------------------------------------------------------------
SUB CriarVariavelSomaReais(vNomeVariavel, vConjunto, vCampo)
    SET $(vNomeVariavel) = NUM(
        Sum({< $(vConjunto) >} $(vCampo)),
        'R$ #.##0'
    );
    LET vNomeVariavel = Text(Replace(vNomeVariavel, '@', '$'));
END SUB
//-----------------------------------------------------------------------------------------------

//-----------------------------------------------------------------------------------------------
//   Função: 	 CriarVariavelSomaMi
//   Objetivo:	 Cria variáveis de soma em Milhões de Reais de conjuntos específicados
//               e substitui o '@' por '$' no conteudo da variavel para 
//               permitir a chamada recursiva de variável sem calculo forçado
//-----------------------------------------------------------------------------------------------
SUB CriarVariavelSomaMi(vNomeVariavel, vConjunto, vCampo)
    SET $(vNomeVariavel) = NUM(
        Sum({< $(vConjunto) >} $(vCampo)) / 1000000,
        'R$ #.##0,00 Mi'
    );
    LET vNomeVariavel = Text(Replace(vNomeVariavel, '@', '$'));
END SUB
//-----------------------------------------------------------------------------------------------

