//     AutoNumberHash128("GestãoBens Item Material Subclasse Código") AS [%SUBCLASSESKEY]
// RESIDENT TEMP_DIM_CASOS_APREENSAO_BENS;

// LEFT JOIN (TEMP_LINK_TABLE_APREENSOES_OPERACOES_CASOS_EVENTOS_APREENSOES_EXTERNAS_ESTRANGEIRO)
// LOAD DISTINCT
//     AutoNumberHash128("IPL") AS [%CASOSKEY],
//     AutoNumberHash128("Proc_Data ID") AS [%CASOSDATAKEY]
// RESIDENT TEMP_DIM_CASOS_DATA;

// LEFT JOIN (TEMP_LINK_TABLE_APREENSOES_OPERACOES_CASOS_EVENTOS_APREENSOES_EXTERNAS_ESTRANGEIRO)
// LOAD DISTINCT
//     AutoNumberHash128("IPL") AS [%CASOSKEY],
//     AutoNumberHash128(ID_OPERACAO) AS [%OPERACOESKEY]
// RESIDENT TEMP_SIGACrimHomologadas;

CONCATENATE(LINK_TABLE_APREENSOES_OPERACOES_CASOS)
Load
	*
RESIDENT TEMP_LINK_TABLE_APREENSOES_OPERACOES_CASOS_EVENTOS_APREENSOES_EXTERNAS_ESTRANGEIRO;

DROP TABLE TEMP_LINK_TABLE_APREENSOES_OPERACOES_CASOS_EVENTOS_APREENSOES_EXTERNAS_ESTRANGEIRO;

CALL StoreAndDrop('FATO_EVENTOS_APREENSOES', '$(vCaminhoTransformadosV3)');

