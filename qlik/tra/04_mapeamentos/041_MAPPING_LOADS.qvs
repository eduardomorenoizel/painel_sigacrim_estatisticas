FROM [$(vCaminhoTabelasCorpDicorNge)CONSOLIDADA - Bens Interesse e Descapitalização Izel.xlsx]
(ooxml, embedded labels, table is MapMaconhaIDs)
WHERE MATCH(IPO, 'Sim')
;

// Carrega os flags que indicam se o Item é Droga Sintética apreendida conforme taxinomia
