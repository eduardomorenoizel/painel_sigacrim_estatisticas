    PRE_PREVISÃO_CUMPRIMENTO_MEDIDAS_CAUTELARES_DESFAVOR_PESSOAS_PRERROGATIVA_FORO, // Boleano sim/nao
    IF (Len(Trim(PRE_GPOL_ST_AUX_GRUPO_TATICO)) > 0,
        'sim',
        'nao')
    AS PRE_GPOL_AUX_GRUPO_TATICO, // Array separado por ","
