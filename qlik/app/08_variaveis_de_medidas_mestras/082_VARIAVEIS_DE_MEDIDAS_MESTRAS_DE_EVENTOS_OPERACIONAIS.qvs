        + GetSelectedCount([Mês da Instauração])
        + GetSelectedCount([Data da Instauração])
        + GetSelectedCount([Ano do Relatório])
        + GetSelectedCount([Mês do Relatório])
        + GetSelectedCount([Data do Relatório]) > 0,
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vOperRelatAposDeflSomAnterDtMesAnoDefl),
        // números por efetivo
            $(vOperRelatAposDeflSomAnterDtMesAnoDefl),
        // números PF EM NÚMEROS
            $(vOperRelatAposDeflSomAnterPfEmNumDtMesAnoDefl)
            ),
//////////////////////// Se selecionado nada selecionado mostrar Ano Atual
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vOperRelatAposDeflSomAnterAnoAtual),
        // números por efetivo
            $(vOperRelatAposDeflSomAnterAnoAtual),
        // números PF EM NÚMEROS
            $(vOperRelatAposDeflSomAnterPfEmNumAnoAtual)
            )
    )
)
;

