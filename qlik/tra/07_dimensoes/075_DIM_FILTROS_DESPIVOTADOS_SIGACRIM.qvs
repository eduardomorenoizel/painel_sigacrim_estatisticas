LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'Colab Premiada'                       AS [Medidas Extraordinárias] RESIDENT TEMP_SIGACrimHomologadas WHERE Upper(COLAB_PREMIADA) = 'SIM';
Concatenate(DIM_MEDIDAS_EXTRAORDINARIAS)
LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'Quebra Dados Telemáticos'             AS [Medidas Extraordinárias] RESIDENT TEMP_SIGACrimHomologadas WHERE Upper(QUEBRA_DADOS_TELEMATICOS) = 'SIM';
Concatenate(DIM_MEDIDAS_EXTRAORDINARIAS)
LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'Interceptação Telefônica'             AS [Medidas Extraordinárias] RESIDENT TEMP_SIGACrimHomologadas WHERE LEN(TRIM(ID_SIS)) > 0;
Concatenate(DIM_MEDIDAS_EXTRAORDINARIAS)
LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'Quebra Dados Telefônicos'             AS [Medidas Extraordinárias] RESIDENT TEMP_SIGACrimHomologadas WHERE Upper(QUEBRA_DADOS_TELEFONICOS) = 'SIM';
Concatenate(DIM_MEDIDAS_EXTRAORDINARIAS)
