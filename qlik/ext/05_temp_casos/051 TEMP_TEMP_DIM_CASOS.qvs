FROM [$(vCarregaDIM_CASOS)]
(qvd)
GROUP BY "Proc. Identificação";

// Remove os campos monetários brutos — substituídos pelos convertidos no LOAD externo
DROP FIELDS [_ValorApurar], [_ValorApurado] FROM TEMP_TEMP_DIM_CASOS;

