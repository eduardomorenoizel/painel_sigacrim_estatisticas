// Título da medida mestra para KPI das prisoes cumpridas em operações em áreas de fronteira SÓ PF EM NÚMEROS:
SET vTituloMedidaMestraKpiPrisoesPreventivasCumpridasEmOperacoesEmAreasFronteiraSoPfEmNumeros = 
IF(
    // Se [Ano] selecionado mostrar vAnoSelecionado
    GetSelectedCount([Ano]) > 0,
    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        'Prisões Cumpridas em Áreas de Fronteira PF EM NÚMEROS em ' & @(vAnoSelecionado),
        'Prisões Cumpridas em Áreas de Fronteira PF EM NÚMEROS em ' & @(vAnoSelecionado),
        'Prisões Cumpridas em Áreas de Fronteira PF EM NÚMEROS em ' & @(vAnoSelecionado)
        ),
    IF(
        // Se [Mês] ou [Data] selecionado mostrar MIN([Ano]) a MAX([Ano])
        GetSelectedCount([Mês]) + GetSelectedCount([Data]) > 0,
        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
            'Prisões Cumpridas em Áreas de Fronteira PF EM NÚMEROS de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Prisões Cumpridas em Áreas de Fronteira PF EM NÚMEROS de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Prisões Cumpridas em Áreas de Fronteira PF EM NÚMEROS de ' & MIN([Ano]) & ' a '& MAX([Ano])
            ),
        IF(
            // Se [Ano da Deflagração] selecionado mostrar vAnoDeflagracaoSelecionado
            GetSelectedCount([Ano da Deflagração]) > 0,
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                'Prisões Cumpridas em Áreas de Fronteira PF EM NÚMEROS em ' & @(vAnoDeflagracaoSelecionado),
                'Prisões Cumpridas em Áreas de Fronteira PF EM NÚMEROS em ' & @(vAnoDeflagracaoSelecionado),
                'Prisões Cumpridas em Áreas de Fronteira PF EM NÚMEROS em ' & @(vAnoDeflagracaoSelecionado)
                ),
            IF(
                // Se [Mês da Deflagração] ou [Data da Deflagração] selecionado mostrar MIN([Ano da Deflagração]) a MAX([Ano da Deflagração])
                GetSelectedCount([Mês da Deflagração]) + GetSelectedCount([Data da Deflagração]) > 0,                        
                PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    'Prisões Cumpridas em Áreas de Fronteira PF EM NÚMEROS de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
                    'Prisões Cumpridas em Áreas de Fronteira PF EM NÚMEROS de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
                    'Prisões Cumpridas em Áreas de Fronteira PF EM NÚMEROS de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração])
                    ),
                // Se nada selecionado mostrar Ano Atual
                PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    'Prisões Cumpridas em Áreas de Fronteira PF EM NÚMEROS em ' & '@(=Year(Today()))',
                    'Prisões Cumpridas em Áreas de Fronteira PF EM NÚMEROS em ' & '@(=Year(Today()))',
                    'Prisões Cumpridas em Áreas de Fronteira PF EM NÚMEROS em ' & '@(=Year(Today()))'
                    )
            )
        )
    )
)
;

