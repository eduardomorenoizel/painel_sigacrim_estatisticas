TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Iniciando carga das variáveis das Medidas Mestras Operacionais;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;

// Variáveis de medidas mestras em cada tela do APP

/*******************************************************************************
    OBS: 
    - as variáveis de medida mestra que terminam sem 'Tot' deve ser usadas
    nos gráficos que usam dimensões de Unidade ou localizações etc.
    - as variáveis de medida mestra que terminam com 'Tot' deve ser usadas
    nos gráficos que usam dimensões de Data Mês Ano etc. DATA=*TOT
*******************************************************************************/

//-----------------------------------------------------------------------------------------------
// Medidas Mestras Operacionais
//-----------------------------------------------------------------------------------------------

//-----------------------------------------------------------------------------------------------
// Variáveis auxiliares de seleção de data (evita repetição de GetSelectedCount em todo o script)
//-----------------------------------------------------------------------------------------------
SET vTemSelecaoDatasContextoFato =
    GetSelectedCount([Ano da Deflagração])
    + GetSelectedCount([Mês da Deflagração])
    + GetSelectedCount([Data da Deflagração])
    + GetSelectedCount([Ano da Apreensão])
    + GetSelectedCount([Mês da Apreensão])
    + GetSelectedCount([Data da Apreensão])
    + GetSelectedCount([Proc_Data Data Ano])
    + GetSelectedCount([Proc_Data Data Mês])
    + GetSelectedCount([Proc_Data Data])
    + GetSelectedCount([Ano do Cadastro])
    + GetSelectedCount([Mês do Cadastro])
    + GetSelectedCount([Data do Cadastro])
    + GetSelectedCount([Ano da Instauração])
    + GetSelectedCount([Mês da Instauração])
    + GetSelectedCount([Data da Instauração])
    + GetSelectedCount([Ano do Relatório])
    + GetSelectedCount([Mês do Relatório])
    + GetSelectedCount([Data do Relatório]) > 0
;

SET vTemSelecaoDatasCalendario =
    GetSelectedCount([Ano])
    + GetSelectedCount([Mês])
    + GetSelectedCount([Data]) > 0
;

SET vTemSelecaoAnoCalendario =
    GetSelectedCount([Ano]) > 0
;

SET vTemSelecaoMesOuDataCalendario =
    GetSelectedCount([Mês]) + GetSelectedCount([Data]) > 0
;

SET vTemSelecaoAnoDeflagracao =
    GetSelectedCount([Ano da Deflagração]) > 0
;

SET vTemSelecaoMesOuDataDeflagracao =
    GetSelectedCount([Mês da Deflagração]) + GetSelectedCount([Data da Deflagração]) > 0
;

//-----------------------------------------------------------------------------------------------
// SUBs geradores - etapa 2 de parametrização
//-----------------------------------------------------------------------------------------------

SUB GerarMedidasMestrasDeflagracao6(pAlias, pRadical)
    // vMedidaMestra[Alias]
    SET vMedidaMestra$(pAlias) =
        IF(
            $(vTemSelecaoDatasContextoFato),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)DtMesAnoDefl),
                $($(pRadical)DtMesAnoDeflPorEfet),
                $($(pRadical)PfEmNumDtMesAnoDefl)
            ),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)DtMesAno),
                $($(pRadical)DtMesAnoPorEfet),
                $($(pRadical)PfEmNumDtMesAno)
            )
        )
    ;

    CALL TratarExpansaoMacro(vMedidaMestra$(pAlias));

    // vMedidaMestra[Alias]Tot
    SET vMedidaMestra$(pAlias)Tot =
        IF(
            $(vTemSelecaoDatasContextoFato),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)DtMesAnoDefl),
                $($(pRadical)DtMesAnoDeflPorEfetTot),
                $($(pRadical)PfEmNumDtMesAnoDefl)
            ),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)DtMesAno),
                $($(pRadical)DtMesAnoPorEfetTot),
                $($(pRadical)PfEmNumDtMesAno)
            )
        )
    ;

    CALL TratarExpansaoMacro(vMedidaMestra$(pAlias)Tot);

    // vMedidaMestra[Alias]SomAnter
    SET vMedidaMestra$(pAlias)SomAnter =
        IF(
            $(vTemSelecaoDatasContextoFato),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)SomAnterDtMesAnoDefl),
                $($(pRadical)SomAnterDtMesAnoDefl),
                $($(pRadical)SomAnterPfEmNumDtMesAnoDefl)
            ),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)SomAnterDtMesAno),
                $($(pRadical)SomAnterDtMesAno),
                $($(pRadical)SomAnterPfEmNumDtMesAno)
            )
        )
    ;

    CALL TratarExpansaoMacro(vMedidaMestra$(pAlias)SomAnter);

    // vMedidaMestraKpi[Alias]
    SET vMedidaMestraKpi$(pAlias) =
        IF(
            $(vTemSelecaoDatasCalendario),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)DtMesAno),
                $($(pRadical)DtMesAnoPorEfet),
                $($(pRadical)PfEmNumDtMesAno)
            ),
            IF(
                $(vTemSelecaoDatasContextoFato),
                PICK(
                    @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    $($(pRadical)DtMesAnoDefl),
                    $($(pRadical)DtMesAnoDeflPorEfet),
                    $($(pRadical)PfEmNumDtMesAnoDefl)
                ),
                PICK(
                    @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    $($(pRadical)AnoAtual),
                    $($(pRadical)AnoAtualPorEfet),
                    $($(pRadical)PfEmNumAnoAtual)
                )
            )
        )
    ;

    CALL TratarExpansaoMacro(vMedidaMestraKpi$(pAlias));

    // vMedidaMestraKpi[Alias]Tot
    SET vMedidaMestraKpi$(pAlias)Tot =
        IF(
            $(vTemSelecaoDatasCalendario),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)DtMesAno),
                $($(pRadical)DtMesAnoPorEfetTot),
                $($(pRadical)PfEmNumDtMesAno)
            ),
            IF(
                $(vTemSelecaoDatasContextoFato),
                PICK(
                    @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    $($(pRadical)DtMesAnoDefl),
                    $($(pRadical)DtMesAnoDeflPorEfetTot),
                    $($(pRadical)PfEmNumDtMesAnoDefl)
                ),
                PICK(
                    @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    $($(pRadical)AnoAtual),
                    $($(pRadical)AnoAtualPorEfetTot),
                    $($(pRadical)PfEmNumAnoAtual)
                )
            )
        )
    ;

    CALL TratarExpansaoMacro(vMedidaMestraKpi$(pAlias)Tot);

    // vMedidaMestraKpi[Alias]SomAnter
    SET vMedidaMestraKpi$(pAlias)SomAnter =
        IF(
            $(vTemSelecaoDatasCalendario),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)SomAnterDtMesAno),
                $($(pRadical)SomAnterDtMesAno),
                $($(pRadical)SomAnterPfEmNumDtMesAno)
            ),
            IF(
                $(vTemSelecaoDatasContextoFato),
                PICK(
                    @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    $($(pRadical)SomAnterDtMesAnoDefl),
                    $($(pRadical)SomAnterDtMesAnoDefl),
                    $($(pRadical)SomAnterPfEmNumDtMesAnoDefl)
                ),
                PICK(
                    @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    $($(pRadical)SomAnterAnoAtual),
                    $($(pRadical)SomAnterAnoAtual),
                    $($(pRadical)SomAnterPfEmNumAnoAtual)
                )
            )
        )
    ;

    CALL TratarExpansaoMacro(vMedidaMestraKpi$(pAlias)SomAnter);
END SUB

SUB GerarTitulosERodapesDeflagracao(pAlias, pTituloAbs, pTituloEfet, pTituloPf, pRadical)
    // vTituloMedidaMestra[Alias]
    SET vTituloMedidaMestra$(pAlias) =
        IF(
            $(vTemSelecaoAnoCalendario),
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                '$(pTituloAbs) em ' & @(vAnoSelecionado),
                '$(pTituloEfet) em ' & @(vAnoSelecionado),
                '$(pTituloPf) em ' & @(vAnoSelecionado)
            ),
            IF(
                $(vTemSelecaoMesOuDataCalendario),
                PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    '$(pTituloAbs) de ' & MIN([Ano]) & ' a ' & MAX([Ano]),
                    '$(pTituloEfet) de ' & MIN([Ano]) & ' a ' & MAX([Ano]),
                    '$(pTituloPf) de ' & MIN([Ano]) & ' a ' & MAX([Ano])
                ),
                IF(
                    $(vTemSelecaoAnoDeflagracao),
                    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                        '$(pTituloAbs) em ' & @(vAnoDeflagracaoSelecionado),
                        '$(pTituloEfet) em ' & @(vAnoDeflagracaoSelecionado),
                        '$(pTituloPf) em ' & @(vAnoDeflagracaoSelecionado)
                    ),
                    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                        '$(pTituloAbs) de ' & MIN([Ano da Deflagração]) & ' a ' & MAX([Ano da Deflagração]),
                        '$(pTituloEfet) de ' & MIN([Ano da Deflagração]) & ' a ' & MAX([Ano da Deflagração]),
                        '$(pTituloPf) de ' & MIN([Ano da Deflagração]) & ' a ' & MAX([Ano da Deflagração])
                    )
                )
            )
        )
    ;

    CALL TratarExpansaoMacro(vTituloMedidaMestra$(pAlias));

    // vTituloMedidaMestraKpi[Alias]
    SET vTituloMedidaMestraKpi$(pAlias) =
        IF(
            $(vTemSelecaoAnoCalendario),
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                '$(pTituloAbs) em ' & @(vAnoSelecionado),
                '$(pTituloEfet) em ' & @(vAnoSelecionado),
                '$(pTituloPf) em ' & @(vAnoSelecionado)
            ),
            IF(
                $(vTemSelecaoMesOuDataCalendario),
                PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    '$(pTituloAbs) de ' & MIN([Ano]) & ' a ' & MAX([Ano]),
                    '$(pTituloEfet) de ' & MIN([Ano]) & ' a ' & MAX([Ano]),
                    '$(pTituloPf) de ' & MIN([Ano]) & ' a ' & MAX([Ano])
                ),
                IF(
                    $(vTemSelecaoAnoDeflagracao),
                    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                        '$(pTituloAbs) em ' & @(vAnoDeflagracaoSelecionado),
                        '$(pTituloEfet) em ' & @(vAnoDeflagracaoSelecionado),
                        '$(pTituloPf) em ' & @(vAnoDeflagracaoSelecionado)
                    ),
                    IF(
                        $(vTemSelecaoMesOuDataDeflagracao),
                        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                            '$(pTituloAbs) de ' & MIN([Ano da Deflagração]) & ' a ' & MAX([Ano da Deflagração]),
                            '$(pTituloEfet) de ' & MIN([Ano da Deflagração]) & ' a ' & MAX([Ano da Deflagração]),
                            '$(pTituloPf) de ' & MIN([Ano da Deflagração]) & ' a ' & MAX([Ano da Deflagração])
                        ),
                        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                            '$(pTituloAbs) em ' & '@(=Year(Today()))',
                            '$(pTituloEfet) em ' & '@(=Year(Today()))',
                            '$(pTituloPf) em ' & '@(=Year(Today()))'
                        )
                    )
                )
            )
        )
    ;

    CALL TratarExpansaoMacro(vTituloMedidaMestraKpi$(pAlias));

    // vTituloCurtoMedidaMestraKpi[Alias]
    SET vTituloCurtoMedidaMestraKpi$(pAlias) =
        IF(
            $(vTemSelecaoAnoCalendario),
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                'em ' & @(vAnoSelecionado),
                'por Efetivo em ' & @(vAnoSelecionado),
                'PF EM NÚMEROS em ' & @(vAnoSelecionado)
            ),
            IF(
                $(vTemSelecaoMesOuDataCalendario),
                PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    'de ' & MIN([Ano]) & ' a ' & MAX([Ano]),
                    'por Efetivo de ' & MIN([Ano]) & ' a ' & MAX([Ano]),
                    'PF EM NÚMEROS de ' & MIN([Ano]) & ' a ' & MAX([Ano])
                ),
                IF(
                    $(vTemSelecaoAnoDeflagracao),
                    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                        'em ' & @(vAnoDeflagracaoSelecionado),
                        'por Efetivo em ' & @(vAnoDeflagracaoSelecionado),
                        'PF EM NÚMEROS em ' & @(vAnoDeflagracaoSelecionado)
                    ),
                    IF(
                        $(vTemSelecaoMesOuDataDeflagracao),
                        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                            'de ' & MIN([Ano da Deflagração]) & ' a ' & MAX([Ano da Deflagração]),
                            'por Efetivo de ' & MIN([Ano da Deflagração]) & ' a ' & MAX([Ano da Deflagração]),
                            'PF EM NÚMEROS de ' & MIN([Ano da Deflagração]) & ' a ' & MAX([Ano da Deflagração])
                        ),
                        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                            'em ' & '@(=Year(Today()))',
                            'por Efetivo em ' & '@(=Year(Today()))',
                            'PF EM NÚMEROS em ' & '@(=Year(Today()))'
                        )
                    )
                )
            )
        )
    ;

    CALL TratarExpansaoMacro(vTituloCurtoMedidaMestraKpi$(pAlias));

    // vRodapeMedidaMestra[Alias]
    SET vRodapeMedidaMestra$(pAlias) =
        'Ano anterior: '
        &
        IF(
            $(vTemSelecaoDatasContextoFato),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)AnoDeflAnterior),
                $($(pRadical)AnoDeflAnteriorPorEfet),
                $($(pRadical)PfEmNumAnoDeflAnterior)
            ),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)AnoAnterior),
                $($(pRadical)AnoAnteriorPorEfet),
                $($(pRadical)PfEmNumAnoAnterior)
            )
        )
    ;

    CALL TratarExpansaoMacro(vRodapeMedidaMestra$(pAlias));

    // vRodapeMedidaMestra[Alias]Tot
    SET vRodapeMedidaMestra$(pAlias)Tot =
        'Ano anterior: '
        &
        IF(
            $(vTemSelecaoDatasContextoFato),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)AnoDeflAnterior),
                $($(pRadical)AnoDeflAnteriorPorEfetTot),
                $($(pRadical)PfEmNumAnoDeflAnterior)
            ),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)AnoAnterior),
                $($(pRadical)AnoAnteriorPorEfetTot),
                $($(pRadical)PfEmNumAnoAnterior)
            )
        )
    ;

    CALL TratarExpansaoMacro(vRodapeMedidaMestra$(pAlias)Tot);
END SUB

SUB GerarMedidasSoPfKpi(pAlias, pTituloPf, pRadical, pTemTituloCurto)
    // vMedidaMestraKpi[Alias]SoPfEmNumeros
    SET vMedidaMestraKpi$(pAlias)SoPfEmNumeros =
        IF(
            $(vTemSelecaoDatasCalendario),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)PfEmNumDtMesAno),
                $($(pRadical)PfEmNumDtMesAno),
                $($(pRadical)PfEmNumDtMesAno)
            ),
            IF(
                $(vTemSelecaoDatasContextoFato),
                PICK(
                    @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    $($(pRadical)PfEmNumDtMesAnoDefl),
                    $($(pRadical)PfEmNumDtMesAnoDefl),
                    $($(pRadical)PfEmNumDtMesAnoDefl)
                ),
                PICK(
                    @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    $($(pRadical)PfEmNumAnoAtual),
                    $($(pRadical)PfEmNumAnoAtual),
                    $($(pRadical)PfEmNumAnoAtual)
                )
            )
        )
    ;

    CALL TratarExpansaoMacro(vMedidaMestraKpi$(pAlias)SoPfEmNumeros);

    // vTituloMedidaMestraKpi[Alias]SoPfEmNumeros
    SET vTituloMedidaMestraKpi$(pAlias)SoPfEmNumeros =
        IF(
            $(vTemSelecaoAnoCalendario),
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                '$(pTituloPf) em ' & @(vAnoSelecionado),
                '$(pTituloPf) em ' & @(vAnoSelecionado),
                '$(pTituloPf) em ' & @(vAnoSelecionado)
            ),
            IF(
                $(vTemSelecaoMesOuDataCalendario),
                PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    '$(pTituloPf) de ' & MIN([Ano]) & ' a ' & MAX([Ano]),
                    '$(pTituloPf) de ' & MIN([Ano]) & ' a ' & MAX([Ano]),
                    '$(pTituloPf) de ' & MIN([Ano]) & ' a ' & MAX([Ano])
                ),
                IF(
                    $(vTemSelecaoAnoDeflagracao),
                    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                        '$(pTituloPf) em ' & @(vAnoDeflagracaoSelecionado),
                        '$(pTituloPf) em ' & @(vAnoDeflagracaoSelecionado),
                        '$(pTituloPf) em ' & @(vAnoDeflagracaoSelecionado)
                    ),
                    IF(
                        $(vTemSelecaoMesOuDataDeflagracao),
                        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                            '$(pTituloPf) de ' & MIN([Ano da Deflagração]) & ' a ' & MAX([Ano da Deflagração]),
                            '$(pTituloPf) de ' & MIN([Ano da Deflagração]) & ' a ' & MAX([Ano da Deflagração]),
                            '$(pTituloPf) de ' & MIN([Ano da Deflagração]) & ' a ' & MAX([Ano da Deflagração])
                        ),
                        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                            '$(pTituloPf) em ' & '@(=Year(Today()))',
                            '$(pTituloPf) em ' & '@(=Year(Today()))',
                            '$(pTituloPf) em ' & '@(=Year(Today()))'
                        )
                    )
                )
            )
        )
    ;

    CALL TratarExpansaoMacro(vTituloMedidaMestraKpi$(pAlias)SoPfEmNumeros);

    IF $(pTemTituloCurto) = 1 THEN
        // vTituloCurtoMedidaMestraKpi[Alias]SoPfEmNumeros
        SET vTituloCurtoMedidaMestraKpi$(pAlias)SoPfEmNumeros =
            IF(
                $(vTemSelecaoAnoCalendario),
                PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    'PF EM NÚMEROS em ' & @(vAnoSelecionado),
                    'PF EM NÚMEROS em ' & @(vAnoSelecionado),
                    'PF EM NÚMEROS em ' & @(vAnoSelecionado)
                ),
                IF(
                    $(vTemSelecaoMesOuDataCalendario),
                    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                        'PF EM NÚMEROS de ' & MIN([Ano]) & ' a ' & MAX([Ano]),
                        'PF EM NÚMEROS de ' & MIN([Ano]) & ' a ' & MAX([Ano]),
                        'PF EM NÚMEROS de ' & MIN([Ano]) & ' a ' & MAX([Ano])
                    ),
                    IF(
                        $(vTemSelecaoAnoDeflagracao),
                        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                            'PF EM NÚMEROS em ' & @(vAnoDeflagracaoSelecionado),
                            'PF EM NÚMEROS em ' & @(vAnoDeflagracaoSelecionado),
                            'PF EM NÚMEROS em ' & @(vAnoDeflagracaoSelecionado)
                        ),
                        IF(
                            $(vTemSelecaoMesOuDataDeflagracao),
                            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                                'PF EM NÚMEROS de ' & MIN([Ano da Deflagração]) & ' a ' & MAX([Ano da Deflagração]),
                                'PF EM NÚMEROS de ' & MIN([Ano da Deflagração]) & ' a ' & MAX([Ano da Deflagração]),
                                'PF EM NÚMEROS de ' & MIN([Ano da Deflagração]) & ' a ' & MAX([Ano da Deflagração])
                            ),
                            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                                'PF EM NÚMEROS em ' & '@(=Year(Today()))',
                                'PF EM NÚMEROS em ' & '@(=Year(Today()))',
                                'PF EM NÚMEROS em ' & '@(=Year(Today()))'
                            )
                        )
                    )
                )
            )
        ;

        CALL TratarExpansaoMacro(vTituloCurtoMedidaMestraKpi$(pAlias)SoPfEmNumeros);
    ENDIF
END SUB

SUB GerarBlocoPorOperacaoHomologada(pAlias, pTituloBase, pRadical)
    // vMedidaMestra[Alias]
    SET vMedidaMestra$(pAlias) =
        IF(
            $(vTemSelecaoDatasContextoFato),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)DtMesAnoDefl),
                $($(pRadical)DtMesAnoDefl),
                $($(pRadical)PfEmNumDtMesAnoDefl)
            ),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)DtMesAno),
                $($(pRadical)DtMesAno),
                $($(pRadical)PfEmNumDtMesAno)
            )
        )
    ;

    CALL TratarExpansaoMacro(vMedidaMestra$(pAlias));

    // vMedidaMestraKpi[Alias]
    SET vMedidaMestraKpi$(pAlias) =
        IF(
            $(vTemSelecaoDatasCalendario),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)DtMesAno),
                $($(pRadical)DtMesAno),
                $($(pRadical)PfEmNumDtMesAno)
            ),
            IF(
                $(vTemSelecaoDatasContextoFato),
                PICK(
                    @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    $($(pRadical)DtMesAnoDefl),
                    $($(pRadical)DtMesAnoDefl),
                    $($(pRadical)PfEmNumDtMesAnoDefl)
                ),
                PICK(
                    @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    $($(pRadical)AnoAtual),
                    $($(pRadical)AnoAtual),
                    $($(pRadical)PfEmNumAnoAtual)
                )
            )
        )
    ;

    CALL TratarExpansaoMacro(vMedidaMestraKpi$(pAlias));

