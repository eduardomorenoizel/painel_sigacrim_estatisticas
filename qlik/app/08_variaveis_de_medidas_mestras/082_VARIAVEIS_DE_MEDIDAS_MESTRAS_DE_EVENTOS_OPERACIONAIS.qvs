        // numeros absolutos 
            $(vPrisPrevExpedEmOperEmAreaFrontDtMesAno),
        // números por efetivo
            $(vPrisPrevExpedEmOperEmAreaFrontDtMesAnoPorEfet),
        // números PF EM NÚMEROS
            $(vPrisPrevExpedEmOperEmAreaFrontPfEmNumDtMesAno)
