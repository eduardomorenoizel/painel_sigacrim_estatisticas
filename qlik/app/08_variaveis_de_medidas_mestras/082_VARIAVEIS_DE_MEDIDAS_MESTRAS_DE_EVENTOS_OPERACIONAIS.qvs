// Título da medida mestra das buscas cumpridas em operações:

SET vTituloMedidaMestraBuscasCumpridasEmOperacoes = 
IF(
    // Se [Ano] selecionado mostrar vAnoSelecionado
    GetSelectedCount([Ano]) > 0,
    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        'Buscas Cumpridas em Operações em ' & @(vAnoSelecionado),
        'Buscas Cumpridas em Operações por Efetivo em ' & @(vAnoSelecionado),
        'Buscas Cumpridas em Operações PF EM NÚMEROS em ' & @(vAnoSelecionado)
        ),
    IF(
        // Se [Mês] ou [Data] selecionado mostrar MIN([Ano]) a MAX([Ano])
        GetSelectedCount([Mês]) + GetSelectedCount([Data]) > 0,
        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
            'Buscas Cumpridas em Operações de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Buscas Cumpridas em Operações por Efetivo de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Buscas Cumpridas em Operações PF EM NÚMEROS de ' & MIN([Ano]) & ' a '& MAX([Ano])
            ),
		IF(
            // Se [Ano da Deflagração] selecionado mostrar vAnoDeflagracaoSelecionado
			GetSelectedCount([Ano da Deflagração]) > 0,
			PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
				'Buscas Cumpridas em Operações em ' & @(vAnoDeflagracaoSelecionado),
				'Buscas Cumpridas em Operações por Efetivo em ' & @(vAnoDeflagracaoSelecionado),
				'Buscas Cumpridas em Operações PF EM NÚMEROS em ' & @(vAnoDeflagracaoSelecionado)
				),
            // Se nada selecionado mostrar MIN([Ano da Deflagração]) a MAX([Ano da Deflagração])
			PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
				'Buscas Cumpridas em Operações de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
				'Buscas Cumpridas em Operações por Efetivo de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
				'Buscas Cumpridas em Operações PF EM NÚMEROS de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração])
				)
		)
	)
)
;

Call TratarExpansaoMacro(vTituloMedidaMestraBuscasCumpridasEmOperacoes);

// Título da medida mestra para KPI das buscas cumpridas em operações:
SET vTituloMedidaMestraKpiBuscasCumpridasEmOperacoes = 
IF(
    // Se [Ano] selecionado mostrar vAnoSelecionado
    GetSelectedCount([Ano]) > 0,
    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        'Buscas Cumpridas em Operações em ' & @(vAnoSelecionado),
        'Buscas Cumpridas em Operações por Efetivo em ' & @(vAnoSelecionado),
        'Buscas Cumpridas em Operações PF EM NÚMEROS em ' & @(vAnoSelecionado)
        ),
    IF(
        // Se [Mês] ou [Data] selecionado mostrar MIN([Ano]) a MAX([Ano])
        GetSelectedCount([Mês]) + GetSelectedCount([Data]) > 0,
        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
            'Buscas Cumpridas em Operações de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Buscas Cumpridas em Operações por Efetivo de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Buscas Cumpridas em Operações PF EM NÚMEROS de ' & MIN([Ano]) & ' a '& MAX([Ano])
            ),
        IF(
            // Se [Ano da Deflagração] selecionado mostrar vAnoDeflagracaoSelecionado
            GetSelectedCount([Ano da Deflagração]) > 0,
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                'Buscas Cumpridas em Operações em ' & @(vAnoDeflagracaoSelecionado),
                'Buscas Cumpridas em Operações por Efetivo em ' & @(vAnoDeflagracaoSelecionado),
                'Buscas Cumpridas em Operações PF EM NÚMEROS em ' & @(vAnoDeflagracaoSelecionado)
                ),
            IF(
                // Se [Mês da Deflagração] ou [Data da Deflagração] selecionado mostrar MIN([Ano da Deflagração]) a MAX([Ano da Deflagração])
                GetSelectedCount([Mês da Deflagração]) + GetSelectedCount([Data da Deflagração]) > 0,                        
                PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    'Buscas Cumpridas em Operações de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
                    'Buscas Cumpridas em Operações por Efetivo de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
                    'Buscas Cumpridas em Operações PF EM NÚMEROS de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração])
                    ),
                // Se nada selecionado mostrar Ano Atual
                PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    'Buscas Cumpridas em Operações em ' & '@(=Year(Today()))',
                    'Buscas Cumpridas em Operações por Efetivo em ' & '@(=Year(Today()))',
                    'Buscas Cumpridas em Operações PF EM NÚMEROS em ' & '@(=Year(Today()))'
                    )
            )
        )
    )
)
;

Call TratarExpansaoMacro(vTituloMedidaMestraKpiBuscasCumpridasEmOperacoes);

// Título curto da medida mestra para KPI das buscas cumpridas em operações:
SET vTituloCurtoMedidaMestraKpiBuscasCumpridasEmOperacoes = 
IF(
    // Se [Ano] selecionado mostrar vAnoSelecionado
    GetSelectedCount([Ano]) > 0,
    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        'em ' & @(vAnoSelecionado),
        'por Efetivo em ' & @(vAnoSelecionado),
        'PF EM NÚMEROS em ' & @(vAnoSelecionado)
        ),
    IF(
        // Se [Mês] ou [Data] selecionado mostrar MIN([Ano]) a MAX([Ano])
        GetSelectedCount([Mês]) + GetSelectedCount([Data]) > 0,
        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
            'de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'por Efetivo de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'PF EM NÚMEROS de ' & MIN([Ano]) & ' a '& MAX([Ano])
            ),
        IF(
            // Se [Ano da Deflagração] selecionado mostrar vAnoDeflagracaoSelecionado
            GetSelectedCount([Ano da Deflagração]) > 0,
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                'em ' & @(vAnoDeflagracaoSelecionado),
                'por Efetivo em ' & @(vAnoDeflagracaoSelecionado),
                'PF EM NÚMEROS em ' & @(vAnoDeflagracaoSelecionado)
                ),
            IF(
                // Se [Mês da Deflagração] ou [Data da Deflagração] selecionado mostrar MIN([Ano da Deflagração]) a MAX([Ano da Deflagração])
                GetSelectedCount([Mês da Deflagração]) + GetSelectedCount([Data da Deflagração]) > 0,                        
                PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    'de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
                    'por Efetivo de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
                    'PF EM NÚMEROS de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração])
                    ),
                // Se nada selecionado mostrar Ano Atual
                PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    'em ' & '@(=Year(Today()))',
                    'por Efetivo em ' & '@(=Year(Today()))',
                    'PF EM NÚMEROS em ' & '@(=Year(Today()))'
                    )
            )
        )
    )
)
;

Call TratarExpansaoMacro(vTituloCurtoMedidaMestraKpiBuscasCumpridasEmOperacoes);

// Rodapé da medida mestra das buscas cumpridas em operações:
SET vRodapeMedidaMestraBuscasCumpridasEmOperacoes = 
'Ano anterior: '
&
    IF(
    // Se selecionado [Ano da Deflagração], [Mês da Deflagração] ou [Data da Deflagração]
       GetSelectedCount([Ano da Deflagração])
        + GetSelectedCount([Mês da Deflagração])
        + GetSelectedCount([Data da Deflagração])
        + GetSelectedCount([Ano da Apreensão])
        + GetSelectedCount([Mês da Apreensão])
        + GetSelectedCount([Data da Apreensão])
        + GetSelectedCount([Proc_Data Data Ano])
        + GetSelectedCount([Proc_Data Data Mês])
        + GetSelectedCount([Proc_Data Data])
        + GetSelectedCount([Ano do Cadastro])
        + GetSelectedCount([Mês do Cadastro])
        + GetSelectedCount([Data do Cadastro])
        + GetSelectedCount([Ano da Instauração])
        + GetSelectedCount([Mês da Instauração])
        + GetSelectedCount([Data da Instauração])
        + GetSelectedCount([Ano do Relatório])
        + GetSelectedCount([Mês do Relatório])
        + GetSelectedCount([Data do Relatório]) > 0,
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // Valores absolutos 
            $(vBuscCumprEmOperAnoDeflAnterior),
        // Valores relativos ao efetivo
            $(vBuscCumprEmOperAnoDeflAnteriorPorEfet),
        // Valores PF EM NÚMEROS
            $(vBuscCumprEmOperPfEmNumAnoDeflAnterior)
            ),
//////////////////////// Se não selecionado [Ano da Deflagração], [Mês da Deflagração] ou [Data da Deflagração], mostrar Ano Anterior
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // Valores absolutos 
            $(vBuscCumprEmOperAnoAnterior),
        // Valores relativos ao efetivo
            $(vBuscCumprEmOperAnoAnteriorPorEfet),
        // Valores PF EM NÚMEROS
            $(vBuscCumprEmOperPfEmNumAnoAnterior)
            )
    )
;

Call TratarExpansaoMacro(vRodapeMedidaMestraBuscasCumpridasEmOperacoes);

