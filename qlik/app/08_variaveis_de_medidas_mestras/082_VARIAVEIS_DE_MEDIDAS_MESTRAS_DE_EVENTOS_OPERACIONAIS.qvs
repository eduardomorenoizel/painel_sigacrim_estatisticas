                    'Operações Homologadas Com Majorantes em ' & '@(=Year(Today()))',
                    'Operações Homologadas Com Majorantes por Efetivo em ' & '@(=Year(Today()))',
                    'Operações Homologadas Com Majorantes PF EM NÚMEROS em ' & '@(=Year(Today()))'
                    )
            )
        )
    )
)
;

Call TratarExpansaoMacro(vTituloMedidaMestraKpiOperacoesHomologadasComMajorantes);

// Título curto da medida mestra para KPI das operações homologadas com majorantes:
SET vTituloCurtoMedidaMestraKpiOperacoesHomologadasComMajorantes = 
IF(
