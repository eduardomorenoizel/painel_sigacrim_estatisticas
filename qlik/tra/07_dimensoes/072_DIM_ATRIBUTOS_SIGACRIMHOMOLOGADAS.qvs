// PAIS_COOPERACAO_POLICIAL, // Array separado por ";"
DIM_PAIS_COOPERACAO_POLICIAL:
LOAD
    AutoNumberHash128(ID_OPERACAO) AS [%ID_OPERACAO_KEY],
	SubField(PAIS_COOPERACAO_POLICIAL,';',IterNo()) AS PAIS_COOPERACAO_POLICIAL
RESIDENT TEMP_SIGACrimHomologadas
WHILE IterNo()<=SubStringCount(PAIS_COOPERACAO_POLICIAL,';')+1;

CALL StoreAndDrop('DIM_PAIS_COOPERACAO_POLICIAL', '$(vCaminhoTransformadosV3)');

