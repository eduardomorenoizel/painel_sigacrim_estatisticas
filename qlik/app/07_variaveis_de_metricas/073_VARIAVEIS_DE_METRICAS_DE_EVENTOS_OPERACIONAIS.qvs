// //==============================================================================================
// // FILTROS BASE
// //
// // Cada variável define o filtro de conjunto para um grupo de métricas.
// // São passados pelo NOME da variável aos SUBs, que expandem com $($(vNomeFiltro)).
// //==============================================================================================

SET vFBaseEven      = [Tipo do Fato] = {'Eventos Operacionais'};
SET vFEvenPf        = cd_tipo_evento_fk = {'pf'}, [Tipo do Fato] = {'Eventos Operacionais'};
SET vFEvenExt       = cd_tipo_evento_fk = {'externo'}, [Tipo do Fato] = {'Eventos Operacionais'};
SET vFEvenEst       = cd_tipo_evento_fk = {'estrangeiro'}, [Tipo do Fato] = {'Eventos Operacionais'};
SET vFEvenPfExec    = cd_tipo_evento_fk = {'pf'}, cd_tipo_participacao = {'execucao_direta'}, [Tipo do Fato] = {'Eventos Operacionais'};
SET vFEvenExtExec   = cd_tipo_evento_fk = {'externo'}, cd_tipo_participacao = {'execucao_direta'}, [Tipo do Fato] = {'Eventos Operacionais'};
SET vFEvenEstExec   = cd_tipo_evento_fk = {'estrangeiro'}, cd_tipo_participacao = {'execucao_direta'}, [Tipo do Fato] = {'Eventos Operacionais'};
SET vFEvenPfInfo    = cd_tipo_evento_fk = {'pf'}, cd_tipo_participacao = {'prestacao_info'}, [Tipo do Fato] = {'Eventos Operacionais'};
SET vFEvenExtInfo   = cd_tipo_evento_fk = {'externo'}, cd_tipo_participacao = {'prestacao_info'}, [Tipo do Fato] = {'Eventos Operacionais'};
SET vFEvenEstInfo   = cd_tipo_evento_fk = {'estrangeiro'}, cd_tipo_participacao = {'prestacao_info'}, [Tipo do Fato] = {'Eventos Operacionais'};
SET vFEvenPfApoi    = cd_tipo_evento_fk = {'pf'}, cd_tipo_participacao = {'prestacao_apoio'}, [Tipo do Fato] = {'Eventos Operacionais'};
SET vFEvenExtApoi   = cd_tipo_evento_fk = {'externo'}, cd_tipo_participacao = {'prestacao_apoio'}, [Tipo do Fato] = {'Eventos Operacionais'};
SET vFEvenEstApoi   = cd_tipo_evento_fk = {'estrangeiro'}, cd_tipo_participacao = {'prestacao_apoio'}, [Tipo do Fato] = {'Eventos Operacionais'};
SET vFEvenPr10Info  =     cd_tipo_participacao = {'prestacao_info'}, [Tipo do Fato] = {'Eventos Operacionais'};
// Eventos PF de execução direta em que a unidade participante (unidade do evento) é diferente da unidade do caso (IPL).
// [Evento em Unidade Diferente do Caso] é calculado no tra 068 (FATO_EVENTOS_OPERACIONAIS):
//   proposta artifacts/propostas/2026-10-27_FLAG_EVENTO_EM_UNIDADE_DIFERENTE_DO_CASO.md
// [Tipo da Data] = {'Evento Operacional'} não entra aqui: o GerarConjunto12Even já o acrescenta nas variantes por [Ano].
// Sem '>' no final: o SUB ainda acrescenta modificadores depois do filtro.
SET vFEvenPr10Exec  = cd_tipo_evento_fk = {'pf'}, cd_tipo_participacao = {'execucao_direta'}, [Evento em Unidade Diferente do Caso] = {'Sim'}, [Tipo do Fato] = {'Eventos Operacionais'};



//==============================================================================================
// FILTROS BASE APREENSÕES
//
// Cada variável define o filtro de conjunto para um grupo de métricas.
// São passados pelo NOME da variável aos SUBs, que expandem com $($(vNomeFiltro)).
//==============================================================================================

SET vFBaseApre      = [Tipo do Fato] = {'Eventos Apreensões'};
SET vFAprePf        = cd_tipo_evento_fk = {'pf'}, [Tipo do Fato] = {'Eventos Apreensões'};
SET vFApreExt       = cd_tipo_evento_fk = {'externo'}, [Tipo do Fato] = {'Eventos Apreensões'};
SET vFApreEst       = cd_tipo_evento_fk = {'estrangeiro'}, [Tipo do Fato] = {'Eventos Apreensões'};
SET vFAprePfExec    = cd_tipo_evento_fk = {'pf'}, cd_tipo_participacao = {'execucao_direta'}, [Tipo do Fato] = {'Eventos Apreensões'};
SET vFApreExtExec   = cd_tipo_evento_fk = {'externo'}, cd_tipo_participacao = {'execucao_direta'}, [Tipo do Fato] = {'Eventos Apreensões'};
SET vFApreEstExec   = cd_tipo_evento_fk = {'estrangeiro'}, cd_tipo_participacao = {'execucao_direta'}, [Tipo do Fato] = {'Eventos Apreensões'};
SET vFAprePfInfo    = cd_tipo_evento_fk = {'pf'}, cd_tipo_participacao = {'prestacao_info'}, [Tipo do Fato] = {'Eventos Apreensões'};
SET vFApreExtInfo   = cd_tipo_evento_fk = {'externo'}, cd_tipo_participacao = {'prestacao_info'}, [Tipo do Fato] = {'Eventos Apreensões'};
SET vFApreEstInfo   = cd_tipo_evento_fk = {'estrangeiro'}, cd_tipo_participacao = {'prestacao_info'}, [Tipo do Fato] = {'Eventos Apreensões'};
SET vFAprePfApoi    = cd_tipo_evento_fk = {'pf'}, cd_tipo_participacao = {'prestacao_apoio'}, [Tipo do Fato] = {'Eventos Apreensões'};
