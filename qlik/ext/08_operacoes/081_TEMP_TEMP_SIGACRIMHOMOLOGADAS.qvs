    PRE_QTD_PREVISTA_BUSCA_DOMICILIA_PRE_DEFLAGRADA, // Número Real
    PRE_PRISAO_TEMPORARIA_PRE_DEFLAGRADA, // Boleano sim/nao
    PRE_QTD_PREVISTA_PRISAO_TEMPORARIA_PRE_DEFLAGRADA, // Número Real
    PRE_PRISAO_PREVENTIVA_PRE_DEFLAGRADA, // Boleano sim/nao
    PRE_QTD_PREVISTA_PRISAO_PREVENTIVA_PRE_DEFLAGRADA, // Número Real
    PRE_PREVISAO_CUMPRIMENTO_SEQUESTRO_BENS_E_OUTRAS_MEDIDAS, // Boleano sim/nao
