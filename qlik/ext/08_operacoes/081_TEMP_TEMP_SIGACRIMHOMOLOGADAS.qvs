// FROM [lib://CORP_DICOR_COP/SIGACrim.qvd]
FROM [$(vCarregaSIGACrim)]
(qvd)
;


LEFT JOIN (TEMP_TEMP_TEMP_SIGACrimHomologadas)
LOAD DISTINCT
    $(vTransformaProcIdentificacaoEmCaso)
    AS IPL,
    "Proc. Identificação"
RESIDENT TEMP_TEMP_DIM_CASOS
WHERE "Proc. Tipo" <> 'NC'
;

// CALL StoreCsv('TEMP_TEMP_TEMP_SIGACrimHomologadas', '$(vCaminhoTabelasTeste)');


//  Rotina para corrigir o formato dos RE de Recuperação de Ativos,
//  que vem no array RE_SEQUESTRO, separados por ':', mas que estão fora
//  do formato padrão "AAAA.NNNNNNN".
// ------------------------------------------------------------
// 0) Variável de normalização (AAAA.NNNNNNN)
SET vFmtCaso =
Left(Replace(KeepChar(Trim($1),'0123456789.'),'.',''),4)
& '.'
& Right('0000000' & Mid(Replace(KeepChar(Trim($1),'0123456789.'),'.',''),5),7);

// ------------------------------------------------------------
// 1) Fonte INLINE + RowID DEFINIDO AQUI (uma vez por linha)
// Raw:
// LOAD
//     RowNo() as RowID,
//     Entrada
// INLINE [
// Entrada
// 2025.79967:2025001350:RE 2024.006741:RE 2024.0097700:2025.0036645  :2025.0024534 2025.0024574
// ];

// (Opcional) Remover quebras de linha caso venham no texto de origem
// RawNorm:
// LOAD
//     RowID,
//     Replace(Replace(Entrada, Chr(13), ''), Chr(10), '') as Entrada
// Resident Raw;
// DROP TABLE Raw;

// ------------------------------------------------------------
// 2) Explodir por ':' (preservando o ID_OPERACAO e a posição)
SplitColon:
LOAD
    ID_OPERACAO, // Chave primária com duplicidade
    IterNo() as PosColon,
    Trim(SubField(RE_SEQUESTRO_DESNORMALIZADA, ':', IterNo())) as Chunk
Resident TEMP_TEMP_TEMP_SIGACrimHomologadas
While Len(SubField(RE_SEQUESTRO_DESNORMALIZADA, ':', IterNo()));
// DROP TABLE RawNorm;

// ------------------------------------------------------------
// 3) Em cada "Chunk", pode haver duas strings separadas por espaço
Tokens:
LOAD
    ID_OPERACAO, // Chave primária com duplicidade
    PosColon,
    IterNo() as PosSpace,
    Trim(SubField(Chunk, ' ', IterNo())) as Token
Resident SplitColon
While Len(Trim(SubField(Chunk, ' ', IterNo())));
DROP TABLE SplitColon;

// ------------------------------------------------------------
// 4) Normalizar cada token em AAAA.NNNNNNN
Normalizado:
LOAD
    ID_OPERACAO, // Chave primária com duplicidade
    PosColon,
    PosSpace,
    Token as TokenOriginal,
    $(vFmtCaso(Token)) as AAAA_NNNNNNN
Resident Tokens
Where Len(KeepChar(Token,'0123456789')) >= 5; // 4 dígitos do ano + ≥1 do número
DROP TABLE Tokens;

// ------------------------------------------------------------
// 5) Rejuntar em UMA linha por ID_OPERACAO, preservando a ordem original
TEMP_TEMP_SIGACrimHomologadas:
LOAD
    ID_OPERACAO, // Chave primária com duplicidade
    Concat(AAAA_NNNNNNN, ':', PosColon*100 + PosSpace) as RE_SEQUESTRO
Resident Normalizado
Group By ID_OPERACAO;

//  Juntar com as outras colunas da tabela  TEMP_TEMP_TEMP_SIGACrimHomologadas
//  e eliminar a tabela temporária TEMP_TEMP_TEMP_SIGACrimHomologadas
Final:
RIGHT JOIN (TEMP_TEMP_SIGACrimHomologadas)
LOAD 
    ID_OPERACAO, // Chave primária com duplicidade
    IPL, // Texto     
    "Proc. Identificação",
    UF, // Texto
