/*----------------------------------------------------------------------------------------------
    SUB GerarListaCampo12(vCampo)
    Gera vListaCampo repetindo o campo 12 vezes (separado por |).
----------------------------------------------------------------------------------------------*/
SUB GerarListaCampo12(vCampo)
    SET vListaCampo =
$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)
;
END SUB

/*----------------------------------------------------------------------------------------------
    SUB ExecutarLoopContagem12
    Executa FOR loop de 12 itens chamando CriarVariavelContagem.
    Requer: vListaNomeVariavel, vListaConjunto, vListaCampo já definidos.
----------------------------------------------------------------------------------------------*/
SUB ExecutarLoopContagem12
    FOR i = 1 TO 12
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vConjunto = SubField('$(vListaConjunto)', '|', i);
        LET vCampo = SubField('$(vListaCampo)', '|', i);
        CALL CriarVariavelContagem('$(vNomeVariavel)', '$(vConjunto)', '$(vCampo)');
    NEXT i
END SUB

/*----------------------------------------------------------------------------------------------
    SUB ExecutarLoopSoma12
    Executa FOR loop de 12 itens chamando CriarVariavelSoma.
