TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Iniciando carga das variáveis das Métricas de Apreensões;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;

//-----------------------------------------------------------------------------------------------
// Variáveis de métricas de apreensões - versão parametrizada
//-----------------------------------------------------------------------------------------------
// Observações:
//      SomaAnteriores já é o Pareto
//      DtMesAno quando o cálculo inclui o "Tipo do Fato"
//      DtMesAnoApre quando o cálculo não inclui o "Tipo do Fato"
//-----------------------------------------------------------------------------------------------

//==============================================================================================
// SUBROUTINES AUXILIARES
//==============================================================================================

SUB GerarConjunto12Apre(vNomeFiltro)
    SET vListaConjunto =
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Apreensão'}|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Apreensão'}
                ,$(vConjApreDtMesAnoPfEmNumeros)|
                $($(vNomeFiltro))|
                $($(vNomeFiltro))
                ,$(vConjApreDtMesAnoAprePfEmNumeros)|
                [Ano] = {@(=Year(Today()))}
                ,$($(vNomeFiltro))
                ,[Tipo da Data] = {'Apreensão'}|
                [Ano] = {@(=Year(Today()))}
                ,$($(vNomeFiltro))
                ,[Tipo da Data] = {'Apreensão'}
                ,$(vConjApreDtMesAnoPfEmNumeros)|
                $($(vNomeFiltro))
                ,[Ano da Apreensão] = {@(=Year(Today()))}|
                $($(vNomeFiltro))
                ,[Ano da Apreensão] = {@(=Year(Today()))}
                ,$(vConjApreDtMesAnoAprePfEmNumeros)|
                [Ano] = {@(=MAX([Ano]-1))}
                ,$($(vNomeFiltro))
                ,[Tipo da Data] = {'Apreensão'}|
                [Ano] = {@(=MAX([Ano]-1))}
                ,$($(vNomeFiltro))
                ,[Tipo da Data] = {'Apreensão'}
                ,$(vConjApreDtMesAnoPfEmNumeros)|
                $($(vNomeFiltro))
                ,[Ano da Apreensão] = {@(=MAX([Ano da Apreensão]-1))}|
                $($(vNomeFiltro))
                ,[Ano da Apreensão] = {@(=MAX([Ano da Apreensão]-1))}
                ,$(vConjApreDtMesAnoAprePfEmNumeros)
                ;
END SUB

SUB GerarListaNomes12Apre(vRadical)
    SET vListaNomeVariavel =
$(vRadical)DtMesAno|
$(vRadical)PfEmNumDtMesAno|
$(vRadical)DtMesAnoApre|
$(vRadical)PfEmNumDtMesAnoApre|
$(vRadical)AnoAtual|
$(vRadical)PfEmNumAnoAtual|
$(vRadical)AnoApreAtual|
$(vRadical)PfEmNumAnoApreAtual|
$(vRadical)AnoAnterior|
$(vRadical)PfEmNumAnoAnterior|
$(vRadical)AnoApreAnterior|
$(vRadical)PfEmNumAnoApreAnterior
;
END SUB

SUB GerarListaNomesSomAnter12Apre(vRadical)
    SET vListaNomeVariavel =
$(vRadical)SomAnterDtMesAno|
$(vRadical)SomAnterPfEmNumDtMesAno|
$(vRadical)SomAnterDtMesAnoApre|
$(vRadical)SomAnterPfEmNumDtMesAnoApre|
$(vRadical)SomAnterAnoAtual|
$(vRadical)SomAnterPfEmNumAnoAtual|
$(vRadical)SomAnterAnoApreAtual|
$(vRadical)SomAnterPfEmNumAnoApreAtual|
$(vRadical)SomAnterAnoAnterior|
$(vRadical)SomAnterPfEmNumAnoAnterior|
$(vRadical)SomAnterAnoApreAnterior|
$(vRadical)SomAnterPfEmNumAnoApreAnterior
;
END SUB

SUB GerarListaCampo12(vCampo)
    SET vListaCampo =
$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)|$(vCampo)
;
END SUB

SUB GerarPorEfet6Reais(vRadical)
    SET vListaNomeVariavel =
$(vRadical)DtMesAnoPorEfet|
$(vRadical)DtMesAnoAprePorEfet|
$(vRadical)AnoAtualPorEfet|
$(vRadical)AnoApreAtualPorEfet|
$(vRadical)AnoAnteriorPorEfet|
$(vRadical)AnoApreAnteriorPorEfet
;
    SET vListaNumerador =
$($(vRadical)DtMesAno)|
$($(vRadical)DtMesAnoApre)|
$($(vRadical)AnoAtual)|
$($(vRadical)AnoApreAtual)|
$($(vRadical)AnoAnterior)|
$($(vRadical)AnoApreAnterior)
;
    SET vListaDenominador =
$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)
;
    FOR i = 1 TO 6
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativaReais('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i

    SET vListaNomeVariavel =
$(vRadical)DtMesAnoPorEfetTot|
$(vRadical)DtMesAnoAprePorEfetTot|
$(vRadical)AnoAtualPorEfetTot|
$(vRadical)AnoApreAtualPorEfetTot|
$(vRadical)AnoAnteriorPorEfetTot|
$(vRadical)AnoApreAnteriorPorEfetTot
;
    SET vListaDenominador =
$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)|$(vServPJTotal)
;
    FOR i = 1 TO 6
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativaReais('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i
END SUB

