// //==============================================================================================
// // FILTROS BASE
// //
// // Cada variável define o filtro de conjunto para um grupo de métricas.
// // São passados pelo NOME da variável aos SUBs, que expandem com $($(vNomeFiltro)).
// //==============================================================================================

// SET vFBaseEven      = [Tipo do Fato] = {'Eventos Operacionais'};
// SET vFAprePf     = cd_tipo_evento_fk = {'pf'}, [Tipo do Fato] = {'Eventos Apreensões'}>;
// SET vFApreExt       = cd_tipo_evento_fk = {'externo'}, [Tipo do Fato] = {'Eventos Apreensões'}>;
// SET vFApreEst   = cd_tipo_evento_fk = {'estrangeiro'}, [Tipo do Fato] = {'Eventos Apreensões'}>;
// SET vFCaptCGAP = [Unidade Sigla do Evento Operacional] = {"*GCAP*"}, cd_tipo_evento_fk = {'estrangeiro'}, [Tipo do Fato] = {'Eventos Apreensões'}>;
// SET vFCad       = [Tipo do Fato] = {'Eventos Operacionais'};

//==============================================================================================
// FILTROS BASE APREENSÕES
//
// Cada variável define o filtro de conjunto para um grupo de métricas.
// São passados pelo NOME da variável aos SUBs, que expandem com $($(vNomeFiltro)).
//==============================================================================================

SET vFBaseApre      = [Tipo do Fato] = {'Eventos Apreensões'};
SET vFAprePf     = cd_tipo_evento_fk = {'pf'}, [Tipo do Fato] = {'Eventos Apreensões'}>;
SET vFApreExt       = cd_tipo_evento_fk = {'externo'}, [Tipo do Fato] = {'Eventos Apreensões'}>;
SET vFApreEst   = cd_tipo_evento_fk = {'estrangeiro'}, [Tipo do Fato] = {'Eventos Apreensões'}>;

//==============================================================================================
// FILTROS BASE PRISÕES
//
// Cada variável define o filtro de conjunto para um grupo de métricas.
// São passados pelo NOME da variável aos SUBs, que expandem com $($(vNomeFiltro)).
//==============================================================================================

SET vFBaseCapt      = [Tipo do Fato] = {'Eventos Prisões'};
SET vFCaptPf     = cd_tipo_evento_fk = {'pf'}, cd_tipo_prisao -= {'FLAGRANTE'}, [Tipo do Fato] = {'Eventos Prisões'}>;
SET vFCaptExt       = cd_tipo_evento_fk = {'externo'}, [Tipo do Fato] = {'Eventos Prisões'}>;
SET vFCaptEst   = cd_tipo_evento_fk = {'estrangeiro'}, [Tipo do Fato] = {'Eventos Prisões'}>;
SET vFCaptCGAP = [Unidade Sigla do Evento Operacional] = {"*GCAP*"}, cd_tipo_evento_fk = {'estrangeiro'}, [Tipo do Fato] = {'Eventos Prisões'}>;

