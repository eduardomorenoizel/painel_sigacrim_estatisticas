// Título da medida mestra de buscas efetivas por operação:

SET vTituloMedidaMestraBuscasEfetivasPorOperacaoHomologada = 
IF(
    // Se [Ano] selecionado mostrar vAnoSelecionado
    GetSelectedCount([Ano]) > 0,
    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        'Buscas Efetivas por Operação em ' & @(vAnoSelecionado),
        'Buscas Efetivas por Operação em ' & @(vAnoSelecionado),
        'Buscas Efetivas por Operação PF EM NÚMEROS em ' & @(vAnoSelecionado)
        ),
    IF(
        // Se [Mês] ou [Data] selecionado mostrar MIN([Ano]) a MAX([Ano])
        GetSelectedCount([Mês]) + GetSelectedCount([Data]) > 0,
        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
            'Buscas Efetivas por Operação de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Buscas Efetivas por Operação de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Buscas Efetivas por Operação PF EM NÚMEROS de ' & MIN([Ano]) & ' a '& MAX([Ano])
            ),
		IF(
            // Se [Ano da Deflagração] selecionado mostrar vAnoDeflagracaoSelecionado
			GetSelectedCount([Ano da Deflagração]) > 0,
			PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
				'Buscas Efetivas por Operação em ' & @(vAnoDeflagracaoSelecionado),
				'Buscas Efetivas por Operação em ' & @(vAnoDeflagracaoSelecionado),
				'Buscas Efetivas por Operação PF EM NÚMEROS em ' & @(vAnoDeflagracaoSelecionado)
				),
            // Se nada selecionado mostrar MIN([Ano da Deflagração]) a MAX([Ano da Deflagração])
			PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
				'Buscas Efetivas por Operação de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
				'Buscas Efetivas por Operação de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
				'Buscas Efetivas por Operação PF EM NÚMEROS de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração])
				)
		)
	)
)
;

Call TratarExpansaoMacro(vTituloMedidaMestraBuscasEfetivasPorOperacaoHomologada);

