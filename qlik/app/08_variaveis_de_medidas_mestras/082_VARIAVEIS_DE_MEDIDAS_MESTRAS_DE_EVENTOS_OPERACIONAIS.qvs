// Título da medida mestra das operações Cadastradas:
SET vTituloMedidaMestraOperacoesCadastradas = 
IF(
    // Se [Ano] selecionado mostrar vAnoSelecionado
    GetSelectedCount([Ano]) > 0,
    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        'Operações Cadastradas em ' & @(vAnoSelecionado),
        'Operações Cadastradas por Efetivo em ' & @(vAnoSelecionado),
        'Operações Cadastradas PF EM NÚMEROS em ' & @(vAnoSelecionado)
        ),
    IF(
        // Se [Mês] ou [Data] selecionado mostrar MIN([Ano]) a MAX([Ano])
        GetSelectedCount([Mês]) + GetSelectedCount([Data]) > 0,
        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
            'Operações Cadastradas de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Operações Cadastradas por Efetivo de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Operações Cadastradas PF EM NÚMEROS de ' & MIN([Ano]) & ' a '& MAX([Ano])
            ),
        IF(
            // Se [Ano do Cadastro] selecionado mostrar vAnoCadastroSelecionado
            GetSelectedCount([Ano do Cadastro]) > 0,
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                'Operações Cadastradas em ' & @(vAnoCadastroSelecionado),
                'Operações Cadastradas por Efetivo em ' & @(vAnoCadastroSelecionado),
                'Operações Cadastradas PF EM NÚMEROS em ' & @(vAnoCadastroSelecionado)
                ),
            // Se nada selecionado mostrar MIN([Ano do Cadastro]) a MAX([Ano do Cadastro])
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                'Operações Cadastradas de ' & MIN([Ano do Cadastro]) & ' a '& MAX([Ano do Cadastro]),
                'Operações Cadastradas por Efetivo de ' & MIN([Ano do Cadastro]) & ' a '& MAX([Ano do Cadastro]),
                'Operações Cadastradas PF EM NÚMEROS de ' & MIN([Ano do Cadastro]) & ' a '& MAX([Ano do Cadastro])
                )
        )
    )
)
;

Call TratarExpansaoMacro(vTituloMedidaMestraOperacoesCadastradas);

