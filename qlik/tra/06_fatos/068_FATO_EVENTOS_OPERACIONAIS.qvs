TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Carregando FATO_EVENTOS_OPERACIONAIS;
TRACE >>>do TEMP_TABELAOEVENTOS_ID_UNIFICADO;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
///////////////////////////////////////////////////////////////
// Carga do BI DE ESTATÍSTICAS CRIMINAIS do NGE/COP/DICOR/PF //
// FATO EVENTOS DO tabelaoeventos.qvd COM LINK TABLE //
///////////////////////////////////////////////////////////////

// IPL -> Unidade Sigla do Caso (mesma regra do vCarregaUnidAreaDirCoorGeralDoCaso, tra 021)
MAP_IPL_UNIDADE_SIGLA_DO_CASO:
MAPPING LOAD DISTINCT
    IPL,
    Upper(Trim(
        IF(
            ApplyMap('MapIPLUnidadeFiccoGise', IPL, 0) > 0,
            ApplyMap('MapIPLUnidadeFiccoGise', IPL),
            "Proc. Unidade Exercício"
        )
    ))
RESIDENT TEMP_DIM_CASOS;

// === FATO_EVENTOS DO tabelaoeventos.qvd === //
FATO_EVENTOS_OPERACIONAIS:
LOAD DISTINCT
    AutoNumberHash128(id_ordem_original_evento) AS [%EVENTOSKEY],

///////////////////
// Sinalizadores //
///////////////////

    houve_apreensao, // Boleano sim/não
    houve_prisao, // Boleano sim/não

    // Unidade participante diferente da unidade do caso (IPL)
    IF(
        ApplyMap('MAP_IPL_UNIDADE_SIGLA_DO_CASO', IPL, '#SEM_CASO#') = '#SEM_CASO#',
        'Sem caso',
        IF(
            Upper(Trim(unidade_participante)) = ApplyMap('MAP_IPL_UNIDADE_SIGLA_DO_CASO', IPL),
            'Não',
            'Sim'
        )
    ) AS [Evento em Unidade Diferente do Caso], // Texto 'Sim' / 'Não' / 'Sem caso'


//////////////
// Métricas //
//////////////

        qtd_presos // Número inteiro

RESIDENT TEMP_TABELAOEVENTOS_ID_UNIFICADO;


// === LINK TABLE DA FATO_EVENTOS DO tabelaoeventos.qvd ===
// CONCATENATE(LINK_TABLE_APREENSOES_OPERACOES_CASOS)
TEMP_LINK_TABLE_APREENSOES_OPERACOES_CASOS_EVENTOS_OPERACIONAIS:
LOAD Distinct
    AutoNumberHash128("IPL") AS [%CASOSKEY],
    AutoNumberHash128(ID_OPERACAO) AS [%OPERACOESKEY],
//     NULL() AS [%APREENSOESKEY], 
//     NULL() AS AS [%CASOSDATAKEY],
    AutoNumberHash128(id_ordem_original_evento) AS [%EVENTOSKEY],
//     NULL() AS [%EVENTOSAPREENSOESKEY],
//
// COMENTADO PARA COLOCAR AS DATAS NAS DIMENSÕES
//     Date(PRE_DT_PREVISTA_DEFLAGRACAO) as "Data Prevista para Deflagração",
//     YEAR(date(PRE_DT_PREVISTA_DEFLAGRACAO)) as "Ano Previsto para Deflagração",
//     MONTH(date(PRE_DT_PREVISTA_DEFLAGRACAO)) as "Mês Previsto para Deflagração",
// //
//     Date(DT_DEFLAGRACAO) as "Data da Deflagração",
//     YEAR(date(DT_DEFLAGRACAO)) as "Ano da Deflagração",
//     MONTH(date(DT_DEFLAGRACAO)) as "Mês da Deflagração",
//     Num(MONTH(date(DT_DEFLAGRACAO))) as "Mês (Num) da Deflagração",
// //
//     date(DT_INICIO) as "Data de Início",
//     Date(DT_HOMOLOGACAO) as "Data da Homologação",
//     YEAR(date(DT_HOMOLOGACAO)) as "Ano da Homologação",
//     MONTH(date(DT_HOMOLOGACAO)) as "Mês da Homologação",
//
    Date(dt_evento) as Data,
    YEAR(date(dt_evento)) as "Ano",
    MONTH(date(dt_evento)) as "Mês",
    Num(MONTH(date(dt_evento))) as "Mês (Num)",
    'Evento Operacional' as "Tipo da Data",
//
    'Eventos Operacionais SIGACrim' as "Fonte",
    'Eventos Operacionais' AS "Tipo do Fato"
    
	,$(vCarregaUnidAreaDirCoorGeralDoEventoOperacional)

RESIDENT TEMP_TABELAOEVENTOS_ID_UNIFICADO;

