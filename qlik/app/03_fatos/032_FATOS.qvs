[FATO_APREENSOES]:
LOAD DISTINCT
    [%APREENSOESKEY]
    ,[É Caso_de_RE_de_Recuperação_de_Ativos]
    ,[É Caso_de_Operação]
    ,[É Item Destruição Ambiental]
    ,[É Item Interesse]
    ,[É Item Descapitalização]
    ,[DESCAP_CLASSE_LVL_1]
    ,[DESCAP_CLASSE_LVL_2]
    ,[É Item Epol 2024 (31/03/25)]
    ,[É Proc. Epol 2024 (31/03/25)]
    ,[É Cigarro Eletrônico]
    ,[GestãoBens Item Quantidade Apreendida]
    ,[GestãoBens Item Quantidade Apreendida Original]
    ,[GestãoBens Item Quantidade Normalizada Apreendida]
    ,[GestãoBens Item Valor Estimado]
    ,[GestãoBens Item Unidade Material]
    ,[GestãoBens Item Unidade Material Original]
    ,[GestãoBens Item Data Entrada Depósito]
    ,[GestãoBens Item Data Saída Depósito]
    ,[GestãoBens Item Quantidade em Depósito]
    ,[GestãoBens Item Quantidade Normalizada em Depósito]
    ,[GestãoBens Item Valor Estimado Em Depósito]
    ,[GestãoBens Item Idade em Depósito]
    ,[GestãoBens Item Idade Apreensão]
    ,[GestãoBens Item Idade Inteira em Depósito]
    ,[GestãoBens Item Idade Inteira Apreensão]
    ,[GestãoBens Item Idade Saída Depósito]
    ,[Item Quantidade Apreendida Cigarros (maços)]
    ,[Item Valor Estimado Cigarros]
    ,[Item Quantidade Apreendida Cocaína (kg)]
    ,[Item Quantidade Apreendida Maconha (kg)]
    ,[Item Quantidade Apreendida Maconha Erradicada (un)]
    ,[Item Quantidade Apreendida Drogas Sintéticas (un)]
    ,[Item Quantidade Apreendida Ecstasy (equivalente em comprimidos) (un)]
    ,[Item Quantidade Apreendida Produtos Químicos (un)]
    ,[Item Quantidade Apreendida Produtos Químicos (kg)]
    ,[Item Quantidade Apreendida Armas (un)]
    ,[Item Quantidade Apreendida Munições (un)]
    ,[Item Quantidade Apreendida Explosivos (un)]
    ,[Quantidade de Itens de Descapitalização Destruídos no Local]
    ,[GestãoBens Item Quantidade Apreendida Ajustada]
    ,[GestãoBens Item Unidade Material Ajustada]
    ,[Valor Total Descapitalização]
    ,[1 Valor Bens Imóveis Apreendidos/Sequestrados LVL1]
    ,[2 Valor Bens Móveis e Semoventes Apreendidos/Sequestrados LVL1]
    ,[1+2 Bens Imóveis Apreendidos/Sequestrados + Bens Móveis e Semoventes Apreendidos/Sequestrados LVL1]
    ,[3 Valor Criptoativos apreendidos/sequestrados LVL1]
    ,[4 Valor Títulos  Valores Mobiliários e Direitos Apreendidos/Sequestrados LVL1]
    ,[5 Valores Monetários Apreendidos/Sequestrados LVL1]
    ,[4+5 Valores Monetários, Títulos e Direitos Apreendidos/Sequestrados LVL1]
    ,[6 Valor Itens de Descapitalização Destruídos no Local LVL1]
    ,[1.1 Valor Imóveis LVL2]
    ,[2.1 Valor Pedras, Metais Preciosos, Joias e Obras de Arte LVL2]
    ,[2.2 Valor Semoventes LVL2]
    ,[2.3 Valor Veículos aéreos LVL2]
    ,[2.4 Valor Veículos aquáticos LVL2]
    ,[2.5 Valor Veículos terrestres LVL2]
    ,[2.6 Valor Outros bens Móvies LVL2]
    ,[2.7 Valor NÃO SE APLICA LVL2]
    ,[3.1 Valor Criptoativos LVL2]
    ,[4.1 Valor Títulos, Valores Mobiliários e Outros Direitos LVL2]
    ,[5.1 Valores Monetários em espécie LVL2]
    ,[5.2 Valores Monetários bloqueados via Bacenjud ou similares LVL2]
    ,[1+2+3+5.2 Sequestros e bloqueios (Sequestros Móveis e Imóveis + Criptoativos + Bloqueio Financeiro)]
    ,[VL_TETO_SEQUESTRO]
FROM [$(vCaminhoTransformadosV3)FATO_APREENSOES.qvd]
(qvd);

