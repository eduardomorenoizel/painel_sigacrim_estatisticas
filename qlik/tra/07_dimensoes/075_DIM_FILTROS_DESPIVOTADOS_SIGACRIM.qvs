///////////////////////////////////////////////////////////////
// Carga do BI DE ESTATÍSTICAS CRIMINAIS do NGE/COP/DICOR/PF //
// Tabelas despivotadas para construção dos filtros das operacoes //
// no painel //
///////////////////////////////////////////////////////////////

// ============================================================
// TABELAS DE FILTRO - UNPIVOT DOS BOOLEANOS
// Vinculadas a DIM_OPERACOES via AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY]
// Fonte: TEMP_SIGACrimHomologadas
// ============================================================

// --- Informações Gerais ---
DIM_INFORMACOES_GERAIS:
LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'Lavagem de Dinheiro'              AS [Informações Gerais] RESIDENT TEMP_SIGACrimHomologadas WHERE Upper(CRIME_LAVAGEM_DINHEIRO) = 'SIM';
Concatenate(DIM_INFORMACOES_GERAIS)
LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'Evasão de Divisas'                AS [Informações Gerais] RESIDENT TEMP_SIGACrimHomologadas WHERE Upper(EVASAO_DIVISAS) = 'SIM';
Concatenate(DIM_INFORMACOES_GERAIS)
LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'Crime Transnacional'              AS [Informações Gerais] RESIDENT TEMP_SIGACrimHomologadas WHERE Upper(CRIME_TRANSNACIONAL) = 'SIM';
Concatenate(DIM_INFORMACOES_GERAIS)
LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'Crime Interestadual'              AS [Informações Gerais] RESIDENT TEMP_SIGACrimHomologadas WHERE Upper(CRIME_INTERESTADUAL) = 'SIM';
Concatenate(DIM_INFORMACOES_GERAIS)
LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'Facção Criminosa'                 AS [Informações Gerais] RESIDENT TEMP_SIGACrimHomologadas WHERE Upper(FACCAO_CRIMINOSA) = 'SIM';
Concatenate(DIM_INFORMACOES_GERAIS)
LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'Área de Fronteira'                AS [Informações Gerais] RESIDENT TEMP_SIGACrimHomologadas WHERE Upper(AREA_FRONTEIRA) = 'SIM';
Concatenate(DIM_INFORMACOES_GERAIS)
LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'Grupo de Extermínio e/ou Milícia' AS [Informações Gerais] RESIDENT TEMP_SIGACrimHomologadas WHERE Upper(GRUPO_EXTERMINIO_MILICIA) = 'SIM';
Concatenate(DIM_INFORMACOES_GERAIS)
LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'Terra Indígena'                   AS [Informações Gerais] RESIDENT TEMP_SIGACrimHomologadas WHERE Upper(TERRA_INDIGENA) = 'SIM';
Concatenate(DIM_INFORMACOES_GERAIS)
LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'Unidade de Conservação'           AS [Informações Gerais] RESIDENT TEMP_SIGACrimHomologadas WHERE Upper(ENVOLVE_UNIDADE_CONSERVACAO) = 'SIM';
Concatenate(DIM_INFORMACOES_GERAIS)
LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'Área Prioritária'                 AS [Informações Gerais] RESIDENT TEMP_SIGACrimHomologadas WHERE Upper(ENVOLVE_AREA_PRIORITARIA) = 'SIM';
Concatenate(DIM_INFORMACOES_GERAIS)
LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'Criptoativo'                      AS [Informações Gerais] RESIDENT TEMP_SIGACrimHomologadas WHERE Upper(CRIPTOATIVO) = 'SIM';
Concatenate(DIM_INFORMACOES_GERAIS)
LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'Prometheus'                       AS [Informações Gerais] RESIDENT TEMP_SIGACrimHomologadas WHERE Upper(RELACIONADA_PROMETHEUS) = 'SIM';
Concatenate(DIM_INFORMACOES_GERAIS)
LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'Tentáculos'                       AS [Informações Gerais] RESIDENT TEMP_SIGACrimHomologadas WHERE Upper(TENTACULOS) = 'SIM';


// --- Medidas Extraordinárias ---
DIM_MEDIDAS_EXTRAORDINARIAS:
LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'RIF'                                  AS [Medidas Extraordinárias] RESIDENT TEMP_SIGACrimHomologadas WHERE Upper(UTILIZACAO_RIF) = 'SIM';
