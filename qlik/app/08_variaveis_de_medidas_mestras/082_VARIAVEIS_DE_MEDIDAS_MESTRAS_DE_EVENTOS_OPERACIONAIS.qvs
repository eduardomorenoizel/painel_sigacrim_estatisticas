        // números PF EM NÚMEROS
            $(vPrisExpedEmOperSomAnterPfEmNumDtMesAnoDefl)
            ),
//////////////////////// Se selecionado nada selecionado mostrar Ano Atual
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vPrisExpedEmOperSomAnterAnoAtual),
        // números por efetivo
            $(vPrisExpedEmOperSomAnterAnoAtual),
        // números PF EM NÚMEROS
            $(vPrisExpedEmOperSomAnterPfEmNumAnoAtual)
