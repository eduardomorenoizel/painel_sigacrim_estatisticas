// Carrega os fatores para normalizar as unidades de pesos e medidas para quilo e
// litro
MapFatorUnidade:
MAPPING LOAD * INLINE [
Unidade, Fator
KG, 1
GR, 1000
UN,	1
CD,	1
PC,	1
FL,	1
GF,	1
MD,	1
CO,	1
LI,	1
L,	1
CT,	1
ML,	1000
MC,	1
UM,	1
M³,	1
PT,	1
BL,	1
];

// Carrega as descrições das unidades de pesos e medidas para quilo e litro
MapUnidadeMedida:
MAPPING LOAD * INLINE [
DeUnidade, ParaUnidade
KG, kg
GR, kg
UN,	un
CD,	un
PC,	un
FL,	un
GF,	un
MD,	un
CO,	un
LI,	l
L,	l
CT,	un
ML,	l
MC,	un
UM,	un
M³,	m³
PT,	un
BL,	un
];


// Carrega o mapeamento de ID_OPERACAO a partir do id_ordem_original_evento,
// para substituir quando carregar o id_ordem_original_evento vindo da
// TEMP_DIM_CASOS_APREENSAO_BENS, inserido anteriormente através da inferência
// utilizando O intervalo IPL + DATA DA DEFLAGRAÇÃO
MapIdOrdemOriginalEventoIdOperacao:
MAPPING LOAD DISTINCT
	id_ordem_original_evento, // chave substituta vinda da ordem de carga do QVD original
    ID_OPERACAO
RESIDENT TEMP_TABELAOEVENTOS_ID_UNIFICADO
WHERE MATCH(tem_relacao_operacao, 1) > 0;

// Carrega os valores totais dos maquinários destruídos no local a partir de agregação
// realizada com os dados da tabela SIGACrimMaquinariosHom.qvd
TempMapApreensoes_Maquinario_SIGACRIM_2024:
LOAD
    ID_OPERACAO,
    sum(COALESCE(VL_TOTAL_MAQUINARIO,0)) AS "6 Valor Itens de Descapitalização Destruídos no Local LVL1"
FROM [lib://MD_SIGACRIM/SIGACrimMaquinariosHom.qvd]
(qvd)
GROUP BY ID_OPERACAO;

// Mapeia os valores totais dos maquinários destruídos no local a partir de agregação
// realizada com os dados da tabela SIGACrimMaquinariosHom.qvd para o ID_OPERACAO
MapApreensoes_Maquinario_SIGACRIM_2024:
MAPPING LOAD DISTINCT
    ID_OPERACAO,
    "6 Valor Itens de Descapitalização Destruídos no Local LVL1"
RESIDENT TempMapApreensoes_Maquinario_SIGACRIM_2024;

DROP TABLE TempMapApreensoes_Maquinario_SIGACRIM_2024;


// Carrega a tabela de domínio que atribui à Diretoria, à Coordenação-Geral e à Coordenação
// a respectiva área de atribuição investigativa.
TempMapArea_Diretoria_CG:
LOAD DISTINCT
    "Proc. Área de Atribuição",
    Diretoria,
    "Coordenação-Geral",
    Coordenação,
    Natureza
FROM [$(vCaminhoExtraidosV2)Area_Diretoria_CG.qvd]
(qvd);

// // Carrega somente o IPL (obtido a partir do Proc. Identificação) e os respectivos
// // "Proc. Área de Atribuição" e "Proc. Unidade Exercício" da DIM_CASOS
// TempMapIPLAreaCasoDiretCGUnid:
// LOAD DISTINCT
//     $(vTransformaProcIdentificacaoEmCaso) AS IPL,
//     "Proc. Área de Atribuição",
//  	"Proc. Unidade Exercício" // Texto com 427 caracteres (960 registros distintos)
// RESIDENT TEMP_DIM_CASOS;

// DROP TABLE TEMP_TEMP_DIM_CASOS;

// Junta as colunas Diretoria, Coordenação-Geral e Coordenação
LEFT JOIN (TempMapProcMigracaoMapIPLAreaCasoDiretCGUnidMapCasodeOperacaoDataDoRelatorio)
LOAD DISTINCT
    "Proc. Área de Atribuição",
    Diretoria,
    "Coordenação-Geral",
    Coordenação
RESIDENT TempMapArea_Diretoria_CG;

// Mapeamentos dos "Proc. Área de Atribuição", Diretoria, Coordenação-Geral, Coordenação e
// "Proc. Unidade Exercício" a partir do IPL da operação
MapIPLAreaCaso:
MAPPING LOAD DISTINCT
	IPL,
    "Proc. Área de Atribuição"
RESIDENT TempMapProcMigracaoMapIPLAreaCasoDiretCGUnidMapCasodeOperacaoDataDoRelatorio
WHERE LEN(TRIM("Proc. Área de Atribuição")) > 0;

[MapIPLCasoDiretoria]:
MAPPING LOAD Distinct
	IPL,
	"Diretoria"
RESIDENT TempMapProcMigracaoMapIPLAreaCasoDiretCGUnidMapCasodeOperacaoDataDoRelatorio
WHERE LEN(TRIM("Diretoria")) > 0;

[MapIPLCasoCG]:
MAPPING LOAD Distinct
	IPL,
	"Coordenação-Geral"
RESIDENT TempMapProcMigracaoMapIPLAreaCasoDiretCGUnidMapCasodeOperacaoDataDoRelatorio
WHERE LEN(TRIM("Coordenação-Geral")) > 0;

[MapIPLCasoUnidade]:
MAPPING LOAD Distinct
	IPL,
	"Proc. Unidade Exercício" // Texto com 427 caracteres (960 registros distintos)
RESIDENT TempMapProcMigracaoMapIPLAreaCasoDiretCGUnidMapCasodeOperacaoDataDoRelatorio
WHERE LEN(TRIM("Proc. Unidade Exercício")) > 0;;

// DROP TABLE TempMapIPLAreaCasoDiretCGUnid;

// Carrega os IPL de cada Operação
TempMapIPLUnidadeFiccoGise:
LOAD DISTINCT
	ID_OPERACAO,
    IPL
RESIDENT TEMP_TEMP_SIGACrimHomologadas;

// Junta a Unidade da Operação conforme inserido no Argus
RIGHT JOIN (TempMapIPLUnidadeFiccoGise)
LOAD DISTINCT
    ID AS ID_OPERACAO,
    Argus_unidade AS Unidade
FROM [$(vCaminhoTabelasCorpDicorNge)Ops Argus Izel.xlsx]
(ooxml, embedded labels, table is Sheet2)
WHERE LEN(TRIM(Argus_unidade)) > 0;

// Mapeia a Unidade da Operação conforme inserido no Argus ao IPL da Operação
// inserida no Argus
MapIPLUnidadeFiccoGise:
MAPPING LOAD DISTINCT
    IPL,
    Unidade AS Unidade_FICCO_GISE
RESIDENT TempMapIPLUnidadeFiccoGise;

DROP TABLE TempMapIPLUnidadeFiccoGise;


[AREADIRETORIAMapping]:
MAPPING LOAD Distinct
	"Proc. Área de Atribuição" AS "AREADIRETORIAMapping-DE",
	Diretoria as "AREADIRETORIAMapping-PARA"
RESIDENT TempMapArea_Diretoria_CG;

[AREACOORDENACAOGERALMapping]:
MAPPING LOAD Distinct
	"Proc. Área de Atribuição" AS "AREACOORDENACAOMapping-DE",
	"Coordenação-Geral" as "AREACOORDENACAOMapping-PARA"
RESIDENT TempMapArea_Diretoria_CG;

[PALASAREAATRIBUICAOMapping]:
MAPPING LOAD Distinct
	Natureza AS "PALASAREAATRIBUICAOMapping-DE",
	"Proc. Área de Atribuição" as "PALASAREAATRIBUICAOMapping-PARA"
RESIDENT TempMapArea_Diretoria_CG;

[PALASAREADIRETORIAMapping]:
MAPPING LOAD Distinct
	Natureza AS "AREADIRETORIAMapping-DE",
	Diretoria as "AREADIRETORIAMapping-PARA"
RESIDENT TempMapArea_Diretoria_CG;

[PALASAREACOORDENACAOGERALMapping]:
MAPPING LOAD Distinct
	Natureza AS "AREACOORDENACAOMapping-DE",
	"Coordenação-Geral" as "AREACOORDENACAOMapping-PARA"
RESIDENT TempMapArea_Diretoria_CG;

DROP TABLE TempMapArea_Diretoria_CG;

[REGIAOMapping]:
MAPPING LOAD * Inline [
REGIAOMapping-UF,REGIAOMapping-REGIAO
"AC","Norte",
"AL","Nordeste",
"AP","Norte",
"AM","Norte",
"BA","Nordeste",
"CE","Nordeste",
"DF","Centro-Oeste",
"ES","Sudeste",
"GO","Centro-Oeste",
"MA","Nordeste",
"MT","Centro-Oeste",
"MS","Centro-Oeste",
"MG","Sudeste",
"PA","Norte",
"PB","Nordeste",
"PR","Sul",
"PE","Nordeste",
"PI","Nordeste",
"RJ","Sudeste",
"RN","Nordeste",
"RS","Sul",
"RO","Norte",
"RR","Norte",
"SC","Sul",
"SP","Sudeste",
"SE","Nordeste",
"TO","Norte
];

// Corrige Unidade Superior de DPF/CAC/PR e DPF/GRA/PR, que estão vinculadas no
// DIM_UNIDADES à DPF/FIG/PR, inclusive muitas subunidades vinculadas diretamente
// à à DPF/FIG/PR sem nem ao menos passar pelas unidades superiores internas das
// próprias DPF/CAC/PR e DPF/GRA/PR

[TempMapCorrigeUnidSuperiorDpfCacDpfGra]:
LOAD DISTINCT
    "Unidade ID",
    "Unidade Responsável ID AJUSTADO"
FROM [$(vCaminhoTabelasCorpDicorNge)DPF-CAC-PR.xlsx]
(ooxml, embedded labels, table is Sheet1);

CONCATENATE(TempMapCorrigeUnidSuperiorDpfCacDpfGra)
LOAD DISTINCT
    "Unidade ID",
    "Unidade Responsável ID AJUSTADO"
FROM [$(vCaminhoTabelasCorpDicorNge)DPF-GRA-PR.xlsx]
(ooxml, embedded labels, table is Sheet1);


[MapCorrigeUnidSuperiorDpfCacDpfGra]:
MAPPING LOAD DISTINCT
    "Unidade ID",
    "Unidade Responsável ID AJUSTADO"
RESIDENT TempMapCorrigeUnidSuperiorDpfCacDpfGra;

DROP TABLE TempMapCorrigeUnidSuperiorDpfCacDpfGra;

// Muda as lotações dos 'LOTADOS' ou 'MISSIONARIOS' nas bases para as bases
// respectivas, para fins de contalibização do efetivo nas bases

[TempMapLotaServidoresnasBases]:
LOAD
    If(Matrícula = 181241,
    	18121,
        Matrícula)
    AS Matrícula,
    Unidade
FROM [$(vCaminhoTabelasCorpDicorNge)RECURSO_HUMANOS_BRUTOS_ARGOS.xlsx]
(ooxml, embedded labels, table is Sheet1)
WHERE MATCH(Unidade,'-') = 0
		AND MATCH(Cargo, 'AADM', 'APF', 'DPF', 'EPF', 'PCF', 'PPF') > 0
        AND MATCH(Status,'ATIVO') > 0
        AND MATCH(Matrícula, 24410) = 0
;

[MapLotaServidoresnasBases]:
MAPPING LOAD DISTINCT
    Matrícula,
    Unidade
RESIDENT TempMapLotaServidoresnasBases;

DROP TABLE TempMapLotaServidoresnasBases;

// Tabela de mapeamento para subclasse -> material id

MapSubClasseItemMaterialID:
Mapping Load DISTINCT
    "GestãoBens Item Material Subclasse Código",
    "GestãoBens Item Material ID"
FROM [$(vCaminhoExtraidosV2)TEMP_DIM_CASOS_APREENSAO_BENS.qvd]
(qvd);

// Cria tabela de mapeamento com IDs anonimizados únicos dos nomes
//  dos presos em eventos externos ou no estrangeiro
MapNomesAnonimizadosID:
MAPPING LOAD DISTINCT
    no_preso,
    'Preso_' & Num(RowNo(), '000000') AS NomeAnonimizado
RESIDENT TEMP_EVENTOS_PRISOES_EXTERNAS_ESTRANGEIRO
ORDER BY no_preso;

// Verifica se o CPF dos presos em eventos externos ou
// no estrangeiro é válido
TMP_CPF:
LOAD
    ds_cpf,
    KeepChar(ds_cpf, '0123456789') AS CPF_Limpo
RESIDENT TEMP_EVENTOS_PRISOES_EXTERNAS_ESTRANGEIRO;

TMP_CPF_VALIDO:
LOAD
    CPF_Limpo,
    IF(
        Len(CPF_Limpo) = 11
        AND CPF_Limpo <> Repeat(Left(CPF_Limpo,1), 11)

        // ======== DV1 ========
        AND Mod(
                (
                    Mid(CPF_Limpo,1,1)*10 +
                    Mid(CPF_Limpo,2,1)*9  +
                    Mid(CPF_Limpo,3,1)*8  +
                    Mid(CPF_Limpo,4,1)*7  +
                    Mid(CPF_Limpo,5,1)*6  +
                    Mid(CPF_Limpo,6,1)*5  +
                    Mid(CPF_Limpo,7,1)*4  +
                    Mid(CPF_Limpo,8,1)*3  +
                    Mid(CPF_Limpo,9,1)*2
                ) * 10,
                11
        ) = Mid(CPF_Limpo,10,1)

        // ======== DV2 ========
        AND Mod(
                (
                    Mid(CPF_Limpo,1,1)*11 +
                    Mid(CPF_Limpo,2,1)*10 +
                    Mid(CPF_Limpo,3,1)*9  +
                    Mid(CPF_Limpo,4,1)*8  +
                    Mid(CPF_Limpo,5,1)*7  +
                    Mid(CPF_Limpo,6,1)*6  +
                    Mid(CPF_Limpo,7,1)*5  +
                    Mid(CPF_Limpo,8,1)*4  +
                    Mid(CPF_Limpo,9,1)*3  +
                    (
                        Mod(
                            (
                                Mid(CPF_Limpo,1,1)*10 +
                                Mid(CPF_Limpo,2,1)*9  +
                                Mid(CPF_Limpo,3,1)*8  +
                                Mid(CPF_Limpo,4,1)*7  +
                                Mid(CPF_Limpo,5,1)*6  +
                                Mid(CPF_Limpo,6,1)*5  +
                                Mid(CPF_Limpo,7,1)*4  +
                                Mid(CPF_Limpo,8,1)*3  +
                                Mid(CPF_Limpo,9,1)*2
                            ) * 10,
                            11
                        )
                    ) * 2
                ) * 10,
                11
        ) = Mid(CPF_Limpo,11,1),

        1, 0
    ) AS CPF_Valido
RESIDENT TMP_CPF;

MapCPFValido:
MAPPING LOAD
    CPF_Limpo,
    CPF_Valido
RESIDENT TMP_CPF_VALIDO;

// Cria tabela de mapeamento com IDs anonimizados únicos dos CPFs
// dos presos em eventos externos ou no estrangeiro
MapCPFAnonimizadosID:
MAPPING
LOAD DISTINCT
    ds_cpf,
    IF(
    	APPLYMAP('MapCPFValido', KeepChar(ds_cpf,'0123456789'), 0) = 1,
		'CPF_' & Num(RowNo(), '000000'),
        'CPF inválido'
	) AS CPFAnonimizado
RESIDENT TEMP_EVENTOS_PRISOES_EXTERNAS_ESTRANGEIRO
ORDER BY ds_cpf;

DROP TABLE TMP_CPF;

DROP TABLE TMP_CPF_VALIDO;

// Tabela de mapeamento para identificar os eventos pf, ou seja, para fazer a deduplicação
// dos eventos para identificar a unidade



// Tabela de mapeamento de Caso de operação e data do relatório
MapCasodeOperacaoDataDoRelatorio:
MAPPING LOAD DISTINCT
    $(vTransformaProcIdentificacaoEmCaso) as Caso,
    "Proc. Data Relatório"
RESIDENT TempMapProcMigracaoMapIPLAreaCasoDiretCGUnidMapCasodeOperacaoDataDoRelatorio
WHERE LEN(TRIM("Proc. Data Relatório")) > 0;;

DROP TABLE TempMapProcMigracaoMapIPLAreaCasoDiretCGUnidMapCasodeOperacaoDataDoRelatorio;

