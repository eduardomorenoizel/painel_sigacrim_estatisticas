TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Carregando TEMP_TEMP_ARMAS_MUNICOES_DROGAS_FINAL_CGPRE;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
/*

Na planilha enviada pela CGPRE, para as apreensões de armas de 2026 ([PLANILHACGPRE] = 'Armas2026'), os registros vêm com
GestãoBens Item ID duplicados, pois a CGPRE altera os registros das apreensões do ePol, de formma cada linha tenha a
quantidade de apreensão igual a 01. Ou seja, se uma apreensão do ePol tem quantidade de apreensão igual a 07, na planilha
da CGPRE, haverá 07 linhas com quantidade de apreensão igual a 01.
Por isso, é necessário deduplicar os registros com base no "GestãoBens Item ID" para que cada linha contenha a quantidade
correta de apreensão, que seria igual à contagem das linhas de apreensão duplicadas para cada "GestãoBens Item ID".
Ou seja, cada GestãoBens Item ID deve ter uma única linha com a quantidade de apreensão igual à contagem das linhas 
duplicadas para esse GestãoBens Item ID.
Também, na planilha enviada pela CGPRE, para as apreensões de armas de 2026 ([PLANILHACGPRE] = 'Armas2026'), às vezes,
GestãoBens Item ID pode vir misturado com o Nº do Bem, e vice-versa, sendo necessário corrigir essa situação antes da 
deduplicação.
Na planilha enviada pela CGPRE, para as apreensões de munições de 2026 [PLANILHACGPRE] = 'Municoes2026', somente foram
tratados os itens 'Munição completa (não deflagrada)', porém alguns Itens vem preenchidos com
'Armas, explosivos, munições e materiais relacionados' que é a categoria e não Item, por isso é necessário corrigir os 
itens todos para 'Munição completa (não deflagrada)'.
*/

// 1) Carrega dados crus + timestamp numérico auxiliar para ordenação confiável
ARMAS_MUNICOES_DROGAS_FINAL_CGPRE_BASE:
LOAD
    "GestãoBens Item ID",
    "Item Tratado pela CGPRE",
    "Nº do Bem",
    "Proc. Identificação",
    "Unidade Sigla",
    "Data Apreensão",
    Timestamp#("Data Apreensão", 'DD/MM/YYYY hh:mm:ss') AS _DataNum,
    "Categoria Material",
    "Classe Material",
    Item,
    "Item Consolidado",
    Descrição,
    "Qtde Apreensão",
    "Qtde Apreensão Corrigida",
    Unidade,
    "Unidade Corrigida",
    PLANILHACGPRE,
    IPL // texto no formato "AAAA.NNNNNNN"
FROM [$(vCaminhoExtraidosV2)TEMP_TEMP_TEMP_ARMAS_MUNICOES_DROGAS_FINAL_CGPRE.qvd]
(qvd);

// 2) Corrige GestãoBens Item ID e Nº do Bem misturados para itens [PLANILHACGPRE] = 'Armas2026'

NOCONCATENATE
ARMAS_2026_DUPLICADAS:
LOAD
    IF(
    	Index("GestãoBens Item ID", '.') > 0,
        "Nº do Bem",
        "GestãoBens Item ID"
    ) AS "GestãoBens Item ID",
    "Item Tratado pela CGPRE",
    IF(
    	Index("Nº do Bem", '.') > 0,
        "Nº do Bem",
        "GestãoBens Item ID"
    ) AS "Nº do Bem",
    "Proc. Identificação",
    "Unidade Sigla",
    "Data Apreensão",
    _DataNum,
    "Categoria Material",
    "Classe Material",
    Item,
    "Item Consolidado",
    Descrição,
    "Qtde Apreensão",
    "Qtde Apreensão Corrigida",
    Unidade,
    "Unidade Corrigida",
    PLANILHACGPRE,
    IPL // texto no formato "AAAA.NNNNNNN"
RESIDENT ARMAS_MUNICOES_DROGAS_FINAL_CGPRE_BASE
Where [PLANILHACGPRE] = 'Armas2026';

// 3) Contagem de duplicadas para itens [PLANILHACGPRE] = 'Armas2026'

NOCONCATENATE
ARMAS_2026_DUPLICADAS_CONTADAS:
LOAD
    "GestãoBens Item ID",
    FirstValue("Item Tratado pela CGPRE") AS "Item Tratado pela CGPRE",
    FirstValue("Nº do Bem") AS "Nº do Bem",
    FirstValue("Proc. Identificação") AS "Proc. Identificação",
    FirstValue("Unidade Sigla") AS "Unidade Sigla",
    FirstValue("Data Apreensão") AS "Data Apreensão",
    FirstValue(_DataNum) AS _DataNum,
    FirstValue("Categoria Material") AS "Categoria Material",
    FirstValue("Classe Material") AS "Classe Material",
    FirstValue(Item) AS Item,
    FirstValue("Item Consolidado") AS "Item Consolidado",
    FirstValue(Descrição) AS Descrição,
    FirstValue("Qtde Apreensão") AS "Qtde Apreensão",
    FirstValue("Qtde Apreensão Corrigida") AS "Qtde Apreensão Corrigida",
    FirstValue(Unidade) AS Unidade,
    FirstValue("Unidade Corrigida") AS "Unidade Corrigida",
    FirstValue(PLANILHACGPRE) AS PLANILHACGPRE,
    FirstValue(IPL) AS IPL, // texto no formato "AAAA.NNNNNNN"
    COUNT("Qtde Apreensão") AS Contagem_Qtde_Apreensao
RESIDENT ARMAS_2026_DUPLICADAS
Group By [GestãoBens Item ID];

DROP TABLE ARMAS_2026_DUPLICADAS;

// 4) Deduplicação para itens [PLANILHACGPRE] = 'Armas2026'

NOCONCATENATE
ARMAS_2026_DEDUPLICADAS:
LOAD
    [GestãoBens Item ID],
    "Item Tratado pela CGPRE",
    "Nº do Bem",
    "Proc. Identificação",
    "Unidade Sigla",
    "Data Apreensão",
    _DataNum,
    "Categoria Material",
    "Classe Material",
    Item,
    "Item Consolidado",
    Descrição,
    IF(Contagem_Qtde_Apreensao > 1,
    	Contagem_Qtde_Apreensao,
        "Qtde Apreensão")
    AS "Qtde Apreensão",
    IF(Contagem_Qtde_Apreensao > 1,
    	Contagem_Qtde_Apreensao,
        "Qtde Apreensão Corrigida")
    AS "Qtde Apreensão Corrigida",
    Unidade,
    "Unidade Corrigida",
    PLANILHACGPRE,
    IPL // texto no formato "AAAA.NNNNNNN"
RESIDENT ARMAS_2026_DUPLICADAS_CONTADAS;

DROP TABLE ARMAS_2026_DUPLICADAS_CONTADAS;


// 5) Correção dos itens da [PLANILHACGPRE] = 'Municoes2026', pois em 2026 até 29/09/2026 a CGPRE só está tratando o Item 
// 'Munição completa (não deflagrada)' e muitas vezes o Item estava erroneamente preenchido com o nome da Categoria
// 'Armas, explosivos, munições e materiais relacionados'

NOCONCATENATE
MUNICOES_2026_ITENS_CORRIGIDOS:
LOAD
    "GestãoBens Item ID",
    "Item Tratado pela CGPRE",
    "Nº do Bem",
    "Proc. Identificação",
    "Unidade Sigla",
    "Data Apreensão",
    _DataNum,
    "Categoria Material",
    "Classe Material",
    'Munição completa (não deflagrada)'  AS Item,
    'Munição completa (não deflagrada)'  AS "Item Consolidado",
    Descrição,
    "Qtde Apreensão",
    "Qtde Apreensão Corrigida",
    Unidade,
    "Unidade Corrigida",
    PLANILHACGPRE,
    IPL // texto no formato "AAAA.NNNNNNN"
RESIDENT ARMAS_MUNICOES_DROGAS_FINAL_CGPRE_BASE
Where [PLANILHACGPRE] = 'Municoes2026';

NOCONCATENATE
ARMAS_MUNICOES_DROGAS_FINAL_CGPRE_BASE_CORRIGIDA:
LOAD
    *
RESIDENT ARMAS_MUNICOES_DROGAS_FINAL_CGPRE_BASE
WHERE MATCH([PLANILHACGPRE], 'Armas2026', 'Municoes2026') = 0;

DROP TABLE ARMAS_MUNICOES_DROGAS_FINAL_CGPRE_BASE;

CONCATENATE (ARMAS_MUNICOES_DROGAS_FINAL_CGPRE_BASE_CORRIGIDA)
LOAD
    *
RESIDENT ARMAS_2026_DEDUPLICADAS;

DROP TABLE ARMAS_2026_DEDUPLICADAS;

CONCATENATE (ARMAS_MUNICOES_DROGAS_FINAL_CGPRE_BASE_CORRIGIDA)
LOAD
    *
RESIDENT MUNICOES_2026_ITENS_CORRIGIDOS;

DROP TABLE MUNICOES_2026_ITENS_CORRIGIDOS;


TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Gravando para auditoria;
TRACE >>> ARMAS_MUNICOES_DROGAS_FINAL_CGPRE_BASE_CORRIGIDA.csv;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;

CALL StoreCsv('ARMAS_MUNICOES_DROGAS_FINAL_CGPRE_BASE_CORRIGIDA', '$(vCaminhoTabelasCorpDicorNge)');

// 6) Deduplica GestãoBens Item ID, mantendo apenas a primeira ocorrência
ARMAS_MUNICOES_DROGAS_FINAL_CGPRE_BASE_CORRIGIDA_DEDUPLICADA:
NOCONCATENATE
LOAD
    "GestãoBens Item ID",
    FirstValue("Item Tratado pela CGPRE") AS "Item Tratado pela CGPRE",
    FirstValue("Nº do Bem") AS "Nº do Bem",
    FirstValue("Proc. Identificação") AS "Proc. Identificação",
    FirstValue("Unidade Sigla") AS "Unidade Sigla",
    FirstValue("Data Apreensão") AS "Data Apreensão",
    FirstValue(_DataNum) AS _DataNum,
    FirstValue("Categoria Material") AS "Categoria Material",
    FirstValue("Classe Material") AS "Classe Material",
    FirstValue(Item) AS Item,
    FirstValue("Item Consolidado") AS "Item Consolidado",
    FirstValue(Descrição) AS Descrição,
    FirstValue("Qtde Apreensão") AS "Qtde Apreensão",
    FirstValue("Qtde Apreensão Corrigida") AS "Qtde Apreensão Corrigida",
    FirstValue(Unidade) AS Unidade,
    FirstValue("Unidade Corrigida") AS "Unidade Corrigida",
    FirstValue(PLANILHACGPRE) AS PLANILHACGPRE,
    FirstValue(IPL) AS IPL // texto no formato "AAAA.NNNNNNN"
RESIDENT ARMAS_MUNICOES_DROGAS_FINAL_CGPRE_BASE_CORRIGIDA
GROUP BY "GestãoBens Item ID";

DROP TABLE ARMAS_MUNICOES_DROGAS_FINAL_CGPRE_BASE_CORRIGIDA;

TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Gravando para auditoria;
TRACE >>> ARMAS_MUNICOES_DROGAS_FINAL_CGPRE_BASE_CORRIGIDA_DEDUPLICADA.csv;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;

CALL StoreCsv('ARMAS_MUNICOES_DROGAS_FINAL_CGPRE_BASE_CORRIGIDA_DEDUPLICADA', '$(vCaminhoTabelasCorpDicorNge)'); //

// Carrega TEMP_TEMP_ARMAS_MUNICOES_DROGAS_FINAL_CGPRE corrigindo o
// GestãoBens Item Material Subclasse Código de acordo com as regras:

// 1- se forem munições, não há diferença, pois os Item, Classe Material e 
//   Cateboria Material da CGPRE (Enielson) são iguais o da TNBIA, então
//   serão carregados os GestãoBens Item Material Subclasse Código da TNBIA
//   de acordo com os critérios abaixo:
//       Item = GestãoBens Item Material

// 2- se forem armas, serão utilizados os Material Classe da CGPRE, pois
//   foram reclassificados corretamente pela CGPRE (Enielson), já os Item e 
//   Categoria Material da CGPRE são iguais aos da TNBIA, então serão
//   carregados os GestãoBens Item Material Subclasse Código da TNBIA
//   de acordo com os critérios abaixo, pois há diferentes GestãoBens Item
//   Material Classe para um mesmo GestãoBens Item Material:
//       Item = GestãoBens Item Material e 
//       Classe Material = GestãoBens Item Material Classe e
//       Categoria Material = GestãoBens Item Material Categoria da TNBIA 

// 3- Se for drogas e os Item da CGPRE (Maria) for igual ao GestãoBens Item 
//   Material, serão carregados os GestãoBens Item Material Classe e
//   GestãoBens Item Material Categoria da TNBIA, pois estão mais corretos
//   do que os da CGPRE da seguinte maneira:
//       Item = GestãoBens Item Material

// 4- Se for drogas e os Item da CGPRE (Maria) for diferente do GestãoBens
//   Item Material, serão carregados os GestãoBens Item Material Subclasse
//   Código da TNBIA constantes na aba MapPlanilhaCgpreIDs da planilha
//   CONSOLIDADA - Bens Interesse e Descapitalização Izel.xlsx, da seguinte
//   forma:
//       Item = Item 
//       "GestãoBens Item Material Ajustado" = GestãoBens Item Material
//       "GestãoBens Item Material Classe Ajustada" = GestãoBens Item Material Classe
//       "GestãoBens Item Material Categoria Ajustada" = GestãoBens Item Material Categoria da TNBIA 
//
// Regras resumidas para correção do GestãoBens Item Material Subclasse Código:
//
// 1- Munições: não há diferença entre CGPRE e TNBIA para Item, Classe e
//    Categoria → JOIN na TNBIA por Item para obter Subclasse Código
//
// 2- Armas: Classe Material da CGPRE foi reclassificada corretamente →
//    JOIN na TNBIA por Item + Classe Material + Categoria Material
//    (disambiguação necessária pois há Classes distintas para um mesmo Item)
//
// 3- Drogas com Item igual ao GestãoBens Item Material da TNBIA →
//    JOIN na TNBIA por Item; Classe e Categoria da TNBIA substituem
//    os da CGPRE (mais corretos)
//
// 4- Drogas com Item diferente do GestãoBens Item Material da TNBIA →
//    JOIN no MapPlanilhaCgpreIDs (planilha CONSOLIDADA) por Item;
//    resultado em campos "Ajustados"

// =========================================================
// Regra 1: Munições
// JOIN na TNBIA apenas por Item
// =========================================================
NOCONCATENATE
TEMP_MUNICOES:
LOAD DISTINCT
    "GestãoBens Item ID",
    "Item Tratado pela CGPRE",
    "Categoria Material",
    "Classe Material",
    Item
RESIDENT ARMAS_MUNICOES_DROGAS_FINAL_CGPRE_BASE_CORRIGIDA_DEDUPLICADA
WHERE "Item Tratado pela CGPRE" = 'Munições';

LEFT JOIN (TEMP_MUNICOES)
LOAD
    "GestãoBens Item Material"           AS Item,
    "GestãoBens Item Material",
    "GestãoBens Item Material Classe",
    "GestãoBens Item Material Categoria",
    "GestãoBens Item Material Subclasse Código"
RESIDENT TEMP_TNBIA;

// =========================================================
// Regra 2: Armas
// JOIN na TNBIA por Item + Classe Material + Categoria Material
// (QlikSense usa todos os campos com mesmo nome como chave composta)
// =========================================================
NOCONCATENATE
TEMP_ARMAS:
LOAD DISTINCT
    "GestãoBens Item ID",
    "Item Tratado pela CGPRE",
    "Categoria Material",
    "Classe Material",
    Item
RESIDENT ARMAS_MUNICOES_DROGAS_FINAL_CGPRE_BASE_CORRIGIDA_DEDUPLICADA
WHERE "Item Tratado pela CGPRE" = 'Armas';

LEFT JOIN (TEMP_ARMAS)
LOAD
    "GestãoBens Item Material"           AS Item,
    "GestãoBens Item Material Classe"    AS [Classe Material],
    "GestãoBens Item Material Categoria" AS [Categoria Material],
    "GestãoBens Item Material",
    "GestãoBens Item Material Classe",
    "GestãoBens Item Material Categoria",
    "GestãoBens Item Material Subclasse Código"
RESIDENT TEMP_TNBIA;

// =========================================================
// Regras 3: Drogas
// Item da CGPRE igual ao GestãoBens Item Material da TNBIA
// Classe e Categoria da TNBIA (mais corretos) substituem os da CGPRE
// =========================================================
NOCONCATENATE
TEMP_DROGAS1:
LOAD DISTINCT
    "GestãoBens Item ID",
    "Item Tratado pela CGPRE",
    "Categoria Material",
    "Classe Material",
    Item
RESIDENT ARMAS_MUNICOES_DROGAS_FINAL_CGPRE_BASE_CORRIGIDA_DEDUPLICADA
WHERE "Item Tratado pela CGPRE" = 'Drogas';


INNER JOIN (TEMP_DROGAS1)
LOAD
    "GestãoBens Item Material"           AS Item,
    "GestãoBens Item Material",
    "GestãoBens Item Material Classe",
    "GestãoBens Item Material Categoria",
    "GestãoBens Item Material Subclasse Código"
RESIDENT TEMP_TNBIA;

// =========================================================
// Regras 4: Drogas
// Item da CGPRE diferente do GestãoBens Item Material da TNBIA
// Busca no MapPlanilhaCgpreIDs; campos com sufixo "Ajustado/a"
// =========================================================
NOCONCATENATE
TEMP_DROGAS2:
LOAD DISTINCT
    "GestãoBens Item ID",
    "Item Tratado pela CGPRE",
    "Categoria Material",
    "Classe Material",
    Item
RESIDENT ARMAS_MUNICOES_DROGAS_FINAL_CGPRE_BASE_CORRIGIDA_DEDUPLICADA
WHERE "Item Tratado pela CGPRE" = 'Drogas';


INNER JOIN (TEMP_DROGAS2)
LOAD DISTINCT
    Item,
    "GestãoBens Item Material Ajustado"           AS "GestãoBens Item Material" ,
    "GestãoBens Item Material Classe Ajustada"    AS "GestãoBens Item Material Classe" ,
    "GestãoBens Item Material Categoria Ajustada" AS "GestãoBens Item Material Categoria" ,
    "GestãoBens Item Material Subclasse Código Ajustada" AS "GestãoBens Item Material Subclasse Código"
FROM [$(vCaminhoTabelasCorpDicorNge)CONSOLIDADA - Bens Interesse e Descapitalização Izel.xlsx]
(ooxml, embedded labels, table is MapPlanilhaCgpreIDs);

// =========================================================
// Consolidação final: une as 4 categorias
// =========================================================
NoConcatenate
TEMP_TEMP_ARMAS_MUNICOES_DROGAS_FINAL_CGPRE:
LOAD * RESIDENT TEMP_MUNICOES;
DROP TABLE TEMP_MUNICOES;

CONCATENATE (TEMP_TEMP_ARMAS_MUNICOES_DROGAS_FINAL_CGPRE)
LOAD * RESIDENT TEMP_ARMAS;
DROP TABLE TEMP_ARMAS;

CONCATENATE (TEMP_TEMP_ARMAS_MUNICOES_DROGAS_FINAL_CGPRE)
LOAD * RESIDENT TEMP_DROGAS1;
DROP TABLE TEMP_DROGAS1;

CONCATENATE (TEMP_TEMP_ARMAS_MUNICOES_DROGAS_FINAL_CGPRE)
LOAD * RESIDENT TEMP_DROGAS2;
DROP TABLE TEMP_DROGAS2;


LEFT JOIN (TEMP_TEMP_ARMAS_MUNICOES_DROGAS_FINAL_CGPRE)
LOAD
    "GestãoBens Item ID",
    "Nº do Bem",
    "Proc. Identificação",
    "Unidade Sigla",
    "Data Apreensão",
    "Item Consolidado",
    "Descrição",
    "Qtde Apreensão",
    "Qtde Apreensão Corrigida",
    Unidade,
    "Unidade Corrigida",
    PLANILHACGPRE,
    IPL // texto no formato "AAAA.NNNNNNN"
RESIDENT ARMAS_MUNICOES_DROGAS_FINAL_CGPRE_BASE_CORRIGIDA_DEDUPLICADA;

DROP TABLE ARMAS_MUNICOES_DROGAS_FINAL_CGPRE_BASE_CORRIGIDA_DEDUPLICADA;

TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Gravando para auditoria;
TRACE >>> TEMP_TEMP_ARMAS_MUNICOES_DROGAS_FINAL_CGPRE.csv;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;

CALL StoreCsv('TEMP_TEMP_ARMAS_MUNICOES_DROGAS_FINAL_CGPRE', '$(vCaminhoTabelasCorpDicorNge)'); //

TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Concluída carga TEMP_TEMP_ARMAS_MUNICOES_DROGAS_FINAL_CGPRE;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;