$(vPrefixoFiltro)[Proc. Matéria Registro Especial] = {'Recuperação de ativos'},[Proc. Tipo] = {'RE'},[Proc. Situação] = {'Em Andamento'},$(vSemRelDatasApreeOperCasos)|
$(vPrefixoFiltro)[Proc. Matéria Registro Especial] = {'Recuperação de ativos'},[Proc. Tipo] = {'RE'},[Proc. Situação] = {'Em Andamento'},[Data] = ,[Ano] = ,[Mês] = |
