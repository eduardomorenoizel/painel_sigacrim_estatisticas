// Título da medida mestra das prisoes temporárias expedidas em operações:

SET vTituloMedidaMestraPrisoesTemporariasExpedidasEmOperacoes = 
IF(
    // Se [Ano] selecionado mostrar vAnoSelecionado
    GetSelectedCount([Ano]) > 0,
    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        'Prisões Temporárias Expedidas em Operações em ' & @(vAnoSelecionado),
        'Prisões Temporárias Expedidas em Operações por Efetivo em ' & @(vAnoSelecionado),
        'Prisões Temporárias Expedidas em Operações PF EM NÚMEROS em ' & @(vAnoSelecionado)
        ),
    IF(
        // Se [Mês] ou [Data] selecionado mostrar MIN([Ano]) a MAX([Ano])
        GetSelectedCount([Mês]) + GetSelectedCount([Data]) > 0,
        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
            'Prisões Temporárias Expedidas em Operações de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Prisões Temporárias Expedidas em Operações por Efetivo de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Prisões Temporárias Expedidas em Operações PF EM NÚMEROS de ' & MIN([Ano]) & ' a '& MAX([Ano])
            ),
		IF(
            // Se [Ano da Deflagração] selecionado mostrar vAnoDeflagracaoSelecionado
			GetSelectedCount([Ano da Deflagração]) > 0,
			PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
				'Prisões Temporárias Expedidas em Operações em ' & @(vAnoDeflagracaoSelecionado),
				'Prisões Temporárias Expedidas em Operações por Efetivo em ' & @(vAnoDeflagracaoSelecionado),
				'Prisões Temporárias Expedidas em Operações PF EM NÚMEROS em ' & @(vAnoDeflagracaoSelecionado)
				),
            // Se nada selecionado mostrar MIN([Ano da Deflagração]) a MAX([Ano da Deflagração])
			PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
				'Prisões Temporárias Expedidas em Operações de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
				'Prisões Temporárias Expedidas em Operações por Efetivo de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
				'Prisões Temporárias Expedidas em Operações PF EM NÚMEROS de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração])
				)
		)
	)
)
;

Call TratarExpansaoMacro(vTituloMedidaMestraPrisoesTemporariasExpedidasEmOperacoes);

