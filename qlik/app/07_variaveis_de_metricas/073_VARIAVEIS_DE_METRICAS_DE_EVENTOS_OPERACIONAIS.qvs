TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Iniciando carga das variáveis das Métricas dos Eventos Operacionais;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;

//-----------------------------------------------------------------------------------------------
// Variáveis de métricas dos eventos operacionais - versão parametrizada
//-----------------------------------------------------------------------------------------------
//
// Observações:
//      SomaAnteriores já é o Pareto
//      DtMesAno    = cálculo com [Tipo do Fato] (datas únicas, sem influência de outros fatos)
//      DtMesAnoEven = cálculo sem [Tipo do Fato] (correlacionado com os demais fatos)
//
// OBS:
//    - variáveis SEM sufixo 'Tot' → usadas em gráficos com dimensões de Unidade/localização etc.
//    - variáveis COM sufixo 'Tot' → usadas em gráficos com dimensões de Data Mês Ano etc.
//-----------------------------------------------------------------------------------------------

//==============================================================================================
// SUBROUTINES AUXILIARES
//==============================================================================================

/*----------------------------------------------------------------------------------------------
    SUB GerarConjunto12Even(vNomeFiltro)
    Gera vListaConjunto com 12 variantes usando padrão de datas do Evento Operacional.
    Parâmetro: vNomeFiltro = nome da variável que contém o filtro base.
    Uso:  SET vFBase = cd_tipo_participacao = {'prestacao_info'}, [Tipo do Fato] = {'Eventos Operacionais'};
          CALL GerarConjunto12Even('vFBase');
----------------------------------------------------------------------------------------------*/
SUB GerarConjunto12Even(vNomeFiltro)
    SET vListaConjunto =
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento Operacional'}|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento Operacional'}
                ,$(vConjEvenDtMesAnoPfEmNumeros)|
                $($(vNomeFiltro))|
                $($(vNomeFiltro))
                ,$(vConjEvenDtMesAnoEvenPfEmNumeros)|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento Operacional'}
                ,[Ano] = {@(=Year(Today()))}|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento Operacional'}
                ,[Ano] = {@(=Year(Today()))}
                ,$(vConjEvenDtMesAnoPfEmNumeros)|
                $($(vNomeFiltro))
                ,[Ano do Evento Operacional] = {@(=Year(Today()))}|
                $($(vNomeFiltro))
                ,[Ano do Evento Operacional] = {@(=Year(Today()))}
                ,$(vConjEvenDtMesAnoEvenPfEmNumeros)|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento Operacional'}
                ,[Ano] = {@(=MAX([Ano]-1))}|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento Operacional'}
                ,[Ano] = {@(=MAX([Ano]-1))}
                ,$(vConjEvenDtMesAnoPfEmNumeros)|
                $($(vNomeFiltro))
                ,[Ano do Evento Operacional] = {@(=MAX([Ano do Evento Operacional]-1))}|
                $($(vNomeFiltro))
                ,[Ano do Evento Operacional] = {@(=MAX([Ano do Evento Operacional]-1))}
                ,$(vConjEvenDtMesAnoEvenPfEmNumeros)
                ;
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarConjunto12EvenApre(vNomeFiltro)
    Gera vListaConjunto com 12 variantes usando padrão de datas do Evento Apreensão.
----------------------------------------------------------------------------------------------*/

SUB GerarConjunto12EvenApre(vNomeFiltro)
    SET vListaConjunto =
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento Apreensão'}|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento Apreensão'}
                ,$(vConjEvenApreDtMesAnoPfEmNumeros)|
                $($(vNomeFiltro))|
                $($(vNomeFiltro))
                ,$(vConjEvenApreDtMesAnoEvenAprePfEmNumeros)|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento Apreensão'}
                ,[Ano] = {@(=Year(Today()))}|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento Apreensão'}
                ,[Ano] = {@(=Year(Today()))}
                ,$(vConjEvenApreDtMesAnoPfEmNumeros)|
                $($(vNomeFiltro))
                ,[Ano do Evento Apreensão] = {@(=Year(Today()))}|
                $($(vNomeFiltro))
                ,[Ano do Evento Apreensão] = {@(=Year(Today()))}
                ,$(vConjEvenApreDtMesAnoEvenAprePfEmNumeros)|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento Apreensão'}
                ,[Ano] = {@(=MAX([Ano]-1))}|
                $($(vNomeFiltro))
                ,[Tipo da Data] = {'Evento Apreensão'}
                ,[Ano] = {@(=MAX([Ano]-1))}
                ,$(vConjEvenApreDtMesAnoPfEmNumeros)|
                $($(vNomeFiltro))
                ,[Ano do Evento Apreensão] = {@(=MAX([Ano do Evento Apreensão]-1))}|
                $($(vNomeFiltro))
                ,[Ano do Evento Apreensão] = {@(=MAX([Ano do Evento Apreensão]-1))}|
                ,$(vConjEvenApreDtMesAnoEvenAprePfEmNumeros)
                ;
END SUB

/*----------------------------------------------------------------------------------------------
