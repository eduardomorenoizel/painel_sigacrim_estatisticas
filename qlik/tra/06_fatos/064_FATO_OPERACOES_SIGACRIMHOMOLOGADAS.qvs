TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Carregando FATO_OPERACOES do TEMP_SIGACrimHomologadas;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
///////////////////////////////////////////////////////////////
// Carga do BI DE ESTATÍSTICAS CRIMINAIS do NGE/COP/DICOR/PF //
// FATO OPERACOES DO SIGACrimHomologadas 2024 COM LINK TABLE //
///////////////////////////////////////////////////////////////

// === FATO_OPERACOES DO SIGACrimHomologadas === //
FATO_OPERACOES:
LOAD DISTINCT
    AutoNumberHash128(ID_OPERACAO) AS [%OPERACOESKEY],

//////////////// comentado pois incluído no [%KEY] ////////////////
    // IPL AS Caso,
    // "Proc. Identificação",
    // ID_OPERACAO,
    // date(DT_INICIO) as DT_INICIO,
    // Date(DT_HOMOLOGACAO) as DT_HOMOLOGACAO,
    // YEAR(date(DT_HOMOLOGACAO)) as DT_ANO_HOMOLOGACAO,
    // MONTH(date(DT_HOMOLOGACAO)) as DT_MES_HOMOLOGACAO,
    // Date(DT_DEFLAGRACAO) as DT_DEFLAGRACAO,
    // YEAR(date(DT_DEFLAGRACAO)) as DT_ANO_DEFLAGRACAO,
    // MONTH(date(DT_DEFLAGRACAO)) as DT_MES_DEFLAGRACAO,

///////////////////
// Sinalizadores //
///////////////////

    HOUVE_FASE_OPERACAO_ANTERIOR, // Boleano Sim/Não
    HOUVE_COOPERACAO_POLICIAL, // Boleano Sim/Não
    HOUVE_COOPERACAO_JURIDICA, // Boleano Sim/Não
    UTILIZACAO_RIF, // Boleano Sim/Não
    GEOPROCESSAMENTO, // Boleano sim/nao
    MATERIAL_GENETICO, // Boleano Sim/Não
    AUXILIO_ORGAO_EXTERNO_INVESTIGACAO, // Boleano Sim/Não - NOVO
    COLAB_PREMIADA, // Boleano sim/nao
    QUEBRA_DADOS_TELEMATICOS, // Boleano sim/nao
    QUEBRA_DADOS_TELEFONICOS, // Boleano sim/nao
    QUEBRA_SIGILO_FINANCEIRO, // Boleano sim/nao
    QUEBRA_SIGILO_FISCAL, // Boleano sim/nao
    ACAO_CONTROLADA, // Boleano sim/nao
    CAPTACAO_AMBIENTAL_SINAIS_MAGNETICOS, // Boleano sim/nao
    AGENTE_INFILTRADO, // Boleano sim/nao
    CRIME_LAVAGEM_DINHEIRO, // Boleano Sim/Não
    LAVAGEM_DINHEIRO_ENVOLVE_ATOS_TRANSNACIONAIS, // Boleano Sim/Não
    LAVAGEM_DINHEIRO_TIPOLOGIAS, // Boleano Sim/Não
    EVASAO_DIVISAS, // Boleano Sim/Não
    CRIME_TRANSNACIONAL, // Boleano SIM/NAO
    CRIME_INTERESTADUAL, // Boleano SIM/NAO
    FACCAO_CRIMINOSA, // Boleano Sim/Não
    AREA_FRONTEIRA, // Boleano Sim/Não
    GRUPO_EXTERMINIO_MILICIA, // Boleano SIM/NAO
    TERRA_INDIGENA, // Boleano Sim/Não
    ENVOLVE_UNIDADE_CONSERVACAO, // Boleano Sim/Não
    ENVOLVE_AREA_PRIORITARIA, // Boleano Sim/Não
    CRIPTOATIVO, // Boleano Sim/Não
    RELACIONADA_PROMETHEUS, // Boleano SIM/NAO
    PREENCHIDO_DADOS_PROMETHEUS, // Boleano SIM/NAO
    TENTACULOS, // Boleano Sim/Não
    TENTACULOS_IPJ_ENVIADA_CBAN, // Boleano Sim/Não
    PRE_BUSCA_DOMICILIA_PRE_DEFLAGRADA, // Boleano sim/nao
    PRE_PRISAO_TEMPORARIA_PRE_DEFLAGRADA, // Boleano sim/nao
    PRE_PRISAO_PREVENTIVA_PRE_DEFLAGRADA, // Boleano sim/nao
    PRE_PREVISAO_CUMPRIMENTO_SEQUESTRO_BENS_E_OUTRAS_MEDIDAS, // Boleano sim/nao
    PRE_PREVISAO_CUMPRIMENTO_MEDIDAS_CAUTELARES, // Boleano sim/nao
    PRE_PREVISAO_AUXILIO_ORGAO_EXTERNO, // Boleano sim/nao
    PRE_PREVISAO_AUXILIO_GRUPO_TATICO, // Boleano sim/nao
    PRE_PREVISÃO_CUMPRIMENTO_MEDIDAS_CAUTELARES_DESFAVOR_ADVOGADOS, // Boleano sim/nao
    PRE_PREVISÃO_CUMPRIMENTO_MEDIDAS_CAUTELARES_DESFAVOR_FUNCIONARIO_PUBLICO, // Boleano sim/nao
    PRE_PREVISÃO_CUMPRIMENTO_MEDIDAS_CAUTELARES_DESFAVOR_PESSOAS_PRERROGATIVA_FORO, // Boleano sim/nao
    PRE_GPOL_AUX_GRUPO_TATICO, // Boleano sim/nao
    AUX_GRUPO_TATICO,
    BUSCA_DOMICILIAR, // Boleano Sim/Não
    PRISAO_TEMPORARIA, // Boleano Sim/Não
    PRISAO_PREVENTIVA, // Boleano Sim/Não
    SEQUESTRO AS "Tem Sequestro", // Boleano Sim/Não (Sim se tiver VL_TOTAL_SEQUESTRO ou VL_TETO_SEQUESTRO ou RE_SEQUESTRO preenchido)
    EXPEDICAO_MEDIDAS_CAUTELARES, // Boleano Sim/Não
    MEDIDAS_CAUTELARES_JUIZO, // Boleano Sim/Não
    MEDIDAS_CAUTELARES_PROIBICAO_ACESSO, // Boleano Sim/Não
    MEDIDAS_CAUTELARES_PROIBICAO_CONTATO, // Boleano Sim/Não
    MEDIDAS_CAUTELARES_PROIBICAO_AUSENTAR_COMARCA, // Boleano Sim/Não
    MEDIDAS_CAUTELARES_RECOLHIMENTO_DOMICILIAR, // Boleano Sim/Não
    MEDIDAS_CAUTELARES_SUSPENSAO_EXERCICIO, // Boleano Sim/Não
    MEDIDAS_CAUTELARES_INTERNACAO_PROVISORIA, // Boleano sim/nao
    MEDIDAS_CAUTELARES_FIANCA, // Boleano Sim/Não
    MEDIDAS_CAUTELARES_MONITORACAO_ELETRONICA, // Boleano Sim/Não
    MEDIDAS_CAUTELARES_PROIBICAO_AUSENTAR_PAIS, // Boleano Sim/Não
    RESGATE_VITIMA_TRAFICO_PESSOAS, // Boleano Sim/Não
    RESGATE_VITIMA_MIGRACAO_ILEGAL, // Boleano Sim/Não
    RESGATE_VITIMA_ORDEM_TRABALHO, // Boleano Sim/Não
    RESGATE_VITIMA_GRUPO_EXTERMINIO, // Boleano Sim/Não
    IDENTIFICACAO_VITIMA_ABUSO, // Boleano Sim/Não
    RESGATE_VITIMA_ABUSO, // Boleano Sim/Não
    DEFLAGRACAO_OPERACAO_REALIZADA_FORMA_SIMULTANEA, // Boleano SIM/NAO
    EXPEDICAO_MEDIDAS_PESSOAS_EXPOSTAS_POLITICAMENTE, // Boleano SIM/NAO
    EXPEDICAO_MEDIDAS_REINTEGRACAO_POSSE, // Boleano Sim/Não
    AUXILIO_ORGAO_EXTERNO, // Boleano Sim/Não - REPOSICIONADO
    HOUVE_CRIME_AMBIENTAL, // Boleano Sim/Não
    HOUVE_DANOS_AMBIENTAIS, // Boleano Sim/Não
    HOUVE_DESTRUICAO_MAQUINARIO, // Boleano Sim/Não
    HOUVE_DESINTRUSAO_INVASORES, // Boleano Sim/Não
    PRODUCAO_MATERIAL_ABUSO, // Boleano Sim/Não
    SISTEMA_RAPINA, // Boleano Sim/Não
    FORCA_TAREFA_IDENT_VITIMAS_FT_IDV, // Boleano Sim/Não
    INVESTIGACAO_REDE_P2P, // Boleano Sim/Não
    HOUVE_CRIME_ODIO, // Boleano Sim/Não
    HOUVE_REPRESSAO_ESCRAVIDAO, // Boleano Sim/Não
    PESSOA_FERIDAS_MORTAS_INVESTIGACAO, // Boleano Sim/Não
    HOUVE_CRIME_ALTA_TECNOLOGIA, // Boleano Sim/Não
    CRIME_ALTA_TECNOLOGIA_MEIO, // Boleano Sim/Não
    CRIME_ESTADO_DEMOCRATICO_DIREITO, // Boleano Sim/Não
    DESVIO_RECURSOS_FEFC_PARTIDARIO, // Boleano Sim/Não
    INVESTIGADO_FILIADO, // Boleano Sim/Não
    PARTICIPACAO_ADVOGADO, // Boleano Sim/Não
    PARTICIPACAO_CONTADOR, // Boleano Sim/Não
    PARTICIPACAO_PARENTE_ASSESSOR, // Boleano Sim/Não
    PREJUIZO_UNIAO, // Boleano Sim/Não
    ENVOLVE_FUNDO_INVESTIMENTO, // Boleano Sim/Não
    APROPRIACAO_INDEBITA_PREV, // Boleano Sim/Não
    QT_FRAUDE_BENEFICIOS_PREV, // Inteiro
    FORCA_TAREFA_PREV, // Boleano Sim/Não
    FRAUDE_BENEFICIOS_PREV, // Boleano Sim/Não
    FRAUDE_CUSTEIO_PREV, // Boleano Sim/Não
    SONEGACAO_PREV, // Boleano Sim/Não
    PREJUIZOS_EVITADOS_UNIAO, // Boleano Sim/Não
    VANTAGEM_INDEVIDA_SERVIDOR, // Boleano Sim/Não
    ERRADICACAO_CULTIVO_DROGAS, // Boleano Sim/Não
    HOUVE_TRAFICO_DROGAS, // Boleano Sim/Não
    BANCO_DADOS_INVADIDOS, // Boleano Sim/Não
    IDENTIFICACAO_MODUS_OPERANDI, // Boleano Sim/Não
    IDENTIFICACAO_SITES_GRUPOS, // Boleano Sim/Não
    INST_BANCARIAS, // Boleano Sim/Não
    MALWARE_BANCARIO, // Boleano Sim/Não
    EXISTE_ESPECIE_CIBER, // Boleano Sim/Não
    HOUVE_INCITACAO_RACISMO, // Boleano Sim/Não
    DIRECIONADO_PESSOA_ESPECIFICA, // Boleano Sim/Não
    HOUVE_GRUPOS_ATACADOS, // Boleano Sim/Não
    HOUVE_APREENSAO_MENOR, // Boleano Sim/Não
    IF(
        [QUEBRA_DADOS_TELEFONICOS] = 'sim' OR
        [QUEBRA_DADOS_TELEMATICOS] = 'sim' OR
        [CAPTACAO_AMBIENTAL_SINAIS_MAGNETICOS] = 'sim' OR
        [QUEBRA_SIGILO_FINANCEIRO] = 'sim' OR
        [QUEBRA_SIGILO_FISCAL] = 'sim' OR
        [COLAB_PREMIADA] = 'sim' OR
        [ACAO_CONTROLADA] = 'sim' OR
        [QTD_NOTICIAS_PROMETHEUS] > 9 OR
        [GEOPROCESSAMENTO] = 'sim' OR
        APPLYMAP('MapIPLAreaCaso', IPL) = 'Tramita em Tribunais Superiores' OR
        [EXPEDICAO_MEDIDAS_PESSOAS_EXPOSTAS_POLITICAMENTE] = 'sim' OR
        [AUX_GRUPO_TATICO] = 'sim' OR
        [CRIME_INTERESTADUAL] = 'sim' OR
        [CRIME_TRANSNACIONAL] = 'sim' OR
        [GRUPO_EXTERMINIO_MILICIA] = 'sim' OR
        [DEFLAGRACAO_OPERACAO_REALIZADA_FORMA_SIMULTANEA] = 'sim',
        'Sim',
        'Não'
    )
    AS MAJORANTE_OPERACAO_PJ, // Boleano Sim/Não - NOVO
    IF(
        [QUEBRA_DADOS_TELEFONICOS] = 'sim' OR
        [QUEBRA_DADOS_TELEMATICOS] = 'sim' OR
        [CAPTACAO_AMBIENTAL_SINAIS_MAGNETICOS] = 'sim' OR
        [QUEBRA_SIGILO_FINANCEIRO] = 'sim' OR
        [QUEBRA_SIGILO_FISCAL] = 'sim' OR
        [COLAB_PREMIADA] = 'sim' OR
        [ACAO_CONTROLADA] = 'sim',
        'Sim',
        'Não'
    )
    AS MAJORANTE_OPERACAO_PJ_CAT_1, // Boleano Sim/Não - NOVO
    IF(
        [QTD_NOTICIAS_PROMETHEUS] > 9 OR
        [GEOPROCESSAMENTO] = 'sim',
        'Sim',
        'Não'
    )
    AS MAJORANTE_OPERACAO_PJ_CAT_2, // Boleano Sim/Não - NOVO
    IF(
        APPLYMAP('MapIPLAreaCaso', IPL) = 'Tramita em Tribunais Superiores' OR
        [EXPEDICAO_MEDIDAS_PESSOAS_EXPOSTAS_POLITICAMENTE] = 'sim' OR
        [AUX_GRUPO_TATICO] = 'sim' OR
        [CRIME_INTERESTADUAL] = 'sim' OR
        [CRIME_TRANSNACIONAL] = 'sim' OR
        [GRUPO_EXTERMINIO_MILICIA] = 'sim' OR
        [DEFLAGRACAO_OPERACAO_REALIZADA_FORMA_SIMULTANEA] = 'sim',
        'Sim',
        'Não'
    )
    AS MAJORANTE_OPERACAO_PJ_CAT_3, // Boleano Sim/Não - NOVO
    IF(
        MEDIDAS_CAUTELARES_INTERNACAO_PROVISORIA = 'sim' OR
        MEDIDAS_CAUTELARES_MONITORACAO_ELETRONICA = 'sim' OR
        MEDIDAS_CAUTELARES_RECOLHIMENTO_DOMICILIAR = 'sim' OR
        MEDIDAS_CAUTELARES_SUSPENSAO_EXERCICIO = 'sim' OR
        MEDIDAS_CAUTELARES_PROIBICAO_AUSENTAR_PAIS = 'sim' OR
        MEDIDAS_CAUTELARES_PROIBICAO_AUSENTAR_COMARCA = 'sim' OR
        MEDIDAS_CAUTELARES_PROIBICAO_ACESSO = 'sim' OR
        MEDIDAS_CAUTELARES_PROIBICAO_CONTATO = 'sim' OR
        MEDIDAS_CAUTELARES_JUIZO = 'sim' OR
        MEDIDAS_CAUTELARES_FIANCA = 'sim',
        'Sim',
        'Não'
    )
    AS OUTRAS_MEDIDAS_CAUTELARES, // Boleano Sim/Não - NOVO
    IF(
        MEDIDAS_CAUTELARES_INTERNACAO_PROVISORIA = 'sim' OR
        MEDIDAS_CAUTELARES_MONITORACAO_ELETRONICA = 'sim' OR
        MEDIDAS_CAUTELARES_RECOLHIMENTO_DOMICILIAR = 'sim' OR
        MEDIDAS_CAUTELARES_SUSPENSAO_EXERCICIO = 'sim',
        'Sim',
        'Não'
    )
    AS OUTRAS_MEDIDAS_CAUTELARES_GRUPO_1, // Boleano Sim/Não - NOVO
    IF(
        MEDIDAS_CAUTELARES_PROIBICAO_AUSENTAR_PAIS = 'sim' OR
        MEDIDAS_CAUTELARES_PROIBICAO_AUSENTAR_COMARCA = 'sim' OR
        MEDIDAS_CAUTELARES_PROIBICAO_ACESSO = 'sim' OR
        MEDIDAS_CAUTELARES_PROIBICAO_CONTATO = 'sim' OR
        MEDIDAS_CAUTELARES_JUIZO = 'sim' OR
        MEDIDAS_CAUTELARES_FIANCA = 'sim',
        'Sim',
        'Não'
    )
    AS OUTRAS_MEDIDAS_CAUTELARES_GRUPO_2, // Boleano Sim/Não - NOVO

//////////////
// Métricas //
//////////////

    COALESCE(QTD_RIF,0) AS QTD_RIF, // Inteiro

    COALESCE(QTD_COLAB_PREMIADA,0) AS QTD_COLAB_PREMIADA, // Inteiro

    COALESCE(QTD_QUEBRA_DADOS_TELEMATICOS,0) AS QTD_QUEBRA_DADOS_TELEMATICOS, // Inteiro

    COALESCE(QTD_QUEBRA_DADOS_TELEFONICO,0) AS QTD_QUEBRA_DADOS_TELEFONICO, // Inteiro

    COALESCE(QTD_QUEBRA_SIGILO_FIN,0) AS QTD_QUEBRA_SIGILO_FIN, // Inteiro

    COALESCE(QTD_QUEBRA_SIGILO_FIS,0) AS QTD_QUEBRA_SIGILO_FIS, // Inteiro

    COALESCE(QTD_ACAO_CONTROLADA,0) AS QTD_ACAO_CONTROLADA, // Inteiro

    COALESCE(QTD_CAPTACAO_AMBIENTAL_SINAIS_MAGNETICOS,0) AS QTD_CAPTACAO_AMBIENTAL_SINAIS_MAGNETICOS, // Inteiro

    COALESCE(QTD_AGENTE_INFILTRADO,0) AS QTD_AGENTE_INFILTRADO, // Inteiro

    COALESCE(QTD_NOTICIAS_PROMETHEUS,0) AS QTD_NOTICIAS_PROMETHEUS, // Inteiro

    COALESCE(VL_TENTACULOS_FRAUDE,0) AS VL_TENTACULOS_FRAUDE, // Número
    COALESCE(QTD_NOTICIAS_TENTACULOS,0) AS QTD_NOTICIAS_TENTACULOS, // Inteiro

    COALESCE(PRE_QTD_PREVISTA_BUSCA_DOMICILIA_PRE_DEFLAGRADA,0) AS PRE_QTD_PREVISTA_BUSCA_DOMICILIA_PRE_DEFLAGRADA, // Número Real
    COALESCE(PRE_QTD_PREVISTA_PRISAO_TEMPORARIA_PRE_DEFLAGRADA,0) AS PRE_QTD_PREVISTA_PRISAO_TEMPORARIA_PRE_DEFLAGRADA, // Número Real
    COALESCE(PRE_QTD_PREVISTA_PRISAO_PREVENTIVA_PRE_DEFLAGRADA,0) AS PRE_QTD_PREVISTA_PRISAO_PREVENTIVA_PRE_DEFLAGRADA, // Número Real
    COALESCE(PRE_VL_ESTIMADO_EM_R$,0) AS PRE_VL_ESTIMADO_EM_R$, // Número como texto com 13 caracteres

    COALESCE(PRE_GPOL_QT_EQUIPES,0) AS PRE_GPOL_QT_EQUIPES, // Número Real
    COALESCE(PRE_GPOL_QT_MAND_BUSCA,0) AS PRE_GPOL_QT_MAND_BUSCA, // Número Real
    COALESCE(PRE_GPOL_QT_MAND_PRI_TEMP,0) AS PRE_GPOL_QT_MAND_PRI_TEMP, // Número Real
    COALESCE(PRE_GPOL_QT_MAND_PRI_PREV,0) AS PRE_GPOL_QT_MAND_PRI_PREV, // Número Real
    COALESCE(PRE_GPOL_QT_MED_CAUT_DIV,0) AS PRE_GPOL_QT_MED_CAUT_DIV, // Número Real
    COALESCE(PRE_GPOL_QT_EFETIVO_TOTAL,0) AS PRE_GPOL_QT_EFETIVO_TOTAL, // Número Real

    COALESCE(QTD_CUMPRIDA_BUSCA_DOMICILIAR,0) AS QTD_CUMPRIDA_BUSCA_DOMICILIAR, // Inteiro
    COALESCE(QTD_EXPEDIDA_BUSCA_DOMICILIAR,0) AS QTD_EXPEDIDA_BUSCA_DOMICILIAR, // Inteiro
    COALESCE(QTD_ENDERECOS_BUSCA_DOMICILIAR,0) AS QTD_ENDERECOS_BUSCA_DOMICILIAR, // Inteiro

    COALESCE(QTD_CUMPRIDA_PRISAO_TEMPORARIA,0) AS QTD_CUMPRIDA_PRISAO_TEMPORARIA, // Inteiro
    COALESCE(QTD_EXPEDIDA_PRISAO_TEMPORARIA,0) AS QTD_EXPEDIDA_PRISAO_TEMPORARIA, // Inteiro

    COALESCE(QTD_CUMPRIDA_PRISAO_PREVENTIVA,0) AS QTD_CUMPRIDA_PRISAO_PREVENTIVA, // Inteiro
    COALESCE(QTD_EXPEDIDA_PRISAO_PREVENTIVA,0) AS QTD_EXPEDIDA_PRISAO_PREVENTIVA, // Inteiro
    coalesce((QTD_CUMPRIDA_PRISAO_TEMPORARIA),0) + coalesce((QTD_CUMPRIDA_PRISAO_PREVENTIVA),0) AS QTD_CUMPRIDA_PRISAO, // Inteiro
	coalesce((QTD_EXPEDIDA_PRISAO_TEMPORARIA),0) + coalesce((QTD_EXPEDIDA_PRISAO_PREVENTIVA),0) AS QTD_EXPEDIDA_PRISAO, // Inteiro


    COALESCE(QTD_MEDIDA_CAUTELARES_JUIZO,0) AS QTD_MEDIDA_CAUTELARES_JUIZO, // Inteiro

    COALESCE(QTD_MEDIDAS_CAUTELARES_PROIBICAO_ACESSO,0) AS QTD_MEDIDAS_CAUTELARES_PROIBICAO_ACESSO, // Inteiro

    COALESCE(QTD_MEDIDAS_CAUTELARES_PROIBICAO_CONTATO,0) AS QTD_MEDIDAS_CAUTELARES_PROIBICAO_CONTATO, // Inteiro

    COALESCE(QTD_MEDIDAS_CAUTELARES_PROIBICAO_AUSENTAR_COMARCA,0) AS QTD_MEDIDAS_CAUTELARES_PROIBICAO_AUSENTAR_COMARCA, // Inteiro

    COALESCE(QTD_MEDIDAS_CAUTELARES_RECOLHIMENTO_DOMICILIAR,0) AS QTD_MEDIDAS_CAUTELARES_RECOLHIMENTO_DOMICILIAR, // Inteiro

    COALESCE(QTD_MEDIDAS_CAUTELARES_SUSPENSAO_EXERCICIO,0) AS QTD_MEDIDAS_CAUTELARES_SUSPENSAO_EXERCICIO, // Inteiro

    COALESCE(QTD_MEDIDAS_CAUTELARES_INTERNACAO_PROVISORIA,0) AS QTD_MEDIDAS_CAUTELARES_INTERNACAO_PROVISORIA, // Inteiro

    COALESCE(QTD_MEDIDAS_CAUTELARES_FIANCA,0) AS QTD_MEDIDAS_CAUTELARES_FIANCA, // Inteiro

    COALESCE(QTD_MEDIDAS_CAUTELARES_MONITORACAO_ELETRONICA,0) AS QTD_MEDIDAS_CAUTELARES_MONITORACAO_ELETRONICA, // Inteiro

    COALESCE(QTD_MEDIDAS_CAUTELARES_PROIBICAO_AUSENTAR_PAIS,0) AS QTD_MEDIDAS_CAUTELARES_PROIBICAO_AUSENTAR_PAIS, // Inteiro
//

    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_HOMENS_ADULTOS,0) AS QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_HOMENS_ADULTOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_MULHERES_ADULTAS,0) AS QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_MULHERES_ADULTAS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO,0) AS QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO,0) AS QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_BRASILEIROS_MASCULINOS,0) AS QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_BRASILEIROS_MASCULINOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_BRASILEIROS_FEMININOS,0) AS QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_BRASILEIROS_FEMININOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_ESTRANGEIROS_MASCULINOS,0) AS QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_ESTRANGEIROS_MASCULINOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_ESTRANGEIROS_FEMININOS,0) AS QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_ESTRANGEIROS_FEMININOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_NAO_HETEROSSEXUAIS,0) AS QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_NAO_HETEROSSEXUAIS, // Inteiro
//
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_HOMENS_ADULTOS,0) +
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_MULHERES_ADULTAS,0) +
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO,0) +
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO,0)
    AS QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_TOTAL, // Inteiro
//

    COALESCE(QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_HOMENS_ADULTOS,0) AS QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_HOMENS_ADULTOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_MULHERES_ADULTAS,0) AS QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_MULHERES_ADULTAS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO,0) AS QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO,0) AS QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_BRASILEIROS_MASCULINOS,0) AS QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_BRASILEIROS_MASCULINOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_BRASILEIROS_FEMININOS,0) AS QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_BRASILEIROS_FEMININOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_ESTRANGEIROS_MASCULINOS,0) AS QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_ESTRANGEIROS_MASCULINOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_ESTRANGEIROS_FEMININOS,0) AS QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_ESTRANGEIROS_FEMININOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_NAO_HETEROSSEXUAIS,0) AS QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_NAO_HETEROSSEXUAIS, // Inteiro
//
    COALESCE(QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_HOMENS_ADULTOS,0) +
    COALESCE(QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_MULHERES_ADULTAS,0) +
    COALESCE(QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO,0) +
    COALESCE(QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO,0) AS QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_TOTAL, // Inteiro
//

    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_HOMENS_ADULTOS,0) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_HOMENS_ADULTOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_MULHERES_ADULTAS,0) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_MULHERES_ADULTAS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO,0) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO,0) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_BRASILEIROS_MASCULINOS,0) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_BRASILEIROS_MASCULINOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_BRASILEIROS_FEMININOS,0) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_BRASILEIROS_FEMININOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_ESTRANGEIROS_MASCULINOS,0) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_ESTRANGEIROS_MASCULINOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_ESTRANGEIROS_FEMININOS,0) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_ESTRANGEIROS_FEMININOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_NAO_HETEROSSEXUAIS,0) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_NAO_HETEROSSEXUAIS, // Inteiro
//
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_HOMENS_ADULTOS,0) +
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_MULHERES_ADULTAS,0) +
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO,0) +
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO,0) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_TOTAL, // Inteiro
//

    COALESCE(QTD_GRUPO_EXTERMINIO_HOMENS_ADULTOS,0) AS QTD_GRUPO_EXTERMINIO_HOMENS_ADULTOS, // Inteiro
    COALESCE(QTD_GRUPO_EXTERMINIO_MULHERES_ADULTAS,0) AS QTD_GRUPO_EXTERMINIO_MULHERES_ADULTAS, // Inteiro
    COALESCE(QTD_GRUPO_EXTERMINIO_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO,0) AS QTD_GRUPO_EXTERMINIO_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO, // Inteiro
    COALESCE(QTD_GRUPO_EXTERMINIO_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO,0) AS QTD_GRUPO_EXTERMINIO_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO, // Inteiro
    COALESCE(QTD_GRUPO_EXTERMINIO_BRASILEIROS_MASCULINOS,0) AS QTD_GRUPO_EXTERMINIO_BRASILEIROS_MASCULINOS, // Inteiro
    COALESCE(QTD_GRUPO_EXTERMINIO_BRASILEIROS_FEMININOS,0) AS QTD_GRUPO_EXTERMINIO_BRASILEIROS_FEMININOS, // Inteiro
    COALESCE(QTD_GRUPO_EXTERMINIO_ESTRANGEIROS_MASCULINOS,0) AS QTD_GRUPO_EXTERMINIO_ESTRANGEIROS_MASCULINOS, // Inteiro
    COALESCE(QTD_GRUPO_EXTERMINIO_ESTRANGEIROS_FEMININOS,0) AS QTD_GRUPO_EXTERMINIO_ESTRANGEIROS_FEMININOS, // Inteiro
    COALESCE(QTD_GRUPO_EXTERMINIO_VITIMAS_NAO_HETEROSSEXUAIS,0) AS QTD_GRUPO_EXTERMINIO_VITIMAS_NAO_HETEROSSEXUAIS, // Inteiro
//
    COALESCE(QTD_GRUPO_EXTERMINIO_HOMENS_ADULTOS,0) +
    COALESCE(QTD_GRUPO_EXTERMINIO_MULHERES_ADULTAS,0) +
    COALESCE(QTD_GRUPO_EXTERMINIO_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO,0) +
    COALESCE(QTD_GRUPO_EXTERMINIO_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO,0) AS QTD_GRUPO_EXTERMINIO_TOTAL, // Inteiro
//

    COALESCE(QTD_IDENT_VIT_ABUSO_0_A_11_ANOS_FEMININO,0) AS QTD_IDENT_VIT_ABUSO_0_A_11_ANOS_FEMININO, // Inteiro
    COALESCE(QTD_IDENT_VIT_ABUSO_0_A_11_ANOS_MASCULINO,0) AS QTD_IDENT_VIT_ABUSO_0_A_11_ANOS_MASCULINO, // Inteiro
    COALESCE(QTD_IDENT_VIT_ABUSO_12_A_17_ANOS_MASCULINO,0) AS QTD_IDENT_VIT_ABUSO_12_A_17_ANOS_MASCULINO, // Inteiro
    COALESCE(QTD_IDENT_VIT_ABUSO_12_A_17_ANOS_FEMININO,0) AS QTD_IDENT_VIT_ABUSO_12_A_17_ANOS_FEMININO, // Inteiro
//
    COALESCE(QTD_IDENT_VIT_ABUSO_0_A_11_ANOS_FEMININO,0) +
    COALESCE(QTD_IDENT_VIT_ABUSO_0_A_11_ANOS_MASCULINO,0) +
    COALESCE(QTD_IDENT_VIT_ABUSO_12_A_17_ANOS_MASCULINO,0) +
    COALESCE(QTD_IDENT_VIT_ABUSO_12_A_17_ANOS_FEMININO,0) AS 
    QTD_IDENT_VIT_MENOR_ABUSO_TOTAL, // Inteiro
//

    COALESCE(QTD_VITIMA_ABUSO_RESGATADA_0_A_11_ANOS_FEMININO,0) AS QTD_VITIMA_ABUSO_RESGATADA_0_A_11_ANOS_FEMININO, // Inteiro
    COALESCE(QTD_VITIMA_ABUSO_RESGATADA_0_A_11_ANOS_MASCULINO,0) AS QTD_VITIMA_ABUSO_RESGATADA_0_A_11_ANOS_MASCULINO, // Inteiro
    COALESCE(QTD_VITIMA_ABUSO_RESGATADA_12_A_17_ANOS_MASCULINO,0) AS QTD_VITIMA_ABUSO_RESGATADA_12_A_17_ANOS_MASCULINO, // Inteiro
    COALESCE(QTD_VITIMA_ABUSO_RESGATADA_12_A_17_ANOS_FEMININO,0) AS QTD_VITIMA_ABUSO_RESGATADA_12_A_17_ANOS_FEMININO, // Inteiro
//
    COALESCE(QTD_VITIMA_ABUSO_RESGATADA_0_A_11_ANOS_FEMININO,0) +
    COALESCE(QTD_VITIMA_ABUSO_RESGATADA_0_A_11_ANOS_MASCULINO,0) +
    COALESCE(QTD_VITIMA_ABUSO_RESGATADA_12_A_17_ANOS_MASCULINO,0) +
    COALESCE(QTD_VITIMA_ABUSO_RESGATADA_12_A_17_ANOS_FEMININO,0) AS QTD_VITIMA_ABUSO_RESGATADA_MENOR_TOTAL, // Inteiro
//

    COALESCE(QTD_MEDIDAS_PESSOAS_EXPOSTAS_POLITICAMENTE,0) AS QTD_MEDIDAS_PESSOAS_EXPOSTAS_POLITICAMENTE, // Inteiro

    COALESCE(QTD_MEDIDA_REINTEGRACAO_POSSE,0) AS QTD_MEDIDA_REINTEGRACAO_POSSE, // Inteiro

    COALESCE(VL_AREA_DESMATADA,0) AS VL_AREA_DESMATADA, // Número

    COALESCE(QTD_DESINTRUSAO_INVASORES,0) AS QTD_DESINTRUSAO_INVASORES, // Inteiro

    COALESCE(QTD_PRODUCAO_MATERIAL_ABUSO,0) AS QTD_PRODUCAO_MATERIAL_ABUSO, // Inteiro

    COALESCE(QTD_PESSOA_FERIDAS_MORTAS_INVESTIGACAO,0) AS QTD_PESSOA_FERIDAS_MORTAS_INVESTIGACAO, // Inteiro

    COALESCE(VL_CRIME_FAZENDARIO,0) AS VL_CRIME_FAZENDARIO, // Número

    COALESCE(VL_PREJUIZOS_EVITADOS_UNIAO,0) AS VL_PREJUIZOS_EVITADOS_UNIAO, // Número

    COALESCE(VL_VANTAGEM_INDEVIDA_SERVIDOR,0) AS VL_VANTAGEM_INDEVIDA_SERVIDOR, // Número

    COALESCE(VL_AREA_ERRADICADA,0) AS VL_AREA_ERRADICADA, // Número
    
    COALESCE(QT_PES_ERRADICADOS,0) AS QT_PES_ERRADICADOS, // Inteiro

    COALESCE(QT_PES_ERRADICADOS,0) * 0.3 AS "Erradicação de maconha (equivalente em kg)", // Inteiro

    COALESCE(QTD_DIRECIONADO_PESSOA_ESPECIFICA,0) AS QTD_DIRECIONADO_PESSOA_ESPECIFICA // Inteiro

RESIDENT TEMP_SIGACrimHomologadas;




// === LINK TABLE DA FATO_OPERACOES DO SIGACrimHomologadas 2024 ===
// CONCATENATE(LINK_TABLE_APREENSOES_OPERACOES_CASOS)
TEMP_LINK_TABLE_APREENSOES_OPERACOES_CASOS_OPERACOES_SIGACRIM:
LOAD Distinct
    AutoNumberHash128("Proc. Identificação") AS [%CASOSKEY],
    AutoNumberHash128(ID_OPERACAO) AS [%OPERACOESKEY],
//     NULL() AS [%APREENSOESKEY], 
//    NULL() AS [%CASOSDATAKEY],
//    NULL() AS [%EVENTOSKEY],
//     NULL() AS [%EVENTOSAPREENSOESEXTERNASESTRANGEIRASKEY],
    
    AutoNumberHash128("Proc. Identificação") AS [%PROC_IDENTIFICACAO_KEY],
    AutoNumberHash128(ID_OPERACAO) AS [%ID_OPERACAO_KEY],
//     NULL() AS [%GESTAO_BENS_ITEM_ID_KEY],
//    NULL() AS [%PROC_DATA_ID_KEY],
//    NULL() AS [%ID_EVENTOS_KEY],
//     NULL() AS [%ID_EVENTOS_APREENSOES_EXTERNAS_ESTRANGEIRAS_KEY]
//
// COMENTADO PARA COLOCAR AS DATAS NAS DIMENSÕES
//     Date(PRE_DT_PREVISTA_DEFLAGRACAO) as "Data Prevista para Deflagração",
//     YEAR(date(PRE_DT_PREVISTA_DEFLAGRACAO)) as "Ano Previsto para Deflagração",
//     MONTH(date(PRE_DT_PREVISTA_DEFLAGRACAO)) as "Mês Previsto para Deflagração",
// //
//     Date(DT_DEFLAGRACAO) as "Data da Deflagração",
//     YEAR(date(DT_DEFLAGRACAO)) as "Ano da Deflagração",
//     MONTH(date(DT_DEFLAGRACAO)) as "Mês da Deflagração",
//     Num(MONTH(date(DT_DEFLAGRACAO))) as "Mês (Num) da Deflagração",
// //
//     date(DT_INICIO) as "Data de Início",
//     Date(DT_HOMOLOGACAO) as "Data da Homologação",
//     YEAR(date(DT_HOMOLOGACAO)) as "Ano da Homologação",
//     MONTH(date(DT_HOMOLOGACAO)) as "Mês da Homologação",
//
    Date(DT_DEFLAGRACAO) as Data,
    YEAR(date(DT_DEFLAGRACAO)) as "Ano",
    MONTH(date(DT_DEFLAGRACAO)) as "Mês",
    Num(MONTH(date(DT_DEFLAGRACAO))) as "Mês (Num)",
    'Deflagração da Operação' as "Tipo da Data",
//
    'Operações SIGACrim' as "Fonte",
    'Operações' AS "Tipo do Fato"
    
    // COMENTADO COM A NOVA MODELAGEM COM VÁRIAS KEYS 
    // ,$(vCarregaUnidAreaDirCoorGeralDaOperacao)

RESIDENT TEMP_SIGACrimHomologadas;


// CONCATENATE(TEMP_LINK_TABLE_APREENSOES_OPERACOES_CASOS_OPERACOES_SIGACRIM)
