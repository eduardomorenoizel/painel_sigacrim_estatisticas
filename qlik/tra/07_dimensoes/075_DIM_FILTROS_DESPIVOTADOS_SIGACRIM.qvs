LOAD AutoNumberHash128(ID_OPERACAO) AS [%ID_FILTROS_OPERACAO_KEY], 'Cooperação Policial'                  AS [Medidas Extraordinárias] RESIDENT TEMP_SIGACrimHomologadas WHERE Upper(HOUVE_COOPERACAO_POLICIAL) = 'SIM';
