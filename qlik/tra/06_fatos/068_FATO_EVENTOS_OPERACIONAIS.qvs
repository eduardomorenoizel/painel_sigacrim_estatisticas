// LEFT JOIN (TEMP_LINK_TABLE_APREENSOES_OPERACOES_CASOS_EVENTOS_OPERACIONAIS)
// LOAD DISTINCT
//     AutoNumberHash128(id_ordem_original_evento) AS [%EVENTOSKEY],
