$($(vRadical)DtMesAnoEvenPris)|
$($(vRadical)AnoAtual)|
$($(vRadical)AnoEvenPrisAtual)|
$($(vRadical)AnoAnterior)|
$($(vRadical)AnoEvenPrisAnterior)
;
    SET vListaDenominador =
$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)|$(vServPJ)
;
    FOR i = 1 TO 6
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
