//==============================================================================================

SET vFEpolSemFiltro = ;
SET vFEpolPrisEmFlagr = [Proc_Data Tipo] = {'Prisão Flagrante'};
SET vFEpolPrisEmFlagrInt = [Proc_Data Tipo] = {'Prisão Flagrante'}, [É Flagrante de Iniciativa Interna] = {'Sim'};
SET vFEpolPrisEmFlagrExt = [Proc_Data Tipo] = {'Prisão Flagrante'}, [É Flagrante de Iniciativa Externa] = {'Sim'};
SET vFEpolIplInstInicProp = [Proc. Origem Documento] = {'PF - Polícia Federal'};
SET vFEpolFlaInst = [Foi Instaurado por Flagrante] = {'Sim'};
SET vFEpolFlaInstInt = [É Flagrante de Iniciativa Interna] = {'Sim'};
SET vFEpolFlaInstExt = [É Flagrante de Iniciativa Externa] = {'Sim'};
SET vFEpolTcoInst = [Foi Instaurado por TC] = {'Sim'};
SET vFEpolReRec = [Proc. Matéria Registro Especial] = {'Recuperação de ativos'};
SET vFEpolAreaFront = AREA_FRONTEIRA = {"SIM"};

//==============================================================================================
// MÉTRICAS BASE (PADRÃO PROC 12)
//==============================================================================================

CALL GerarMetricaSomaCompletaProc('vPrisEmFlagr', '$(vFEpolPrisEmFlagr)', '[Proc_Data Prisão]');
CALL GerarMetricaSomaCompletaProc('vPrisEmFlagrInt', '$(vFEpolPrisEmFlagrInt)', '[Proc_Data Prisão]');
CALL GerarMetricaSomaCompletaProc('vPrisEmFlagrExt', '$(vFEpolPrisEmFlagrExt)', '[Proc_Data Prisão]');

CALL GerarMetricaContagemCompletaProc('vIplInst', '$(vFEpolSemFiltro)', '[Proc_Data IPL Instaurado ID]');
CALL GerarMetricaContagemCompletaProc('vIplInstInicProp', '$(vFEpolIplInstInicProp)', '[Proc_Data IPL Instaurado ID]');
CALL GerarMetricaContagemCompletaProc('vIplRelat', '$(vFEpolSemFiltro)', '[Proc_Data IPL Relatado ID]');

CALL GerarMetricaContagemCompletaProc('vReRecAtivInst', '$(vFEpolReRec)', '[Proc_Data RE Instaurado ID]');
CALL GerarMetricaContagemCompletaProc('vReRecAtivRelat', '$(vFEpolReRec)', '[Proc_Data RE Relatado ID]');

CALL GerarMetricaSomaCompletaProc('vIndiciam', '$(vFEpolSemFiltro)', '[Proc_Data Indiciamento]');
CALL GerarMetricaContagemCompletaProc('vIplSoluc', '$(vFEpolSemFiltro)', '[Proc_Data IPL Solucionado]');
CALL GerarMetricaContagemCompletaProc('vIplComAutIdent', '$(vFEpolSemFiltro)', '[Proc_Data IPL Autoria Identificada]');
CALL GerarMetricaContagemCompletaProc('vIplNaoCrime', '$(vFEpolSemFiltro)', '[Proc_Data IPL Não Crime]');
CALL GerarMetricaContagemCompletaProc('vIplNaoSoluc', '$(vFEpolSemFiltro)', '[Proc_Data IPL Não Solucionado]');

//==============================================================================================
// MÉTRICAS BASE (PADRÃO INST 12)
//==============================================================================================

CALL GerarMetricaContagemCompletaInst('vFlaInst', '$(vFEpolFlaInst)', '[Proc_Data Flagrante Instaurado ID]');
CALL GerarMetricaContagemCompletaInst('vFlaInstInt', '$(vFEpolFlaInstInt)', '[Proc_Data Flagrante Instaurado ID]');
CALL GerarMetricaContagemCompletaInst('vFlaInstExt', '$(vFEpolFlaInstExt)', '[Proc_Data Flagrante Instaurado ID]');
CALL GerarMetricaContagemCompletaInst('vTcoInst', '$(vFEpolTcoInst)', '[Proc_Data Flagrante Instaurado ID]');
CALL GerarMetricaContagemCompletaInst('vTcoEnce', '$(vFEpolSemFiltro)', '[Proc_Data TC Encerrado ID]');

//==============================================================================================
// MÉTRICAS COM PADRÕES DIFERENCIADOS
//==============================================================================================

// Inquéritos em Andamento
CALL GerarListaNomes4SemRel('vIplEmAnd');
CALL GerarListaCampo4('DISTINCT [Proc. Identificação]');
CALL GerarConjunto4EmAndIpl('$(vFEpolSemFiltro)');
CALL ExecutarLoopContagem4;
CALL GerarPorEfetEmAnd('vIplEmAnd');

CALL GerarListaNomesSomAnter4SemRel('vIplEmAnd');
CALL GerarListaCampo4('DISTINCT [Proc. Identificação]');
CALL GerarConjunto4EmAndIpl('$(vFEpolSemFiltro)');
CALL ExecutarLoopContagemSomAnter4;

// Duração média dos Inquéritos em Andamento
SET vListaNomeVariavel =
vDurMedIplEmAndSemRelDtAprOpeCaso|
vDurMedIplEmAnd
;
SET vListaCampo =
[Proc. Duração Dias]|[Proc. Duração Dias]
;
CALL GerarConjunto2EmAndIpl('$(vFEpolSemFiltro)');
FOR i = 1 TO 2
    LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
    LET vConjunto = SubField('$(vListaConjunto)', '|', i);
    LET vCampo = SubField('$(vListaCampo)', '|', i);
    CALL CriarVariavelMedia('$(vNomeVariavel)', '$(vConjunto)', '$(vCampo)');
NEXT i

// Duração média dos Inquéritos Relatados
CALL GerarMetricaMedia12Proc('vDurMedIplRelat', '[Proc_Data IPL Relatado ID] = {"*"}', '[Proc_Data IPL Duração Dias]');

// RE de Recuperação de Ativos em Andamento
CALL GerarListaNomes4SemRel('vReRecAtivEmAnd');
CALL GerarListaCampo4('DISTINCT [Proc. Identificação]');
CALL GerarConjunto4EmAndRe('$(vFEpolSemFiltro)');
CALL ExecutarLoopContagem4;
CALL GerarPorEfetEmAnd('vReRecAtivEmAnd');

// Duração média dos RE de Recuperação de Ativos em Andamento
SET vListaNomeVariavel =
vDurMedReRecAtivEmAndSemRelDtAprOpeCaso|
vDurMedReRecAtivEmAndPfEmSemRelDtAprOpeCaso|
vDurMedReRecAtivEmAnd|
vDurMedReRecAtivEmAndPfEmNum
;
CALL GerarListaCampo4('[Proc. Duração Dias]');
CALL GerarConjunto4EmAndRe('$(vFEpolSemFiltro)');
CALL ExecutarLoopMedia4;

// Duração média dos RE de Recuperação de Ativos Relatados
CALL GerarMetricaMedia12ProcSemPf('vDurMedReRecAtivRelat', '[Proc. Matéria Registro Especial] = {''Recuperação de ativos''}, [Proc_Data RE Relatado ID] = {"*"}', '[Proc_Data RE Duração Dias]');

