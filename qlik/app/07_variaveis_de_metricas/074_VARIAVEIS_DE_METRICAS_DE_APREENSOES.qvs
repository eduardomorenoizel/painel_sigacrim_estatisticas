CALL GerarMetricaBiCompleta('vValImoveisBi',              'vFApreBase', '[1 Valor Bens Imóveis Apreendidos/Sequestrados LVL1]');
CALL GerarMetricaBiCompleta('vValMovSemovBi',             'vFApreBase', '[2 Valor Bens Móveis e Semoventes Apreendidos/Sequestrados LVL1]');
CALL GerarMetricaBiCompleta('vValImovMovBi',              'vFApreBase', '[1+2 Bens Imóveis Apreendidos/Sequestrados + Bens Móveis e Semoventes Apreendidos/Sequestrados LVL1]');
CALL GerarMetricaBiCompleta('vValCriptoBi',               'vFApreBase', '[3 Valor Criptoativos apreendidos/sequestrados LVL1]');
CALL GerarMetricaBiCompleta('vValTilValMobBi',            'vFApreBase', '[4 Valor Títulos  Valores Mobiliários e Direitos Apreendidos/Sequestrados LVL1]');
CALL GerarMetricaBiCompleta('vValMonetBi',                'vFApreBase', '[5 Valores Monetários Apreendidos/Sequestrados LVL1]');
CALL GerarMetricaBiCompleta('vValMonTitBi',               'vFApreBase', '[4+5 Valores Monetários, Títulos e Direitos Apreendidos/Sequestrados LVL1]');
CALL GerarMetricaBiCompleta('vValPedMetJoiArteBi',        'vFApreBase', '[2.1 Valor Pedras, Metais Preciosos, Joias e Obras de Arte LVL2]');
CALL GerarMetricaBiCompleta('vValSemovBi',                'vFApreBase', '[2.2 Valor Semoventes LVL2]');
CALL GerarMetricaBiCompleta('vValVeicAerBi',              'vFApreBase', '[2.3 Valor Veículos aéreos LVL2]');
