RESIDENT TEMP_DIM_CASOS_APREENSAO_BENS;


// CALL StoreCsv('FATO_APREENSOES', '$(vCaminhoTabelasTeste)');


// LINK TABLE DA FATO_APREENSOES DO DIM_CASOS_APREENSAO_BENS
LINK_TABLE_APREENSOES_OPERACOES_CASOS:
LOAD Distinct
    AutoNumberHash128("Proc. Identificação") AS [%CASOSKEY],
    AutoNumberHash128(ID_OPERACAO) AS [%OPERACOESKEY],
    AutoNumberHash128("GestãoBens Item ID") AS [%APREENSOESKEY], 
    AutoNumberHash128("GestãoBens Item Material Subclasse Código") AS [%SUBCLASSESKEY],
//     NULL() AS [%CASOSDATAKEY],
    AutoNumberHash128(id_ordem_original_evento) AS [%EVENTOSKEY],
//     NULL() AS [%EVENTOSAPREENSOESEXTERNASESTRANGEIRASKEY],
//     NULL() AS [%EVENTOSPRISOESEXTERNASESTRANGEIRASKEY],

    AutoNumberHash128("Proc. Identificação") AS [%PROC_IDENTIFICACAO_KEY],
    AutoNumberHash128(ID_OPERACAO) AS [%ID_OPERACAO_KEY],
    AutoNumberHash128("GestãoBens Item ID") AS [%GESTAO_BENS_ITEM_ID_KEY],
    AutoNumberHash128("GestãoBens Item Material Subclasse Código") AS [%ITEM_SUBCLASSE_KEY],
//     NULL() AS [%PROC_DATA_ID_KEY],
    AutoNumberHash128(id_ordem_original_evento) AS [%ID_EVENTOS_KEY],
//     NULL() AS [%ID_EVENTOS_APREENSOES_EXTERNAS_ESTRANGEIRAS_KEY]
//     NULL() AS [%ID_EVENTOS_PRISOES_EXTERNAS_ESTRANGEIRAS_KEY]

// Retirada a Unidade da Apreensão por erro da DIM_CASOS_APREENSAO_BENS que traz a unidade de custódia e não a de apreensão
// 	"GestãoBens Apreensão Unidade Sigla" as [%UNIDADE_KEY], // Texto com 30 caracteres (sem registros faltantes)
// 	"GestãoBens Apreensão Unidade Sigla" as "Unidade Sigla da Apreensão", // Texto com 30 caracteres (sem registros faltantes)
// 	"GestãoBens Apreensão Unidade Cidade" as "Cidade da Apreensão", // Texto com 23 caracteres (só tem quando SISCART)
//     "GestãoBens Apreensão Unidade UF" as "Unidade UF da Apreensão", // Texto com 2 caracteres (sem registros faltantes)
//
	DATE("GestãoBens Item Data Apreensão") as Data,
    year("GestãoBens Item Data Apreensão") as "Ano",
    month("GestãoBens Item Data Apreensão") as "Mês",
    Num(MONTH("GestãoBens Item Data Apreensão")) as "Mês (Num)",
    'Apreensão' as "Tipo da Data",
//
// COMENTADO PARA COLOCAR AS DATAS NAS DIMENSÕES
	// "GestãoBens Item Data Apreensão" as "Data da Apreensão",
    // year("GestãoBens Item Data Apreensão") as "Ano da Apreensão",
    // month("GestãoBens Item Data Apreensão") as "Mês da Apreensão",
    'Apreensões ePol' AS "Fonte",
    'Apreensões' AS "Tipo do Fato"
RESIDENT TEMP_DIM_CASOS_APREENSAO_BENS;

LEFT JOIN (LINK_TABLE_APREENSOES_OPERACOES_CASOS)
LOAD DISTINCT
    AutoNumberHash128("Proc. Identificação") AS [%PROC_IDENTIFICACAO_KEY],
	$(vCarregaUnidAreaDirCoorGeralDoCaso)
RESIDENT TEMP_DIM_CASOS;

LEFT JOIN (LINK_TABLE_APREENSOES_OPERACOES_CASOS)
LOAD DISTINCT
    AutoNumberHash128("Proc. Identificação") AS [%PROC_IDENTIFICACAO_KEY],
    AutoNumberHash128("Proc_Data ID") AS [%CASOSDATAKEY],
    AutoNumberHash128("Proc_Data ID") AS [%PROC_DATA_ID_KEY]
RESIDENT TEMP_DIM_CASOS_DATA;

TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>>Concluída carga FATO_APREENSOES DO TEMP_DIM_CASOS_APREENSAO_BENS;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;