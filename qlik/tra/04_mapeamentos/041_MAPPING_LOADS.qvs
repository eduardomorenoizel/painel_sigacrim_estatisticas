TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Carregando MAPPING LOADs;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
// Carrega as categorias Item de interesse, Item de descapitalização e as classes
// predefinidas dos bens de descapitalização de acordo com taxinomia estabelecida
// pela COP LVL1 e LVL2
TempMapDescapitalizacao:
LOAD DISTINCT
    "Cod epol",
    ITEM_INTERESSE,
    ITEM_DESCAPITALIZAÇÃO,
    DESCAP_CLASSE_LVL_1,
    DESCAP_CLASSE_LVL_2,
    "Descapitalização 2024"
FROM [$(vCaminhoTabelasCorpDicorNge)CONSOLIDADA - Bens Interesse e Descapitalização Izel.xlsx]
(ooxml, embedded labels, table is CONSOLIDADA);

MapItemInteresse:
MAPPING LOAD DISTINCT
    "Cod epol",
    [ITEM_INTERESSE] // 'SIM' ou 'NÃO'
RESIDENT TempMapDescapitalizacao;

MapItemDescapitalizacao:
MAPPING LOAD DISTINCT
    "Cod epol",
    [ITEM_DESCAPITALIZAÇÃO] // 'SIM' ou 'NÃO'
RESIDENT TempMapDescapitalizacao;

MapClasse_LVL_1:
MAPPING LOAD DISTINCT
    "Cod epol",
    [DESCAP_CLASSE_LVL_1]
RESIDENT TempMapDescapitalizacao;

MapClasse_LVL_2:
MAPPING LOAD DISTINCT
    "Cod epol",
    [DESCAP_CLASSE_LVL_2]
RESIDENT TempMapDescapitalizacao;

DROP TABLE TempMapDescapitalizacao;

// Carrega os RE_SEQUESTRO que estão vinculados ao Caso_de_Operação (antigo IPL da 
// TABELA_APREENSÕES) listados no array do RE_SEQUESTRO da tabela OPERACOES
// como Caso_de_RE_de_Recuperação_de_Ativos
TempMapRESequestroIPL:
LOAD
	IPL as Caso_de_Operação,
	SubField(RE_SEQUESTRO,':',IterNo()) AS Caso_de_RE_de_Recuperação_de_Ativos
RESIDENT TEMP_TEMP_SIGACrimHomologadas
WHILE IterNo()<=SubStringCount(RE_SEQUESTRO,':')+1;

// Mapeia os Caso_de_Operação da tabela APREENSOES correspondentes aos
// Caso_de_RE_de_Recuperação_de_Ativos
MapRESequestroIPL:
MAPPING LOAD DISTINCT
    Caso_de_RE_de_Recuperação_de_Ativos,
    Caso_de_Operação
RESIDENT TempMapRESequestroIPL;

DROP TABLE TempMapRESequestroIPL;


// Mapeia os ID_OPERACAO correspondentes aos Caso_de_Operação da tabela OPERACOES
MapCasoOperacao:
MAPPING LOAD DISTINCT
    IPL as Codigo,
    ID_OPERACAO as Resultado
RESIDENT TEMP_TEMP_SIGACrimHomologadas
WHERE LEN(TRIM(IPL)) > 0;

// MappingLoad para indicar o [Proc.Identificação] do evento no qual a unidade participou com 
// "execucao_direta no tipo de procedimento "IPL", para usar na DIM_CASO para identificar os 
// flagrantes internos, quando o flagrante houver sido registrado no epol e no TabelaoEventos:

TempMapTabelaoEventosPF:
LOAD DISTINCT
    "Proc. Identificação",
    id_evento,
    dt_evento,
    unidade_participante
RESIDENT TEMP_TABELAOEVENTOS_ID_UNIFICADO
    WHERE MATCH(ds_tipo_procedimento, 'IPL')
    AND MATCH(cd_tipo_evento_fk, 'pf')
    AND MATCH(cd_tipo_participacao, 'execucao_direta')
;

MapIdEventoTabelaoEventosPF:
MAPPING LOAD DISTINCT
    "Proc. Identificação" as Codigo,
    id_evento as Resultado
RESIDENT TempMapTabelaoEventosPF
WHERE LEN(TRIM("Proc. Identificação")) > 0;

MapDtEventoTabelaoEventosPF:
MAPPING LOAD DISTINCT
    "Proc. Identificação" as Codigo,
    date(dt_evento) as Resultado
RESIDENT TempMapTabelaoEventosPF
WHERE LEN(TRIM("Proc. Identificação")) > 0;

MapUndEventoTabelaoEventosPF:
MAPPING LOAD DISTINCT
    "Proc. Identificação" as Codigo,
    unidade_participante as Resultado
RESIDENT TempMapTabelaoEventosPF
WHERE LEN(TRIM("Proc. Identificação")) > 0;

DROP TABLE TempMapTabelaoEventosPF;

// Carrega tabela temporária com campos da TEMP_DIM_CASOS, para os seguintes mappings:
// - carregar os flags que indicam se o Item ID foi migrado do SINPRO
// - carrega somente o IPL (obtido a partir do Proc. Identificação) e os respectivos
// 	 "Proc. Área de Atribuição" e "Proc. Unidade Exercício" da DIM_CASOS
// - tabela de mapeamento de Caso de operação e data do relatório
// - tabela de mapeamento para marcar IPL instaurado por flagrante
// - tabela de mapeamento para marcar IPL instaurado por TC
// - tabela de mapeamento para marcar IPL que é Evento de Execução Direta
// - tabela de mapeamento para marcar IPL que é Flagrante de Iniciativa Interna IPO 2025
TempMapProcMigracaoMapIPLAreaCasoDiretCGUnidMapCasodeOperacaoDataDoRelatorio:
LOAD DISTINCT
    "Proc. Identificação",
    "Proc. Migração Sinpro",
    $(vTransformaProcIdentificacaoEmCaso) AS IPL,
    "Proc. Área de Atribuição",
 	"Proc. Unidade Exercício", // Texto com 427 caracteres (960 registros distintos)
    $(vTransformaProcIdentificacaoEmCaso) as Caso,
    "Proc. Data Relatório"

RESIDENT TEMP_DIM_CASOS;

// // Carrega os flags que indicam se o Item ID foi migrado do SINPRO
// TempMapProcMigracao:
// LOAD DISTINCT
// //     "Proc. Identificação"
// // RESIDENT TEMP_DIM_CASOS_APREENSAO_BENS;
// // LEFT JOIN (TempMapProcMigracao)
// // Load
//     "Proc. Identificação",
//     "Proc. Migração Sinpro"
// RESIDENT TEMP_DIM_CASOS;

MapProcMigracao:
MAPPING LOAD DISTINCT
    "Proc. Identificação" as Codigo,
    "Proc. Migração Sinpro" as Resultado
RESIDENT TempMapProcMigracaoMapIPLAreaCasoDiretCGUnidMapCasodeOperacaoDataDoRelatorio
WHERE LEN(TRIM("Proc. Migração Sinpro")) > 0;

// DROP TABLE TempMapProcMigracao;

// Carrega os flags que indicam se o Idem ID era Item de descapitalização em 31/03/2025.
MapItemDescEpol_31_03_25:
MAPPING LOAD DISTINCT
    "GestãoBens Item Material Subclasse Código",
    'Sim' as Resultado
FROM [$(vCaminhoTabelasCorpDicorNge)CONSOLIDADA - Bens Interesse e Descapitalização Izel.xlsx]
(ooxml, embedded labels, table is MapItemDescEpol_31_03_25);

// Carrega os flags que indicam se Proc. Identificação do Idem ID estava entre aqueles selecionados em 31/03/2025.
MapProcIdenDescEpol_31_03_25:
MAPPING LOAD DISTINCT
    "Proc. Identificação",
    'Sim' as Resultado
FROM [$(vCaminhoTabelasCorpDicorNge)descapitalizao_epol_31_03_2025.xlsx]
(ooxml, embedded labels, table is MapProcIdenDescEpol_31_03_25);

// Carrega os flags que indicam se o Item é Item de Destruição Ambiental conforme
// taxinomia TNBIA
MapItemDestrAmb:
MAPPING LOAD DISTINCT
    "GestãoBens Item Material Subclasse Código",
    'Sim' as Resultado
FROM [$(vCaminhoTabelasCorpDicorNge)CONSOLIDADA - Bens Interesse e Descapitalização Izel.xlsx]
(ooxml, embedded labels, table is MapItemDestrAmb);

// Carrega os flags que indicam se o Item é Cigarro Eletrônico conforme taxinomia
// TNBIA
MapMaterialCigarroEletronico:
MAPPING LOAD DISTINCT
    "GestãoBens Item Material Subclasse Código",
    'Sim' as Resultado
FROM [$(vCaminhoTabelasCorpDicorNge)CONSOLIDADA - Bens Interesse e Descapitalização Izel.xlsx]
(ooxml, embedded labels, table is MapMaterialCigarroEletronico);

// Carrega os fatores para normalizar a quantidade de cigarros em maços conforme
// taxinomia TNBIA
TempMapFatorCigarros:
LOAD DISTINCT
    "GestãoBens Item Material Subclasse Código",
    Fator
FROM [$(vCaminhoTabelasCorpDicorNge)CONSOLIDADA - Bens Interesse e Descapitalização Izel.xlsx]
(ooxml, embedded labels, table is MapFatorCigarros);

MapFatorCigarros:
MAPPING LOAD DISTINCT
    "GestãoBens Item Material Subclasse Código",
    Fator
RESIDENT TempMapFatorCigarros;

DROP TABLE TempMapFatorCigarros;

// Carrega os fatores que alteraram os preços dos cigarros conforme definido pela
// Receita Federal
// 5 antes de '01/09/2024'
// 6.5 depois de '01/09/2024'
MapValorUnitarioCigarro:
MAPPING LOAD DISTINCT
	"GestãoBens Item ID",
	IF([GestãoBens Item Data Apreensão] >= '01/09/2024', 6.5, 5) AS FaixaValorUnitario
RESIDENT TEMP_DIM_CASOS_APREENSAO_BENS;

// Carrega os flags que indicam se o Item é Cocaína apreendida conforme taxinomia
// TNBIA
MapCocainaIDs:
MAPPING LOAD DISTINCT
    "GestãoBens Item Material Subclasse Código",
    'Sim' as Resultado
FROM [$(vCaminhoTabelasCorpDicorNge)CONSOLIDADA - Bens Interesse e Descapitalização Izel.xlsx]
(ooxml, embedded labels, table is MapCocainaIDs)
WHERE MATCH(IPO, 'Sim')
;

