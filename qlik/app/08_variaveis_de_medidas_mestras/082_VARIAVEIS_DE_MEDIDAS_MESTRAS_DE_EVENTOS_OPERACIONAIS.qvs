// Título da medida mestra dos resgates de vítimas de trabalho escravo em operações:

SET vTituloMedidaMestraVitimasTrabalhoEscravoEmOperacoes = 
IF(
    // Se [Ano] selecionado mostrar vAnoSelecionado
    GetSelectedCount([Ano]) > 0,
    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        'Vít Trab Escravo Resg em Operações em ' & @(vAnoSelecionado),
        'Vít Trab Escravo Resg em Operações por Efetivo em ' & @(vAnoSelecionado),
        'Vít Trab Escravo Resg em Operações PF EM NÚMEROS em ' & @(vAnoSelecionado)
        ),
    IF(
        // Se [Mês] ou [Data] selecionado mostrar MIN([Ano]) a MAX([Ano])
        GetSelectedCount([Mês]) + GetSelectedCount([Data]) > 0,
        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
            'Vít Trab Escravo Resg em Operações de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Vít Trab Escravo Resg em Operações por Efetivo de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Vít Trab Escravo Resg em Operações PF EM NÚMEROS de ' & MIN([Ano]) & ' a '& MAX([Ano])
            ),
		IF(
            // Se [Ano da Deflagração] selecionado mostrar vAnoDeflagracaoSelecionado
			GetSelectedCount([Ano da Deflagração]) > 0,
			PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
				'Vít Trab Escravo Resg em Operações em ' & @(vAnoDeflagracaoSelecionado),
				'Vít Trab Escravo Resg em Operações por Efetivo em ' & @(vAnoDeflagracaoSelecionado),
				'Vít Trab Escravo Resg em Operações PF EM NÚMEROS em ' & @(vAnoDeflagracaoSelecionado)
				),
            // Se nada selecionado mostrar MIN([Ano da Deflagração]) a MAX([Ano da Deflagração])
			PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
				'Vít Trab Escravo Resg em Operações de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
				'Vít Trab Escravo Resg em Operações por Efetivo de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
				'Vít Trab Escravo Resg em Operações PF EM NÚMEROS de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração])
				)
		)
	)
)
;

Call TratarExpansaoMacro(vTituloMedidaMestraVitimasTrabalhoEscravoEmOperacoes);

