    NPJDPF,                             Efetivo NPJ DPF Sem Sede
    NPJDPFSede,                          Efetivo NPJ DPF Sede
    NPJDPFSR,                           Efetivo NPJ DPF SR
    NPJDPFDescentralizadas,             Efetivo NPJ DPF Descentralizadas
    NPJDPFBases,                        Efetivo NPJ DPF Bases
    NPJDPFDelegaciasEspecializadasPJ,   Efetivo NPJ DPF Delegacias Especializadas
    NPJAPFComSede,                      Efetivo NPJ APF Com Sede
    NPJAPF,                             Efetivo NPJ APF Sem Sede
    NPJAPFSede,                          Efetivo NPJ APF Sede
    NPJAPFSR,                           Efetivo NPJ APF SR
    NPJAPFDescentralizadas,             Efetivo NPJ APF Descentralizadas
    NPJAPFBases,                        Efetivo NPJ APF Bases
    NPJAPFDelegaciasEspecializadasPJ,   Efetivo NPJ APF Delegacias Especializadas
    NPJEPFComSede,                      Efetivo NPJ EPF Com Sede
    NPJEPF,                             Efetivo NPJ EPF Sem Sede
    NPJEPFSede,                          Efetivo NPJ EPF Sede
    NPJEPFSR,                           Efetivo NPJ EPF SR
    NPJEPFDescentralizadas,             Efetivo NPJ EPF Descentralizadas
    NPJEPFBases,                        Efetivo NPJ EPF Bases
    NPJEPFDelegaciasEspecializadasPJ,   Efetivo NPJ EPF Delegacias Especializadas
    NPJPPFComSede,                      Efetivo NPJ PPF Com Sede
    NPJPPF,                             Efetivo NPJ PPF Sem Sede
    NPJPPFSede,                          Efetivo NPJ PPF Sede
    NPJPPFSR,                           Efetivo NPJ PPF SR
    NPJPPFDescentralizadas,             Efetivo NPJ PPF Descentralizadas
    NPJPPFBases,                        Efetivo NPJ PPF Bases
    NPJPPFDelegaciasEspecializadasPJ,   Efetivo NPJ PPF Delegacias Especializadas
    NPJPCFComSede,                      Efetivo NPJ PCF Com Sede
    NPJPCF,                             Efetivo NPJ PCF Sem Sede
    NPJPCFSede,                          Efetivo NPJ PCF Sede
    NPJPCFSR,                           Efetivo NPJ PCF SR
    NPJPCFDescentralizadas,             Efetivo NPJ PCF Descentralizadas
    NPJPCFBases,                        Efetivo NPJ PCF Bases
    NPJPCFDelegaciasEspecializadasPJ,   Efetivo NPJ PCF Delegacias Especializadas
    NPJADMComSede,                      Efetivo NPJ ADM Com Sede
    NPJADM,                             Efetivo NPJ ADM Sem Sede
    NPJADMSede,                          Efetivo NPJ ADM Sede
    NPJADMSR,                           Efetivo NPJ ADM SR
    NPJADMDescentralizadas,             Efetivo NPJ ADM Descentralizadas
    NPJADMBases,                        Efetivo NPJ ADM Bases
    NPJADMDelegaciasEspecializadasPJ,   Efetivo NPJ ADM Delegacias Especializadas
];

FOR i = 1 TO NoOfRows('TabelaMedidasMestrasEfetivo')
    LET vLoop_S  = Peek('Sufixo', $(i)-1, 'TabelaMedidasMestrasEfetivo');
    LET vLoop_T  = Peek('Titulo', $(i)-1, 'TabelaMedidasMestrasEfetivo');

    LET vLoop_N1 = 'vMedidaMestraQtdServ'       & '$(vLoop_S)';
    LET vLoop_N2 = 'vMedidaMestraQtdServ'       & '$(vLoop_S)' & 'SomAnter';
    LET vLoop_N3 = 'vTituloMedidaMestraQtdServ' & '$(vLoop_S)';

    LET vLoop_QV   = 'vQtdServ' & '$(vLoop_S)';
    LET vLoop_QVSA = 'vQtdServ' & '$(vLoop_S)' & 'SomAnter';

    // Pré-computa o valor expandido uma vez por iteração (3× expansão → 1× expansão)
    LET vLoop_EQV   = '$($(vLoop_QV))';
    LET vLoop_EQVSA = '$($(vLoop_QVSA))';

    SET $(vLoop_N1) =
        PICK(@(vMostrarValAbsouRelaoEfetouPFEmNum)+1,
            $(vLoop_EQV),
            $(vLoop_EQV),
            $(vLoop_EQV)
        );
    Call TratarExpansaoMacro($(vLoop_N1));

    SET $(vLoop_N2) =
        PICK(@(vMostrarValAbsouRelaoEfetouPFEmNum)+1,
            $(vLoop_EQVSA),
            $(vLoop_EQVSA),
            $(vLoop_EQVSA)
        );
    Call TratarExpansaoMacro($(vLoop_N2));

    SET $(vLoop_N3) =
        PICK(@(vMostrarValAbsouRelaoEfetouPFEmNum)+1,
            '$(vLoop_T)',
            '$(vLoop_T)',
            '$(vLoop_T)'
        );
    Call TratarExpansaoMacro($(vLoop_N3));

NEXT i
DROP TABLE TabelaMedidasMestrasEfetivo;


//-----------------------------------------------------------------------------------------------
// Limpeza das variáveis auxiliares do loop
//-----------------------------------------------------------------------------------------------

SET vLoop_S     = ;
SET vLoop_T     = ;
SET vLoop_N1    = ;
SET vLoop_N2    = ;
SET vLoop_N3    = ;
SET vLoop_QV    = ;
SET vLoop_QVSA  = ;
SET vLoop_EQV   = ;
SET vLoop_EQVSA = ;

TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Concluída carga das variáveis das Medidas Mestras de Efetivo;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
