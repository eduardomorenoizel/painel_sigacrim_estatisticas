            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vPrisTempCumprEmOperEmAreaFrontDtMesAno),
        // números por efetivo
            $(vPrisTempCumprEmOperEmAreaFrontDtMesAnoPorEfet),
        // números PF EM NÚMEROS
            $(vPrisTempCumprEmOperEmAreaFrontPfEmNumDtMesAno)
