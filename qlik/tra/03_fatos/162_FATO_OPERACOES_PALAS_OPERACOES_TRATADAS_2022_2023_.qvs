TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Carregando FATO_OPERACOES do;
TRACE >>> TEMP_Palas_Operacoes_Tratadas_2022_2023;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
/////////////////////////////////////////////////////////////////////////
// Carga do BI DE ESTATÍSTICAS CRIMINAIS do NGE/COP/DICOR/PF           //
// FATO_OPERACOES DO Palas_Operacoes_Tratadas_2022_2023 COM LINK TABLE //
/////////////////////////////////////////////////////////////////////////

// === FATO_OPERACOES DO Palas_Operacoes_Tratadas_2022_2023 ===
CONCATENATE (FATO_OPERACOES)
LOAD DISTINCT
    AutoNumberHash128(ID_OPERACAO) AS [%OPERACOESKEY],

//////////////// comentado pois incluído no [%KEY] ////////////////
    // IPL AS Caso_de_Operação,
    // "Proc. Identificação",
    // ID_OPERACAO,
    // Date(DT_HOMOLOGACAO) as DT_HOMOLOGACAO,
    // YEAR(date(DT_HOMOLOGACAO)) as DT_ANO_HOMOLOGACAO,
    // MONTH(date(DT_HOMOLOGACAO)) as DT_MES_HOMOLOGACAO,
    // Date(DT_DEFLAGRACAO) as DT_DEFLAGRACAO,
    // YEAR(date(DT_DEFLAGRACAO)) as DT_ANO_DEFLAGRACAO,
    // MONTH(date(DT_DEFLAGRACAO)) as DT_MES_DEFLAGRACAO,
//
//

///////////////////
// Sinalizadores //
///////////////////

    IF(COALESCE("Valores em espécie legal, nacional ou estrangeira, efetivamente apreendidos, em Reais.",0)
       + COALESCE("Valores de outros bens lícitos ou ilícitos (desconsiderando valores em espécie legal) efetivamente apreendidos, em Reais.",0)
            + COALESCE(VL_SEQUESTRO_VALOR_BLOQUEADO_FINANCEIRO,0)
                + COALESCE(TRIM(VL_TETO_SEQUESTRO)) > 0,
                'SIM',
                'NAO'                    
    )
    AS "Tem Sequestro",
    IF(COALESCE(QTD_EXPEDIDA_BUSCA_DOMICILIAR,0) > 0, 'SIM', 'NAO') AS BUSCA_DOMICILIAR, // Boleano Sim/Não
    IF(COALESCE(QTD_EXPEDIDA_PRISAO_TEMPORARIA,0) > 0, 'SIM', 'NAO') AS PRISAO_TEMPORARIA, // Boleano Sim/Não
    IF(COALESCE(QTD_EXPEDIDA_PRISAO_PREVENTIVA,0) > 0, 'SIM', 'NAO') AS PRISAO_PREVENTIVA, // Boleano Sim/Não
    IF(COALESCE(QTD_MEDIDA_CAUTELARES_JUIZO,0)
        + COALESCE(QTD_MEDIDAS_CAUTELARES_PROIBICAO_ACESSO,0)
            + COALESCE(QTD_MEDIDAS_CAUTELARES_PROIBICAO_CONTATO,0)
                + COALESCE(QTD_MEDIDAS_CAUTELARES_PROIBICAO_AUSENTAR_COMARCA,0)
                    + COALESCE(QTD_MEDIDAS_CAUTELARES_RECOLHIMENTO_DOMICILIAR,0)
                        + COALESCE(QTD_MEDIDAS_CAUTELARES_SUSPENSAO_EXERCICIO,0)
                            + COALESCE(QTD_MEDIDAS_CAUTELARES_INTERNACAO_PROVISORIA,0)
                                + COALESCE(QTD_MEDIDAS_CAUTELARES_FIANCA,0)
                                    + COALESCE(QTD_MEDIDAS_CAUTELARES_MONITORACAO_ELETRONICA,0) > 0,
                                    'SIM',
                                    'NÃO'
    ) AS EXPEDICAO_MEDIDAS_CAUTELARES, // Boleano Sim/Não
    IF(COALESCE(QTD_MEDIDA_CAUTELARES_JUIZO,0) > 0, 'SIM', 'NAO') AS MEDIDAS_CAUTELARES_JUIZO, // Boleano Sim/Não
    IF(COALESCE(QTD_MEDIDAS_CAUTELARES_PROIBICAO_ACESSO,0) > 0, 'SIM', 'NAO') AS MEDIDAS_CAUTELARES_PROIBICAO_ACESSO, // Boleano Sim/Não
    IF(COALESCE(QTD_MEDIDAS_CAUTELARES_PROIBICAO_CONTATO,0) > 0, 'SIM', 'NAO') AS MEDIDAS_CAUTELARES_PROIBICAO_CONTATO, // Boleano Sim/Não
    IF(COALESCE(QTD_MEDIDAS_CAUTELARES_PROIBICAO_AUSENTAR_COMARCA,0) > 0, 'SIM', 'NAO') AS MEDIDAS_CAUTELARES_PROIBICAO_AUSENTAR_COMARCA, // Boleano Sim/Não
    IF(COALESCE(QTD_MEDIDAS_CAUTELARES_RECOLHIMENTO_DOMICILIAR,0) > 0, 'SIM', 'NAO') AS MEDIDAS_CAUTELARES_RECOLHIMENTO_DOMICILIAR, // Boleano Sim/Não
    IF(COALESCE(QTD_MEDIDAS_CAUTELARES_SUSPENSAO_EXERCICIO,0) > 0, 'SIM', 'NAO') AS MEDIDAS_CAUTELARES_SUSPENSAO_EXERCICIO, // Boleano Sim/Não
    IF(COALESCE(QTD_MEDIDAS_CAUTELARES_INTERNACAO_PROVISORIA,0) > 0, 'SIM', 'NAO') AS MEDIDAS_CAUTELARES_INTERNACAO_PROVISORIA, // Boleano Sim/Não
    IF(COALESCE(QTD_MEDIDAS_CAUTELARES_FIANCA,0) > 0, 'SIM', 'NAO') AS MEDIDAS_CAUTELARES_FIANCA, // Boleano Sim/Não
    IF(COALESCE(QTD_MEDIDAS_CAUTELARES_MONITORACAO_ELETRONICA,0) > 0, 'SIM', 'NAO') AS MEDIDAS_CAUTELARES_MONITORACAO_ELETRONICA, // Boleano Sim/Não
    IF(COALESCE(COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_HOMENS_ADULTOS,0) +
                COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_MULHERES_ADULTAS,0) +
                COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO,0) +
                COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO,0),
                0
                ) > 0, 'SIM', 'NAO'
    ) AS RESGATE_VITIMA_TRAFICO_PESSOAS, // Boleano Sim/Não
    IF(COALESCE(COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_HOMENS_ADULTOS,0) +
                COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_MULHERES_ADULTAS,0) +
                COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO,0) +
                COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO,0),
                0
                ) > 0, 'SIM', 'NAO'
    ) AS RESGATE_VITIMA_ORDEM_TRABALHO, // Boleano Sim/Não
    ERRADICACAO_CULTIVO_DROGAS, // Boleano Sim/Não
    IF(COALESCE("Resgate de vítimas em condições análogas à escravidão, exploração sexual, tráfico de pessoas, tráfico de órgãos e de grupo de execução ou no caso de operação policial de repressão ao trabalho escravo realizada no modelo de força-tarefa (e",
                0
                ) > 0, 'SIM', 'NAO'
    ) AS HOUVE_REPRESSAO_ESCRAVIDAO, // Boleano 0/1    

//////////////
// Métricas //
//////////////


    COALESCE(QTD_EXPEDIDA_BUSCA_DOMICILIAR,0) AS QTD_EXPEDIDA_BUSCA_DOMICILIAR, // Inteiro
    COALESCE(QTD_EXPEDIDA_BUSCA_DOMICILIAR,0) AS QTD_CUMPRIDA_BUSCA_DOMICILIAR, // Inteiro

//


    COALESCE(QTD_EXPEDIDA_PRISAO_TEMPORARIA,0) AS QTD_EXPEDIDA_PRISAO_TEMPORARIA, // Inteiro
//


    COALESCE(QTD_EXPEDIDA_PRISAO_PREVENTIVA,0) AS QTD_EXPEDIDA_PRISAO_PREVENTIVA, // Inteiro

//
	coalesce((QTD_EXPEDIDA_PRISAO_TEMPORARIA),0) + coalesce((QTD_EXPEDIDA_PRISAO_PREVENTIVA),0) AS QTD_EXPEDIDA_PRISAO, // Inteiro
//
    COALESCE(QTD_EXPEDIDA_PRISAO_TEMPORARIA,0) AS QTD_CUMPRIDA_PRISAO_TEMPORARIA, // Inteiro
//


    COALESCE(QTD_EXPEDIDA_PRISAO_PREVENTIVA,0) AS QTD_CUMPRIDA_PRISAO_PREVENTIVA, // Inteiro

//
	coalesce((QTD_EXPEDIDA_PRISAO_TEMPORARIA),0) + coalesce((QTD_EXPEDIDA_PRISAO_PREVENTIVA),0) AS QTD_CUMPRIDA_PRISAO, // Inteiro
//

    COALESCE(QTD_MEDIDA_CAUTELARES_JUIZO,0) AS QTD_MEDIDA_CAUTELARES_JUIZO, // Inteiro


    COALESCE(QTD_MEDIDAS_CAUTELARES_PROIBICAO_ACESSO,0) AS QTD_MEDIDAS_CAUTELARES_PROIBICAO_ACESSO, // Inteiro


    COALESCE(QTD_MEDIDAS_CAUTELARES_PROIBICAO_CONTATO,0) AS QTD_MEDIDAS_CAUTELARES_PROIBICAO_CONTATO, // Inteiro


    COALESCE(QTD_MEDIDAS_CAUTELARES_PROIBICAO_AUSENTAR_COMARCA,0) AS QTD_MEDIDAS_CAUTELARES_PROIBICAO_AUSENTAR_COMARCA, // Inteiro


    COALESCE(QTD_MEDIDAS_CAUTELARES_RECOLHIMENTO_DOMICILIAR,0) AS QTD_MEDIDAS_CAUTELARES_RECOLHIMENTO_DOMICILIAR, // Inteiro


    COALESCE(QTD_MEDIDAS_CAUTELARES_SUSPENSAO_EXERCICIO,0) AS QTD_MEDIDAS_CAUTELARES_SUSPENSAO_EXERCICIO, // Inteiro


    COALESCE(QTD_MEDIDAS_CAUTELARES_INTERNACAO_PROVISORIA,0) AS QTD_MEDIDAS_CAUTELARES_INTERNACAO_PROVISORIA, // Inteiro


    COALESCE(QTD_MEDIDAS_CAUTELARES_FIANCA,0) AS QTD_MEDIDAS_CAUTELARES_FIANCA, // Inteiro


    COALESCE(QTD_MEDIDAS_CAUTELARES_MONITORACAO_ELETRONICA,0) AS QTD_MEDIDAS_CAUTELARES_MONITORACAO_ELETRONICA, // Inteiro


    COALESCE("Quantidade de mandados judiciais de cunho cautelar assecuratório.",0) AS "Quantidade de mandados judiciais de cunho cautelar assecuratório.", // Inteiro


    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_HOMENS_ADULTOS,0) AS QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_HOMENS_ADULTOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_MULHERES_ADULTAS,0) AS QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_MULHERES_ADULTAS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO,0) AS QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO,0) AS QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_BRASILEIROS_MASCULINOS,0) AS QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_BRASILEIROS_MASCULINOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_BRASILEIROS_FEMININOS,0) AS QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_BRASILEIROS_FEMININOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_ESTRANGEIROS_MASCULINOS,0) AS QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_ESTRANGEIROS_MASCULINOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_ESTRANGEIROS_FEMININOS,0) AS QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_ESTRANGEIROS_FEMININOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_NAO_HETEROSSEXUAIS,0) AS QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_NAO_HETEROSSEXUAIS, // Inteiro


    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_HOMENS_ADULTOS,0) +
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_MULHERES_ADULTAS,0) +
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO,0) +
    COALESCE(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO,0)
    AS QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_TOTAL, // Inteiro




    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_HOMENS_ADULTOS,0) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_HOMENS_ADULTOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_MULHERES_ADULTAS,0) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_MULHERES_ADULTAS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO,0) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO,0) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_BRASILEIROS_MASCULINOS,0) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_BRASILEIROS_MASCULINOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_BRASILEIROS_FEMININOS,0) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_BRASILEIROS_FEMININOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_ESTRANGEIROS_MASCULINOS,0) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_ESTRANGEIROS_MASCULINOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_ESTRANGEIROS_FEMININOS,0) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_ESTRANGEIROS_FEMININOS, // Inteiro
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_NAO_HETEROSSEXUAIS,0) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_NAO_HETEROSSEXUAIS, // Inteiro


    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_HOMENS_ADULTOS,0) +
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_MULHERES_ADULTAS,0) +
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO,0) +
    COALESCE(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO,0)
    AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_TOTAL // Inteiro
RESIDENT TEMP_Palas_Operacoes_Tratadas_2022_2023;

// === LINK TABLE FATO_OPERACOES DO Palas_Operacoes_Tratadas_2022_2023 === //
// CONCATENATE(LINK_TABLE_APREENSOES_OPERACOES_CASOS)
TEMP_LINK_TABLE_APREENSOES_OPERACOES_CASOS_OPERACOES_PALAS:
LOAD Distinct
    AutoNumberHash128("Proc. Identificação") AS [%CASOSKEY],
    AutoNumberHash128(ID_OPERACAO) AS [%OPERACOESKEY],
//     NULL() AS [%APREENSOESKEY], 
//    NULL() AS [%CASOSDATAKEY],
//    NULL() AS [%EVENTOSKEY],
    
    AutoNumberHash128("Proc. Identificação") AS [%PROC_IDENTIFICACAO_KEY],
    AutoNumberHash128(ID_OPERACAO) AS [%ID_OPERACAO_KEY],
//     NULL() AS [%GESTAO_BENS_ITEM_ID_KEY],
//    NULL() AS [%PROC_DATA_ID_KEY],
//    NULL() AS [%ID_EVENTOS_KEY],
//

//
// COMENTADO PARA COLOCAR AS DATAS NAS DIMENSÕES
// 	COALESCE(Date(DT_HOMOLOGACAO), Date(DT_DEFLAGRACAO)) as "Data da Homologação",
//     COALESCE(YEAR(date(DT_HOMOLOGACAO)), YEAR(date(DT_DEFLAGRACAO))) as "Ano da Homologação",
//     COALESCE(MONTH(date(DT_HOMOLOGACAO)), MONTH(date(DT_DEFLAGRACAO))) as "Mês da Homologação",
// //
//     Date(DT_DEFLAGRACAO) as "Data da Deflagração",
//     YEAR(date(DT_DEFLAGRACAO)) as "Ano da Deflagração",
//     MONTH(date(DT_DEFLAGRACAO)) as "Mês da Deflagração",
//     Num(MONTH(date(DT_DEFLAGRACAO))) as "Mês (Num) da Deflagração",
//
    Date(DT_DEFLAGRACAO) as Data,
    YEAR(date(DT_DEFLAGRACAO)) as "Ano",
    MONTH(date(DT_DEFLAGRACAO)) as "Mês",
    Num(MONTH(date(DT_DEFLAGRACAO))) as "Mês (Num)",
    'Deflagração da Operação' as "Tipo da Data",
//
    'Operações Palas' as "Fonte",
    'Operações' AS "Tipo do Fato",

//     // COMENTADO COM A NOVA MODELAGEM COM VÁRIAS KEYS 
// //  Unidade, Área de Atribuição, Diretoria e CG da Operação
// // 	UNIDADE AS [%UNIDADE_OPERACAO], // Texto
// 	UF AS "Unidade UF da Operação", // Texto
//     UNIDADE AS "Unidade Sigla da Operação", // Texto
// //
//     // Área de atribuição da operação
//     APPLYMAP('PALASAREAATRIBUICAOMapping', AREAATRIBUICAOPALAS)
//     AS "Área de Atribuição da Operação",
//     // Diretoria da operação
//     APPLYMAP('PALASAREADIRETORIAMapping', AREAATRIBUICAOPALAS)
//     AS "Diretoria da Operação",
//     // Coordenação-Geral da operação
//     APPLYMAP('PALASAREACOORDENACAOGERALMapping', AREAATRIBUICAOPALAS)
//     AS "Coordenação-Geral da Operação",

//  Unidade, Área de Atribuição, Diretoria e CG do Caso
    AutoNumberHash128(UNIDADE) AS [%UNIDADE_KEY],
	UF AS "Unidade UF do Caso", // Texto
    UNIDADE AS "Unidade Sigla do Caso", // Texto
//

	// Área atribuição do caso
    APPLYMAP('PALASAREAATRIBUICAOMapping', AREAATRIBUICAOPALAS)
    AS "Área de Atribuição do Caso",
    // Diretoria do caso
    APPLYMAP('PALASAREADIRETORIAMapping', AREAATRIBUICAOPALAS)
    AS "Diretoria do Caso",
    // Coordenação-Geral do caso
    APPLYMAP('PALASAREACOORDENACAOGERALMapping', AREAATRIBUICAOPALAS)
    AS "Coordenação-Geral do Caso"

//     // COMENTADO COM A NOVA MODELAGEM COM VÁRIAS KEYS 
// // //////// JUNTANDO AS APREENSOES
// //  Unidade e Data das Apreensões
// // Retirada a Unidade da Apreensão por erro da DIM_CASOS_APREENSAO_BENS que traz a unidade de custódia e não a de apreensão	
// // 	UNIDADE AS [%UNIDADE_OPERACAO], // Texto
// // 	UF AS "Unidade UF da Apreensão", // Texto
// //     UNIDADE AS "Unidade Sigla da Apreensão", // Texto
// //
// //
// 	DT_DEFLAGRACAO as "Data da Apreensão",
//     year(DT_DEFLAGRACAO) as "Ano da Apreensão",
//     month(DT_DEFLAGRACAO) as "Mês da Apreensão"


// // /////////FIM DA JUNTADA DAS APREENSOES

RESIDENT TEMP_Palas_Operacoes_Tratadas_2022_2023;



LEFT JOIN (TEMP_LINK_TABLE_APREENSOES_OPERACOES_CASOS_OPERACOES_PALAS)
LOAD DISTINCT
    AutoNumberHash128("Proc. Identificação") AS [%PROC_IDENTIFICACAO_KEY],
    AutoNumberHash128(ID_OPERACAO) AS [%ID_OPERACAO_KEY],
    AutoNumberHash128("GestãoBens Item ID") AS [%APREENSOESKEY], 
    AutoNumberHash128("GestãoBens Item Material Subclasse Código") AS [%SUBCLASSESKEY],
    AutoNumberHash128("GestãoBens Item ID") AS [%GESTAO_BENS_ITEM_ID_KEY],
    AutoNumberHash128("GestãoBens Item Material Subclasse Código") AS [%ITEM_SUBCLASSE_KEY]
RESIDENT TEMP_DIM_CASOS_APREENSAO_BENS;

LEFT JOIN (TEMP_LINK_TABLE_APREENSOES_OPERACOES_CASOS_OPERACOES_PALAS)
LOAD DISTINCT
    AutoNumberHash128("Proc. Identificação") AS [%PROC_IDENTIFICACAO_KEY],
    AutoNumberHash128("Proc_Data ID") AS [%CASOSDATAKEY],
    AutoNumberHash128("Proc_Data ID") AS [%PROC_DATA_ID_KEY]
RESIDENT TEMP_DIM_CASOS_DATA;

CONCATENATE(LINK_TABLE_APREENSOES_OPERACOES_CASOS)
Load
	*
RESIDENT TEMP_LINK_TABLE_APREENSOES_OPERACOES_CASOS_OPERACOES_PALAS;

DROP TABLE TEMP_LINK_TABLE_APREENSOES_OPERACOES_CASOS_OPERACOES_PALAS;

CALL StoreAndDrop('FATO_OPERACOES', '$(vCaminhoTransformadosV3)');
