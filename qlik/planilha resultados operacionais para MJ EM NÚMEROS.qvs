    "Proc. Órgão Vítima",
    "Proc. Duração Dias",
    "Unidade UF",
    "Proc. Data Encerrado",
    "Proc. Tipo Encerrado",
    "Proc. Tipo Encerrado2",
    "Proc. Tipo Encerrado3",
