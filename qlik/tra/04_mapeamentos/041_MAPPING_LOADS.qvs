FROM [$(vCaminhoTabelasCorpDicorNge)CONSOLIDADA - Bens Interesse e Descapitalização Izel.xlsx]
(ooxml, embedded labels, table is MapSinteticasIDs)
WHERE MATCH(IPO, 'Sim')
;

// Carrega os flags que indicam se o Item é Ecstasy em comprimidos apreendida conforme taxinomia
// TNBIA
MapEcstasyIDs:
MAPPING LOAD DISTINCT
    "GestãoBens Item Material Subclasse Código",
    'Sim' as Resultado
FROM [$(vCaminhoTabelasCorpDicorNge)CONSOLIDADA - Bens Interesse e Descapitalização Izel.xlsx]
(ooxml, embedded labels, table is MapEcstasyIDs)
WHERE MATCH(IPO, 'Sim')
;

// Carrega os flags que indicam se o "Proc. Tipo Penal" do Proc. Identificação
// é o art. 34 da Lei 11.343/06 para identificar apreensão de precursores de drogas
MapIPLTipoPenalPrecursores:
MAPPING LOAD DISTINCT
    "Proc. Identificação",
    'Sim' as Resultado
RESIDENT TEMP_DIM_CASOS_TIPO_PENAL
WHERE MATCH("Proc. Tipo Penal", 'Art.34, Lei 11343/2006');

