TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Carregando TEMP_TEMP_SIGACrimHomologadas;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
// Carga da TEMP_TEMP_SIGACrimHomologadas para eliminar as duplicidades do campo ID_OPERACAO
// e manter a tabela residente até o fim da carga para montar as tabelas associativas
// de muitos para muitos usando o campo Caso_de_Operação (antigo IPL), pois as outras
// tabelas não tem o campo ID_OPERACAO, mas um Caso_de_Operação (antigo IPL) pode ter
// mais de um ID_OPERACAO.
// As tabelas associativas ID_OPERACAO, Caso_de_Operação (antigo IPL) antes de cada 
// link table servirá para não causar duplicidsade nas tabelas FATO_APREENSOES e 
// FATO_CASOS, pois um caCaso_de_Operação (antigo IPL) pode ter vários ID_OPERACAO 
TEMP_TEMP_TEMP_SIGACrimHomologadas:
LOAD DISTINCT
    ID_OPERACAO, // Chave primária com duplicidade 
    $(vCorrigeIplsSigacrim)
    AS IPL, // Texto
    UF, // Texto
    UNIDADE, // Texto
    ID_AREA_ATRIBUICAO, // Inteiro - REPOSICIONADO
    NOME_OPERACAO, // Texto
    DS_OPERACAO,
    ETAPAOPERACAO,
    DT_INICIO, // Data
    DT_CADASTRO, // Data
    IF(ID_OPERACAO=164,
    	'10/02/2024',
        DT_HOMOLOGACAO) as DT_HOMOLOGACAO, // Data
    DT_DEFLAGRACAO, // Data
    DS_VISIBILIDADE, // Texto
    HOUVE_FASE_OPERACAO_ANTERIOR, // Boleano Sim/Não
    AREAATRIBUICAO,  // Texto
    ID_UNIDADE, // Inteiro
    DIRETORIA, // Texto
    DIRETORIAAREA, // Texto - NOVO
    COORDENACAO, // Texto
    HOUVE_COOPERACAO_POLICIAL, // Boleano Sim/Não
    PAIS_COOPERACAO_POLICIAL, // Array separado por ";"
    ORGANISMO_INTERNACIONAL, // Array separado por ";"
    HOUVE_COOPERACAO_JURIDICA, // Boleano Sim/Não
    PAIS_COOPERACAO_JURIDICA, // Array separado por ";"
    UTILIZACAO_RIF, // Boleano Sim/Não
    TIPO_RIF, // Texto
    QTD_RIF, // Inteiro
    GEOPROCESSAMENTO, // Boleano Sim/Não
    MATERIAL_GENETICO, // Boleano Sim/Não
    AUXILIO_ORGAO_EXTERNO_INVESTIGACAO, // Boleano Sim/Não - NOVO
    NO_ORGAO_COOPERACAO_INVESTIGACAO, // Array separado por ";" - NOVO
    COLAB_PREMIADA, // Boleano Sim/Não
    QTD_COLAB_PREMIADA, // Inteiro
    QUEBRA_DADOS_TELEMATICOS, // Boleano Sim/Não
    QTD_QUEBRA_DADOS_TELEMATICOS, // Inteiro
    QUEBRA_DADOS_TELEFONICOS, // Boleano Sim/Não
    QTD_QUEBRA_DADOS_TELEFONICO, // Inteiro
    ID_SIS, // Array separado por ";"
    QUEBRA_SIGILO_FINANCEIRO, // Boleano Sim/Não
    QTD_QUEBRA_SIGILO_FIN, // Inteiro
    ID_SIMBA, // Array separado por ";"
    QUEBRA_SIGILO_FISCAL, // Boleano Sim/Não
    QTD_QUEBRA_SIGILO_FIS, // Inteiro
    ACAO_CONTROLADA, // Boleano Sim/Não
    QTD_ACAO_CONTROLADA, // Inteiro
    CAPTACAO_AMBIENTAL_SINAIS_MAGNETICOS, // Boleano Sim/Não
    QTD_CAPTACAO_AMBIENTAL_SINAIS_MAGNETICOS, // Inteiro
    AGENTE_INFILTRADO, // Boleano Sim/Não
    QTD_AGENTE_INFILTRADO, // Inteiro
    CRIME_LAVAGEM_DINHEIRO, // Boleano Sim/Não
    DS_ATIVIDADE_ECONOMICA, // Texto
    LAVAGEM_DINHEIRO_ENVOLVE_ATOS_TRANSNACIONAIS, // Boleano Sim/Não
