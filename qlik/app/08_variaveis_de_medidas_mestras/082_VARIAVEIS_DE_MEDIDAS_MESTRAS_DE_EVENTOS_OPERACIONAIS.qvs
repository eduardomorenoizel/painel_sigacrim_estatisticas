            $(vOperHomEmAreaFrontPfEmNumDtMesAnoDefl)
            ),
//////////////////////// Se não selecionado [Ano da Deflagração], [Mês da Deflagração] ou [Data da Deflagração], mostrar [Ano], [Mês] ou [Data]:
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vOperHomEmAreaFrontDtMesAno),
        // números por efetivo
            $(vOperHomEmAreaFrontDtMesAnoPorEfet),
        // números PF EM NÚMEROS
            $(vOperHomEmAreaFrontPfEmNumDtMesAno)
            )
