    QTD_CUMPRIDA_BUSCA_DOMICILIAR, // Inteiro
    QTD_EXPEDIDA_BUSCA_DOMICILIAR, // Inteiro
    QTD_ENDERECOS_BUSCA_DOMICILIAR, // Inteiro
