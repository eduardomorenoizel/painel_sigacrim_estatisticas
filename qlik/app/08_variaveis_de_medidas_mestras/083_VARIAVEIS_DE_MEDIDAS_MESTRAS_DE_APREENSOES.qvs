TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Iniciando carga das variáveis das Medidas Mestras de Apreensões;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;

// Variáveis de medidas mestras em cada tela do APP

/*******************************************************************************
    OBS: 
    - as variáveis de medida mestra que terminam sem 'Tot' deve ser usadas
    nos gráficos que usam dimensões de Unidade ou localizações etc.
    - as variáveis de medida mestra que terminam com 'Tot' deve ser usadas
    nos gráficos que usam dimensões de Data Mês Ano etc. DATA=*TOT
*******************************************************************************/

//-----------------------------------------------------------------------------------------------
// Medidas Mestras de Apreensão
//-----------------------------------------------------------------------------------------------

//-----------------------------------------------------------------------------------------------
// Variáveis auxiliares de seleção de data (evita repetição de GetSelectedCount em todo o script)
//-----------------------------------------------------------------------------------------------
SET vTemSelecaoDatasContextoFato =
    GetSelectedCount([Ano da Deflagração])
    + GetSelectedCount([Mês da Deflagração])
    + GetSelectedCount([Data da Deflagração])
    + GetSelectedCount([Ano da Apreensão])
    + GetSelectedCount([Mês da Apreensão])
    + GetSelectedCount([Data da Apreensão])
    + GetSelectedCount([Proc_Data Data Ano])
    + GetSelectedCount([Proc_Data Data Mês])
    + GetSelectedCount([Proc_Data Data])
    + GetSelectedCount([Ano do Cadastro])
    + GetSelectedCount([Mês do Cadastro])
    + GetSelectedCount([Data do Cadastro])
    + GetSelectedCount([Ano da Instauração])
    + GetSelectedCount([Mês da Instauração])
    + GetSelectedCount([Data da Instauração])
    + GetSelectedCount([Ano do Relatório])
    + GetSelectedCount([Mês do Relatório])
    + GetSelectedCount([Data do Relatório]) > 0
;

SET vTemSelecaoDatasCalendario =
    GetSelectedCount([Ano])
    + GetSelectedCount([Mês])
    + GetSelectedCount([Data]) > 0
;

//-----------------------------------------------------------------------------------------------
// SUBs geradores - etapa 2 de parametrização
//-----------------------------------------------------------------------------------------------

SUB GerarMedidasApreSomAnterMiBi(pAlias, pRadical)
    // vMedidaMestra[Alias]
    SET vMedidaMestra$(pAlias) =
        IF(
            $(vTemSelecaoDatasContextoFato),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)DtMesAnoApre),
                $($(pRadical)DtMesAnoAprePorEfet),
                $($(pRadical)PfEmNumDtMesAnoApre)
            ),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)DtMesAno),
                $($(pRadical)DtMesAnoPorEfet),
                $($(pRadical)PfEmNumDtMesAno)
            )
        )
    ;

    CALL TratarExpansaoMacro(vMedidaMestra$(pAlias));

    // vMedidaMestra[Alias]Tot
    SET vMedidaMestra$(pAlias)Tot =
        IF(
            $(vTemSelecaoDatasContextoFato),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)DtMesAnoApre),
                $($(pRadical)DtMesAnoAprePorEfetTot),
                $($(pRadical)PfEmNumDtMesAnoApre)
            ),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)DtMesAno),
                $($(pRadical)DtMesAnoPorEfetTot),
                $($(pRadical)PfEmNumDtMesAno)
            )
        )
    ;

    CALL TratarExpansaoMacro(vMedidaMestra$(pAlias)Tot);

    // vMedidaMestra[Alias]SomAnter
    SET vMedidaMestra$(pAlias)SomAnter =
        IF(
            $(vTemSelecaoDatasContextoFato),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)SomAnterDtMesAno),
                $($(pRadical)SomAnterDtMesAno),
                $($(pRadical)SomAnterPfEmNumDtMesAno)
            ),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)SomAnterDtMesAnoApre),
                $($(pRadical)SomAnterDtMesAnoApre),
                $($(pRadical)SomAnterPfEmNumDtMesAnoApre)
