//----------------------------------------------------------------------------------------------

CALL GerarMetricaContagemCompletaProcData('vIplComAutIdent', 'vFCasosData', '[Proc_Data IPL Autoria Identificada]');

//----------------------------------------------------------------------------------------------
// Percentual de Inquéritos com Autoria Identificada
//----------------------------------------------------------------------------------------------

CALL GerarPercTotal12ProcData('vPercIplComAutIdent', 'vFCasosData', '[Proc_Data IPL Autoria Identificada]', '[Proc_Data IPL Relatado ID]');

//----------------------------------------------------------------------------------------------
// Inquéritos Não Crime
//----------------------------------------------------------------------------------------------

CALL GerarMetricaContagemCompletaProcData('vIplNaoCrime', 'vFCasosData', '[Proc_Data IPL Não Crime]');

//----------------------------------------------------------------------------------------------
// Percentual de Inquéritos Não Crime
//----------------------------------------------------------------------------------------------

CALL GerarPercTotal12ProcData('vPercIplNaoCrime', 'vFCasosData', '[Proc_Data IPL Não Crime]', '[Proc_Data IPL Relatado ID]');

//----------------------------------------------------------------------------------------------
// Inquéritos Não Solucionados
//----------------------------------------------------------------------------------------------

CALL GerarMetricaContagemCompletaProcData('vIplNaoSoluc', 'vFCasosData', '[Proc_Data IPL Não Solucionado]');

//----------------------------------------------------------------------------------------------
// Percentual de Inquéritos Não Solucionados
//----------------------------------------------------------------------------------------------

CALL GerarPercTotal12ProcData('vPercIplNaoSoluc', 'vFCasosData', '[Proc_Data IPL Não Solucionado]', '[Proc_Data IPL Relatado ID]');

//----------------------------------------------------------------------------------------------
// Percentual de Inquéritos Instaurados por Iniciativa Própria por Instaurados
//----------------------------------------------------------------------------------------------

SET vListaNomeVariavel =
vIplInstInicPropPorInstDtMesAno|
vIplInstInicPropPorInstProcDtDtMesAno|
vIplInstInicPropPorInstAnoAtual|
vIplInstInicPropPorInstProcDtDtAnoAtual|
vIplInstInicPropPorInstAnoAnterior|
vIplInstInicPropPorInstProcDtDtAnoAnterior
;
SET vListaNumerador =
$(vIplInstInicPropPfEmNumDtMesAno)|
$(vIplInstInicPropPfEmNumProcDtDtMesAno)|
$(vIplInstInicPropPfEmNumAnoAtual)|
$(vIplInstInicPropPfEmNumProcDtDtAnoAtual)|
$(vIplInstInicPropPfEmNumAnoAnterior)|
$(vIplInstInicPropPfEmNumProcDtDtAnoAnterior)
;
SET vListaDenominador =
$(vIplInstPfEmNumDtMesAno)|
$(vIplInstPfEmNumProcDtDtMesAno)|
$(vIplInstPfEmNumAnoAtual)|
$(vIplInstPfEmNumProcDtDtAnoAtual)|
$(vIplInstPfEmNumAnoAnterior)|
$(vIplInstPfEmNumProcDtDtAnoAnterior)
;

FOR i = 1 TO 6
    LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
    LET vNumerador = SubField('$(vListaNumerador)', '|', i);
    LET vDenominador = SubField('$(vListaDenominador)', '|', i);
    CALL CriarVariavelRelativaPercentual('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
NEXT i
