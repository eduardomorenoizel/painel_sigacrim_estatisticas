CALL GerarMetricaMiCompleta('vValMonetEspMi',             'vFApreBase', '[5.1 Valores Monetários em espécie LVL2]');
CALL GerarMetricaMiCompleta('vValBacenjudMi',             'vFApreBase', '[5.2 Valores Monetários bloqueados via Bacenjud ou similares LVL2]');
