//-----------------------------------------------------------------------------------------------
// Variáveis de métricas do ePol - versão parametrizada
//-----------------------------------------------------------------------------------------------
// Observações:
//      SomaAnteriores já é o Pareto
//      DtMesAno = cálculo com [Tipo da Data] (datas únicas)
//      ProcDtDt = cálculo sem [Tipo da Data] (correlacionado com outros fatos)
//-----------------------------------------------------------------------------------------------

//==============================================================================================
// SUBROUTINES AUXILIARES
//==============================================================================================

SUB DefinirPrefixoFiltro(vFiltro)
    IF Len(Trim('$(vFiltro)')) > 0 THEN
        LET vPrefixoFiltro = '$(vFiltro),';
    ELSE
        LET vPrefixoFiltro = '';
    ENDIF
END SUB

SUB GerarConjunto12Proc(vFiltro)
    CALL DefinirPrefixoFiltro('$(vFiltro)');
    SET vListaConjunto =
$(vPrefixoFiltro)[Tipo do Fato] = {'Casos_Data'},[Tipo da Data] = {'Evento do Caso'}|
$(vPrefixoFiltro)[Tipo do Fato] = {'Casos_Data'},[Tipo da Data] = {'Evento do Caso'},$(vConjProcDataDtMesAnoPfEmNumeros)|
$(vPrefixoFiltro)[Tipo do Fato] = {'Casos_Data'}|
$(vPrefixoFiltro)[Tipo do Fato] = {'Casos_Data'},$(vConjProcDataDtMesAnoProcDataPfEmNumeros)|
$(vPrefixoFiltro)[Tipo do Fato] = {'Casos_Data'},[Tipo da Data] = {'Evento do Caso'},[Ano] = {@(=Year(Today()))}|
$(vPrefixoFiltro)[Tipo do Fato] = {'Casos_Data'},[Tipo da Data] = {'Evento do Caso'},[Ano] = {@(=Year(Today()))},$(vConjProcDataDtMesAnoPfEmNumeros)|
$(vPrefixoFiltro)[Tipo do Fato] = {'Casos_Data'},[Proc_Data Data Ano] = {@(=Year(Today()))}|
$(vPrefixoFiltro)[Tipo do Fato] = {'Casos_Data'},[Proc_Data Data Ano] = {@(=Year(Today()))},$(vConjProcDataDtMesAnoProcDataPfEmNumeros)|
$(vPrefixoFiltro)[Tipo do Fato] = {'Casos_Data'},[Tipo da Data] = {'Evento do Caso'},[Ano] = {@(=MAX([Ano]-1))}|
$(vPrefixoFiltro)[Tipo do Fato] = {'Casos_Data'},[Tipo da Data] = {'Evento do Caso'},[Ano] = {@(=MAX([Ano]-1))},$(vConjProcDataDtMesAnoPfEmNumeros)|
$(vPrefixoFiltro)[Tipo do Fato] = {'Casos_Data'},[Proc_Data Data Ano] = {@(MAX([Proc_Data Data Ano]-1))}|
$(vPrefixoFiltro)[Tipo do Fato] = {'Casos_Data'},[Proc_Data Data Ano] = {@(MAX([Proc_Data Data Ano]-1))},$(vConjProcDataDtMesAnoProcDataPfEmNumeros)
;
END SUB

