// Título da medida mestra das operações homologadas:
SET vTituloMedidaMestraOperacoesHomologadas = 
IF(
    // Se [Ano] selecionado mostrar vAnoSelecionado
    GetSelectedCount([Ano]) > 0,
    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        'Operações Homologadas em ' & @(vAnoSelecionado),
        'Operações Homologadas por Efetivo em ' & @(vAnoSelecionado),
        'Operações Homologadas PF EM NÚMEROS em ' & @(vAnoSelecionado)
        ),
    IF(
        // Se [Mês] ou [Data] selecionado mostrar MIN([Ano]) a MAX([Ano])
        GetSelectedCount([Mês]) + GetSelectedCount([Data]) > 0,
        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
            'Operações Homologadas de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Operações Homologadas por Efetivo de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Operações Homologadas PF EM NÚMEROS de ' & MIN([Ano]) & ' a '& MAX([Ano])
            ),
        IF(
            // Se [Ano da Deflagração] selecionado mostrar vAnoDeflagracaoSelecionado
            GetSelectedCount([Ano da Deflagração]) > 0,
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                'Operações Homologadas em ' & @(vAnoDeflagracaoSelecionado),
                'Operações Homologadas por Efetivo em ' & @(vAnoDeflagracaoSelecionado),
                'Operações Homologadas PF EM NÚMEROS em ' & @(vAnoDeflagracaoSelecionado)
                ),
            // Se nada selecionado mostrar MIN([Ano da Deflagração]) a MAX([Ano da Deflagração])
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                'Operações Homologadas de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
                'Operações Homologadas por Efetivo de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
                'Operações Homologadas PF EM NÚMEROS de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração])
                )
        )
    )
)
;

Call TratarExpansaoMacro(vTituloMedidaMestraOperacoesHomologadas);

// Título da medida mestra para KPI das operações homologadas:
SET vTituloMedidaMestraKpiOperacoesHomologadas = 
IF(
    // Se [Ano] selecionado mostrar vAnoSelecionado
    GetSelectedCount([Ano]) > 0,
    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        'Operações Homologadas em ' & @(vAnoSelecionado),
        'Operações Homologadas por Efetivo em ' & @(vAnoSelecionado),
        'Operações Homologadas PF EM NÚMEROS em ' & @(vAnoSelecionado)
        ),
    IF(
        // Se [Mês] ou [Data] selecionado mostrar MIN([Ano]) a MAX([Ano])
        GetSelectedCount([Mês]) + GetSelectedCount([Data]) > 0,
        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
            'Operações Homologadas de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Operações Homologadas por Efetivo de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Operações Homologadas PF EM NÚMEROS de ' & MIN([Ano]) & ' a '& MAX([Ano])
            ),
        IF(
            // Se [Ano da Deflagração] selecionado mostrar vAnoDeflagracaoSelecionado
            GetSelectedCount([Ano da Deflagração]) > 0,
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                'Operações Homologadas em ' & @(vAnoDeflagracaoSelecionado),
                'Operações Homologadas por Efetivo em ' & @(vAnoDeflagracaoSelecionado),
                'Operações Homologadas PF EM NÚMEROS em ' & @(vAnoDeflagracaoSelecionado)
                ),
            IF(
                // Se [Mês da Deflagração] ou [Data da Deflagração] selecionado mostrar MIN([Ano da Deflagração]) a MAX([Ano da Deflagração])
                GetSelectedCount([Mês da Deflagração]) + GetSelectedCount([Data da Deflagração]) > 0,                        
                PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    'Operações Homologadas de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
                    'Operações Homologadas por Efetivo de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
                    'Operações Homologadas PF EM NÚMEROS de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração])
                    ),
                // Se nada selecionado mostrar Ano Atual
                PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    'Operações Homologadas em ' & '@(=Year(Today()))',
                    'Operações Homologadas por Efetivo em ' & '@(=Year(Today()))',
                    'Operações Homologadas PF EM NÚMEROS em ' & '@(=Year(Today()))'
                    )
            )
        )
    )
)
;

Call TratarExpansaoMacro(vTituloMedidaMestraKpiOperacoesHomologadas);

// Título curto da medida mestra para KPI das operações homologadas:
SET vTituloCurtoMedidaMestraKpiOperacoesHomologadas = 
IF(
    // Se [Ano] selecionado mostrar vAnoSelecionado
    GetSelectedCount([Ano]) > 0,
    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        'em ' & @(vAnoSelecionado),
        'por Efetivo em ' & @(vAnoSelecionado),
        'PF EM NÚMEROS em ' & @(vAnoSelecionado)
        ),
    IF(
        // Se [Mês] ou [Data] selecionado mostrar MIN([Ano]) a MAX([Ano])
        GetSelectedCount([Mês]) + GetSelectedCount([Data]) > 0,
        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
            'de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'por Efetivo de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'PF EM NÚMEROS de ' & MIN([Ano]) & ' a '& MAX([Ano])
            ),
        IF(
            // Se [Ano da Deflagração] selecionado mostrar vAnoDeflagracaoSelecionado
            GetSelectedCount([Ano da Deflagração]) > 0,
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                'em ' & @(vAnoDeflagracaoSelecionado),
                'por Efetivo em ' & @(vAnoDeflagracaoSelecionado),
                'PF EM NÚMEROS em ' & @(vAnoDeflagracaoSelecionado)
                ),
            IF(
                // Se [Mês da Deflagração] ou [Data da Deflagração] selecionado mostrar MIN([Ano da Deflagração]) a MAX([Ano da Deflagração])
                GetSelectedCount([Mês da Deflagração]) + GetSelectedCount([Data da Deflagração]) > 0,                        
                PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    'de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
                    'por Efetivo de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
                    'PF EM NÚMEROS de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração])
                    ),
                // Se nada selecionado mostrar Ano Atual
                PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    'em ' & '@(=Year(Today()))',
                    'por Efetivo em ' & '@(=Year(Today()))',
                    'PF EM NÚMEROS em ' & '@(=Year(Today()))'
                    )
            )
        )
    )
)
;

Call TratarExpansaoMacro(vTituloCurtoMedidaMestraKpiOperacoesHomologadas);

// Rodapé da medida mestra das operações homologadas:
SET vRodapeMedidaMestraOperacoesHomologadas = 
'Ano anterior: '
&
    IF(
    // Se selecionado [Ano da Deflagração], [Mês da Deflagração] ou [Data da Deflagração]
       GetSelectedCount([Ano da Deflagração])
        + GetSelectedCount([Mês da Deflagração])
        + GetSelectedCount([Data da Deflagração])
        + GetSelectedCount([Ano da Apreensão])
        + GetSelectedCount([Mês da Apreensão])
        + GetSelectedCount([Data da Apreensão])
        + GetSelectedCount([Proc_Data Data Ano])
        + GetSelectedCount([Proc_Data Data Mês])
        + GetSelectedCount([Proc_Data Data])
        + GetSelectedCount([Ano do Cadastro])
        + GetSelectedCount([Mês do Cadastro])
        + GetSelectedCount([Data do Cadastro])
        + GetSelectedCount([Ano da Instauração])
        + GetSelectedCount([Mês da Instauração])
        + GetSelectedCount([Data da Instauração])
        + GetSelectedCount([Ano do Relatório])
        + GetSelectedCount([Mês do Relatório])
        + GetSelectedCount([Data do Relatório]) > 0,
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vOperHomAnoDeflAnterior),
        // números por efetivo
            $(vOperHomAnoDeflAnteriorPorEfet),
        // números PF EM NÚMEROS
            $(vOperHomPfEmNumAnoDeflAnterior)
            ),
//////////////////////// Se não selecionado [Ano da Deflagração], [Mês da Deflagração] ou [Data da Deflagração], mostrar Ano da Deflagração Anterior
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vOperHomAnoAnterior),
        // números por efetivo
            $(vOperHomAnoAnteriorPorEfet),
        // números PF EM NÚMEROS
            $(vOperHomPfEmNumAnoAnterior)
            )
    )
;

Call TratarExpansaoMacro(vRodapeMedidaMestraOperacoesHomologadas);

// Rodapé da medida mestra das operações homologadas TOTAL:
SET vRodapeMedidaMestraOperacoesHomologadasTot = 
'Ano anterior: '
&
    IF(
    // Se selecionado [Ano da Deflagração], [Mês da Deflagração] ou [Data da Deflagração]
       GetSelectedCount([Ano da Deflagração])
        + GetSelectedCount([Mês da Deflagração])
        + GetSelectedCount([Data da Deflagração])
        + GetSelectedCount([Ano da Apreensão])
        + GetSelectedCount([Mês da Apreensão])
        + GetSelectedCount([Data da Apreensão])
        + GetSelectedCount([Proc_Data Data Ano])
        + GetSelectedCount([Proc_Data Data Mês])
        + GetSelectedCount([Proc_Data Data])
        + GetSelectedCount([Ano do Cadastro])
        + GetSelectedCount([Mês do Cadastro])
        + GetSelectedCount([Data do Cadastro])
        + GetSelectedCount([Ano da Instauração])
        + GetSelectedCount([Mês da Instauração])
        + GetSelectedCount([Data da Instauração])
        + GetSelectedCount([Ano do Relatório])
        + GetSelectedCount([Mês do Relatório])
        + GetSelectedCount([Data do Relatório]) > 0,
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vOperHomAnoDeflAnterior),
        // números por efetivo
            $(vOperHomAnoDeflAnteriorPorEfetTot),
        // números PF EM NÚMEROS
            $(vOperHomPfEmNumAnoDeflAnterior)
            ),
//////////////////////// Se não selecionado [Ano da Deflagração], [Mês da Deflagração] ou [Data da Deflagração], mostrar Ano da Deflagração Anterior
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vOperHomAnoAnterior),
        // números por efetivo
            $(vOperHomAnoAnteriorPorEfetTot),
        // números PF EM NÚMEROS
            $(vOperHomPfEmNumAnoAnterior)
            )
    )
;

Call TratarExpansaoMacro(vRodapeMedidaMestraOperacoesHomologadasTot);

//-----------------------------------------------------------------------------------------------
// Cálculo das medidas mestras das Operações Homologadas SÓ PF EM NÚMEROS
//-----------------------------------------------------------------------------------------------

// Medida mestra para KPI das operações homologadas SÓ PF EM NÚMEROS com seleção de Ano, Mês ou Data, para mostrar dados do ano atual quando nada estiver selecionado:
SET vMedidaMestraKpiOperacoesHomologadasSoPfEmNumeros =
IF(
// Se selecionado [Ano], [Mês] ou [Data]
	  GetSelectedCount([Ano])
    + GetSelectedCount([Mês])
    + GetSelectedCount([Data]) > 0,
    PICK(
        @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // números PF EM NÚMEROS
        $(vOperHomPfEmNumDtMesAno),
        // números PF EM NÚMEROS
        $(vOperHomPfEmNumDtMesAno),
        // números PF EM NÚMEROS
        $(vOperHomPfEmNumDtMesAno)
        ),
//////////////////////// Se selecionado [Ano da Deflagração], [Mês da Deflagração] ou [Data da Deflagração]
    IF(
    // Se selecionado [Ano da Deflagração], [Mês da Deflagração] ou [Data da Deflagração]
       GetSelectedCount([Ano da Deflagração])
        + GetSelectedCount([Mês da Deflagração])
        + GetSelectedCount([Data da Deflagração])
        + GetSelectedCount([Ano da Apreensão])
        + GetSelectedCount([Mês da Apreensão])
        + GetSelectedCount([Data da Apreensão])
        + GetSelectedCount([Proc_Data Data Ano])
        + GetSelectedCount([Proc_Data Data Mês])
        + GetSelectedCount([Proc_Data Data])
        + GetSelectedCount([Ano do Cadastro])
        + GetSelectedCount([Mês do Cadastro])
        + GetSelectedCount([Data do Cadastro])
        + GetSelectedCount([Ano da Instauração])
        + GetSelectedCount([Mês da Instauração])
        + GetSelectedCount([Data da Instauração])
        + GetSelectedCount([Ano do Relatório])
        + GetSelectedCount([Mês do Relatório])
        + GetSelectedCount([Data do Relatório]) > 0,
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // números PF EM NÚMEROS
            $(vOperHomPfEmNumDtMesAnoDefl),
        // números PF EM NÚMEROS
            $(vOperHomPfEmNumDtMesAnoDefl),
        // números PF EM NÚMEROS
            $(vOperHomPfEmNumDtMesAnoDefl)
            ),
//////////////////////// Se selecionado nada selecionado mostrar Ano Atual
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // números PF EM NÚMEROS
            $(vOperHomPfEmNumAnoAtual),
        // números PF EM NÚMEROS
            $(vOperHomPfEmNumAnoAtual),
        // números PF EM NÚMEROS
            $(vOperHomPfEmNumAnoAtual)
            )
    )
)
;

Call TratarExpansaoMacro(vMedidaMestraKpiOperacoesHomologadasSoPfEmNumeros);

// Título da medida mestra para KPI das operações homologadas SÓ PF EM NÚMEROS:
SET vTituloMedidaMestraKpiOperacoesHomologadasSoPfEmNumeros = 
IF(
    // Se [Ano] selecionado mostrar vAnoSelecionado
    GetSelectedCount([Ano]) > 0,
    PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        'Operações Homologadas PF EM NÚMEROS em ' & @(vAnoSelecionado),
        'Operações Homologadas PF EM NÚMEROS em ' & @(vAnoSelecionado),
        'Operações Homologadas PF EM NÚMEROS em ' & @(vAnoSelecionado)
        ),
    IF(
        // Se [Mês] ou [Data] selecionado mostrar MIN([Ano]) a MAX([Ano])
        GetSelectedCount([Mês]) + GetSelectedCount([Data]) > 0,
        PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
            'Operações Homologadas PF EM NÚMEROS de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Operações Homologadas PF EM NÚMEROS de ' & MIN([Ano]) & ' a '& MAX([Ano]),
            'Operações Homologadas PF EM NÚMEROS de ' & MIN([Ano]) & ' a '& MAX([Ano])
            ),
        IF(
            // Se [Ano da Deflagração] selecionado mostrar vAnoDeflagracaoSelecionado
            GetSelectedCount([Ano da Deflagração]) > 0,
            PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                'Operações Homologadas PF EM NÚMEROS em ' & @(vAnoDeflagracaoSelecionado),
                'Operações Homologadas PF EM NÚMEROS em ' & @(vAnoDeflagracaoSelecionado),
                'Operações Homologadas PF EM NÚMEROS em ' & @(vAnoDeflagracaoSelecionado)
                ),
            IF(
                // Se [Mês da Deflagração] ou [Data da Deflagração] selecionado mostrar MIN([Ano da Deflagração]) a MAX([Ano da Deflagração])
                GetSelectedCount([Mês da Deflagração]) + GetSelectedCount([Data da Deflagração]) > 0,                        
                PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    'Operações Homologadas PF EM NÚMEROS de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
                    'Operações Homologadas PF EM NÚMEROS de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração]),
                    'Operações Homologadas PF EM NÚMEROS de ' & MIN([Ano da Deflagração]) & ' a '& MAX([Ano da Deflagração])
                    ),
                // Se nada selecionado mostrar Ano Atual
                PICK(@(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                    'Operações Homologadas PF EM NÚMEROS em ' & '@(=Year(Today()))',
                    'Operações Homologadas PF EM NÚMEROS em ' & '@(=Year(Today()))',
                    'Operações Homologadas PF EM NÚMEROS em ' & '@(=Year(Today()))'
                    )
            )
        )
    )
)
;

Call TratarExpansaoMacro(vTituloMedidaMestraKpiOperacoesHomologadasSoPfEmNumeros);

// Título curto da medida mestra para KPI das operações homologadas SÓ PF EM NÚMEROS:
