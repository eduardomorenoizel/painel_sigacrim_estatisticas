//SEÇÃO SIGACrim

TABELA_SIGACRIM:


LOAD
    ID_OPERACAO,
    ID_AREA_ATRIBUICAO,
    IPL,
    UF,
    UNIDADE,
    ID_UNIDADE,
//   AREAATRIBUICAO,
    NOME_OPERACAO,
    DS_OPERACAO,
    ETAPAOPERACAO,
    date(DT_INICIO) as DT_INICIO,
    IF((isnull(DT_HOMOLOGACAO) AND ETAPAOPERACAO = 'Homologada'), Date(DT_DEFLAGRACAO +30), Date(DT_HOMOLOGACAO)) as DT_HOMOLOGACAO,
    Date(DT_DEFLAGRACAO) as DT_DEFLAGRACAO,
    YEAR(date(DT_DEFLAGRACAO)) as DT_ANO_DEFLAGRACAO,
    MONTH(date(DT_DEFLAGRACAO)) as DT_MES_DEFLAGRACAO,
    DS_VISIBILIDADE,
    HOUVE_FASE_OPERACAO_ANTERIOR,
    DIRETORIA,
    DIRETORIAAREA,
    COORDENACAO,
    HOUVE_COOPERACAO_POLICIAL,
    PAIS_COOPERACAO_POLICIAL,
    ORGANISMO_INTERNACIONAL,
    HOUVE_COOPERACAO_JURIDICA,
    PAIS_COOPERACAO_JURIDICA,
    UTILIZACAO_RIF,
    TIPO_RIF,
    QTD_RIF,
    GEOPROCESSAMENTO,
    MATERIAL_GENETICO,
    AUXILIO_ORGAO_EXTERNO,
    NO_ORGAO_COOPERACAO,
    COLAB_PREMIADA,
    QTD_COLAB_PREMIADA,
    QUEBRA_DADOS_TELEMATICOS,
    QTD_QUEBRA_DADOS_TELEMATICOS,
    QUEBRA_DADOS_TELEFONICOS,
    QTD_QUEBRA_DADOS_TELEFONICO,
    QUEBRA_SIGILO_FINANCEIRO,
    QTD_QUEBRA_SIGILO_FIN,
    QUEBRA_SIGILO_FISCAL,
    QTD_QUEBRA_SIGILO_FIS,
    ACAO_CONTROLADA,
    QTD_ACAO_CONTROLADA,
    CAPTACAO_AMBIENTAL_SINAIS_MAGNETICOS,
    QTD_CAPTACAO_AMBIENTAL_SINAIS_MAGNETICOS,
    AGENTE_INFILTRADO,
    QTD_AGENTE_INFILTRADO,
    CRIME_LAVAGEM_DINHEIRO,
    DS_ATIVIDADE_ECONOMICA,
    LAVAGEM_DINHEIRO_ENVOLVE_ATOS_TRANSNACIONAIS,
    LAVAGEM_DINHEIRO_TIPOLOGIAS,
    EVASAO_DIVISAS,
    DS_MEIO_EVASAO_DIVISA,
    PAIS_EVASAO_DIVISAS,
    CRIME_TRANSNACIONAL,
    PAIS_CRIME_TRANSNACIONAL,
    CRIME_INTERESTADUAL,
    UF_CRIME_INTERESTADUAL,
    FACCAO_CRIMINOSA,
    FACCAO_DESCRICAO,
    AREA_FRONTEIRA,
    PAIS_FRONTEIRA,
    GRUPO_EXTERMINIO_MILICIA,
    TERRA_INDIGENA,
    DS_TERRA_INDIGENA,
    ENVOLVE_UNIDADE_CONSERVACAO,
    UNIDADE_CONSERVACAO,
    ENVOLVE_AREA_PRIORITARIA,
    CRIPTOATIVO,
    RELACIONADA_PROMETHEUS,
    PREENCHIDO_DADOS_PROMETHEUS,
    QTD_NOTICIAS_PROMETHEUS,
    TENTACULOS,
    TENTACULOS_IPJ_ENVIADA_CBAN,
    VL_TENTACULOS_FRAUDE,
    QTD_NOTICIAS_TENTACULOS,
    TENTACULOS_SEI_IPJ,
    PRE_DT_PREVISTA_DEFLAGRACAO,
    if( ((date(DT_DEFLAGRACAO) >= Today()) OR (isnull(date(DT_DEFLAGRACAO))) ) AND (date(PRE_DT_PREVISTA_DEFLAGRACAO) >= Today() ) AND (date(PRE_DT_PREVISTA_DEFLAGRACAO) <= Today()+30), 'OPERAÇÕES PRÓX. 30 DIAS') as PRE_OPS_PROX_30D,
    if( ((date(DT_DEFLAGRACAO) >= Today()) OR (isnull(date(DT_DEFLAGRACAO))) )  AND (date(PRE_DT_PREVISTA_DEFLAGRACAO) >= Today() ), 'OPERAÇÕES COM DATA PREVISTA') as PRE_OPS_PREVISTAS,
    if( ((date(DT_DEFLAGRACAO) >= Today()) OR (isnull(date(DT_DEFLAGRACAO))) )  AND (Today() - Date(PRE_DT_PREVISTA_DEFLAGRACAO) >0), 'OPERAÇÕES COM DATA VENCIDA')   as PRE_OPS_DT_VENCIDA,
//     PRE_NR_REGISTROS_ESPECIAIS,
//     PRE_BUSCA_DOMICILIA_PRE_DEFLAGRADA,
//     PRE_QTD_PREVISTA_BUSCA_DOMICILIA_PRE_DEFLAGRADA,
//     PRE_PRISAO_TEMPORARIA_PRE_DEFLAGRADA,
//     PRE_QTD_PREVISTA_PRISAO_TEMPORARIA_PRE_DEFLAGRADA,
//     PRE_PRISAO_PREVENTIVA_PRE_DEFLAGRADA,
//     PRE_QTD_PREVISTA_PRISAO_PREVENTIVA_PRE_DEFLAGRADA,
//     PRE_PREVISAO_CUMPRIMENTO_SEQUESTRO_BENS_E_OUTRAS_MEDIDAS,
//     "PRE_VL_ESTIMADO_EM_R$",
//     PRE_PREVISAO_CUMPRIMENTO_MEDIDAS_CAUTELARES,
//     PRE_PREVISAO_AUXILIO_ORGAO_EXTERNO,
//     PRE_NO_ORGAO_COOPERACAO,
//     PRE_PREVISAO_AUXILIO_GRUPO_TATICO,
//     PRE_DS_GRUPO_TATICO,
//     PRE_PREVISÃO_CUMPRIMENTO_MEDIDAS_CAUTELARES_DESFAVOR_ADVOGADOS,
//     PRE_PREVISÃO_CUMPRIMENTO_MEDIDAS_CAUTELARES_DESFAVOR_FUNCIONARIO_PUBLICO,
//     PRE_PREVISÃO_CUMPRIMENTO_MEDIDAS_CAUTELARES_DESFAVOR_PESSOAS_PRERROGATIVA_FORO,
//     PRE_OB_PRE_DEFLAGRACAO,
    BUSCA_DOMICILIAR,
    QTD_CUMPRIDA_BUSCA_DOMICILIAR,
    QTD_EXPEDIDA_BUSCA_DOMICILIAR,
    QTD_ENDERECOS_BUSCA_DOMICILIAR,
    PRISAO_TEMPORARIA,
    QTD_CUMPRIDA_PRISAO_TEMPORARIA,
    QTD_EXPEDIDA_PRISAO_TEMPORARIA,
    PRISAO_PREVENTIVA,
    QTD_CUMPRIDA_PRISAO_PREVENTIVA,
    QTD_EXPEDIDA_PRISAO_PREVENTIVA,
    SEQUESTRO,
    VL_TOTAL_SEQUESTRO,
    VL_SEQUESTRO_VALOR_MOVEIS,
    VL_SEQUESTRO_VALOR_BLOQUEADO_FINANCEIRO,
    VL_SEQUESTRO_VALOR_ESTIMADO_IMOVEIS,
    VL_SEQUESTRO_VALOR_CRIPTO,
    VL_TETO_SEQUESTRO,
    EXPEDICAO_MEDIDAS_CAUTELARES,
    MEDIDAS_CAUTELARES_JUIZO,
    QTD_MEDIDA_CAUTELARES_JUIZO,
    MEDIDAS_CAUTELARES_PROIBICAO_ACESSO,
    QTD_MEDIDAS_CAUTELARES_PROIBICAO_ACESSO,
    MEDIDAS_CAUTELARES_PROIBICAO_CONTATO,
    QTD_MEDIDAS_CAUTELARES_PROIBICAO_CONTATO,
    MEDIDAS_CAUTELARES_PROIBICAO_AUSENTAR_COMARCA,
    QTD_MEDIDAS_CAUTELARES_PROIBICAO_AUSENTAR_COMARCA,
    MEDIDAS_CAUTELARES_RECOLHIMENTO_DOMICILIAR,
    QTD_MEDIDAS_CAUTELARES_RECOLHIMENTO_DOMICILIAR,
    MEDIDAS_CAUTELARES_SUSPENSAO_EXERCICIO,
    QTD_MEDIDAS_CAUTELARES_SUSPENSAO_EXERCICIO,
    MEDIDAS_CAUTELARES_INTERNACAO_PROVISORIA,
    QTD_MEDIDAS_CAUTELARES_INTERNACAO_PROVISORIA,
    MEDIDAS_CAUTELARES_FIANCA,
    QTD_MEDIDAS_CAUTELARES_FIANCA,
    MEDIDAS_CAUTELARES_MONITORACAO_ELETRONICA,
    QTD_MEDIDAS_CAUTELARES_MONITORACAO_ELETRONICA,
    MEDIDAS_CAUTELARES_PROIBICAO_AUSENTAR_PAIS,
    QTD_MEDIDAS_CAUTELARES_PROIBICAO_AUSENTAR_PAIS,
    RESGATE_VITIMA_TRAFICO_PESSOAS,
    if(isnull(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_HOMENS_ADULTOS),0,QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_HOMENS_ADULTOS) as QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_HOMENS_ADULTOS,
    if(isnull(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_MULHERES_ADULTAS),0,QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_MULHERES_ADULTAS) as QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_MULHERES_ADULTAS,
    if(isnull(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO),0,QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO) as QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO,
    if(isnull(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO),0,QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO) as QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO,
    if(isnull(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_BRASILEIROS_MASCULINOS),0,QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_BRASILEIROS_MASCULINOS) as QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_BRASILEIROS_MASCULINOS,
    if(isnull(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_BRASILEIROS_FEMININOS),0,QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_BRASILEIROS_FEMININOS) as QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_BRASILEIROS_FEMININOS,
    if(isnull(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_ESTRANGEIROS_MASCULINOS),0,QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_ESTRANGEIROS_MASCULINOS) as QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_ESTRANGEIROS_MASCULINOS,
    if(isnull(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_ESTRANGEIROS_FEMININOS),0,QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_ESTRANGEIROS_FEMININOS) as QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_ESTRANGEIROS_FEMININOS,
    if(isnull(QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_NAO_HETEROSSEXUAIS),0,QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_NAO_HETEROSSEXUAIS) as QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_NAO_HETEROSSEXUAIS,
    //QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_HOMENS_ADULTOS + QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_MULHERES_ADULTAS + QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO + QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO as QTD_RESGATE_VIT_TRAF_TOTAL1,
    //QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_BRASILEIROS_MASCULINOS + QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_BRASILEIROS_FEMININOS + QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_ESTRANGEIROS_MASCULINOS + QTD_RESGATE_VITIMA_TRAFICO_PESSOAS_ESTRANGEIROS_FEMININOS as QTD_RESGATE_VIT_TRAF_TOTAL2,
    RESGATE_VITIMA_MIGRACAO_ILEGAL,
    if(isnull(QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_HOMENS_ADULTOS),0,QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_HOMENS_ADULTOS) as QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_HOMENS_ADULTOS,
    if(isnull(QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_MULHERES_ADULTAS),0,QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_MULHERES_ADULTAS) as QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_MULHERES_ADULTAS,
    if(isnull(QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO),0,QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO) as QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO,
    if(isnull(QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO),0, QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO) as  QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO,
    if(ISNULL(QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_BRASILEIROS_MASCULINOS), 0, QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_BRASILEIROS_MASCULINOS) AS QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_BRASILEIROS_MASCULINOS,
    if(ISNULL(QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_BRASILEIROS_FEMININOS), 0, QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_BRASILEIROS_FEMININOS) AS QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_BRASILEIROS_FEMININOS,
    if(ISNULL(QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_ESTRANGEIROS_MASCULINOS), 0, QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_ESTRANGEIROS_MASCULINOS) AS QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_ESTRANGEIROS_MASCULINOS,
    if(ISNULL(QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_ESTRANGEIROS_FEMININOS), 0, QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_ESTRANGEIROS_FEMININOS) AS QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_ESTRANGEIROS_FEMININOS,
    if(ISNULL(QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_NAO_HETEROSSEXUAIS), 0, QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_NAO_HETEROSSEXUAIS) AS QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_NAO_HETEROSSEXUAIS,
    //QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_HOMENS_ADULTOS + QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_MULHERES_ADULTAS + QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO + QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO as QTD_RESGATE_VIT_MIGR_TOTAL1,
    //QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_BRASILEIROS_MASCULINOS + QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_BRASILEIROS_FEMININOS + QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_ESTRANGEIROS_MASCULINOS + QTD_RESGATE_VITIMA_MIGRACAO_ILEGAL_ESTRANGEIROS_FEMININOS as QTD_RESGATE_VIT_MIGR_TOTAL2,
    RESGATE_VITIMA_ORDEM_TRABALHO,
    if(ISNULL(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_HOMENS_ADULTOS), 0, QTD_RESGATE_VITIMA_ORDEM_TRABALHO_HOMENS_ADULTOS) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_HOMENS_ADULTOS,
    if(ISNULL(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_MULHERES_ADULTAS), 0, QTD_RESGATE_VITIMA_ORDEM_TRABALHO_MULHERES_ADULTAS) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_MULHERES_ADULTAS,
    if(ISNULL(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO), 0, QTD_RESGATE_VITIMA_ORDEM_TRABALHO_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO,
    if(ISNULL(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO), 0, QTD_RESGATE_VITIMA_ORDEM_TRABALHO_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO,
    IF(ISNULL(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_BRASILEIROS_MASCULINOS), 0, QTD_RESGATE_VITIMA_ORDEM_TRABALHO_BRASILEIROS_MASCULINOS) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_BRASILEIROS_MASCULINOS,
    IF(ISNULL(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_BRASILEIROS_FEMININOS), 0, QTD_RESGATE_VITIMA_ORDEM_TRABALHO_BRASILEIROS_FEMININOS) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_BRASILEIROS_FEMININOS,
    IF(ISNULL(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_ESTRANGEIROS_MASCULINOS), 0, QTD_RESGATE_VITIMA_ORDEM_TRABALHO_ESTRANGEIROS_MASCULINOS) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_ESTRANGEIROS_MASCULINOS,
    IF(ISNULL(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_ESTRANGEIROS_FEMININOS), 0, QTD_RESGATE_VITIMA_ORDEM_TRABALHO_ESTRANGEIROS_FEMININOS) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_ESTRANGEIROS_FEMININOS,
    IF(ISNULL(QTD_RESGATE_VITIMA_ORDEM_TRABALHO_NAO_HETEROSSEXUAIS), 0, QTD_RESGATE_VITIMA_ORDEM_TRABALHO_NAO_HETEROSSEXUAIS) AS QTD_RESGATE_VITIMA_ORDEM_TRABALHO_NAO_HETEROSSEXUAIS,
    //QTD_RESGATE_VITIMA_ORDEM_TRABALHO_HOMENS_ADULTOS + QTD_RESGATE_VITIMA_ORDEM_TRABALHO_MULHERES_ADULTAS + QTD_RESGATE_VITIMA_ORDEM_TRABALHO_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO +  QTD_RESGATE_VITIMA_ORDEM_TRABALHO_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO as QTD_RESGATE_VIT_ESCR_TOTAL1,
    //QTD_RESGATE_VITIMA_ORDEM_TRABALHO_BRASILEIROS_MASCULINOS + QTD_RESGATE_VITIMA_ORDEM_TRABALHO_BRASILEIROS_FEMININOS + QTD_RESGATE_VITIMA_ORDEM_TRABALHO_ESTRANGEIROS_MASCULINOS + QTD_RESGATE_VITIMA_ORDEM_TRABALHO_ESTRANGEIROS_FEMININOS as QTD_RESGATE_VIT_ESCR_TOTAL2,
    RESGATE_VITIMA_GRUPO_EXTERMINIO,
    if(isnull(QTD_GRUPO_EXTERMINIO_HOMENS_ADULTOS),0, QTD_GRUPO_EXTERMINIO_HOMENS_ADULTOS) as QTD_GRUPO_EXTERMINIO_HOMENS_ADULTOS,
    if(isnull(QTD_GRUPO_EXTERMINIO_MULHERES_ADULTAS),0, QTD_GRUPO_EXTERMINIO_MULHERES_ADULTAS) as QTD_GRUPO_EXTERMINIO_MULHERES_ADULTAS,
    if(isnull(QTD_GRUPO_EXTERMINIO_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO),0, QTD_GRUPO_EXTERMINIO_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO) as QTD_GRUPO_EXTERMINIO_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO,
    if(isnull(QTD_GRUPO_EXTERMINIO_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO),0, QTD_GRUPO_EXTERMINIO_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO) as QTD_GRUPO_EXTERMINIO_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO,
    if(isnull(QTD_GRUPO_EXTERMINIO_BRASILEIROS_MASCULINOS),0, QTD_GRUPO_EXTERMINIO_BRASILEIROS_MASCULINOS) as QTD_GRUPO_EXTERMINIO_BRASILEIROS_MASCULINOS,
    if(isnull(QTD_GRUPO_EXTERMINIO_BRASILEIROS_FEMININOS),0, QTD_GRUPO_EXTERMINIO_BRASILEIROS_FEMININOS) as QTD_GRUPO_EXTERMINIO_BRASILEIROS_FEMININOS,
    if(isnull(QTD_GRUPO_EXTERMINIO_ESTRANGEIROS_MASCULINOS),0, QTD_GRUPO_EXTERMINIO_ESTRANGEIROS_MASCULINOS) as QTD_GRUPO_EXTERMINIO_ESTRANGEIROS_MASCULINOS,
    if(isnull(QTD_GRUPO_EXTERMINIO_ESTRANGEIROS_FEMININOS),0, QTD_GRUPO_EXTERMINIO_ESTRANGEIROS_FEMININOS) as QTD_GRUPO_EXTERMINIO_ESTRANGEIROS_FEMININOS,
    if(isnull(QTD_GRUPO_EXTERMINIO_VITIMAS_NAO_HETEROSSEXUAIS),0, QTD_GRUPO_EXTERMINIO_VITIMAS_NAO_HETEROSSEXUAIS) as QTD_GRUPO_EXTERMINIO_VITIMAS_NAO_HETEROSSEXUAIS,
    //QTD_GRUPO_EXTERMINIO_HOMENS_ADULTOS + QTD_GRUPO_EXTERMINIO_MULHERES_ADULTAS + QTD_GRUPO_EXTERMINIO_CRIANCAS_E_ADOLESCENTES_SEXO_MASCULINO + QTD_GRUPO_EXTERMINIO_CRIANCAS_E_ADOLESCENTES_SEXO_FEMININO as QTD_RESGATE_VIT_EXT_TOTAL1,
    //QTD_GRUPO_EXTERMINIO_BRASILEIROS_MASCULINOS + QTD_GRUPO_EXTERMINIO_BRASILEIROS_FEMININOS +  QTD_GRUPO_EXTERMINIO_ESTRANGEIROS_MASCULINOS + QTD_GRUPO_EXTERMINIO_ESTRANGEIROS_FEMININOS as QTD_RESGATE_VIT_EXT_TOTAL2,
    IDENTIFICACAO_VITIMA_ABUSO,
    if(isnull(QTD_IDENT_VIT_ABUSO_0_A_11_ANOS_FEMININO), 0,QTD_IDENT_VIT_ABUSO_0_A_11_ANOS_FEMININO) as QTD_IDENT_VIT_ABUSO_0_A_11_ANOS_FEMININO,
    if(isnull(QTD_IDENT_VIT_ABUSO_0_A_11_ANOS_MASCULINO), 0, QTD_IDENT_VIT_ABUSO_0_A_11_ANOS_MASCULINO) as QTD_IDENT_VIT_ABUSO_0_A_11_ANOS_MASCULINO,
    if(isnull(QTD_IDENT_VIT_ABUSO_12_A_17_ANOS_MASCULINO), 0, QTD_IDENT_VIT_ABUSO_12_A_17_ANOS_MASCULINO) as QTD_IDENT_VIT_ABUSO_12_A_17_ANOS_MASCULINO,
    if(isnull(QTD_IDENT_VIT_ABUSO_12_A_17_ANOS_FEMININO), 0, QTD_IDENT_VIT_ABUSO_12_A_17_ANOS_FEMININO) as QTD_IDENT_VIT_ABUSO_12_A_17_ANOS_FEMININO,
    RESGATE_VITIMA_ABUSO,
    if(isnull(QTD_VITIMA_ABUSO_RESGATADA_0_A_11_ANOS_FEMININO), 0,QTD_VITIMA_ABUSO_RESGATADA_0_A_11_ANOS_FEMININO) as QTD_VITIMA_ABUSO_RESGATADA_0_A_11_ANOS_FEMININO,
    if(isnull(QTD_VITIMA_ABUSO_RESGATADA_0_A_11_ANOS_MASCULINO), 0,QTD_VITIMA_ABUSO_RESGATADA_0_A_11_ANOS_MASCULINO) as QTD_VITIMA_ABUSO_RESGATADA_0_A_11_ANOS_MASCULINO,
    if(isnull(QTD_VITIMA_ABUSO_RESGATADA_12_A_17_ANOS_MASCULINO), 0,QTD_VITIMA_ABUSO_RESGATADA_12_A_17_ANOS_MASCULINO) as QTD_VITIMA_ABUSO_RESGATADA_12_A_17_ANOS_MASCULINO,
    if(isnull(QTD_VITIMA_ABUSO_RESGATADA_12_A_17_ANOS_FEMININO), 0 ,QTD_VITIMA_ABUSO_RESGATADA_12_A_17_ANOS_FEMININO) as QTD_VITIMA_ABUSO_RESGATADA_12_A_17_ANOS_FEMININO,
