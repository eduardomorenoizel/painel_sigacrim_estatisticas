//-----------------------------------------------------------------------------------------------

//-----------------------------------------------------------------------------------------------
// GERAÇÃO AUTOMÁTICA DE VARIÁVEIS DE MÉTRICAS DE EFETIVO
//
// Para adicionar um novo grupo de servidores:
//   1. Defina a variável de conjunto acima (na seção "Filtros para Conjuntos de Servidores"):
//        SET vConjServidores{NovoSufixo} = [Campo] = {'Valor'}, ...;
//
//   2. Adicione uma linha nas tabelas abaixo com:
//        NovoSufixo, vConjServidoresNovoSufixo
//
// As variáveis a seguir são geradas automaticamente:
//   vQtdServ{Sufixo}          → contagem formatada
//   vQtdServ{Sufixo}Total     → contagem total (TOTAL)
//   vQtdServ{Sufixo}SomAnter  → proporção acumulada (RangeSum/Total)
//   vServ{Sufixo}             → denominador (sem filtro de Caso/Operação)
//   vServ{Sufixo}Total        → denominador total
//   vServ{Sufixo}UnidOpApreCaso → denominador por unidade (sem filtro de data)
//-----------------------------------------------------------------------------------------------


//-----------------------------------------------------------------------------------------------
// SEÇÃO 1: vQtdServ — Quantidades de efetivo por grupo
// Gera: vQtdServ{Sufixo}, vQtdServ{Sufixo}Total, vQtdServ{Sufixo}SomAnter
//-----------------------------------------------------------------------------------------------

TabelaQtdServEfetivo:
LOAD * INLINE [
    Sufixo,                          ConjVariavel
    PFComSede,                       vConjServidoresPFComSede
    PF,                              vConjServidoresPF
    PFSede,                          vConjServidoresPFSede
    PFSR,                            vConjServidoresPFSR
    PFDescentralizadas,              vConjServidoresPFDescentralizadas
    PFBases,                         vConjServidoresPFBases
    PFDelegaciasEspecializadasPJ,    vConjServidoresPFDelegaciasEspecializadasPJ
    NPFComSede,                      vConjServidoresNPFComSede
    NPF,                             vConjServidoresNPF
    NPFSede,                         vConjServidoresNPFSede
    NPFSR,                           vConjServidoresNPFSR
    NPFDescentralizadas,             vConjServidoresNPFDescentralizadas
    NPFBases,                        vConjServidoresNPFBases
    NPFDelegaciasEspecializadasPJ,   vConjServidoresNPFDelegaciasEspecializadasPJ
    PJComSede,                       vConjServidoresPJComSede
    PJ,                              vConjServidoresPJ
    PJSede,                          vConjServidoresPJSede
    PJSR,                            vConjServidoresPJSR
    PJDescentralizadas,              vConjServidoresPJDescentralizadas
    PJBases,                         vConjServidoresPJBases
    PJDelegaciasEspecializadasPJ,    vConjServidoresPJDelegaciasEspecializadasPJ
    NPJComSede,                      vConjServidoresNPJComSede
    NPJ,                             vConjServidoresNPJ
    NPJSede,                         vConjServidoresNPJSede
    NPJSR,                           vConjServidoresNPJSR
    NPJDescentralizadas,             vConjServidoresNPJDescentralizadas
    NPJBases,                        vConjServidoresNPJBases
    NPJDelegaciasEspecializadasPJ,   vConjServidoresNPJDelegaciasEspecializadasPJ
    PolComSede,                      vConjServidoresPolComSede
    Pol,                             vConjServidoresPol
    DPFComSede,                      vConjServidoresDPFComSede
    DPF,                             vConjServidoresDPF
    DPFSede,                          vConjServidoresDPFSede
    DPFSR,                           vConjServidoresDPFSR
    DPFDescentralizadas,             vConjServidoresDPFDescentralizadas
    DPFBases,                        vConjServidoresDPFBases
    DPFDelegaciasEspecializadasPJ,   vConjServidoresDPFDelegaciasEspecializadasPJ
    APFComSede,                      vConjServidoresAPFComSede
    APF,                             vConjServidoresAPF
    APFSede,                          vConjServidoresAPFSede
    APFSR,                           vConjServidoresAPFSR
    APFDescentralizadas,             vConjServidoresAPFDescentralizadas
