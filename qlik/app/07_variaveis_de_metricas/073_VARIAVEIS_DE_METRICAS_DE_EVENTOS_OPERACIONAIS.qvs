/*----------------------------------------------------------------------------------------------
    SUB _GerarListasProporcao12Even(vRadical, vRadicalNum, vRadicalDen)
    Helper interno: gera vListaNomeVariavel, vListaNumerador, vListaDenominador
    para 12 variáveis de proporção a partir dos radicais do numerador e denominador.
----------------------------------------------------------------------------------------------*/
SUB _GerarListasProporcao12Even(vRadical, vRadicalNum, vRadicalDen)
    SET vListaNomeVariavel =
$(vRadical)DtMesAno|
$(vRadical)PfEmNumDtMesAno|
$(vRadical)DtMesAnoEven|
$(vRadical)PfEmNumDtMesAnoEven|
$(vRadical)AnoAtual|
$(vRadical)PfEmNumAnoAtual|
$(vRadical)AnoEvenAtual|
$(vRadical)PfEmNumAnoEvenAtual|
$(vRadical)AnoAnterior|
$(vRadical)PfEmNumAnoAnterior|
$(vRadical)AnoEvenAnterior|
$(vRadical)PfEmNumAnoEvenAnterior
;
    SET vListaNumerador =
$($(vRadicalNum)DtMesAno)|
$($(vRadicalNum)PfEmNumDtMesAno)|
$($(vRadicalNum)DtMesAnoEven)|
$($(vRadicalNum)PfEmNumDtMesAnoEven)|
$($(vRadicalNum)AnoAtual)|
$($(vRadicalNum)PfEmNumAnoAtual)|
$($(vRadicalNum)AnoEvenAtual)|
$($(vRadicalNum)PfEmNumAnoEvenAtual)|
$($(vRadicalNum)AnoAnterior)|
$($(vRadicalNum)PfEmNumAnoAnterior)|
$($(vRadicalNum)AnoEvenAnterior)|
$($(vRadicalNum)PfEmNumAnoEvenAnterior)
;
    SET vListaDenominador =
$($(vRadicalDen)DtMesAno)|
$($(vRadicalDen)PfEmNumDtMesAno)|
$($(vRadicalDen)DtMesAnoEven)|
$($(vRadicalDen)PfEmNumDtMesAnoEven)|
$($(vRadicalDen)AnoAtual)|
$($(vRadicalDen)PfEmNumAnoAtual)|
$($(vRadicalDen)AnoEvenAtual)|
$($(vRadicalDen)PfEmNumAnoEvenAtual)|
$($(vRadicalDen)AnoAnterior)|
$($(vRadicalDen)PfEmNumAnoAnterior)|
$($(vRadicalDen)AnoEvenAnterior)|
$($(vRadicalDen)PfEmNumAnoEvenAnterior)
;
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarProporcao12Even(vRadical, vRadicalNum, vRadicalDen)
    Gera 12 variáveis de proporção relativa (CriarVariavelRelativa):
      vRadical[Sufixo] = vRadicalNum[Sufixo] / vRadicalDen[Sufixo]
----------------------------------------------------------------------------------------------*/
SUB GerarProporcao12Even(vRadical, vRadicalNum, vRadicalDen)
    CALL _GerarListasProporcao12Even('$(vRadical)', '$(vRadicalNum)', '$(vRadicalDen)');
    FOR i = 1 TO 12
        LET vNomeVariavel = SubField('$(vListaNomeVariavel)', '|', i);
        LET vNumerador = SubField('$(vListaNumerador)', '|', i);
        LET vDenominador = SubField('$(vListaDenominador)', '|', i);
        CALL CriarVariavelRelativa('$(vNomeVariavel)', '$(vNumerador)', '$(vDenominador)');
    NEXT i
END SUB

/*----------------------------------------------------------------------------------------------
    SUB GerarProporcaoPercentual12Even(vRadical, vRadicalNum, vRadicalDen)
    Gera 12 variáveis de proporção percentual (CriarVariavelRelativaPercentual):
      vRadical[Sufixo] = vRadicalNum[Sufixo] / vRadicalDen[Sufixo] * 100
----------------------------------------------------------------------------------------------*/
SUB GerarProporcaoPercentual12Even(vRadical, vRadicalNum, vRadicalDen)
