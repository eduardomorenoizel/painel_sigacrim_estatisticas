        // Valores relativos ao efetivo
            $(vVitGrupExtEmOperAnoAnteriorPorEfet),
        // Valores PF EM NÚMEROS
            $(vVitGrupExtEmOperPfEmNumAnoAnterior)
            )
    )
;

