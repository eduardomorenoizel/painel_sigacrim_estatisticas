            $(vTemSelecaoDatasContextoFato),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)MiDtMesAnoApre),
                $($(pRadical)MiDtMesAnoAprePorEfet),
                $($(pRadical)MiPfEmNumDtMesAnoApre)
            ),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)MiDtMesAno),
                $($(pRadical)MiDtMesAnoPorEfet),
                $($(pRadical)MiPfEmNumDtMesAno)
            )
        )
    ;

    CALL TratarExpansaoMacro(vMedidaMestra$(pAlias)Mi);

    // vMedidaMestra[Alias]MiTot
    SET vMedidaMestra$(pAlias)MiTot =
        IF(
            $(vTemSelecaoDatasContextoFato),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)MiDtMesAnoApre),
                $($(pRadical)MiDtMesAnoAprePorEfetTot),
                $($(pRadical)MiPfEmNumDtMesAnoApre)
            ),
            PICK(
                @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
                $($(pRadical)MiDtMesAno),
                $($(pRadical)MiDtMesAnoPorEfetTot),
                $($(pRadical)MiPfEmNumDtMesAno)
            )
        )
    ;

    CALL TratarExpansaoMacro(vMedidaMestra$(pAlias)MiTot);

    // vMedidaMestra[Alias]Bi
    SET vMedidaMestra$(pAlias)Bi =
