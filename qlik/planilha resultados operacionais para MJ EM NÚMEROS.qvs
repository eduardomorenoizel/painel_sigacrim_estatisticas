TABELA_EPOL:
left Keep (TABELA_SIGACRIM)

LOAD
   "Procedimento ID",
    "Proc. Crime CEP",
    "Proc. Órgão Vítima Original",
    "Proc. Escrivão Matrícula",
    "Proc. Delegado Matrícula",
    "Proc. Identificação",
    SubField(KeepChar("Proc. Identificação", '0123456789.'),'.',1 ) & '.' & Right('0000000' & SubField((KeepChar("Proc. Identificação", '0123456789.')), '.', 2), 7)  as IPL,
    "Proc. Link",
    "Proc. NC ID",
    "Proc. Protocolo",
    "Proc. Processo #",
    "Proc. Processo Seção",
    "Proc. Processo Tribunal",
    "Proc. Processo Vara",
    "Proc. Processo MPF",
