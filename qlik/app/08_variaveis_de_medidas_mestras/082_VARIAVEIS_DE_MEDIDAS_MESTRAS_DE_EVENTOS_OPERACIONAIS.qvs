TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;
TRACE >>> Iniciando carga das Medidas Mestras Operacionais;
TRACE >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>;

// Variáveis de medidas mestras em cada tela do APP

/*******************************************************************************
    OBS: 
    - as variáveis de medida mestra que terminam sem 'Tot' deve ser usadas
    nos gráficos que usam dimensões de Unidade ou localizações etc.
    - as variáveis de medida mestra que terminam com 'Tot' deve ser usadas
    nos gráficos que usam dimensões de Data Mês Ano etc. DATA=*TOT
*******************************************************************************/

//-----------------------------------------------------------------------------------------------
// Medidas Mestras Operacionais
//-----------------------------------------------------------------------------------------------

//-----------------------------------------------------------------------------------------------
// Cálculo das medidas mestras das Operações Homologadas relativas:
//      - numeros absolutos
//      - números por efetivo
//      - números PF EM NÚMEROS
//-----------------------------------------------------------------------------------------------

// Medida mestra das operações homologadas com seleção de Ano, Mês ou Data:
SET vMedidaMestraOperacoesHomologadas =
    IF(
    // Se selecionado [Ano da Deflagração], [Mês da Deflagração] ou [Data da Deflagração]
       GetSelectedCount([Ano da Deflagração])
        + GetSelectedCount([Mês da Deflagração])
        + GetSelectedCount([Data da Deflagração])
        + GetSelectedCount([Ano da Apreensão])
        + GetSelectedCount([Mês da Apreensão])
        + GetSelectedCount([Data da Apreensão])
        + GetSelectedCount([Proc_Data Data Ano])
        + GetSelectedCount([Proc_Data Data Mês])
        + GetSelectedCount([Proc_Data Data])
        + GetSelectedCount([Ano do Cadastro])
        + GetSelectedCount([Mês do Cadastro])
        + GetSelectedCount([Data do Cadastro])
        + GetSelectedCount([Ano da Instauração])
        + GetSelectedCount([Mês da Instauração])
        + GetSelectedCount([Data da Instauração])
        + GetSelectedCount([Ano do Relatório])
        + GetSelectedCount([Mês do Relatório])
        + GetSelectedCount([Data do Relatório]) > 0,
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vOperHomDtMesAnoDefl),
        // números por efetivo
            $(vOperHomDtMesAnoDeflPorEfet),
        // números PF EM NÚMEROS
            $(vOperHomPfEmNumDtMesAnoDefl)
            ),
//////////////////////// Se não selecionado [Ano da Deflagração], [Mês da Deflagração] ou [Data da Deflagração], mostrar [Ano], [Mês] ou [Data]:
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vOperHomDtMesAno),
        // números por efetivo
            $(vOperHomDtMesAnoPorEfet),
        // números PF EM NÚMEROS
            $(vOperHomPfEmNumDtMesAno)
            )
    )
;

Call TratarExpansaoMacro(vMedidaMestraOperacoesHomologadas);

// Medida mestra das operações homologadas com seleção de Ano, Mês ou Data TOTAL:
SET vMedidaMestraOperacoesHomologadasTot =
    IF(
    // Se selecionado [Ano da Deflagração], [Mês da Deflagração] ou [Data da Deflagração]
       GetSelectedCount([Ano da Deflagração])
        + GetSelectedCount([Mês da Deflagração])
        + GetSelectedCount([Data da Deflagração])
        + GetSelectedCount([Ano da Apreensão])
        + GetSelectedCount([Mês da Apreensão])
        + GetSelectedCount([Data da Apreensão])
        + GetSelectedCount([Proc_Data Data Ano])
        + GetSelectedCount([Proc_Data Data Mês])
        + GetSelectedCount([Proc_Data Data])
        + GetSelectedCount([Ano do Cadastro])
        + GetSelectedCount([Mês do Cadastro])
        + GetSelectedCount([Data do Cadastro])
        + GetSelectedCount([Ano da Instauração])
        + GetSelectedCount([Mês da Instauração])
        + GetSelectedCount([Data da Instauração])
        + GetSelectedCount([Ano do Relatório])
        + GetSelectedCount([Mês do Relatório])
        + GetSelectedCount([Data do Relatório]) > 0,
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vOperHomDtMesAnoDefl),
        // números por efetivo
            $(vOperHomDtMesAnoDeflPorEfetTot),
        // números PF EM NÚMEROS
            $(vOperHomPfEmNumDtMesAnoDefl)
            ),
//////////////////////// Se não selecionado [Ano da Deflagração], [Mês da Deflagração] ou [Data da Deflagração], mostrar [Ano], [Mês] ou [Data]:
        PICK(
            @(vMostrarValAbsouRelaoEfetouPfEmNum)+1,
        // numeros absolutos 
            $(vOperHomDtMesAno),
        // números por efetivo
            $(vOperHomDtMesAnoPorEfetTot),
        // números PF EM NÚMEROS
            $(vOperHomPfEmNumDtMesAno)
            )
    )
;

Call TratarExpansaoMacro(vMedidaMestraOperacoesHomologadasTot);

