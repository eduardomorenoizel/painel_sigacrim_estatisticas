//-----------------------------------------------------------------------------------------------
// Dimensões para filtrar unidades Superintendências, Especializadas, Bases e Descentralizadas
// por Unidade Sigla do Caso
//-----------------------------------------------------------------------------------------------

DIM_HIERARQUIA_UNIDADE_SIGLA_DO_CASO:
LOAD DISTINCT
    AutoNumberHash128("Unidade Sigla do Caso") AS [%UNIDADE_KEY],
    IF(
        WildMatch(
            "Unidade Sigla do Caso",
            'BABC/*',
            'BAC/*',
            'BASEPLATANOS/*',
            'BEMIG/*',
            'BRBA/*',
            'FICCO/*',
            'GIASE/*',
            'GISE/*',
            'GISECONT/*',
            'BASEQUADRANTE/*',
            'BASELACOR/*',
            '*/BABC/*',
            '*/BAC/*',
            '*/BASEPLATANOS/*',
            '*/BEMIG/*',
            '*/BRBA/*',
            '*/FICCO/*',
            '*/GIASE/*',
            '*/GISE/*',
            '*/GISECONT/*',
            '*/BASEQUADRANTE/*',
            '*/BASELACOR/*'
        ) > 0,
        'Base',
        PICK(
            1 + WildMatch(
                "Unidade Sigla do Caso",
                'PF',
                '*/PF',
                'SR/PF/*',
                '*/SR/PF/*',
                'DPF/*'
                '*/DPF/*'
            ),
            '',
            'Órgão Central',
            'Órgão Central',
            'Órgão Regional',
            'Órgão Regional',
            'Delegacia Descentralizada',
            'Delegacia Descentralizada'
        )
    ) AS "Tipo da Unidade do Caso",
    IF(
        WildMatch(
            "Unidade Sigla do Caso",
            'BABC/*',
            'BAC/*',
            'BASEPLATANOS/*',
            'BEMIG/*',
            'BRBA/*',
            'FICCO/*',
            'GIASE/*',
            'GISE/*',
            'GISECONT/*',
            'BASEQUADRANTE/*',
            'BASELACOR/*',
            '*/BABC/*',
            '*/BAC/*',
            '*/BASEPLATANOS/*',
            '*/BEMIG/*',
            '*/BRBA/*',
            '*/FICCO/*',
            '*/GIASE/*',
            '*/GISE/*',
            '*/GISECONT/*',
            '*/BASEQUADRANTE/*',
            '*/BASELACOR/*'
        ) = 0,
        IF(
            WildMatch(
                "Unidade Sigla do Caso",
                'PF',
                '*/PF'
            ) > 0,
            'Sim',
            'Não'
        )
    ) AS "É Órgão Central",
    IF(
